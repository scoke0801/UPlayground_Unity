{
  "schemaVersion": 1,
  "id": "EnemyBehavior_Humanoid_Staff",
  "displayName": "스태프 원거리 마법사",
  "actorKind": "Ground",
  "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_P09Staff.asset",
  "blackboard": {
    "tickInterval": 0.1,
    "optimalCombatDistance": 12.0,
    "minCombatDistance": 6.0,
    "personalSpaceDistance": 2.0,
    "preferredRange": 12.0,
    "maxComboPressureCount": 2,
    "enablePatrol": true
  },
  "rules": [],
  "groups": [
    {
      "name": "00 실행 보호와 타깃 획득",
      "priority": 1000,
      "rules": [
        { "name": "BlockedStateKeep", "priority": 1000,
          "when": [{ "condition": "IsBlockedEnemyState" }],
          "do": [{ "action": "KeepCurrentState" }] },
        { "name": "NoTargetPatrol", "priority": 990,
          "when": [{ "condition": "HasTarget", "invert": true }],
          "do": [{ "action": "PatrolOrIdle" }] }
      ]
    },
    {
      "name": "10 근접 압박에서 거리 확보",
      "priority": 960,
      "when": [{ "condition": "HasTarget" }],
      "rules": [
        { "name": "MakeCastingSpace", "priority": 960,
          "when": [
            { "condition": "DistanceLessOrEqual", "value": "minCombatDistance" },
            { "condition": "CooldownReady", "value": "StaffSpacing" }
          ],
          "do": [{ "action": "RequestAction", "intent": "Retreat", "cooldownId": "StaffSpacing", "cooldownDuration": 3.5 }] },
        { "name": "CorneredRepulse", "priority": 955,
          "when": [
            { "condition": "DistanceLessOrEqual", "value": "2.5" },
            { "condition": "CooldownReady", "value": "StaffSpacing", "invert": true },
            { "condition": "ActionDelayElapsed" },
            { "condition": "HasLineOfSight" },
            { "condition": "HasAttackSlot" },
            { "condition": "CanActivateAbility", "attackCategory": "Heavy", "abilityRole": "Counter" }
          ],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Heavy", "abilityRole": "Counter" }] },
        { "name": "CorneredSweepOnly", "priority": 950,
          "when": [
            { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" },
            { "condition": "CooldownReady", "value": "StaffSpacing", "invert": true },
            { "condition": "ActionDelayElapsed" },
            { "condition": "HasLineOfSight" },
            { "condition": "HasAttackSlot" },
            { "condition": "CanActivateAbility", "attackCategory": "Basic", "abilityRole": "Counter" },
            { "condition": "CooldownReady", "value": "StaffSweep" }
          ],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Basic", "abilityRole": "Counter", "cooldownId": "StaffSweep", "cooldownDuration": 4.0 }] }
      ]
    },
    {
      "name": "20 사선을 확보한 원거리 시전",
      "priority": 900,
      "when": [
        { "condition": "HasTarget" },
        { "condition": "DistanceGreater", "value": "minCombatDistance" },
        { "condition": "ActionDelayElapsed" },
        { "condition": "HasLineOfSight" },
        { "condition": "HasAttackSlot" }
      ],
      "rules": [
        { "name": "ChargedBeamCast", "priority": 930,
          "when": [
            { "condition": "CanActivateAbility", "attackCategory": "Skill", "abilityRole": "Signature" }
          ],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Skill", "abilityRole": "Signature" }] },
        { "name": "FanBeamCast", "priority": 925,
          "when": [{ "condition": "CanActivateAbility", "attackCategory": "Skill", "abilityRole": "Finisher" }],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Skill", "abilityRole": "Finisher" }] },
        { "name": "BeamCast", "priority": 920,
          "when": [{ "condition": "CanActivateAbility", "attackCategory": "Skill", "abilityRole": "Punish" }],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Skill", "abilityRole": "Punish" }] },
        { "name": "HomingCast", "priority": 917,
          "when": [{ "condition": "CanActivateAbility", "attackCategory": "Basic", "abilityRole": "Punish" }],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Basic", "abilityRole": "Punish" }] },
        { "name": "FanCast", "priority": 915,
          "when": [{ "condition": "CanActivateAbility", "attackCategory": "Basic", "abilityRole": "Finisher" }],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Basic", "abilityRole": "Finisher" }] },
        { "name": "BoltCast", "priority": 910,
          "when": [{ "condition": "CanActivateAbility", "attackCategory": "Basic", "abilityRole": "Opener" }],
          "do": [{ "action": "RequestAction", "intent": "Attack", "attackCategory": "Basic", "abilityRole": "Opener" }] }
      ]
    },
    {
      "name": "30 재배치와 사거리 복구",
      "priority": 800,
      "when": [{ "condition": "HasTarget" }],
      "rules": [
        { "name": "ApproachOutsideSpellRange", "priority": 830,
          "when": [
            { "condition": "DistanceGreater", "value": "preferredRange" },
            { "condition": "HasAttackInRange", "invert": true }
          ],
          "do": [{ "action": "RequestAction", "intent": "Chase" }] },
        { "name": "RepositionBlockedSight", "priority": 820,
          "when": [
            { "condition": "HasLineOfSight", "invert": true },
            { "condition": "CooldownReady", "value": "StaffReposition" }
          ],
          "do": [{ "action": "RequestAction", "intent": "KeepDistance", "style": "Circle", "cooldownId": "StaffReposition", "cooldownDuration": 2.0 }] },
        { "name": "RepositionBetweenCasts", "priority": 810,
          "when": [
            { "condition": "ActionDelayElapsed", "invert": true },
            { "condition": "CooldownReady", "value": "StaffReposition" }
          ],
          "do": [{ "action": "RequestAction", "intent": "KeepDistance", "style": "Circle", "cooldownId": "StaffReposition", "cooldownDuration": 2.0 }] },
        { "name": "HoldCastingPosition", "priority": 800,
          "do": [{ "action": "RequestAction", "intent": "Recover", "style": "Idle" }] }
      ]
    }
  ]
}
