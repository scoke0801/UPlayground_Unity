      periods: 15
    - id: scholarly.03.4
      topic: people
      text: "\uB2F5\uC744 \uC544\uB294\uB370 \uB9D0\uC744 \uB2A6\uAC8C \uAEBC\uB0C8\uC5B4\uC694."
