  m_EditorClassIdentifier:
  nodeId: joan_intro_07
  nodeType: 0
  channel: 0
  speakerId: "조안"
  dialogueText: "새벽에 동쪽 풀숲에서 둘이 쓰는 붉은 천을 봤어. 그 뒤로는 나도 흔적을 못 찾았어."
  portrait: {fileID: 21300000, guid: 6b28897dd9aaef84590221cd2a4bbc24, type: 3}
