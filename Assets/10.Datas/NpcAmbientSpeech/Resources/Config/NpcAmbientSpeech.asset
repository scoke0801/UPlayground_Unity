      activities: 9
      periods: 15
    - id: scholarly.07.4
      topic: plans
      text: "\uB9C8\uC9C0\uB9C9 \uC7A5\uC744 \uBA3C\uC800 \uBCF4\uB294 \uBC84\uB987\uC744
