var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");if(!host.isLoaded||host.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("clean Host Edit Mode 필요; 미저장 변경은 보존");
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
if(hash(host.path)!="461E34FCF4E88EB1FD910979D627B750F238F66B66AF6A3F77A3BB06DAA87598")throw new Exception("source-v2 hash mismatch");
var roots=host.GetRootGameObjects();var all=roots.SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();var environment=roots.Single(g=>g.name=="AuthoredEnvironment");var red=environment.transform.Find("월드 구간/붉은나무숲");if(red==null)throw new Exception("정확 root 누락; 이름폴백 금지");
Func<Transform,string> path=t=>{string s=t.name;while(t.parent!=null){t=t.parent;s=t.name+"/"+s;}return s;};
Func<Bounds,object> bounds=b=>new{min=new[]{b.min.x,b.min.y,b.min.z},max=new[]{b.max.x,b.max.y,b.max.z}};
var area=new Bounds(new Vector3(1145,200,552.5f),new Vector3(168,1200,163));Physics.SyncTransforms();
var native=environment.GetComponentsInChildren<Component>(true).Where(c=>c is Renderer||c is Collider).Where(c=>area.Intersects(c is Renderer?((Renderer)c).bounds:((Collider)c).bounds)).Select(c=>new{path=path(c.transform),type=c.GetType().FullName,globalObjectId=GlobalObjectId.GetGlobalObjectIdSlow(c).ToString(),bounds=bounds(c is Renderer?((Renderer)c).bounds:((Collider)c).bounds),active=c.gameObject.activeInHierarchy,hostScene=c.gameObject.scene.path}).ToArray();
var modifiers=all.SelectMany(t=>t.GetComponents<Component>()).Where(c=>c!=null&&c.GetType().Name=="NavMeshModifierVolume").Select(c=>new{path=path(c.transform),globalObjectId=GlobalObjectId.GetGlobalObjectIdSlow(c).ToString(),position=new[]{c.transform.position.x,c.transform.position.y,c.transform.position.z},serialized=EditorJsonUtility.ToJson(c)}).ToArray();
var ids=all.SelectMany(t=>t.GetComponents<UPlayGround.Components.SceneEntityId>()).Select(e=>new{id=e.Guid,path=path(e.transform),position=new[]{e.transform.position.x,e.transform.position.y,e.transform.position.z},withinExpandedReference=area.Contains(e.transform.position)}).ToArray();
var regionBindings=all.SelectMany(t=>t.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&(c.GetType().Name.Contains("Region")||c.GetType().Name.Contains("Streamed")||c.GetType().Name=="ContinuousWorldController")).Select(c=>new{path=path(c.transform),type=c.GetType().FullName,serialized=EditorJsonUtility.ToJson(c)}).ToArray();
var result=new{status="readonly expansion; no core permission",sceneHash=hash(host.path),hostDirty=host.isDirty,rootGlobalId=GlobalObjectId.GetGlobalObjectIdSlow(red).ToString(),native=native,modifierVolumes=modifiers,allHostIds=ids,regionBindings=regionBindings,physicsRule="Host scene only; no other ArtReview hits allowed",navRule="loaded-global sample is not Host path certification"};var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);string json=(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result});System.IO.File.WriteAllText("output/WorldThemeProduction/RedTreeForest/live-protection-probe.json",json);return "native="+native.Length+" modifiers="+modifiers.Length+" ids="+ids.Length+" near="+ids.Count(r=>r.withinExpandedReference)+" regionBindings="+regionBindings.Length+" dirty="+host.isDirty;
