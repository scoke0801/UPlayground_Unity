/* ═══════════════════════════════════════════════════════════
   BehaviorTree Editor  —  Unreal Engine Style
   ═══════════════════════════════════════════════════════════ */

/* ── 그래프 배경 ─────────────────────────────────────────── */
GridBackground {
    --grid-background-color: #1b1b1b;
    --line-color:             #252525;
    --thick-line-color:       #303030;
    --spacing:                20;
}

/* ── 툴바 ───────────────────────────────────────────────── */
.bt-toolbar-label {
    color: #bbbbbb;
    -unity-font-style: bold;
    margin-right: 12px;
    font-size: 12px;
    align-self: center;
}

.bt-editmode-badge {
    background-color: #3a3a3a;
    color: #aaaaaa;
    border-radius: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    align-self: center;
}

.bt-runtime-badge {
    background-color: #c84800;
    color: #ffffff;
    border-radius: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    align-self: center;
}

/* ══════════════════════════════════════════════════════════
   노드 기본 구조
   ══════════════════════════════════════════════════════════ */

.bt-ue-node {
    min-width: 190px;
}

/* 노드 외곽 테두리 + 배경 */
.bt-ue-node #node-border {
    background-color: #252526;
    border-radius: 6px;
    border-width: 2px;
    border-color: #3c3c3c;
    overflow: hidden;
}

/* 선택 시 흰 테두리 */
.bt-ue-node:selected #node-border {
    border-color: #dddddd;
    border-width: 2px;
}

/* ── 입력 포트 행 (최상단) ─────────────────────────────── */
.bt-ue-portrow-top {
    align-items: center;
    justify-content: center;
    background-color: #1b1b1b;
    min-height: 18px;
    padding-top: 0px;
    padding-bottom: 0px;
}

/* ── 헤더 (titleContainer) ─────────────────────────────── */
.bt-ue-node #title {
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 0px;
    background-color: transparent;
    border-bottom-width: 0px;
}

.bt-ue-header-row {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
}

.bt-ue-icon {
    font-size: 13px;
    color: rgba(255,255,255,0.9);
    -unity-font-style: bold;
    margin-right: 6px;
    -unity-text-align: middle-center;
    width: 16px;
}

.bt-ue-typename {
    font-size: 11px;
    color: rgba(255,255,255,0.85);
    -unity-font-style: bold;
    flex-grow: 1;
}

.bt-ue-spacer {
    flex-grow: 1;
}

.bt-ue-status-dot {
    font-size: 9px;
    color: rgba(0,0,0,0);
    width: 10px;
    height: 10px;
    -unity-text-align: middle-center;
}

/* ── 타입별 헤더 색상 ──────────────────────────────────── */
.bt-type-selector  #title { background-color: #1a55a8; }
.bt-type-sequence  #title { background-color: #1a6b30; }
.bt-type-random    #title { background-color: #8c6015; }
.bt-type-action    #title { background-color: #5c1a8a; }
.bt-type-condition #title { background-color: #1a6060; }
.bt-type-inverter      #title { background-color: #7a6200; }
.bt-type-cooldown      #title { background-color: #1a5050; }
.bt-type-forcesuccess  #title { background-color: #1a5080; }
.bt-type-loop          #title { background-color: #4a1a6a; }
.bt-type-guard         #title { background-color: #6b1a1a; }

/* ── 바디 (extensionContainer) ─────────────────────────── */
.bt-ue-body {
    padding-top: 8px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: #1a1a1a;
    background-color: #2d2d2d;
}

.bt-ue-nodename {
    font-size: 12px;
    color: #e8e8e8;
    -unity-font-style: bold;
    white-space: normal;
}

.bt-ue-desc {
    font-size: 10px;
    color: #888888;
    margin-top: 3px;
}

/* ── 출력 포트 행 (최하단) ─────────────────────────────── */
.bt-ue-portrow-bottom {
    align-items: center;
    justify-content: center;
    background-color: #1b1b1b;
    min-height: 18px;
    padding-top: 0px;
    padding-bottom: 0px;
    border-top-width: 1px;
    border-top-color: #1a1a1a;
}

/* ── 포트 공통 ─────────────────────────────────────────── */
.bt-ue-node Port {
    background-color: transparent;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 0px;
    padding-right: 0px;
}

/* 포트 라벨 숨김 */
.bt-ue-node .port-label {
    display: none;
}

/* 포트 커넥터 (사각형 핀 스타일) */
.bt-ue-node .port__connector {
    width: 16px;
    height: 7px;
    border-radius: 2px;
    background-color: #505050;
    border-width: 1px;
    border-color: #888888;
}

.bt-ue-node .port__connector:hover {
    background-color: #aaaaaa;
    border-color: #ffffff;
}

.bt-ue-node Port.connected .port__connector {
    background-color: #c8c8c8;
    border-color: #eeeeee;
}

/* ── 런타임 상태 — 테두리 색 ──────────────────────────── */
.bt-running    #node-border { border-color: #f5c518; border-width: 2px; }
.bt-success    #node-border { border-color: #4caf50; border-width: 2px; }
.bt-failure    #node-border { border-color: #f44336; border-width: 2px; }
.bt-breakpoint #node-border { border-color: #ff2020; border-width: 3px; }

/* 상태 도트 색상 */
.bt-dot-running { color: #f5c518; }
.bt-dot-success { color: #4caf50; }
.bt-dot-failure { color: #f44336; }

/* ── 실행 순서 인덱스 배지 ─────────────────────────────── */
.bt-child-index {
    position:         absolute;
    top:              2px;
    left:             4px;
    font-size:        9px;
    color:            #f5c518;
    -unity-font-style: bold;
    background-color: rgba(0,0,0,0.55);
    border-radius:    3px;
    padding-top:      1px;
    padding-bottom:   1px;
    padding-left:     3px;
    padding-right:    3px;
}

/* ══════════════════════════════════════════════════════════
   Service 스트립 (extensionContainer 하단)
   ══════════════════════════════════════════════════════════ */

.bt-service-strip {
    flex-direction: row;
    align-items: center;
    background-color: #1a3a1a;
    border-top-width: 1px;
    border-top-color: #2a5a2a;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 4px;
}

.bt-svc-icon {
    font-size: 10px;
    color: #6ec06e;
    margin-right: 5px;
    width: 12px;
    -unity-text-align: middle-center;
}

.bt-svc-label {
    font-size: 10px;
    color: #5aaa5a;
    -unity-font-style: italic;
}

/* ══════════════════════════════════════════════════════════
   Decorator 뱃지 (Unreal식 인라인 — extensionContainer 상단)
   ══════════════════════════════════════════════════════════ */

.bt-decorator-badge {
    background-color: #2a2a2a;
    border-radius: 3px;
    border-width: 0px;
    border-left-width: 3px;
    border-left-color: #888888;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 4px;
}

/* 타입별 왼쪽 강조색 */
.bt-dec-guard       { border-left-color: #2a7aaf; background-color: #1a2a38; }
.bt-dec-cooldown    { border-left-color: #5ab0a8; background-color: #1a2e2d; }
.bt-dec-inverter    { border-left-color: #c8a020; background-color: #2a2000; }
.bt-dec-forcesuccess{ border-left-color: #4caf50; background-color: #1a2a1a; }
.bt-dec-loop        { border-left-color: #9b59b6; background-color: #24182e; }

.bt-dec-icon {
    font-size: 11px;
    color: #dddddd;
    -unity-font-style: bold;
    margin-right: 5px;
    width: 13px;
    -unity-text-align: middle-center;
}

.bt-dec-label {
    font-size: 10px;
    color: #cccccc;
    -unity-font-style: bold;
}

.bt-dec-abort {
    font-size: 9px;
    color: #888888;
    -unity-font-style: italic;
    padding-left: 18px;
    margin-top: 1px;
}

/* ══════════════════════════════════════════════════════════
   Blackboard 패널
   ══════════════════════════════════════════════════════════ */

.bt-blackboard {
    background-color: #1e1e1e;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.bt-blackboard-title {
    color: #cccccc;
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

.bt-blackboard-row {
    flex-direction: row;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: #282828;
}

.bt-blackboard-type {
    color: #f5a623;
    font-size: 10px;
    width: 52px;
    -unity-font-style: bold;
}

.bt-blackboard-key {
    color: #888888;
    font-size: 10px;
    width: 130px;
}

.bt-blackboard-value {
    color: #88c8f0;
    font-size: 10px;
    flex-grow: 1;
    -unity-font-style: bold;
}
