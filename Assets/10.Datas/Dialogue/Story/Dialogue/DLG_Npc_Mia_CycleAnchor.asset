  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId:
  trueNextNodeId:
  falseNextNodeId:
  choices:
  - choiceText: "마지막으로 본 곳이 어디야?"
    nextNodeId: mia_initial_request_2
    displayCondition: {fileID: 0}
    isGreyedOut: 0
  - choiceText: "지나온 길부터 같이 짚어 보자."
    nextNodeId: mia_initial_location_route
    displayCondition: {fileID: 0}
    isGreyedOut: 0
  condition: {fileID: 0}
