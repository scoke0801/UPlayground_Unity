      text: "\uC774\uC81C \uADF8\uB9CC \uB4E4\uC5B4\uAC00\uC57C \uD560 \uC2DC\uAC04\uC774\uAD6C\uB098."
      activities: 9
      periods: 8
    - id: seasoned.15.0
      topic: rest
      text: "\uC549\uC744 \uC790\uB9AC\uAC00 \uC788\uC73C\uBA74 \uBC1C\uC774 \uBA3C\uC800
        \uC54C\uC544."
      activities: 8
      periods: 15
    - id: seasoned.15.1
      topic: rest
      text: "\uC77C\uC5B4\uB098\uB824\uBA74 \uC598\uAE30\uB97C \uB05D\uB0B4\uC57C
        \uD558\uB294\uB370."
      activities: 8
      periods: 15
    - id: seasoned.15.2
      topic: rest
      text: "\uD5C8\uB9AC\uB97C \uD3B4\uB2C8\uAE4C \uC18C\uB9AC\uAC00 \uB098\uB124."
      activities: 8
      periods: 15
    - id: seasoned.15.3
      topic: rest
      text: "\uC7A0\uAE50 \uC270\uB2E4\uB354\uB2C8 \uC81C\uB300\uB85C \uC549\uC558\uC5B4."
      activities: 8
      periods: 15
    - id: seasoned.15.4
      topic: rest
      text: "\uADF8\uB0E5 \uC549\uC544 \uC788\uB294 \uAC74 \uC624\uB79C\uB9CC\uC774\uB124."
      activities: 8
      periods: 15
    - id: seasoned.15.5
      topic: rest
      text: "\uC26C\uBA74\uC11C\uB3C4 \uC190\uC740 \uAC00\uB9CC\uC788\uC9C8 \uC54A\uC9C0."
      activities: 8
      periods: 15
    - id: seasoned.15.6
      topic: rest
      text: "\uC77C\uC5B4\uB098\uB294 \uAE40\uC5D0 \uD560 \uC77C\uC744 \uBAA8\uC544\uC57C\uACA0\uC5B4."
      activities: 8
      periods: 15
    - id: seasoned.15.7
      topic: rest
      text: "\uC878\uC558\uB0D0\uACE0 \uBB3C\uC73C\uBA74 \uC544\uB2C8\uB77C\uACE0
        \uD560 \uD150\uB370."
      activities: 8
      periods: 15
  - id: courtly
    direction: "\uC7A5\uC2DD \uC788\uB294 \uC678\uD22C\uC640 \uC798 \uC815\uB3C8\uB41C
      \uC758\uC0C1. \uACA9\uC2DD\uC744 \uB0B4\uC138\uC6B0\uAE30\uBCF4\uB2E4 \uC0C9\xB7\uD5A5\xB7\uBAA8\uC591\uC5D0
      \uAE4C\uB2E4\uB86D\uACE0 \uC18D\uB9C8\uC74C\uC744 \uC870\uAE08 \uC228\uAE30\uB294
      \uCDE8\uD5A5\uAC00. \uB2E8\uC815\uD55C \uD574\uC694\uCCB4 \uD63C\uC7A3\uB9D0,
      \uADC0\uC871 \uC2E0\uBD84\uC744 \uC9C0\uC5B4\uB0B4\uC9C0 \uC54A\uB294\uB2E4."
    lines:
    - id: courtly.00.0
      topic: lost
      text: "\uB298 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uB450\uC5C8\uB294\uB370 \uC774\uC0C1\uD558\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.1
      topic: lost
      text: "\uC783\uC5B4\uBC84\uB9B4 \uB9CC\uD55C \uD06C\uAE30\uB294 \uC544\uB2CC\uB370\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.2
      topic: lost
      text: "\uCC3E\uB294 \uBAA8\uC2B5\uC744 \uB108\uBB34 \uC624\uB798 \uBCF4\uC774\uC9C4
        \uB9D0\uC544\uC57C\uC8E0."
      activities: 9
      periods: 15
    - id: courtly.00.3
      topic: lost
      text: "\uBC14\uAFD4 \uB123\uC740 \uAC78 \uC78A\uACE0 \uC788\uC5C8\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.4
      topic: lost
      text: "\uD3EC\uC7A5\uB9CC \uB0A8\uACA8 \uB193\uC558\uB098 \uBD10\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.5
      topic: lost
      text: "\uB208\uC5D0 \uB744\uB294 \uC0C9\uC73C\uB85C \uACE0\uB97C\uAC78 \uADF8\uB7AC\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.6
      topic: lost
      text: "\uC548\uCABD \uC8FC\uBA38\uB2C8\uB294 \uC800\uB3C4 \uC790\uC8FC \uC78A\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.00.7
      topic: lost
      text: "\uB3CC\uB824 \uB4DC\uB9B0 \uAC78 \uC81C \uAC83\uC73C\uB85C \uCC3E\uACE0
        \uC788\uC5C8\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.0
      topic: food
      text: "\uD5A5\uC740 \uC88B\uC558\uB294\uB370 \uB9DB\uC740 \uC870\uAE08 \uB2EC\uB790\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.1
      topic: food
      text: "\uC791\uC740 \uC794\uC774 \uAE08\uBC29 \uBE44\uB294 \uAC74 \uC544\uC27D\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.2
      topic: food
      text: "\uB35C \uB2EC\uAC8C \uBD80\uD0C1\uD55C\uB2E4\uB294 \uAC78 \uC78A\uC5C8\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.3
      topic: food
      text: "\uB9DB\uC744 \uBB3B\uAE38\uB798 \uC88B\uB2E4\uACE0\uB9CC \uB300\uB2F5\uD588\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.4
      topic: food
      text: "\uD55C \uC785\uB9CC \uBA39\uC73C\uB824\uB2E4 \uBAA8\uC591\uC744 \uB9DD\uCCE4\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.5
      topic: food
      text: "\uADF8\uB987 \uC0C9\uC774 \uB9DB\uAE4C\uC9C0 \uBC14\uAFD4 \uB193\uB294
        \uAC78\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.6
      topic: food
      text: "\uB9C8\uC9C0\uB9C9 \uD55C \uC870\uAC01\uC740 \uB298 \uACE0\uB974\uAE30
        \uC5B4\uB835\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.01.7
      topic: food
      text: "\uCC28\uAC00 \uC2DD\uC73C\uBA74 \uB2E4\uB978 \uD5A5\uC774 \uB098\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.0
      topic: expenses
      text: "\uC0C9 \uD558\uB098 \uB54C\uBB38\uC5D0 \uC624\uB798 \uACE0\uB974\uACE0
        \uC788\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.1
      topic: expenses
      text: "\uAC19\uC740 \uBB3C\uAC74\uC744 \uB450 \uBC88 \uBCF4\uB7EC \uAC14\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.2
      topic: expenses
      text: "\uAC00\uACA9\uC744 \uB4E3\uAE30 \uC804\uC5D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4
        \uBC84\uB838\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.3
      topic: expenses
      text: "\uB531 \uD558\uB098\uB9CC \uACE0\uB974\uB77C\uB294 \uAC8C \uC5B4\uB835\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.4
      topic: expenses
      text: "\uC190\uC5D0 \uB4E4\uBA74 \uB0B4\uB824\uB193\uAE30\uAC00 \uB354 \uD798\uB4E4\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.5
      topic: expenses
      text: "\uD3EC\uC7A5\uC774 \uB108\uBB34 \uC608\uBED0\uC11C \uD480\uAE30\uAC00
        \uC544\uAE4C\uC6E0\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.6
      topic: expenses
      text: "\uC120\uBB3C\uC740 \uBC1B\uB294 \uBD84 \uCDE8\uD5A5\uC774 \uBA3C\uC800\uACA0\uC9C0\uC694."
      activities: 9
      periods: 15
    - id: courtly.02.7
      topic: expenses
      text: "\uBE44\uC2B7\uD55C \uAC8C \uC788\uB294\uB370\uB3C4 \uB2E4\uB974\uAC8C
        \uBCF4\uC774\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.0
      topic: people
      text: "\uC88B\uB2E4\uB294 \uB9D0\uC744 \uB108\uBB34 \uB2F4\uB2F4\uD558\uAC8C
        \uD588\uB098 \uBD10\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.1
      topic: people
      text: "\uC774\uB984\uC744 \uD2C0\uB9AC\uC9C0 \uC54A\uC73C\uB824\uACE0 \uACC4\uC18D
        \uC0DD\uAC01\uD588\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.2
      topic: people
      text: "\uBC18\uAC00\uC6B4 \uD2F0\uAC00 \uB0AC\uC744\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.3
      topic: people
      text: "\uCE6D\uCC2C\uC744 \uB4E4\uC73C\uBA74 \uB300\uB2F5\uC774 \uB2A6\uC5B4\uC838\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.4
      topic: people
      text: "\uB2E4\uC74C \uB9D0\uC744 \uAE30\uB2E4\uB9AC\uB2E4 \uC778\uC0AC\uB97C
        \uB193\uCCE4\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.5
      topic: people
      text: "\uB9C8\uC74C\uC5D0 \uC548 \uB4E0\uB2E4\uB294 \uB73B\uC740 \uC544\uB2C8\uC5C8\uB294\uB370."
      activities: 9
      periods: 15
    - id: courtly.03.6
      topic: people
      text: "\uB208\uCE58\uCC44\uC168\uB2E4\uBA74 \uC870\uAE08 \uBD80\uB044\uB7FD\uACA0\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.03.7
      topic: people
      text: "\uC6C3\uB294 \uAC78 \uCC38\uC73C\uB824\uB2E4 \uB354 \uC5B4\uC0C9\uD574\uC84C\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.0
      topic: animals
      text: "\uACE0\uC591\uC774\uB294 \uC637 \uC0C9\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.1
      topic: animals
      text: "\uD138\uC774 \uBD99\uC73C\uBA74 \uC637\uAC10\uC774 \uC798 \uBCF4\uC5EC\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.2
      topic: animals
      text: "\uB2E4\uAC00\uC624\uB294 \uAC74 \uC88B\uC740\uB370 \uBC1C\uD1B1\uC740
        \uC870\uAE08."
      activities: 9
      periods: 15
    - id: courtly.04.3
      topic: animals
      text: "\uAC15\uC544\uC9C0 \uC55E\uC5D0\uC120 \uD45C\uC815\uC744 \uC228\uAE30\uAE30
        \uC5B4\uB835\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.4
      topic: animals
      text: "\uADF8 \uC791\uC740 \uBC1C\uB85C \uAF64 \uBA40\uB9AC \uAC00\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.5
      topic: animals
      text: "\uBA39\uC774\uB97C \uAEBC\uB0B4\uAE30 \uC804\uBD80\uD130 \uC54C\uACE0
        \uC788\uC5C8\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.6
      topic: animals
      text: "\uAC00\uB9CC\uD788 \uC549\uC544 \uC788\uC73C\uBA74 \uC606\uC5D0 \uC624\uB354\uB77C\uACE0\uC694."
      activities: 9
      periods: 15
    - id: courtly.04.7
      topic: animals
      text: "\uB3D9\uBB3C\uC740 \uCE6D\uCC2C\uBC1B\uB294 \uC904 \uC54C\uC544\uB4E3\uACA0\uC9C0\uC694?"
      activities: 9
      periods: 15
    - id: courtly.05.0
      topic: clothes
      text: "\uD55C\uCABD\uB9CC \uC811\uD78C \uAC8C \uACC4\uC18D \uB208\uC5D0 \uB4E4\uC5B4\uC640\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.1
      topic: clothes
      text: "\uBE5B \uBC1B\uB294 \uCABD\uC5D0 \uB530\uB77C \uC0C9\uC774 \uB2EC\uB77C\uC9C0\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.2
      topic: clothes
      text: "\uC2E4 \uD558\uB098\uB97C \uBF51\uC558\uB354\uB2C8 \uB354 \uAE38\uAC8C
        \uB098\uC654\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.3
      topic: clothes
      text: "\uC7A5\uC2DD\uC740 \uC608\uC05C\uB370 \uBA38\uB9AC\uCE74\uB77D\uC774
        \uAC78\uB824\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.4
      topic: clothes
      text: "\uB9E4\uB4ED \uB05D\uC744 \uAC19\uC740 \uAE38\uC774\uB85C \uB9DE\uCDC4\uB294\uB370."
      activities: 9
      periods: 15
    - id: courtly.05.5
      topic: clothes
      text: "\uC637\uAC10\uC774 \uC6B0\uB294 \uB370\uB97C \uC190\uBD10\uC57C\uACA0\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.6
      topic: clothes
      text: "\uC774 \uB2E8\uCD94\uB294 \uBE5B\uC774 \uB108\uBB34 \uAC15\uD558\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.05.7
      topic: clothes
      text: "\uC8FC\uBA38\uB2C8 \uBAA8\uC591 \uB54C\uBB38\uC5D0 \uACE0\uB978 \uC637\uC774\uC5D0\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.0
      topic: habits
      text: "\uC794\uC744 \uB193\uC73C\uBA74 \uC190\uC7A1\uC774\uB97C \uAF2D \uB3CC\uB9AC\uAC8C
        \uB418\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.1
      topic: habits
      text: "\uCC28\uC774\uAC00 \uBCF4\uC774\uBA74 \uBAA8\uB978 \uCC99\uD558\uAE30\uAC00
        \uC5B4\uB824\uC6CC\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.2
      topic: habits
      text: "\uD45C\uC815\uC744 \uACE0\uB978\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB294\uB370
        \uAD73\uC5B4 \uC788\uC5C8\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.3
      topic: habits
      text: "\uB9C8\uC74C\uC5D0 \uB4E0 \uAC74 \uB450 \uBC88 \uD655\uC778\uD574\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.4
      topic: habits
      text: "\uAC19\uC740 \uAC04\uACA9\uC73C\uB85C \uB193\uB294 \uBC84\uB987\uC774
        \uC788\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.5
      topic: habits
      text: "\uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uACFC \uC88B\uB2E4\uB294 \uB9D0\uC740
        \uB2E4\uB978\uB370\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.6
      topic: habits
      text: "\uC18C\uB9E4 \uB05D\uC744 \uB9CC\uC9C0\uB2E4\uAC00 \uB610 \uC8FC\uB984\uC744
        \uB0C8\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.06.7
      topic: habits
      text: "\uC870\uC6A9\uD788 \uC6C3\uC73C\uBA74 \uC544\uBB34\uB3C4 \uBABB \uC54C\uC544\uBCF4\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.0
      topic: plans
      text: "\uB2E4\uC74C\uC5D4 \uD3C9\uC18C\uC5D0 \uC548 \uACE0\uB974\uB358 \uC0C9\uB3C4
        \uBCFC\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.1
      topic: plans
      text: "\uC4F0\uC9C0 \uC54A\uACE0 \uB450\uAE30\uC5D4 \uC870\uAE08 \uC544\uAE5D\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.2
      topic: plans
      text: "\uD3EC\uC7A5 \uB048\uC73C\uB85C \uC791\uC740 \uB9E4\uB4ED\uC744 \uB9CC\uB4E4\uC5B4
        \uBCFC\uAE4C \uD574\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.3
      topic: plans
      text: "\uB3CC\uB824 \uB4DC\uB9B4 \uB54C \uAC19\uC740 \uBAA8\uC591\uC73C\uB85C
        \uBB36\uACE0 \uC2F6\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.4
      topic: plans
      text: "\uADF8\uBD84\uC774 \uACE0\uB978 \uAC83\uB3C4 \uD55C\uBC88 \uBCF4\uACE0
        \uC2F6\uB124\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.5
      topic: plans
      text: "\uC608\uC05C\uB370 \uBD88\uD3B8\uD55C \uAC74 \uC774\uC81C \uADF8\uB9CC
        \uACE0\uB97C\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.6
      topic: plans
      text: "\uB9DE\uB294 \uD06C\uAE30\uB97C \uB530\uB85C \uC801\uC5B4 \uB450\uC5B4\uC57C\uACA0\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: courtly.07.7
      topic: plans
      text: "\uC774\uBC88\uC5D4 \uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uAC78 \uB9D0\uD574
        \uBCFC\uB798\uC694."
      activities: 9
      periods: 15
    - id: courtly.08.0
      topic: travel
      text: "\uAE38\uC744 \uACE0\uB974\uB2E4 \uAC19\uC740 \uACF3\uC73C\uB85C \uB3CC\uC544\uC654\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.1
      topic: travel
      text: "\uBA40\uB9AC\uC11C \uBCF4\uB358 \uBAA8\uC591\uACFC \uC870\uAE08 \uB2EC\uB77C\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.2
      topic: travel
      text: "\uAC78\uC73C\uBA74\uC11C \uBCF4\uBA74 \uC0C9\uC774 \uB2EC\uB77C\uC9C0\uB294
        \uAC8C \uC788\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.3
      topic: travel
      text: "\uB108\uBB34 \uBE60\uB974\uBA74 \uAD6C\uACBD\uD55C \uAC8C \uAE30\uC5B5\uC5D0
        \uC548 \uB0A8\uC544\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.4
      topic: travel
      text: "\uBC1C\uAC78\uC74C\uC5D0 \uB9DE\uCDB0 \uC637\uC774 \uC2A4\uCE58\uB294
        \uC18C\uB9AC\uAC00 \uB098\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.5
      topic: travel
      text: "\uC5B4\uB290 \uCABD\uC73C\uB85C \uB3CC\uC544 \uB098\uC654\uB294\uC9C0
        \uC7A0\uAE50 \uD5F7\uAC08\uB838\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.6
      topic: travel
      text: "\uC774 \uAE38\uC740 \uB3CC\uC544\uAC08 \uB54C \uB2E4\uC2DC \uBCF4\uACE0
        \uC2F6\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.08.7
      topic: travel
      text: "\uAC77\uB294 \uB3D9\uC548 \uC0DD\uAC01\uC774 \uC870\uAE08 \uAC00\uBCBC\uC6CC\uC84C\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.0
      topic: feet
      text: "\uC0C8 \uC2E0\uBC1C\uC774 \uC544\uC9C1 \uC800\uB97C \uBAA8\uB974\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.1
      topic: feet
      text: "\uBC1C\uB4F1\uC758 \uB048\uC744 \uC870\uAE08 \uB290\uC2A8\uD558\uAC8C
        \uD560\uAC78\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.2
      topic: feet
      text: "\uC608\uC05C \uC2E0\uBC1C\uACFC \uD3B8\uD55C \uC2E0\uBC1C\uC740 \uB2E4\uB974\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.3
      topic: feet
      text: "\uBC1C\uB05D\uC5D0 \uD798\uC744 \uC8FC\uBA74 \uAC78\uC74C\uC774 \uAD73\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.4
      topic: feet
      text: "\uD55C\uCABD \uBC11\uCC3D \uC18C\uB9AC\uB9CC \uB354 \uD06C\uAC8C \uB098\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.5
      topic: feet
      text: "\uC637\uC790\uB77D\uC744 \uBC1F\uC9C0 \uC54A\uC73C\uB824\uB2C8 \uBCF4\uD3ED\uC774
        \uC9E7\uC544\uC838\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.6
      topic: feet
      text: "\uCC9C\uCC9C\uD788 \uAC78\uC5B4\uC57C \uB35C \uC4F8\uB9AC\uACA0\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: courtly.09.7
      topic: feet
      text: "\uBC1C\uC774 \uD3B8\uD55C \uAC78 \uACE8\uB790\uC5B4\uC57C \uD588\uB124\uC694."
      activities: 2
      periods: 15
    - id: courtly.10.0
      topic: effort
      text: "\uBAA8\uC591\uBCF4\uB2E4 \uC7A1\uB294 \uBC95\uC774 \uBA3C\uC800\uC600\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.1
      topic: effort
      text: "\uC0DD\uAC01\uD55C \uB300\uB85C \uC190\uC774 \uC6C0\uC9C1\uC774\uC9C4
        \uC54A\uC544\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.2
      topic: effort
      text: "\uC870\uAE08 \uD2C0\uC5B4\uC9C4 \uAC8C \uB208\uC5D0 \uB4E4\uC5B4\uC624\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.3
      topic: effort
      text: "\uB05D\uAE4C\uC9C0 \uAC19\uC740 \uD798\uC744 \uC8FC\uB294 \uAC8C \uC5B4\uB835\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.4
      topic: effort
      text: "\uC774\uBC88\uC5D4 \uC81C \uC190\uC5D0\uB3C4 \uC775\uC744\uAE4C\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.5
      topic: effort
      text: "\uBCF4\uAE30\uC5D0 \uC26C\uC6CC\uB3C4 \uD574 \uBCF4\uBA74 \uB2E4\uB974\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.6
      topic: effort
      text: "\uC774\uB9CC\uD07C\uC740 \uC81C\uAC00 \uD55C \uD2F0\uAC00 \uB098\uACA0\uC9C0\uC694."
      activities: 4
      periods: 15
    - id: courtly.10.7
      topic: effort
      text: "\uAC89\uBCF4\uB2E4 \uC548\uCABD\uC5D0 \uB354 \uC190\uC774 \uAC00\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.0
      topic: mistakes
      text: "\uAD1C\uCC2E\uB2E4\uACE0 \uB118\uAE30\uAE30\uC5D4 \uC790\uAFB8 \uBCF4\uC774\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.1
      topic: mistakes
      text: "\uB108\uBB34 \uBC18\uB4EF\uD558\uAC8C \uD558\uB824\uB2E4 \uD2C0\uB838\uC5B4\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.2
      topic: mistakes
      text: "\uC190\uC744 \uB5BC\uBA74 \uB35C \uC2E0\uACBD \uC4F0\uC77C\uAE4C\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.3
      topic: mistakes
      text: "\uACE0\uCE5C \uC790\uB9AC\uB97C \uB610 \uB9CC\uC84C\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.4
      topic: mistakes
      text: "\uD55C\uCABD\uC744 \uB9DE\uCD94\uB2C8 \uB2E4\uB978 \uCABD\uC774 \uB2EC\uB77C\uC838\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.5
      topic: mistakes
      text: "\uAC00\uAE4C\uC774 \uBCFC\uC218\uB85D \uC791\uC740 \uD760\uC774 \uBCF4\uC774\uB124\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.6
      topic: mistakes
      text: "\uC544\uAE4C \uBA48\uCDC4\uC73C\uBA74 \uAD1C\uCC2E\uC558\uC744 \uD150\uB370\uC694."
      activities: 4
      periods: 15
    - id: courtly.11.7
      topic: mistakes
      text: "\uBAA8\uC591\uC744 \uBC14\uAFB8\uB294 \uD3B8\uC774 \uB098\uC744\uC9C0\uB3C4
        \uBAA8\uB974\uACA0\uC5B4\uC694."
      activities: 4
      periods: 15
    - id: courtly.12.0
      topic: dawn
      text: "\uC7A0\uC5D0\uC11C \uAE68\uB2C8 \uBAA9\uC18C\uB9AC\uAC00 \uB0AF\uC124\uC5B4\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.1
      topic: dawn
      text: "\uC77C\uCC0D \uAE7C\uB2E4\uACE0 \uC11C\uB450\uB97C \uD544\uC694\uB294
        \uC5C6\uACA0\uC8E0."
      activities: 9
      periods: 1
    - id: courtly.12.2
      topic: dawn
      text: "\uAFC8\uC5D0\uC11C \uACE0\uB978 \uC0C9\uC774 \uC788\uC5C8\uB294\uB370
        \uC78A\uC5C8\uB124\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.3
      topic: dawn
      text: "\uC544\uCE68\uC5D4 \uAC70\uC6B8\uC744 \uC624\uB798 \uBCF4\uC9C0 \uC54A\uC73C\uB824
        \uD574\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.4
      topic: dawn
      text: "\uC774\uBD88 \uC811\uD78C \uC120\uC774 \uC790\uAFB8 \uB2EC\uB77C\uC9C0\uB124\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.5
      topic: dawn
      text: "\uC790\uB294 \uB3D9\uC548 \uBA38\uB9AC\uAC00 \uB9CE\uC774 \uC5C9\uCF30\uC5B4\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.6
      topic: dawn
      text: "\uC544\uCE68\uC5D0 \uB9C8\uC2E4 \uCC28\uBD80\uD130 \uC0DD\uAC01\uD588\uC5B4\uC694."
      activities: 9
      periods: 1
    - id: courtly.12.7
      topic: dawn
      text: "\uB35C \uAE6C \uC5BC\uAD74\uC740 \uC870\uAE08 \uC228\uAE30\uACE0 \uC2F6\uB124\uC694."
      activities: 9
      periods: 1
    - id: courtly.13.0
      topic: dusk
      text: "\uC774 \uBE5B\uC5D0\uC120 \uAC19\uC740 \uC0C9\uB3C4 \uB530\uB73B\uD574
        \uBCF4\uC774\uB124\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.1
      topic: dusk
      text: "\uC800\uB141\uC774 \uB418\uB2C8 \uC637\uAE43\uC774 \uB354 \uAC70\uC2AC\uB824\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.2
      topic: dusk
      text: "\uB3CC\uC544\uAC00\uBA74 \uC7A5\uC2DD\uBD80\uD130 \uD480\uACE0 \uC2F6\uC5B4\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.3
      topic: dusk
      text: "\uB0AE\uC5D0 \uACE0\uB978 \uAC8C \uC9C0\uAE08\uB3C4 \uB9C8\uC74C\uC5D0
        \uB4E4\uAE4C\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.4
      topic: dusk
      text: "\uC800\uB141\uC0C1\uC5D0\uB294 \uC870\uAE08 \uC791\uC740 \uC794\uC774
        \uC88B\uACA0\uC5B4\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.5
      topic: dusk
      text: "\uC624\uB298\uC740 \uD5A5\uC744 \uB108\uBB34 \uC9C4\uD558\uAC8C \uACE8\uB790\uB098
        \uBD10\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.6
      topic: dusk
      text: "\uC9D1\uC5D0 \uAC00\uB294 \uAE38\uC5D4 \uAC78\uC74C\uC744 \uB2A6\uCD9C\uB798\uC694."
      activities: 9
      periods: 4
    - id: courtly.13.7
      topic: dusk
      text: "\uD574\uAC00 \uAE30\uC6B8\uBA74 \uBC18\uC9DD\uC774\uB294 \uAC83\uB3C4
        \uCC28\uBD84\uD574\uC9C0\uB124\uC694."
      activities: 9
      periods: 4
    - id: courtly.14.0
      topic: night
      text: "\uBC24\uC5D0\uB294 \uCC9C\uC774 \uC2A4\uCE58\uB294 \uC18C\uB9AC\uB3C4
        \uC798 \uB4E4\uB824\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.1
      topic: night
      text: "\uC878\uB9B0 \uD45C\uC815\uC744 \uC228\uAE30\uAE30\uAC00 \uC5B4\uB835\uB124\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.2
      topic: night
      text: "\uC5B4\uB450\uC6B8 \uB550 \uC0C9\uBCF4\uB2E4 \uBAA8\uC591\uC774 \uBA3C\uC800
        \uBCF4\uC5EC\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.3
      topic: night
      text: "\uC790\uAE30 \uC804\uC5D0 \uC637\uC740 \uAF2D \uAC78\uC5B4 \uB450\uC5B4\uC57C\uC9C0\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.4
      topic: night
      text: "\uC774 \uC2DC\uAC04\uC5D0 \uB2E8 \uAC78 \uBA39\uC73C\uBA74 \uD6C4\uD68C\uD558\uACA0\uC8E0."
      activities: 9
      periods: 8
    - id: courtly.14.5
      topic: night
      text: "\uB0AE\uC5D0 \uD558\uB824\uB358 \uB9D0\uC774 \uC774\uC81C\uC57C \uB5A0\uC624\uB974\uB124\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.6
      topic: night
      text: "\uBD88 \uB044\uAE30 \uC804 \uADF8\uB9BC\uC790\uAC00 \uAE38\uC5B4\uC9C0\uB294
        \uAC8C \uC7AC\uBC0C\uC5B4\uC694."
      activities: 9
      periods: 8
    - id: courtly.14.7
      topic: night
      text: "\uBA38\uB9AC\uB97C \uD480\uBA74 \uC7A0\uC774 \uC870\uAE08 \uBE68\uB9AC
        \uC640\uC694."
      activities: 9
      periods: 8
    - id: courtly.15.0
      topic: rest
      text: "\uC549\uC73C\uB2C8 \uC637\uC774 \uC811\uD788\uB294 \uB370\uAC00 \uBCF4\uC774\uB124\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.1
      topic: rest
      text: "\uC26C\uBA74\uC11C\uAE4C\uC9C0 \uB9E4\uBB34\uC0C8\uB97C \uACE0\uCE58\uACE0
        \uC788\uB124\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.2
      topic: rest
      text: "\uC870\uAE08 \uAD6C\uACA8\uC838\uB3C4 \uAD1C\uCC2E\uACA0\uC9C0\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.3
      topic: rest
      text: "\uC190\uC744 \uC26C\uAC8C \uD558\uB2C8 \uC18C\uB9E4\uAC00 \uB35C \uC6C0\uC9C1\uC774\uB124\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.4
      topic: rest
      text: "\uB4F1\uC744 \uAE30\uB300\uBA74 \uD3B8\uD560 \uAC83 \uAC19\uC740\uB370\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.5
      topic: rest
      text: "\uC790\uC138\uB97C \uACE0\uB974\uB2E4\uAC00 \uC26C\uB294 \uAC78 \uC78A\uC5C8\uC5B4\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.6
      topic: rest
      text: "\uC624\uB298\uC740 \uADF8\uB0E5 \uD3B8\uD558\uAC8C \uC549\uC544 \uBCFC\uAE4C\uC694."
      activities: 8
      periods: 15
    - id: courtly.15.7
      topic: rest
      text: "\uB208\uC744 \uAC10\uC73C\uBA74 \uC0C9\uB3C4 \uC7A0\uC2DC \uC0AC\uB77C\uC9C0\uB124\uC694."
      activities: 8
      periods: 15
