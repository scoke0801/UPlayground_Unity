float protect=Convert.ToSingle(plan["protectedContentRadius"]),roadThreshold=Convert.ToSingle(plan["roadAlphaThreshold"]),maxSlope=Convert.ToSingle(plan["maximumSlope"]),buildingMargin=Convert.ToSingle(plan["buildingFootprintMargin"]);Physics.SyncTransforms();
Func<float,float,bool> eligible=(x,z)=>{
 if(x<1010||x>1135||z<340||z>395||x>1086&&x<1096)return false;
 foreach(var id in ids)if(new Vector2(x-id.transform.position.x,z-id.transform.position.z).sqrMagnitude<protect*protect)return false;
 foreach(var h in houseBounds)if(x>=h.min[0]-buildingMargin&&x<=h.max[0]+buildingMargin&&z>=h.min[2]-buildingMargin&&z<=h.max[2]+buildingMargin)return false;
 foreach(var box in boxes)if(box.enabled&&box.bounds.Contains(new Vector3(x,box.bounds.center.y,z)))return false;
