  m_EditorClassIdentifier: 
  nodeId: guide_welcome_2
  nodeType: 0
  channel: 0
  speakerId: "Bokusei"
  dialogueText: "맞아. 어디부터 확인하면 되지?"
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId: guide_welcome_3
