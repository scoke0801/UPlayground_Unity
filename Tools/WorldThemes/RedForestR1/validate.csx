// 검토 사본의 저장 식별자, 보호 지면, 경로와 전용 데이터 연결을 검사한다.
var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(s.path!="Assets/01.Scenes/ArtReview/WorldThemes/RedForestR1.unity"||s.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 검토 씬 필요");
var t=Terrain.activeTerrain;var d=t.terrainData;var src=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/LakeVisualV2/Terrain.asset");
var all=s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var originalIds=System.IO.File.ReadAllLines("output/RedForestR1/ids-before.tsv").Select(l=>l.Split('\t')).ToDictionary(a=>a[0],a=>a[1]);
var ids=all.SelectMany(q=>q.GetComponents<UPlayGround.Components.SceneEntityId>()).ToArray();
var idErrors=ids.Where(e=>!originalIds.ContainsKey(GlobalObjectId.GetGlobalObjectIdSlow(e).targetObjectId.ToString())||originalIds[GlobalObjectId.GetGlobalObjectIdSlow(e).targetObjectId.ToString()]!=e.Guid).Select(e=>e.name).ToArray();
var ownerErrors=ids.Where(e=>new SerializedObject(e).FindProperty("_ownerKey").stringValue!=GlobalObjectId.GetGlobalObjectIdSlow(e).ToString()).Select(e=>e.name).ToArray();
var protectedObjects=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&new[]{"SceneEntityId","SceneArrivalPoint","PortalActor","FlowGraphTriggerVolume"}.Contains(c.GetType().Name)).ToArray();
var ground=protectedObjects.Select(c=>new{c.name,delta=t.SampleHeight(c.transform.position)-src.GetInterpolatedHeight(c.transform.position.x/2400,(c.transform.position.z+700)/2800)}).Where(v=>Mathf.Abs(v.delta)>.02f).ToArray();
var points=new[]{new Vector3(1150,0,495),new Vector3(1150,0,525),new Vector3(1152.8f,0,558.4f),new Vector3(1152.8f,0,560.4f),new Vector3(1135,0,580),new Vector3(1120,0,610)};
var paths=new List<string>();for(int i=0;i<points.Length-1;i++)for(int reverse=0;reverse<2;reverse++){var p=points[reverse==0?i:i+1];var q=points[reverse==0?i+1:i];p.y=t.SampleHeight(p);q.y=t.SampleHeight(q);UnityEngine.AI.NavMeshHit a,b;if(!UnityEngine.AI.NavMesh.SamplePosition(p,out a,3,-1)||!UnityEngine.AI.NavMesh.SamplePosition(q,out b,3,-1)){paths.Add(i+"/"+reverse+" NoSample");continue;}var path=new UnityEngine.AI.NavMeshPath();UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,-1,path);paths.Add(i+"/"+reverse+" "+path.status);}
var h=d.GetHeights(0,0,d.heightmapResolution,d.heightmapResolution);var old=src.GetHeights(0,0,src.heightmapResolution,src.heightmapResolution);int heightChanges=0,outside=0,flightGroundChanges=0,eliteGroundChanges=0;float maxDelta=0;
for(int z=0;z<h.GetLength(0);z++)for(int x=0;x<h.GetLength(1);x++){float delta=Mathf.Abs(h[z,x]-old[z,x])*400;if(delta<.001f)continue;heightChanges++;maxDelta=Mathf.Max(maxDelta,delta);float wx=x*2400f/(h.GetLength(1)-1),wz=-700+z*2800f/(h.GetLength(0)-1);if(wx<1074||wx>1226||wz<459||wz>627)outside++;if(Vector2.Distance(new Vector2(wx,wz),new Vector2(1150,525))<30)flightGroundChanges++;if(Vector2.Distance(new Vector2(wx,wz),new Vector2(1230,560))<30)eliteGroundChanges++;}
int surfaceOutside=0,detailOutside=0;var aNow=d.GetAlphamaps(0,0,d.alphamapWidth,d.alphamapHeight);var aOld=src.GetAlphamaps(0,0,src.alphamapWidth,src.alphamapHeight);
for(int z=0;z<d.alphamapHeight;z++)for(int x=0;x<d.alphamapWidth;x++){float wx=x*2400f/(d.alphamapWidth-1),wz=-700+z*2800f/(d.alphamapHeight-1);if(wx>=1074&&wx<=1226&&wz>=459&&wz<=627)continue;for(int l=0;l<d.alphamapLayers;l++)if(Mathf.Abs(aNow[z,x,l]-(l<src.alphamapLayers?aOld[z,x,l]:0))>.005f){surfaceOutside++;break;}}
for(int l=0;l<d.detailPrototypes.Length;l++){var now=d.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,l);var before=l<src.detailPrototypes.Length?src.GetDetailLayer(0,0,src.detailWidth,src.detailHeight,l):new int[d.detailHeight,d.detailWidth];for(int z=0;z<d.detailHeight;z++)for(int x=0;x<d.detailWidth;x++){float wx=x*2400f/(d.detailWidth-1),wz=-700+z*2800f/(d.detailHeight-1);if(wx>=1074&&wx<=1226&&wz>=459&&wz<=627)continue;if(now[z,x]!=before[z,x])detailOutside++;}}
var canopy=GameObject.Find("RedForestR1_Canopy");var flight=canopy.transform.Cast<Transform>().Select(q=>{var b=q.GetComponentsInChildren<Renderer>(true).First().bounds;float dx=Mathf.Max(b.min.x-1150,0,1150-b.max.x),dz=Mathf.Max(b.min.z-525,0,525-b.max.z);return new{q.name,distance=Mathf.Sqrt(dx*dx+dz*dz)};}).ToArray();
var eliteFlight=canopy.transform.Cast<Transform>().Select(q=>{var b=q.GetComponentsInChildren<Renderer>(true).First().bounds;float dx=Mathf.Max(b.min.x-1230,0,1230-b.max.x),dz=Mathf.Max(b.min.z-560,0,560-b.max.z);return new{q.name,distance=Mathf.Sqrt(dx*dx+dz*dz)};}).ToArray();
var result=new{scene=s.path,s.isDirty,compileFailed=EditorUtility.scriptCompilationFailed,missingScripts=all.Sum(q=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(q.gameObject)),ids=ids.Length,idErrors,ownerErrors,protectedCount=protectedObjects.Length,protectedGroundChanges=ground,heightChanges,heightOutsideScope=outside,maxDelta,flightGroundChanges,eliteGroundChanges,surfaceOutside,detailOutside,paths=paths.ToArray(),newCanopyBounds=flight,eliteCanopyBounds=eliteFlight,terrain=AssetDatabase.GetAssetPath(d),nav=AssetDatabase.GetAssetPath(GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>().navMeshData),scope="Editor 정적 데이터/경로 계산. 실제 TPS·비행·지상 추격·성능·저장 복원 대기"};
var json=AppDomain.CurrentDomain.GetAssemblies().Select(v=>v.GetType("Newtonsoft.Json.JsonConvert")).First(v=>v!=null);System.IO.File.WriteAllText("output/RedForestR1/final-validation.json",(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return result;

