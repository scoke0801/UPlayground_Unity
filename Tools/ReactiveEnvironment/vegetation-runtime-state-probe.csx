var saved=new UPlayGround.Data.Save.WorldStateSaveData();export.Invoke(world,new object[]{saved});System.Type json=null;foreach(var assembly in System.AppDomain.CurrentDomain.GetAssemblies()){json=assembly.GetType("Newtonsoft.Json.JsonConvert");if(json!=null)break;}string serialized=(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{saved});var restored=(UPlayGround.Data.Save.WorldStateSaveData)json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(System.Type)}).Invoke(null,new object[]{serialized,typeof(UPlayGround.Data.Save.WorldStateSaveData)});import.Invoke(world,new object[]{restored});bool roundTrip=target.State.HasSameValues(ref wet);string stable=target.StableId;target.gameObject.SetActive(false);target.gameObject.SetActive(true);bool rebound=target.IsAlive()&&target.StableId==stable&&target.State.HasSameValues(ref wet);
int cloneCount=0,maskCount=0,materials=0;foreach(var root in scene.GetRootGameObjects())foreach(var adapter in root.GetComponentsInChildren<UPlayGround.Gameplay.World.ReactiveEnvironment.TerrainDetailReaction>(true)){var terrain=adapter.GetComponent<UnityEngine.Terrain>();if(terrain.terrainData!=adapter.SourceData&&!UnityEditor.EditorUtility.IsPersistent(terrain.terrainData)&&terrain.GetComponent<UnityEngine.TerrainCollider>().terrainData==terrain.terrainData)cloneCount++;foreach(var prototype in terrain.terrainData.detailPrototypes)foreach(var renderer in prototype.prototype.GetComponentsInChildren<UnityEngine.Renderer>(true))foreach(var material in renderer.sharedMaterials){materials++;if(material.GetFloat("_UseEnvironmentCells")==1&&material.GetTexture("_EnvironmentCellMask")==adapter.StateMask)maskCount++;}}
report.AppendLine("target="+stable+" heatAccepted="+acceptedHeat+" fire="+fire.combustion+" char="+fire.charAmount+" fireVector="+fireVector+" waterAccepted="+acceptedWater+" wet="+wet.wetness+" afterWater="+wet.combustion+" wetVector="+wetVector);report.AppendLine("jsonRoundTrip="+roundTrip+" rebindSameIdAndState="+rebound+" jsonBytes="+System.Text.Encoding.UTF8.GetByteCount(serialized)+" terrainRuntimeClone="+cloneCount+" detailMasks="+maskCount+"/"+materials+" twoTicksMs="+tickMs);
if(!acceptedHeat||fire.combustion!=UPlayGround.Core.ReactiveEnvironment.EnvironmentCombustion.Burning||fireVector.w<0.99f||!acceptedWater||wet.wetness<0.9f||wet.combustion==UPlayGround.Core.ReactiveEnvironment.EnvironmentCombustion.Burning||wetVector.x<0.9f||!roundTrip||!rebound||cloneCount!=1||maskCount!=10)throw new System.InvalidOperationException("본편 런타임 검증 실패");return report.ToString();}
catch(System.Exception error){report.AppendLine(error.ToString());throw;}finally{try{if(captured){import.Invoke(world,new object[]{baseline});report.AppendLine("실행 전 환경 상태 복원 완료. 실제 저장 슬롯 기록 없음.");}}finally{System.IO.File.WriteAllText("output/ReactiveEnvironment/VegetationConversion-20261114/runtime-state-probe.txt",report.ToString());}}
