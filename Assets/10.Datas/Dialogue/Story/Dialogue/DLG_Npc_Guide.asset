  m_EditorClassIdentifier: 
  nodeId: guide_secret_3
  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "그럼 됐어. 나도 지난번을 기억해. 길과 사람들의 하루는 되돌아왔지만, 네가 익힌 것까지 사라진 건 아니야."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
