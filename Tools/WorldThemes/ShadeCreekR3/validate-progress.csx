// 검토본 저장 후 식별자·지지면·영역 밖 데이터와 실제 왕복 경로를 검사한다.
var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(s.path!="Assets/01.Scenes/ArtReview/WorldThemes/ShadeCreekR3.unity"||s.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 검토본 필요");
var t=Terrain.activeTerrain;var d=t.terrainData;var src=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/RedForestVisualR1/Terrain.asset");
var all=s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var sourceIds=System.IO.File.ReadAllLines("output/ShadeCreekR3/ids-current-canonical.tsv").Select(l=>l.Split('\t')).ToDictionary(a=>a[0],a=>a[1]);
var ids=all.SelectMany(q=>q.GetComponents<UPlayGround.Components.SceneEntityId>()).ToArray();
var idErrors=ids.Where(e=>!sourceIds.ContainsKey(GlobalObjectId.GetGlobalObjectIdSlow(e).targetObjectId.ToString())||sourceIds[GlobalObjectId.GetGlobalObjectIdSlow(e).targetObjectId.ToString()]!=e.Guid).Select(e=>e.name).ToArray();
var ownerErrors=ids.Where(e=>new SerializedObject(e).FindProperty("_ownerKey").stringValue!=GlobalObjectId.GetGlobalObjectIdSlow(e).ToString()).Select(e=>e.name).ToArray();
var protectedObjects=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&new[]{"SceneEntityId","SceneArrivalPoint","PortalActor","FlowGraphTriggerVolume"}.Contains(c.GetType().Name)).ToArray();
var ground=protectedObjects.Select(c=>new{c.name,delta=t.SampleHeight(c.transform.position)-src.GetInterpolatedHeight(c.transform.position.x/2400,(c.transform.position.z+700)/2800)}).Where(v=>Mathf.Abs(v.delta)>.02f).ToArray();
var points=new[]{new Vector3(1700,0,740),new Vector3(1640,0,750),new Vector3(1605,0,805),new Vector3(1608,0,814),new Vector3(1650,0,855),new Vector3(1750,0,870)};
var paths=new List<object>();for(int i=0;i<points.Length-1;i++)for(int reverse=0;reverse<2;reverse++){var p=points[reverse==0?i:i+1];var q=points[reverse==0?i+1:i];p.y=t.SampleHeight(p);q.y=t.SampleHeight(q);UnityEngine.AI.NavMeshHit a,b;if(!UnityEngine.AI.NavMesh.SamplePosition(p,out a,3,-1)||!UnityEngine.AI.NavMesh.SamplePosition(q,out b,3,-1)){paths.Add(new{segment=i,reverse,status="NoSample"});continue;}var path=new UnityEngine.AI.NavMeshPath();UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,-1,path);paths.Add(new{segment=i,reverse,status=path.status.ToString()});}
Func<float,float,bool> inside=(x,z)=>Mathf.Pow((x-1655)/145,2)+Mathf.Pow((z-810)/115,2)<=1.001f;
var h=d.GetHeights(0,0,d.heightmapResolution,d.heightmapResolution);var old=src.GetHeights(0,0,src.heightmapResolution,src.heightmapResolution);int heightChanges=0,heightOutside=0;float maxDelta=0;
for(int z=0;z<h.GetLength(0);z++)for(int x=0;x<h.GetLength(1);x++){float delta=Mathf.Abs(h[z,x]-old[z,x])*400;if(delta<.001f)continue;heightChanges++;maxDelta=Mathf.Max(maxDelta,delta);if(!inside(x*2400f/(h.GetLength(1)-1),-700+z*2800f/(h.GetLength(0)-1)))heightOutside++;}
int surfaceOutside=0,detailOutside=0;var now=d.GetAlphamaps(0,0,d.alphamapWidth,d.alphamapHeight);var before=src.GetAlphamaps(0,0,src.alphamapWidth,src.alphamapHeight);
for(int z=0;z<d.alphamapHeight;z++)for(int x=0;x<d.alphamapWidth;x++){if(inside(x*2400f/(d.alphamapWidth-1),-700+z*2800f/(d.alphamapHeight-1)))continue;for(int l=0;l<d.alphamapLayers;l++)if(Mathf.Abs(now[z,x,l]-(l<src.alphamapLayers?before[z,x,l]:0))>.005f){surfaceOutside++;break;}}
for(int l=0;l<d.detailPrototypes.Length;l++){var a=d.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,l);var b=l<src.detailPrototypes.Length?src.GetDetailLayer(0,0,src.detailWidth,src.detailHeight,l):new int[d.detailHeight,d.detailWidth];for(int z=0;z<d.detailHeight;z++)for(int x=0;x<d.detailWidth;x++){if(inside(x*2400f/(d.detailWidth-1),-700+z*2800f/(d.detailHeight-1)))continue;if(a[z,x]!=b[z,x])detailOutside++;}}
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(a=>a!=null);Func<object,string> serialize=o=>(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
var contracts=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null).Select(c=>new{id=GlobalObjectId.GetGlobalObjectIdSlow(c).targetObjectId.ToString(),type=c.GetType().FullName,json=EditorJsonUtility.ToJson(c),position=new[]{c.transform.position.x,c.transform.position.y,c.transform.position.z}}).ToArray();System.IO.File.WriteAllText("output/ShadeCreekR3/contracts-after.json",serialize(contracts));
var result=new{scene=s.path,s.isDirty,compileFailed=EditorUtility.scriptCompilationFailed,missingScripts=all.Sum(q=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(q.gameObject)),ids=ids.Length,idErrors,ownerErrors,protectedCount=protectedObjects.Length,protectedGroundChanges=ground,heightChanges,heightOutside,maxDelta,surfaceOutside,detailOutside,scatter=d.detailScatterMode.ToString(),paths,terrain=AssetDatabase.GetAssetPath(d),nav=AssetDatabase.GetAssetPath(GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>().navMeshData),scope="Editor 정적 데이터·NavMesh 계산. 실제 TPS·바람·LOD·저장/로드·성능 미수행"};
System.IO.File.WriteAllText("output/ShadeCreekR3/validation.json",serialize(result));return result;

