      activities: 9
      periods: 15
    - id: seasoned.02.3
      topic: expenses
      text: "\uC794\uB3C8\uC744 \uB9E1\uACA8 \uB450\uBA74 \uB610 \uAC00\uAC8C \uB3FC."
      activities: 9
      periods: 15
    - id: seasoned.02.4
      topic: expenses
      text: "\uB0A8\uB294 \uAC78 \uB098\uB220 \uC8FC\uB824\uACE0 \uB354 \uC0C0\uC9C0
        \uBB50\uC57C."
      activities: 9
      periods: 15
    - id: seasoned.02.5
      topic: expenses
      text: "\uD544\uC694\uD55C \uC0AC\uB78C \uC0DD\uAC01\uC774 \uBA3C\uC800 \uB098\uB124."
      activities: 9
      periods: 15
    - id: seasoned.02.6
      topic: expenses
      text: "\uC774\uAC70 \uAC12\uC774 \uC544\uB2C8\uB77C \uCD94\uC5B5 \uAC12\uC744
        \uB0B4\uB294 \uAC74\uAC00."
      activities: 9
      periods: 15
    - id: seasoned.02.7
      topic: expenses
      text: "\uAD6C\uACBD\uD55C \uAC12\uC740 \uC548 \uBC1B\uC73C\uB2C8 \uB2E4\uD589\uC774\uC57C."
      activities: 9
      periods: 15
    - id: seasoned.03.0
      topic: people
      text: "\uC544\uB294 \uC5BC\uAD74\uC778\uAC00 \uC2F6\uC73C\uBA74 \uC6EC\uB9CC\uD574\uC120
