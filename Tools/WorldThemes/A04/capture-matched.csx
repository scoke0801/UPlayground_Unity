Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(baseline["sourceScene"].ToString());if((host.isLoaded&&(host.isLoaded&&host.isDirty))||EditorApplication.isCompiling||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("clean Host Edit Mode 필요");
