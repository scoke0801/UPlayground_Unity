  m_EditorClassIdentifier:
  nodeId: guide_wait_return_anchor
  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "미아가 울타리 쪽을 보고 있어. 먼저 다녀와. 그 뒤에 이야기하자."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
