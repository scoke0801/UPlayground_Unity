  m_Name: Node_Welcome_1
  m_EditorClassIdentifier:
  nodeId: guide_welcome_1
  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "어서 와! 여기는 시작의 마을이야! 순환 시련장을 조사하러 온 탐험가가 맞지?"
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId: guide_welcome_2
  trueNextNodeId:
  falseNextNodeId:
  choices: []
