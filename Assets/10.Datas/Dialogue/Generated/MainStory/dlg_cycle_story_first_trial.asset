  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "시련장 외곽에 수호자 셋이 흩어져 있어. 나침반에 잡히는 세 신호를 원하는 순서로 따라가."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
