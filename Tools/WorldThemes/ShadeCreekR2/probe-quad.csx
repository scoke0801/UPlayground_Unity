var source=GameObject.Find("Explore_0155_R2").GetComponentsInChildren<MeshFilter>(true).Last().sharedMesh;var mesh=new Mesh();mesh.vertices=source.vertices;mesh.uv=source.uv;mesh.triangles=source.triangles;mesh.RecalculateNormals();mesh.RecalculateTangents();mesh.RecalculateBounds();
var go=new GameObject("ProbeQuad");go.hideFlags=HideFlags.HideAndDontSave;go.layer=31;go.transform.position=new Vector3(0,1000,0);go.AddComponent<MeshFilter>().sharedMesh=mesh;var renderer=go.AddComponent<MeshRenderer>();var mat=new Material(Shader.Find("Universal Render Pipeline/Unlit"));mat.SetColor("_BaseColor",Color.magenta);mat.SetFloat("_Cull",0);renderer.sharedMaterial=mat;
var cg=new GameObject("ProbeCamera");cg.hideFlags=HideFlags.HideAndDontSave;var c=cg.AddComponent<Camera>();c.enabled=false;c.cullingMask=1<<31;c.useOcclusionCulling=false;c.clearFlags=CameraClearFlags.SolidColor;c.backgroundColor=Color.gray;c.fieldOfView=60;c.transform.position=new Vector3(0,1000,-40);
var rt=new RenderTexture(720,720,24);var tex=new Texture2D(720,720,TextureFormat.RGB24,false);rt.hideFlags=HideFlags.HideAndDontSave;tex.hideFlags=HideFlags.HideAndDontSave;var old=RenderTexture.active;
try{c.targetTexture=rt;for(int i=0;i<2;i++){if(i==1)renderer.sharedMaterial=AssetDatabase.LoadAssetAtPath<Material>("Assets/10.Datas/World/ThemeStudies/ShadeCreekR2/Canopy_2.mat");c.Render();RenderTexture.active=rt;tex.ReadPixels(new Rect(0,0,720,720),0,0);tex.Apply();System.IO.File.WriteAllBytes("output/ShadeCreekR2/quad-"+i+".png",tex.EncodeToPNG());}return "new mesh plain/atlas";}finally{c.targetTexture=null;RenderTexture.active=old;foreach(var obj in new UnityEngine.Object[]{go,cg,mesh,mat,rt,tex})UnityEngine.Object.DestroyImmediate(obj);}
