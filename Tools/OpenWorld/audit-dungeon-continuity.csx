var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();
if(EditorApplication.isPlayingOrWillChangePlaymode||scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity")throw new Exception("LakeVillageWorld Edit Mode가 필요합니다.");
string folder="output/OpenWorld/DungeonContinuity";
if(!System.IO.File.Exists(folder+"/applied.json"))throw new Exception("아직 적용되지 않았습니다.");
var roots=scene.GetRootGameObjects();
var all=roots.SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var groups=all.Where(t=>t.name=="연속 석벽과 보상").ToArray();if(groups.Length!=6)throw new Exception("보수 구역 수 불일치");
int missing=groups.SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject));
if(missing!=0)throw new Exception("Missing Script: "+missing);
var ids=roots.SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).ToArray();
var before=System.IO.File.ReadAllLines(folder+"/identities-before.txt");
var current=new HashSet<string>(ids.Select(c=>c.Guid+"|"+c.transform.position.ToString("F4")));
if(before.Any(line=>!current.Contains(line)))throw new Exception("기존 진행 개체 변경");
if(ids.GroupBy(c=>c.Guid).Any(g=>g.Count()>1))throw new Exception("중복 SceneEntityId");
var rewards=groups.SelectMany(g=>g.GetComponentsInChildren<UPlayGround.DropItemActor>(true)).ToArray();
if(rewards.Length!=6||rewards.Any(a=>a.ItemData==null||a.InteractionData==null||!a.CanInteract()||a.GetComponent<UPlayGround.Components.SceneEntityId>()==null||a.GetComponent<Collider>()==null||a.gameObject.layer!=LayerMask.NameToLayer("InteractableObject")))throw new Exception("상자 상호작용·보상·저장 참조 누락");
foreach(var r in groups.SelectMany(g=>g.GetComponentsInChildren<MeshRenderer>(true)))if(r.sharedMaterials.Any(m=>m==null||m.shader==null||m.shader.name.Contains("InternalError")))throw new Exception("재질·셰이더 누락: "+r.name);
var report=new List<string>{"Unity="+Application.unityVersion,"컴파일 실패="+EditorUtility.scriptCompilationFailed,"보수 구역="+groups.Length,"기존 진행 ID·좌표 보존="+before.Length,"신규 보물상자="+rewards.Length,"Missing Script="+missing,"실제 입력·열기·저장/로드·시각 품질=사용자 테스트 대기"};
foreach(var a in rewards)report.Add(a.transform.parent.parent.name+" | "+a.transform.position.ToString("F2")+" | "+a.ItemData.itemName+" x"+a.Count+" | mapId="+UPlayGround.Manager.World.RegionOwnership.Resolve(a));
System.IO.File.WriteAllLines(folder+"/audit.txt",report);return string.Join("\n",report);
