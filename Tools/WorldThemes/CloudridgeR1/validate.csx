if(Application.dataPath.Replace('\\','/')!="C:/UsingProject/UnityProject/UPlayground/Assets")throw new Exception("프로젝트 불일치");
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});
var lease=(Dictionary<string,string>)jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock"),typeof(Dictionary<string,string>)});if(lease["owner"]!="B")throw new Exception("B 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/CloudridgeR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 B 검토 씬 필요");
var terrain=Terrain.activeTerrain;var d=terrain.terrainData;var baseline=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/ThemeStudies/CloudridgeR1/BaselineTerrain.asset");
var routes=new[]{new[]{new Vector2(1040,1410),new Vector2(1080,1370),new Vector2(1145,1300),new Vector2(1225,1265),new Vector2(1310,1310),new Vector2(1400,1365),new Vector2(1360,1420)},new[]{new Vector2(800,1230),new Vector2(1040,1410),new Vector2(1190,1450),new Vector2(1360,1420),new Vector2(1490,1330),new Vector2(1580,1220),new Vector2(1630,1100)}};
var rows=new List<object>();float max=0;int failures=0;
foreach(var route in routes)for(int i=0;i<route.Length-1;i++){var delta=route[i+1]-route[i];var side=new Vector2(-delta.y,delta.x).normalized;int steps=Mathf.CeilToInt(delta.magnitude/2);for(int j=0;j<=steps;j++)for(int offset=-4;offset<=4;offset+=2){var p=Vector2.Lerp(route[i],route[i+1],j/(float)steps)+side*offset;float old=baseline.GetInterpolatedHeight(p.x/d.size.x,(p.y+700)/d.size.z),now=d.GetInterpolatedHeight(p.x/d.size.x,(p.y+700)/d.size.z);float change=Mathf.Abs(now-old);max=Mathf.Max(max,change);if(change>.02f)failures++;rows.Add(new{x=p.x,z=p.y,before=old,after=now,delta=change});}}
System.IO.File.WriteAllText("output/CloudridgeR1/walking-support.json",json(new{coordinateSpace="world metres",origin=new[]{0,0,-700},routeHalfWidth=4,stepMetres=2,samples=rows.Count,maxHeightDelta=max,failures,rows,scope="기존 본길과 발견 순환로 Terrain 지지면. 실제 TPS/전체 Collider 접지 합격 아님"}));
var protectedJson=System.IO.File.ReadAllText("output/CloudridgeR1/protected-points.json");var pointsMatch=System.Text.RegularExpressions.Regex.Match(protectedJson,"\"points\"\\s*:\\s*(\\[.*?\\])\\s*,\\s*\"scope\"");var protectedPoints=(float[][])jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{pointsMatch.Groups[1].Value,typeof(float[][])});var supportRows=protectedPoints.Select(p=>{float old=baseline.GetInterpolatedHeight(p[0]/d.size.x,(p[2]+700)/d.size.z),now=d.GetInterpolatedHeight(p[0]/d.size.x,(p[2]+700)/d.size.z);return new{position=p,before=old,after=now,delta=Mathf.Abs(now-old)};}).ToArray();System.IO.File.WriteAllText("output/CloudridgeR1/content-support-final.json",json(new{samples=supportRows.Length,failures=supportRows.Count(p=>p.delta>.02f),rows=supportRows}));
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var ids=all.SelectMany(t=>t.GetComponents<UPlayGround.Components.SceneEntityId>()).Select(c=>new{guid=c.Guid,owner=new SerializedObject(c).FindProperty("_ownerKey").stringValue,currentOwner=GlobalObjectId.GetGlobalObjectIdSlow(c).ToString()}).ToArray();
var dependencies=AssetDatabase.GetDependencies(scene.path,true);var own=dependencies.Where(p=>p.StartsWith("Assets/10.Datas/World/ThemeStudies/CloudridgeR1/")).ToArray();
var refs=own.SelectMany(p=>AssetDatabase.LoadAllAssetsAtPath(p).Where(a=>a!=null).SelectMany(a=>{var list=new List<object>();if(a is TerrainData||a is Mesh||a is Texture||a is UnityEngine.AI.NavMeshData){foreach(var target in AssetDatabase.GetDependencies(p,false))if(target!=p)list.Add(new{asset=p,property="native dependency (terrain prototypes separately enumerated)",target,guid=AssetDatabase.AssetPathToGUID(target),ownership=target.StartsWith("Assets/10.Datas/World/ThemeStudies/CloudridgeR1/")?"B":"read-only shared"});return list;}var so=new SerializedObject(a);var iterator=so.GetIterator();while(iterator.Next(true)){if(iterator.propertyType!=SerializedPropertyType.ObjectReference||iterator.objectReferenceValue==null)continue;string target=AssetDatabase.GetAssetPath(iterator.objectReferenceValue);list.Add(new{asset=p,property=iterator.propertyPath,target,guid=AssetDatabase.AssetPathToGUID(target),ownership=target.StartsWith("Assets/10.Datas/World/ThemeStudies/CloudridgeR1/")?"B":"read-only shared"});}return list;})).ToArray();
System.IO.File.WriteAllText("output/CloudridgeR1/references-final.json",json(new{scene=scene.path,ownAssets=own,dependencies,serializedReferences=refs,terrain=new{path=AssetDatabase.GetAssetPath(d),layers=d.terrainLayers.Select(l=>new{path=AssetDatabase.GetAssetPath(l),guid=AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(l))}).ToArray(),detailPrototypes=d.detailPrototypes.Select(p=>new{prefab=AssetDatabase.GetAssetPath(p.prototype),texture=AssetDatabase.GetAssetPath(p.prototypeTexture),p.minHeight,p.maxHeight}).ToArray(),treePrototypes=d.treePrototypes.Select(p=>AssetDatabase.GetAssetPath(p.prefab)).ToArray(),treeInstances=d.treeInstanceCount}}));
int missingScripts=all.Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject));
var editor=new{project=Application.dataPath,scene=scene.path,scene.isDirty,playing=EditorApplication.isPlaying,compiling=EditorApplication.isCompiling,compileFailed=EditorUtility.scriptCompilationFailed,temporaryCaptureObjects=Resources.FindObjectsOfTypeAll<GameObject>().Count(g=>g.name.StartsWith("CloudridgeTemporary")),pipeline=QualitySettings.renderPipeline==null?"null":QualitySettings.renderPipeline.name};
System.IO.File.WriteAllText("output/CloudridgeR1/editor-final-state.json",json(editor));
System.IO.File.WriteAllText("output/CloudridgeR1/static-validation.json",json(new{walkingSamples=rows.Count,maxHeightDelta=max,walkingFailures=failures,missingScripts,ids,ownerMismatches=ids.Count(i=>i.owner!=i.currentOwner),sourceReferencePolicy="B 전용 경로 밖의 모든 공유 데이터는 읽기 전용",editor}));
return new{walkingSamples=rows.Count,maxHeightDelta=max,walkingFailures=failures,missingScripts,ids=ids.Length,ownerMismatches=ids.Count(i=>i.owner!=i.currentOwner),ownAssets=own.Length};



