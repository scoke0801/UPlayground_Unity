/* 궁극기 시퀀스 에디터 전용 스타일. UPlayGroundEditor.uss의 --up-* 토큰을 함께 사용한다. */

.up-ult-root {
    flex-grow: 1;
}

/* ── 상단 툴바 ───────────────────────────────────────── */
.up-ult-toolbar {
    flex-shrink: 0;
    align-items: center;
    height: 26px;
}

.up-ult-toolbar-asset {
    width: 320px;
    min-width: 200px;
    max-width: 360px;
    flex-grow: 0;
    flex-shrink: 1;
    margin-right: 6px;
}

.up-ult-spacer {
    flex-grow: 1;
}

.up-ult-pill {
    -unity-font-style: bold;
    font-size: 11px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 9px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.up-ult-pill--ok {
    background-color: rgba(73, 171, 143, 0.18);
    color: rgb(126, 214, 184);
}

.up-ult-pill--warn {
    background-color: rgba(214, 165, 62, 0.20);
    color: rgb(232, 192, 112);
}

.up-ult-pill--error {
    background-color: rgba(224, 90, 90, 0.20);
    color: rgb(240, 142, 142);
}

/* ── 본문 스플릿 ─────────────────────────────────────── */
.up-ult-split {
    flex-grow: 1;
    min-height: 240px;
    border-top-width: 1px;
    border-top-color: var(--up-border-strong);
}

.up-ult-timeline-pane {
    min-width: 460px;
    background-color: var(--up-bg-0);
}

.up-ult-inspector-pane {
    min-width: 340px;
    background-color: var(--up-bg-1);
    border-left-width: 1px;
    border-left-color: var(--up-border-strong);
}

/* ── 타임라인 툴바 ───────────────────────────────────── */
.up-ult-timeline-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
    padding-left: 8px;
    padding-right: 8px;
}

.up-ult-timeline-title-block {
    width: 116px;
    min-width: 116px;
    height: 38px;
    padding-top: 3px;
    padding-left: 4px;
    flex-shrink: 0;
    overflow: hidden;
}

.up-ult-timeline-kicker {
    height: 13px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
}

.up-ult-timeline-title {
    height: 19px;
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-ult-toolbar-divider {
    width: 1px;
    min-width: 1px;
    height: 24px;
    margin-left: 8px;
    margin-right: 8px;
    flex-shrink: 0;
    background-color: var(--up-border);
}

.up-ult-control-label {
    font-size: 11px;
    color: var(--up-text-dim);
    margin-right: 4px;
}

.up-ult-zoom {
    width: 150px;
    min-width: 84px;
    flex-shrink: 1;
    margin-right: 8px;
}

.up-ult-snap {
    min-width: 54px;
    flex-shrink: 0;
}

.up-ult-fps {
    width: 76px;
    min-width: 68px;
    flex-shrink: 0;
}

.up-ult-time-label {
    -unity-font-style: bold;
    color: var(--up-text);
    min-width: 96px;
    -unity-text-align: middle-right;
}

.up-ult-tool-btn {
    height: 24px;
    margin-left: 3px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.up-ult-scroll {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.up-ult-timeline-viewport {
    position: relative;
    flex-grow: 1;
    min-height: 120px;
}

/* ── 캔버스(타임라인 본체) ───────────────────────────── */
.up-ult-canvas {
    position: relative;
}

.up-ult-grid {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.up-ult-ruler {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 24px;
}

.up-ult-tick {
    position: absolute;
    font-size: 10px;
    color: var(--up-text-faint);
    top: 6px;
}

.up-ult-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgb(255, 82, 86);
}

.up-ult-cursor-cap {
    position: absolute;
    top: 0;
    width: 40px;
    height: 14px;
    margin-left: -19px;
    background-color: rgb(255, 82, 86);
    border-radius: 3px;
    color: rgb(20, 12, 12);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.up-ult-marquee {
    position: absolute;
    background-color: rgba(96, 156, 240, 0.14);
    border-width: 1px;
    border-color: rgba(126, 184, 255, 0.75);
}

.up-ult-timeline-empty {
    position: absolute;
    width: 440px;
    min-height: 148px;
    left: 16px;
    top: 48px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 18px;
    align-items: center;
    background-color: rgba(19, 29, 38, 0.96);
    border-width: 1px;
    border-color: rgba(82, 148, 205, 0.42);
    border-radius: 7px;
}

.up-ult-timeline-empty__kicker {
    height: 15px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
    -unity-text-align: middle-center;
}

.up-ult-timeline-empty__title {
    height: 25px;
    margin-top: 2px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--up-text);
    -unity-text-align: middle-center;
}

.up-ult-timeline-empty__description {
    margin-top: 4px;
    color: var(--up-text-dim);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.up-ult-timeline-empty__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.up-ult-timeline-empty__add {
    height: 26px;
    min-width: 118px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-style: bold;
    background-color: rgba(46, 154, 255, 0.20);
    border-color: rgba(86, 174, 245, 0.68);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(190, 224, 250);
}

/* ── 이벤트 블록 ─────────────────────────────────────── */
.up-ult-event {
    position: absolute;
    height: 26px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    overflow: hidden;
    flex-direction: row;
    align-items: center;
}

.up-ult-event:hover {
    border-color: rgba(255, 255, 255, 0.72);
}

.up-ult-event--selected {
    border-width: 2px;
    border-color: rgb(126, 192, 255);
}

.up-ult-event__label {
    flex-grow: 1;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 8px;
    padding-right: 7px;
    color: rgb(238, 244, 249);
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-ult-event__handle {
    width: 5px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0);
}

.up-ult-event:hover .up-ult-event__handle,
.up-ult-event--selected .up-ult-event__handle {
    background-color: rgba(255, 255, 255, 0.22);
}

.up-ult-event--instant {
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.72);
}

.up-ult-event--instant .up-ult-event__label {
    padding-left: 8px;
    padding-right: 7px;
}

.up-ult-event--instant .up-ult-event__handle--left {
    display: none;
}

.up-ult-event--instant .up-ult-event__handle--right {
    width: 7px;
    background-color: rgba(255, 255, 255, 0);
}

.up-ult-event--instant:hover .up-ult-event__handle--right,
.up-ult-event--instant.up-ult-event--selected .up-ult-event__handle--right {
    background-color: rgba(255, 255, 255, 0.28);
}

/* 타입별 색상 */
.up-ult-event--vfx { background-color: rgb(48, 103, 151); }
.up-ult-event--sound { background-color: rgb(62, 116, 72); }
.up-ult-event--time { background-color: rgb(143, 103, 30); }
.up-ult-event--camfx { background-color: rgb(92, 68, 137); }
.up-ult-event--shake { background-color: rgb(139, 73, 49); }
.up-ult-event--damage { background-color: rgb(151, 55, 58); }
.up-ult-event--callback { background-color: rgb(82, 94, 105); }

/* ── 인스펙터 ────────────────────────────────────────── */
.up-ult-inspector-header {
    min-height: 50px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 7px;
    padding-bottom: 7px;
    flex-shrink: 0;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-ult-inspector-kicker {
    height: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--up-accent);
}

.up-ult-inspector-title {
    height: 20px;
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--up-text);
}

.up-ult-inspector-scroll {
    flex-grow: 1;
}

.up-ult-section {
    margin: 6px;
    padding: 6px;
    background-color: var(--up-bg-2);
    border-radius: var(--up-radius);
    border-width: 1px;
    border-color: var(--up-border);
}

.up-ult-section .unity-base-field__label {
    min-width: 124px;
    width: 42%;
}

.up-ult-section .unity-base-field__input {
    min-width: 120px;
}

.up-ult-event-section {
    border-left-width: 3px;
    border-left-color: var(--up-accent);
}

.up-ult-validation-section {
    background-color: var(--up-bg-1);
}

.up-ult-settings {
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.up-ult-settings-foldout {
    margin-top: 4px;
    background-color: var(--up-bg-2);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-ult-settings-foldout > .unity-foldout__toggle {
    min-height: 30px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-font-style: bold;
    color: var(--up-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-ult-settings-foldout > .unity-foldout__content {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 6px;
}

.up-ult-setting-field .unity-base-field__label {
    min-width: 116px;
    width: 40%;
}

.up-ult-section-title {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--up-text);
    margin-bottom: 4px;
}

.up-ult-validation-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 2px;
    margin-bottom: 2px;
}

.up-ult-validation-badge {
    width: 6px;
    min-width: 6px;
    height: 14px;
    border-radius: 2px;
    margin-right: 6px;
    margin-top: 1px;
}

.up-ult-validation-text {
    flex-grow: 1;
    font-size: 11px;
    white-space: normal;
    color: var(--up-text-dim);
}

.up-ult-badge--ok { background-color: rgb(73, 171, 143); }
.up-ult-badge--warn { background-color: rgb(214, 165, 62); }
.up-ult-badge--error { background-color: rgb(224, 90, 90); }

.up-ult-event-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.up-ult-event-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 6px;
}

.up-ult-btn-row {
    flex-direction: row;
    margin-top: 6px;
}

.up-ult-btn-row Button {
    flex-grow: 1;
    height: 22px;
    margin-left: 2px;
    margin-right: 2px;
}

.up-ult-empty-hint {
    font-size: 11px;
    color: var(--up-text-faint);
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 12px;
}

.up-ult-quicklinks {
    flex-direction: row;
}

.up-ult-quicklinks Button {
    margin-left: 2px;
    font-size: 11px;
}
