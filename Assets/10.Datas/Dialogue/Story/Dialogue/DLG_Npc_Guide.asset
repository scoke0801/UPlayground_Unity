  m_Script: {fileID: 11500000, guid: 33dbbdb6f707d9846a5e61bf67613e4e, type: 3}
  m_Name: Node_Welcome_2
  m_EditorClassIdentifier: 
  nodeId: guide_welcome_2
  nodeType: 0
  channel: 0
  speakerId: Protagonist
  dialogueText: "세 사람과 만나 대결에서 이기면 되는 거지."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId: guide_welcome_3
  trueNextNodeId: 
  falseNextNodeId: 
  choices: []
  condition: {fileID: 0}
  eventActions: []
