var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlaying||scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity")throw new Exception("전용 Edit Mode 씬 필요");
string data="Assets/10.Datas/World/RiverBasinWorld";
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var read=json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});var plan=(Dictionary<string,object>)read.Invoke(null,new object[]{System.IO.File.ReadAllText("Tools/RiverBasinWorld/production-plan.json"),typeof(Dictionary<string,object>)});var rr=(float[][])read.Invoke(null,new object[]{plan["river"].ToString(),typeof(float[][])});var river=rr.Select(r=>new Vector3(r[0],r[1],r[2])).ToArray();
Func<int,Vector3> across=i=>{var a=river[Mathf.Max(0,i-1)];var b=river[Mathf.Min(river.Length-1,i+1)];var direction=b-a;direction.y=0;return Vector3.Cross(direction.normalized,Vector3.up)*(i>=river.Length-2?15:7);};
var vertices=new List<Vector3>();var triangles=new List<int>();
for(int i=1;i<river.Length;i++){var a=river[i-1];var b=river[i];int count=Mathf.CeilToInt(Vector3.Distance(a,b)/24);for(int j=0;j<count;j++){float t0=(float)j/count,t1=(float)(j+1)/count;var c=Vector3.Lerp(a,b,t0);var d=Vector3.Lerp(a,b,t1);var left=Vector3.Lerp(across(i-1),across(i),t0);var right=Vector3.Lerp(across(i-1),across(i),t1);float next=d.y;d.y=c.y;int k=vertices.Count;vertices.AddRange(new[]{c-left,d-right,d+right,c+left});triangles.AddRange(new[]{k,k+2,k+1,k,k+3,k+2});k=vertices.Count;vertices.AddRange(new[]{d-right,d+right,new Vector3(d.x+right.x,next,d.z+right.z),new Vector3(d.x-right.x,next,d.z-right.z)});triangles.AddRange(new[]{k,k+2,k+1,k,k+3,k+2});}}
var mesh=AssetDatabase.LoadAssetAtPath<Mesh>(data+"/RiverPools.asset");mesh.Clear();mesh.SetVertices(vertices);mesh.SetTriangles(triangles,0);mesh.uv=vertices.Select(v=>new Vector2(v.x/6,v.z/6)).ToArray();mesh.RecalculateNormals();mesh.RecalculateBounds();EditorUtility.SetDirty(mesh);AssetDatabase.SaveAssetIfDirty(mesh);
var material=AssetDatabase.LoadAssetAtPath<Material>(data+"/RiverWater.mat");if(material==null){material=new Material(AssetDatabase.LoadAssetAtPath<Material>("Assets/10.Datas/World/OpenWorld/ShadeCreekVisualR3/CreekWater.mat"));AssetDatabase.CreateAsset(material,data+"/RiverWater.mat");}
material.SetColor("_ShallowColor",new Color(.20f,.42f,.39f,1));material.SetColor("_DeepColor",new Color(.06f,.24f,.28f,1));material.SetFloat("_WaveStrength",.12f);material.SetFloat("_FoamStrength",.14f);material.SetFloat("_ShoreFade",0);material.SetFloat("_Recession",0);material.SetFloat("_DepthDistance",3);material.SetFloat("_SurfaceOpacity",.65f);EditorUtility.SetDirty(material);AssetDatabase.SaveAssetIfDirty(material);
foreach(var r in GameObject.Find("수계 · 평탄 소와 낙차").GetComponentsInChildren<Renderer>())r.sharedMaterial=material;
UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return "평탄 소·낙차의 굽이 단면 공유. 수면 전용 재질 적용";
