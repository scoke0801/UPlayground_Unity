if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("\"C\""))throw new Exception("C 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();
if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/HarborReedR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 C 검토 씬 필요");
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var terrain=all.Select(g=>g.GetComponent<Terrain>()).First(g=>g!=null);var data=terrain.terrainData;
var source=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/ShadeCreekVisualR3/Terrain.asset");
int heightChanged=0,heightOutside=0,alphaChanged=0,alphaOutside=0;float maxHeight=0;
for(int z=0;z<data.heightmapResolution;z+=64){int rows=Math.Min(64,data.heightmapResolution-z);var before=source.GetHeights(0,z,data.heightmapResolution,rows);var after=data.GetHeights(0,z,data.heightmapResolution,rows);
 for(int iz=0;iz<rows;iz++)for(int x=0;x<data.heightmapResolution;x++){float diff=Mathf.Abs(before[iz,x]-after[iz,x]);if(diff<.000001f)continue;heightChanged++;maxHeight=Mathf.Max(maxHeight,diff*data.size.y);float wx=x*data.size.x/(data.heightmapResolution-1),wz=(z+iz)*data.size.z/(data.heightmapResolution-1)-700;if(wx<1818||wx>1866||wz< -360||wz> -319)heightOutside++;}}
for(int z=0;z<data.alphamapHeight;z+=32){int rows=Math.Min(32,data.alphamapHeight-z);var before=source.GetAlphamaps(0,z,data.alphamapWidth,rows);var after=data.GetAlphamaps(0,z,data.alphamapWidth,rows);
 for(int iz=0;iz<rows;iz++)for(int x=0;x<data.alphamapWidth;x++){bool changed=false;for(int k=0;k<after.GetLength(2);k++){float old=k<before.GetLength(2)?before[iz,x,k]:0;if(Mathf.Abs(old-after[iz,x,k])>.008f){changed=true;break;}}if(!changed)continue;alphaChanged++;float wx=(x+.5f)*data.size.x/data.alphamapWidth,wz=(z+iz+.5f)*data.size.z/data.alphamapHeight-700;if(wx<1818||wx>2008||wz< -410||wz> -317)alphaOutside++;}}
var expected=new Dictionary<long,string>();foreach(var line in System.IO.File.ReadAllLines("output/HarborReedR1/content-ids.tsv")){var parts=line.Split('\t');expected.Add(long.Parse(parts[0]),parts[1]);}
var ids=all.SelectMany(t=>t.GetComponents<UPlayGround.Components.SceneEntityId>()).ToArray();
var idFailures=ids.Where(c=>!expected.ContainsKey((long)GlobalObjectId.GetGlobalObjectIdSlow(c).targetObjectId)||expected[(long)GlobalObjectId.GetGlobalObjectIdSlow(c).targetObjectId]!=c.Guid).Select(c=>c.name).ToArray();
var harbor=GameObject.Find("AuthoredEnvironment").transform.Find("월드 구간/항구");
var referenceRows=new List<object>();foreach(var asset in AssetDatabase.LoadAllAssetsAtPath(AssetDatabase.GetAssetPath(data))){if(asset==null)continue;var so=new SerializedObject(asset);var p=so.GetIterator();while(p.Next(true))if(p.propertyType==SerializedPropertyType.ObjectReference&&p.objectReferenceValue!=null){var o=p.objectReferenceValue;string ap=AssetDatabase.GetAssetPath(o);referenceRows.Add(new{owner=asset.name,property=p.propertyPath,path=ap,guid=AssetDatabase.AssetPathToGUID(ap),mode=ap.StartsWith("Assets/10.Datas/World/ThemeStudies/HarborReedR1/")?"C-owned":"shared-readonly"});}}
var dependencies=AssetDatabase.GetDependencies("Assets/10.Datas/World/ThemeStudies/HarborReedR1/Terrain.asset",true);
var result=new{heightChanged,heightOutside,maxHeight,alphaChanged,alphaOutside,ids=ids.Length,idFailures,harborMissingScripts=harbor.GetComponentsInChildren<Transform>(true).Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject)),harborMissingMaterials=harbor.GetComponentsInChildren<Renderer>(true).Count(r=>r.sharedMaterials.Any(m=>m==null)),scatter=data.detailScatterMode.ToString(),trees=data.treeInstanceCount,detailPrototypes=data.detailPrototypes.Length,dependencies,referenceRows,limitations="전체 데이터 비교는 높이1e-6, alpha0.008 허용. 실제 입력/CPU/GPU/LOD 활성 단계 미수행."};
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(a=>a!=null);Func<object,string> serialize=o=>(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
System.IO.File.WriteAllText("output/HarborReedR1/references-final.json",serialize(result));
System.IO.File.WriteAllText("output/HarborReedR1/editor-final-state.json",serialize(new{project=Application.dataPath,scene=scene.path,scene.isDirty,play=EditorApplication.isPlaying,compiling=EditorApplication.isCompiling,compilationFailed=EditorUtility.scriptCompilationFailed,temporaryCaptureObjects=Resources.FindObjectsOfTypeAll<GameObject>().Count(g=>g.name=="TemporaryArtCapture")}));
return new{heightChanged,heightOutside,maxHeight,alphaChanged,alphaOutside,ids=ids.Length,idFailures,referenceCount=referenceRows.Count};
