--- !u!114 &11400105
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33dbbdb6f707d9846a5e61bf67613e4e, type: 3}
  m_Name: Node_PreAnchor_1
  m_EditorClassIdentifier:
  nodeId: guide_pre_anchor_1
  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "미아가 울타리 쪽을 자꾸 돌아보고 있네. 먼저 무슨 일인지 들어 봐 줘."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
