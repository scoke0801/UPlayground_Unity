var previousActive=UnityEngine.SceneManagement.SceneManager.GetActiveScene();var previousPipeline=QualitySettings.renderPipeline;var previousPipelineGlobal=UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline;bool hostLoadedBefore=host.isLoaded;bool hostDirty=(host.isLoaded&&host.isDirty);var loaded=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(plan["scene"].ToString());bool opened=false;var preview=new UnityEngine.SceneManagement.Scene();bool hasPreview=false;var rows=new List<object>();string output=plan["output"].ToString()+"/"+stage;System.IO.Directory.CreateDirectory(output);
