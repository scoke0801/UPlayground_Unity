if(!EditorApplication.isPlaying)throw new Exception("Play Mode 필요");
var player=UPlayGround.Manager.PartyManager.Instance.ActiveCharacter;var continuous=UPlayGround.Manager.World.ContinuousWorldController.Active;var world=UPlayGround.Manager.WorldStateManager.Instance;var inventory=UPlayGround.Manager.InventoryManager.Instance;
if(player==null||continuous==null||!continuous.IsInitialized||continuous.IsTravelling||!UPlayGround.Manager.CameraManager.Instance.IsSceneCameraReady)throw new Exception("월드·카메라·플레이어 준비 필요");
var ids=new[]{"c42bb9f480ec4f3cacdf786ab0a59e31","c42bb9f480ec4f3cacdf786ab0a59e32","c42bb9f480ec4f3cacdf786ab0a59e33"};var actors=UnityEngine.Object.FindObjectsByType<UPlayGround.DropItemActor>(FindObjectsInactive.Include,FindObjectsSortMode.None).Where(a=>a.GetComponent<UPlayGround.Components.SceneEntityId>()!=null).ToArray();var pickups=ids.Select(id=>actors.Single(a=>a.GetComponent<UPlayGround.Components.SceneEntityId>().Guid==id)).ToArray();
var before=new UPlayGround.Data.Save.GameSaveData();world.ExportSaveData(before);inventory.ExportSaveData(before);var original=player.transform.position;var rotation=player.transform.rotation;var map=UPlayGround.Manager.SceneManager.Instance.CurrentMapID;
var folder="output/OpenWorld/Exploration/Iteration06/play";System.IO.Directory.CreateDirectory(folder);System.IO.File.WriteAllText(folder+"/rewards.txt","RUNNING");var rows=new List<string>{DateTime.UtcNow.ToString("O"),"실제 상호작용 API·취소/소비·인벤토리·메모리 저장 재적용. 실제 입력·파일 재시작 아님"};int index=0,stage=0;double start=EditorApplication.timeSinceStartup,next=start;float finishGameTime=0;int countBefore=0;EditorApplication.CallbackFunction tick=null;
tick=()=>{bool finish=false;try{
 if(!EditorApplication.isPlaying||player==null||EditorApplication.timeSinceStartup-start>100)throw new Exception("검사 중단/시간 초과");if(EditorApplication.timeSinceStartup<next)return;var pickup=pickups[index];int item=pickup.ItemData.itemId;
 if(stage==0){world.ImportSaveData(before);inventory.ImportSaveData(before);var p=pickup.transform.position+Vector3.left*2;player.ActorController.Motor.SetPosition(p);continuous.RestoreLocation(continuous.ResidentMapId,player);countBefore=inventory.GetItemCount(item);stage=1;next=EditorApplication.timeSinceStartup+1.2;return;}
 if(stage==1){var owner=UPlayGround.Manager.World.RegionOwnership.Resolve(pickup);rows.Add(ids[index]+" owner="+owner+" player="+player.transform.position+" grounded="+player.ActorController.Motor.GroundingStatus.IsStableOnGround+" item="+item);if(owner!="LakeOfLifeScenario")throw new Exception("소유 mapId 불일치");pickup.Interact(player);pickup.StopInteract();stage=2;next=EditorApplication.timeSinceStartup+1.1;return;}
 if(stage==2){bool cancelled=pickup.CanInteract()&&inventory.GetItemCount(item)==countBefore;rows.Add("CANCEL="+cancelled);if(!cancelled)throw new Exception("취소 실패");pickup.Interact(player);finishGameTime=Time.time+pickup.InteractionData.interactionCompleteDuration+.25f;stage=3;next=EditorApplication.timeSinceStartup+.1;return;}
 if(pickup.IsInteracting()&&Time.time<finishGameTime)return;
 bool collected=!pickup.gameObject.activeSelf&&inventory.GetItemCount(item)==countBefore+pickup.Count;rows.Add("COLLECT="+collected+" inventory="+countBefore+"->"+inventory.GetItemCount(item));if(!collected)throw new Exception("획득 실패");var after=new UPlayGround.Data.Save.GameSaveData();world.ExportSaveData(after);inventory.ExportSaveData(after);
 world.ImportSaveData(before);inventory.ImportSaveData(before);bool restored=pickup.gameObject.activeSelf&&pickup.CanInteract()&&inventory.GetItemCount(item)==countBefore;rows.Add("IMPORT_BEFORE="+restored);if(!restored)throw new Exception("획득 전 복구 실패");
 world.ImportSaveData(after);inventory.ImportSaveData(after);bool consumed=!pickup.gameObject.activeSelf&&inventory.GetItemCount(item)==countBefore+pickup.Count;rows.Add("IMPORT_AFTER="+consumed);if(!consumed)throw new Exception("획득 후 복구 실패");
 index++;stage=0;if(index==pickups.Length){rows.Add("RESULT=PASS rewards="+index);finish=true;}
}catch(Exception exception){rows.Add("RESULT=FAIL "+exception);finish=true;}finally{if(finish){EditorApplication.update-=tick;if(EditorApplication.isPlaying){world.ImportSaveData(before);inventory.ImportSaveData(before);if(player!=null){player.ActorController.Motor.SetPosition(original);player.ActorController.Motor.SetRotation(rotation);continuous.RestoreLocation(map,player);}}System.IO.File.WriteAllLines(folder+"/rewards.txt",rows);}}};EditorApplication.update+=tick;return "보상 검사 시작; rewards.txt RESULT 확인 후 후속 요청";
