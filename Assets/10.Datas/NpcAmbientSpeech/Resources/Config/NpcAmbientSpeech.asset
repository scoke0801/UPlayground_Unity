      activities: 9
      periods: 15
    - id: scholarly.04.7
      topic: animals
      text: "\uB2E4 \uC544\uB294 \uC904 \uC54C\uC558\uB358 \uAC83\uB3C4 \uAC00\uAE4C\uC774\uC120
