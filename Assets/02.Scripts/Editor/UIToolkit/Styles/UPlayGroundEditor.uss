/* 디자인 토큰 -----------------------------------------------------------
   MotionEditor.uss 등 도구 전용 스타일시트가 참조하는 --up-* 값의 단일 소스.
   이 블록이 없으면 var(--up-*)가 해석되지 않아 여백/선택 하이라이트가 모두 사라진다. */
.up-editor-root {
    --up-bg-0: rgb(9, 14, 20);
    --up-bg-1: rgb(14, 21, 29);
    --up-bg-2: rgb(20, 29, 39);
    --up-bg-3: rgb(28, 39, 51);
    --up-border: rgb(56, 69, 82);
    --up-border-strong: rgb(62, 84, 103);
    --up-text: rgb(228, 235, 244);
    --up-text-dim: rgb(166, 181, 198);
    --up-text-faint: rgb(142, 157, 174);
    --up-accent: rgb(46, 154, 255);
    --up-accent-soft: rgba(46, 154, 255, 0.22);
    --up-space-1: 4px;
    --up-space-2: 8px;
    --up-space-3: 12px;
    --up-radius: 4px;
    --up-font-sm: 11px;
    --up-font-md: 12px;
}

.up-theme-light {
    --up-bg-0: rgb(224, 226, 230);
    --up-bg-1: rgb(235, 237, 240);
    --up-bg-2: rgb(215, 218, 223);
    --up-bg-3: rgb(205, 209, 215);
    --up-border: rgb(168, 172, 178);
    --up-border-strong: rgb(125, 132, 141);
    --up-text: rgb(35, 38, 43);
    --up-text-dim: rgb(82, 87, 94);
    --up-text-faint: rgb(110, 116, 124);
    --up-accent: rgb(20, 106, 200);
    --up-accent-soft: rgba(20, 106, 200, 0.20);
}

.up-editor-root {
    flex-grow: 1;
    min-width: 600px;
    min-height: 400px;
    background-color: rgb(9, 14, 20);
}

.up-theme-light {
    background-color: rgb(224, 226, 230);
}

.up-motion-toolbar,
.up-motion-control-panels,
.up-motion-preview-controls {
    flex-shrink: 0;
}

.up-motion-main-split {
    flex-grow: 1;
    min-height: 260px;
    border-top-width: 1px;
    border-top-color: rgb(62, 84, 103);
}

.up-motion-content-split {
    flex-grow: 1;
    min-width: 600px;
}

.up-motion-sidebar {
    min-width: 280px;
    background-color: rgb(14, 21, 29);
}

.up-motion-sidebar-imgui,
.up-motion-body,
.up-motion-body-imgui {
    flex-grow: 1;
}

.up-motion-body {
    min-width: 320px;
    background-color: rgb(9, 14, 20);
}

.up-motion-inspector-pane {
    min-width: 280px;
    background-color: rgb(14, 21, 29);
    border-left-width: 1px;
    border-left-color: rgb(62, 84, 103);
}

.up-hidden {
    display: none;
}

/* 공통 에디터 도구 크롬 --------------------------------------------------- */
.up-tool-header {
    height: 64px;
    min-height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(14, 21, 29);
    border-bottom-width: 1px;
    border-bottom-color: rgb(62, 84, 103);
}

.up-tool-header__icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    opacity: 0.92;
}

.up-tool-header__copy {
    flex-grow: 1;
    min-width: 0;
}

.up-tool-header__title-row {
    flex-direction: row;
    align-items: center;
}

.up-tool-header__title {
    color: rgb(228, 235, 244);
    font-size: 15px;
    -unity-font-style: bold;
}

.up-tool-header__badge {
    height: 18px;
    margin-left: 8px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(46, 154, 255);
    background-color: rgba(46, 154, 255, 0.16);
    border-width: 1px;
    border-color: rgb(46, 154, 255);
    border-radius: 4px;
    font-size: 9px;
    -unity-text-align: middle-center;
}

.up-tool-header__description {
    margin-top: 3px;
    color: rgb(142, 157, 174);
    font-size: 11px;
    white-space: normal;
}

.up-legacy-host {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
    background-color: rgb(9, 14, 20);
}

.up-legacy-tool {
    min-width: 420px;
}

.up-editor-root > .unity-toolbar {
    min-height: 28px;
    flex-shrink: 0;
    background-color: rgb(20, 29, 39);
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 61, 77);
}

/* 셀/패널 골격은 토큰 없이도 읽힐 수 있어야 하므로 명시 색상을 유지한다. */
.up-theme-light .up-motion-main-split {
    border-top-color: rgb(125, 132, 141);
}

.up-theme-light .up-motion-sidebar,
.up-theme-light .up-motion-inspector-pane,
.up-theme-light .up-tool-header {
    background-color: rgb(235, 237, 240);
}

.up-theme-light .up-motion-body,
.up-theme-light .up-legacy-host {
    background-color: rgb(224, 226, 230);
}

.up-theme-light .up-motion-inspector-pane {
    border-left-color: rgb(125, 132, 141);
}

.up-theme-light .up-tool-header {
    border-bottom-color: rgb(125, 132, 141);
}

.up-theme-light .up-tool-header__title {
    color: rgb(35, 38, 43);
}

.up-theme-light .up-tool-header__description {
    color: rgb(82, 87, 94);
}

.up-theme-light .up-tool-header__badge {
    background-color: rgba(46, 133, 235, 0.14);
}

.up-theme-light > .unity-toolbar {
    background-color: rgb(207, 210, 215);
    border-bottom-color: rgb(150, 154, 160);
}
