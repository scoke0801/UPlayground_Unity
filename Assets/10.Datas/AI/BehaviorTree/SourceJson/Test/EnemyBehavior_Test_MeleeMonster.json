{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_MeleeMonster",
    "displayName": "Test Melee Monster",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_skeleton_sword.asset",
    "blackboard": {
        "tickInterval": 0.1,
        "enablePatrol": true,
        "optimalCombatDistance": 1.8,
        "minCombatDistance": 1.0,
        "personalSpaceDistance": 0.65,
        "guardChance": 0.25,
        "retreatChance": 0.15,
        "circleWeight": 1.0
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "NoTarget",
            "priority": 900,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "PatrolOrIdle" }
            ]
        },
        {
            "name": "CounterPlayerAttack",
            "priority": 820,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerAttacking" },
                { "condition": "DistanceLessOrEqual", "value": "1.4" }
            ],
            "do": [
                { "action": "Transition", "state": "Counter" }
            ]
        },
        {
            "name": "MeleeAttack",
            "priority": 760,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "1.8" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "TooClose",
            "priority": 700,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "OutOfRange",
            "priority": 500,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Chase" }
            ]
        },
        {
            "name": "CombatIdle",
            "priority": 100,
            "select": "WeightedRandom",
            "choices": [
                { "weightKey": "guardChance", "action": "Transition", "state": "Guard" },
                { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" }
            ]
        }
    ]
}
