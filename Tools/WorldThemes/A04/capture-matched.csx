 var after=preservedFiles.ToDictionary(p=>p,p=>hash(p));bool filesUnchanged=preservedFiles.All(p=>hashes[p]==after[p]);System.IO.File.WriteAllText(output+"/preservation.json",json(new{filesBefore=hashes,filesAfter=after,filesUnchanged=filesUnchanged,hostDirtyBefore=hostDirty,hostDirtyAfter=(host.isLoaded&&host.isDirty),activeSceneBefore=previousActive.path,activeSceneAfter=UnityEngine.SceneManagement.SceneManager.GetActiveScene().path,qualityRpRestored=QualitySettings.renderPipeline==previousPipeline,globalRpRestored=UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline==previousPipelineGlobal,baselineDirty=loaded.isLoaded&&loaded.isDirty,hostLoadedBefore=hostLoadedBefore,hostLoadedAfter=host.isLoaded,persistentAlphaUnchanged=persistentAlphaUnchanged,persistentDirtyUnchanged=persistentDirtyUnchanged,activeSlotMaskAfter=fadeMask(),currentRenderPipelineBefore=rpBefore,currentRenderPipelineAfter=AssetDatabase.GetAssetPath(UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline)}));if(!filesUnchanged||(host.isLoaded&&host.isDirty)!=hostDirty)throw new Exception("촬영 원본 보존 실패");
