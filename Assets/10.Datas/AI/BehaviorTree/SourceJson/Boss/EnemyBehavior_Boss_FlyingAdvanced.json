{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Boss_FlyingAdvanced",
    "displayName": "Boss Flying Advanced",
    "actorKind": "Flying",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_griffin.asset",
    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": false,
        "optimalCombatDistance": 2.2,
        "minCombatDistance": 1.4,
        "personalSpaceDistance": 0.9,
        "guardChance": 0.0,
        "retreatChance": 0.25,
        "circleWeight": 1.0
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "DiveWhenAirLimitReached",
            "priority": 970,
            "when": [
                { "condition": "IsCurrentState", "value": "Flying_AirCircle" },
                { "condition": "IsAirAttackLimitReached" },
                { "condition": "HasDiveSkillAvailable" },
                { "condition": "RollDiveChance" }
            ],
            "do": [
                { "action": "SelectFlyingDiveSkill" },
                { "action": "FlyingTransition", "state": "Dive" }
            ]
        },
        {
            "name": "LandAfterAirLimit",
            "priority": 950,
            "when": [
                { "condition": "IsCurrentState", "value": "Flying_AirCircle" },
                { "condition": "IsAirAttackLimitReached" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Land" }
            ]
        },
        {
            "name": "KeepAirLoop",
            "priority": 920,
            "when": [
                { "condition": "IsFlyingAirState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "TakeOffFromGround",
            "priority": 880,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "ShouldFlyingTakeOff" }
            ],
            "do": [
                { "action": "ResetFlyingAirCounters" },
                { "action": "FlyingTransition", "state": "TakeOff" }
            ]
        },
        {
            "name": "NoTarget",
            "priority": 800,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Idle" }
            ]
        },
        {
            "name": "GroundSkillAttack",
            "priority": 680,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "DistanceLessOrEqual", "value": "2.2" },
                { "condition": "FlyingCanUseSkill" }
            ],
            "do": [
                { "action": "RequestFlyingAttackSlot" },
                { "action": "FlyingTransition", "state": "GroundAttack" }
            ]
        },
        {
            "name": "GroundRetreat",
            "priority": 600,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Retreat" }
            ]
        },
        {
            "name": "GroundApproach",
            "priority": 420,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Chase" }
            ]
        },
        {
            "name": "FallbackChase",
            "priority": 100,
            "when": [
                { "condition": "HasTarget" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Chase" }
            ]
        }
    ]
}
