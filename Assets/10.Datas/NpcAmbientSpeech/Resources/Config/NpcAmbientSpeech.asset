      activities: 9
      periods: 15
    - id: bright.00.3
      topic: lost
      text: "\uAE30\uC5B5\uB098\uAE30 \uC804\uC5D0 \uB2E4\uB978 \uC0DD\uAC01\uC744
        \uD574 \uBC84\uB838\uB124."
      activities: 9
      periods: 15
    - id: bright.00.4
      topic: lost
      text: "\uC544, \uB9DE\uB2E4! \u2026\uBB50\uAC00 \uB9DE\uC558\uB354\uB77C?"
      activities: 9
      periods: 15
    - id: bright.00.5
      topic: lost
      text: "\uC8FC\uBA38\uB2C8\uAC00 \uB9CE\uC544\uB3C4 \uBB38\uC81C\uC57C."
      activities: 9
      periods: 15
    - id: bright.00.6
      topic: lost
      text: "\uC67C\uCABD\uC5D0 \uB123\uC73C\uBA74 \uC548 \uC78A\uC744 \uC904 \uC54C\uC558\uC9C0."
      activities: 9
      periods: 15
    - id: bright.00.7
      topic: lost
      text: "\uC774\uBC88\uC5D4 \uC783\uC5B4\uBC84\uB9B0 \uAC8C \uC544\uB2C8\uB77C
