      activities: 9
      periods: 15
    - id: scholarly.07.0
      topic: plans
      text: "\uB098\uC911\uC5D0 \uC5EC\uBC31\uC5D0 \uC791\uAC8C \uC801\uC5B4 \uB46C\uC57C\uACA0\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: scholarly.07.1
      topic: plans
      text: "\uB2E4\uC74C\uC5D4 \uC9C8\uBB38\uC744 \uD558\uB098\uB9CC \uAC00\uC838\uAC00
