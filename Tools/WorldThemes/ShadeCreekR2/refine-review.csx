// 전용 빌보드로 마지막 단계를 복원하고, 물가의 밝기와 바닥의 과한 녹색을 조정한다.
var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();string dir="Assets/10.Datas/World/ThemeStudies/ShadeCreekR2/";
if(s.path!="Assets/01.Scenes/ArtReview/WorldThemes/ShadeCreekR2.unity"||s.isDirty||EditorApplication.isPlayingOrWillChangePlaymode||EditorUtility.scriptCompilationFailed)throw new Exception("저장된 R2 필요");
var mat=AssetDatabase.LoadAssetAtPath<Material>(dir+"Canopy_2.mat");mat.SetFloat("_Saturation",.75f);mat.SetFloat("_Value",.7f);mat.SetFloat("_Metallic",0);mat.SetFloat("_Smoothness",.2f);EditorUtility.SetDirty(mat);AssetDatabase.SaveAssetIfDirty(mat);
int count=0;foreach(var group in s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<LODGroup>(true))){var lods=group.GetLODs();if(lods.Length!=4||!lods[0].renderers.Any(r=>r.sharedMaterials.Any(m=>m!=null&&AssetDatabase.GetAssetPath(m)==dir+"Canopy_0.mat")))continue;var bill=group.GetComponentsInChildren<MeshRenderer>(true).FirstOrDefault(r=>r.GetComponent<MeshFilter>()!=null&&r.GetComponent<MeshFilter>().sharedMesh.vertexCount==4);if(bill==null)throw new Exception("빌보드 누락");bill.enabled=true;bill.sharedMaterial=mat;lods[3].renderers=new Renderer[]{bill};group.SetLODs(lods);group.RecalculateBounds();PrefabUtility.RecordPrefabInstancePropertyModifications(bill);PrefabUtility.RecordPrefabInstancePropertyModifications(group);count++;}
if(count!=192)throw new Exception("예상 수목 수와 다름: "+count);
var floor=AssetDatabase.LoadAssetAtPath<TerrainLayer>(dir+"ForestFloor.terrainlayer");floor.diffuseRemapMin=new Vector4(.045f,.035f,.025f,0);floor.diffuseRemapMax=new Vector4(.4f,.34f,.32f,1);EditorUtility.SetDirty(floor);AssetDatabase.SaveAssetIfDirty(floor);
var water=AssetDatabase.LoadAssetAtPath<Material>(dir+"CreekWater.mat");water.SetFloat("_AmbientFloor",.68f);water.SetFloat("_SurfaceOpacity",.67f);water.SetFloat("_ShoreFade",.08f);water.SetColor("_ShallowColor",new Color(.45f,.58f,.51f,1));EditorUtility.SetDirty(water);AssetDatabase.SaveAssetIfDirty(water);
Terrain.activeTerrain.terrainData.SetBaseMapDirty();Terrain.activeTerrain.Flush();UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(s);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(s);return new{count,lastLodVertices=4,performanceMeasured=false};
