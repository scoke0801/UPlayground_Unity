var original=UnityEngine.SceneManagement.SceneManager.GetActiveScene();
var preview=UnityEditor.SceneManagement.EditorSceneManager.NewPreviewScene();var temporaryMaterials=new List<Material>();
string output="output/RiverBasinWorld/VisualR1/study";System.IO.Directory.CreateDirectory(output);
try{
 var ground=GameObject.CreatePrimitive(PrimitiveType.Plane);UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(ground,preview);ground.transform.localScale=Vector3.one*5;var dirt=new Material(Shader.Find("Universal Render Pipeline/Lit"));temporaryMaterials.Add(dirt);dirt.color=new Color(.23f,.25f,.18f);dirt.SetFloat("_Smoothness",0);ground.GetComponent<Renderer>().sharedMaterial=dirt;
 var light=new GameObject("StudySun").AddComponent<Light>();UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(light.gameObject,preview);light.type=LightType.Directional;light.transform.rotation=Quaternion.Euler(42,-35,0);light.intensity=1.6f;light.color=new Color(1,.94f,.84f);light.shadows=LightShadows.Soft;
 var cam=new GameObject("StudyCamera").AddComponent<Camera>();UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(cam.gameObject,preview);cam.scene=preview;cam.enabled=false;cam.fieldOfView=48;cam.transform.position=new Vector3(18,7,-23);cam.transform.LookAt(new Vector3(0,7,0));cam.farClipPlane=200;cam.clearFlags=CameraClearFlags.SolidColor;cam.backgroundColor=new Color(.42f,.50f,.53f);
 string[] paths={"Assets/ExternalAssets/Environment/Idyllic Fantasy Nature/Prefabs/BroadleafTree_01_Red.prefab","Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Foliage/Trees/Osmanthus/PF_EastLands_Osmanthus_01.prefab","Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Foliage/Trees/Osmanthus/PF_EastLands_Osmanthus_03.prefab"};
 for(int i=0;i<paths.Length;i++){
  var g=UnityEngine.Object.Instantiate(AssetDatabase.LoadAssetAtPath<GameObject>(paths[i]));UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(g,preview);g.transform.position=Vector3.zero;g.transform.localScale=Vector3.one*(i==0?1.7f:1);foreach(var group in g.GetComponentsInChildren<LODGroup>())group.ForceLOD(0);
  var clones=new Dictionary<Material,Material>();foreach(var r in g.GetComponentsInChildren<Renderer>(true)){var mats=r.sharedMaterials;for(int j=0;j<mats.Length;j++){var source=mats[j];if(source==null)continue;Material m;if(!clones.TryGetValue(source,out m)){m=new Material(source);temporaryMaterials.Add(m);clones.Add(source,m);if(m.HasProperty("_Top_Color")){m.SetColor("_Top_Color",new Color(.82f,.48f,.08f,0));m.SetColor("_Bottom_Color",new Color(.36f,.20f,.045f,0));}if(m.HasProperty("_Foliage_Color_Top")){m.SetColor("_Foliage_Color_Top",i==2?new Color(1,.35f,.06f,1):new Color(1,.66f,.14f,1));m.SetColor("_Foliage_Color_Bottom",i==2?new Color(.48f,.17f,.03f,1):new Color(.55f,.36f,.06f,1));m.SetColor("_Always_On_Fresnel_Color",Color.black);}}mats[j]=m;}r.sharedMaterials=mats;}
  var previous=RenderTexture.active;var rt=RenderTexture.GetTemporary(800,800,24);cam.targetTexture=rt;cam.Render();RenderTexture.active=rt;var texture=new Texture2D(800,800,TextureFormat.RGBA32,false);texture.ReadPixels(new Rect(0,0,800,800),0,0);texture.Apply();System.IO.File.WriteAllBytes(output+"/tree_"+i+".png",texture.EncodeToPNG());UnityEngine.Object.DestroyImmediate(texture);cam.targetTexture=null;RenderTexture.active=previous;RenderTexture.ReleaseTemporary(rt);UnityEngine.Object.DestroyImmediate(g);
 }
}finally{UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(preview);foreach(var m in temporaryMaterials)UnityEngine.Object.DestroyImmediate(m);}
return output;
