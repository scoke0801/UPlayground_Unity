      periods: 8
    - id: reserved.14.4
      topic: night
      text: "\uC7A0\uACB0\uC5D0 \uAE68\uBA74 \uD55C\uB3D9\uC548 \uBA4D\uD558\uB354\uB77C."
      activities: 9
      periods: 8
    - id: reserved.14.5
      topic: night
      text: "\uD558\uD488\uC744 \uCC38\uC558\uB354\uB2C8 \uB208\uBB3C\uC774 \uB098."
      activities: 9
      periods: 8
    - id: reserved.14.6
      topic: night
      text: "\uB0AE\uC5D0 \uBABB \uB4E4\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294
        \uAC83 \uAC19\uC544."
      activities: 9
      periods: 8
    - id: reserved.14.7
      topic: night
      text: "\uBD88 \uB044\uAE30 \uC804\uC5D0 \uB298 \uD55C \uBC88 \uB354 \uBCF4\uAC8C
        \uB3FC."
      activities: 9
      periods: 8
    - id: reserved.15.0
      topic: rest
      text: "\uC549\uC73C\uB2C8 \uC5B4\uAE68\uAC00 \uAC00\uBCBC\uC6CC\uC84C\uC5B4."
      activities: 8
      periods: 15
    - id: reserved.15.1
      topic: rest
      text: "\uC274 \uB54C\uB294 \uC190\uB3C4 \uAC00\uB9CC\uB450\uC790."
      activities: 8
      periods: 15
    - id: reserved.15.2
      topic: rest
      text: "\uB9D0 \uC5C6\uC774 \uC549\uC544 \uC788\uC5B4\uB3C4 \uAD1C\uCC2E\uB124."
      activities: 8
      periods: 15
    - id: reserved.15.3
      topic: rest
      text: "\uC5EC\uAE30\uC120 \uC7A0\uAE50 \uAE34\uC7A5\uC744 \uD480\uC5B4\uB3C4
        \uB418\uACA0\uC9C0."
      activities: 8
      periods: 15
    - id: reserved.15.4
      topic: rest
      text: "\uB4F1\uC744 \uD3B4\uB2C8 \uB20C\uB9B0 \uB370\uAC00 \uB2F9\uACA8."
