 var patchData=new TerrainData();patchData.heightmapResolution=33;patchData.alphamapResolution=16;patchData.size=new Vector3(8,1,8);patchData.terrainLayers=new[]{terrain.terrainData.terrainLayers[4],terrain.terrainData.terrainLayers[7]};patchData.SetHeights(0,0,new float[33,33]);var patchObject=UnityEngine.Object.Instantiate(terrain.gameObject,rig.transform,false);patchObject.name="PreviewSurface8m_ExcludeFromIntegration";patchObject.transform.position=new Vector3(1126,79.6f,576);var patch=patchObject.GetComponent<Terrain>();patch.terrainData=patchData;patch.enabled=true;patch.detailObjectDistance=0;patchObject.GetComponent<TerrainCollider>().terrainData=patchData;
 var candidateRows=new List<object>();for(int layer=0;layer<2;layer++){var alpha=new float[16,16,2];for(int z=0;z<16;z++)for(int x=0;x<16;x++)alpha[z,x,layer]=1;patchData.SetAlphamaps(0,0,alpha);patch.Flush();string key=layer==0?"Ground4":"ForestGround";candidateRows.Add(new{key=key,worldSizeMeters=8,layerPath=AssetDatabase.GetAssetPath(patchData.terrainLayers[layer]),layerGuid=AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(patchData.terrainLayers[layer])),settings=EditorJsonUtility.ToJson(patchData.terrainLayers[layer]),status="실제근접/넓은프레임 촬영; 기존자산 설정 그대로"});}
