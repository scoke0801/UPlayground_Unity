      periods: 15
    - id: bright.03.3
      topic: people
      text: "\uBE44\uBC00\uC774\uB77C\uACE0 \uB4E4\uC73C\uBA74 \uB354 \uAD81\uAE08\uD574\uC9C0\uC796\uC544."
