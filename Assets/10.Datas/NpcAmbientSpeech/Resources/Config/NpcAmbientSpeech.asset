      periods: 15
    - id: reserved.15.6
      topic: rest
      text: "\uC544\uBB34\uB3C4 \uBD80\uB974\uC9C0 \uC54A\uC73C\uBA74 \uC870\uAE08
        \uB354."
      activities: 8
      periods: 15
    - id: reserved.15.7
      topic: rest
      text: "\uC774\uB300\uB85C \uB208\uB9CC \uC26C\uAC8C \uD558\uC790."
      activities: 8
      periods: 15
  - id: gentle
    direction: "\uBC1D\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uC758\uC0C1\uC758 \uC870\uC6A9\uD55C
      \uC778\uC0C1. \uB0A8\uC758 \uC548\uBD80\uC5D0 \uB9C8\uC74C\uC774 \uC4F0\uC774\uACE0
      \uC791\uC740 \uC0DD\uBB3C\uC744 \uC798 \uAE30\uC5B5\uD558\uC9C0\uB9CC \uBD80\uD0C1\uC744
      \uC27D\uAC8C \uBABB \uD55C\uB2E4. \uD63C\uC7A3\uB9D0\uC740 \uD574\uC694\uCCB4\uC640
      \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uBBF8\uC644\uACB0 \uBC1C\uD654, \uAD50\uD6C8\uC740
      \uD53C\uD55C\uB2E4."
    lines:
    - id: gentle.00.0
      topic: lost
      text: "\uC5B4\uB514\uC5D0 \uB450\uC5C8\uB294\uC9C0 \uB9D0\uB85C \uD574 \uB458\uAC78\uC694."
      activities: 9
      periods: 15
    - id: gentle.00.1
      topic: lost
      text: "\uB204\uAC00 \uCE58\uC6CC \uC900 \uAC74 \uC544\uB2C8\uACA0\uC9C0\uC694?"
      activities: 9
      periods: 15
    - id: gentle.00.2
      topic: lost
      text: "\uC78A\uC744\uAE4C \uBD10 \uB530\uB85C \uB480\uB294\uB370 \uADF8\uB9CC."
      activities: 9
      periods: 15
    - id: gentle.00.3
      topic: lost
      text: "\uC774\uB984\uC744 \uC801\uC5B4 \uB193\uC73C\uBA74 \uB3CC\uC544\uC62C\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: gentle.00.4
      topic: lost
      text: "\uC544\uAE4C \uC190\uC5D0 \uB4E4\uACE0 \uC788\uB358 \uAC83 \uAC19\uC740\uB370."
      activities: 9
      periods: 15
    - id: gentle.00.5
      topic: lost
      text: "\uBABB \uCC3E\uC73C\uBA74 \uBE4C\uB824 \uC900 \uBD84\uAED8 \uBB50\uB77C\uACE0
        \uD558\uC8E0."
      activities: 9
      periods: 15
    - id: gentle.00.6
      topic: lost
      text: "\uAE30\uC5B5\uB0AC\uC5B4\uC694. \uB2E4\uB978 \uC8FC\uBA38\uB2C8\uC600\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.00.7
      topic: lost
      text: "\uC798 \uBCF4\uC774\uB294 \uB370 \uB450\uBA74 \uC624\uD788\uB824 \uBABB
        \uCC3E\uB098 \uBD10\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.0
      topic: food
      text: "\uD55C \uC21F\uAC00\uB77D \uB354 \uB728\uBA74 \uC870\uAE08 \uC9DC\uACA0\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.1
      topic: food
      text: "\uB530\uB73B\uD55C \uAD6D\uC744 \uCC9C\uCC9C\uD788 \uBA39\uACE0 \uC2F6\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.2
      topic: food
      text: "\uBE75\uC774 \uC791\uC544 \uBCF4\uC5EC\uC11C \uB450 \uAC1C\uB97C \uACE8\uB790\uB294\uB370."
      activities: 9
      periods: 15
    - id: gentle.01.3
      topic: food
      text: "\uB9D0\uB9B0 \uACFC\uC77C\uC5D0 \uC528\uAC00 \uC788\uC5C8\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.4
      topic: food
      text: "\uB2EC\uB2E4\uACE0 \uD558\uBA74 \uB35C \uB2EC\uAC8C \uC904\uAE4C\uC694?"
      activities: 9
      periods: 15
    - id: gentle.01.5
      topic: food
      text: "\uD55C \uC785 \uB0A8\uAE34 \uAC8C \uC790\uAFB8 \uC0DD\uAC01\uB098\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.6
      topic: food
      text: "\uBC25 \uBA39\uC5C8\uB0D0\uB294 \uB9D0\uC744 \uBABB \uD558\uACE0 \uC654\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.01.7
      topic: food
      text: "\uB35C\uC5B4 \uC8FC\uB824\uB2E4\uAC00 \uC81C \uBAAB\uC744 \uB2E4 \uC92C\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.02.0
      topic: expenses
      text: "\uB3CC\uB824\uB193\uC73C\uB824\uB2C8 \uC190\uC774 \uC798 \uC548 \uB5A8\uC5B4\uC9C0\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.02.1
      topic: expenses
      text: "\uC120\uBB3C\uC740 \uC81C \uAC83 \uACE0\uB97C \uB54C\uBCF4\uB2E4 \uC5B4\uB835\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.02.2
      topic: expenses
      text: "\uADF8\uBD84\uC774 \uC88B\uC544\uD558\uB294 \uC0C9\uC774 \uBB50\uC600\uB354\uB77C."
      activities: 9
      periods: 15
    - id: gentle.02.3
      topic: expenses
      text: "\uB108\uBB34 \uD070 \uAC78 \uC8FC\uBA74 \uBD80\uB2F4\uC2A4\uB7EC\uC6B8\uAE4C\uC694?"
      activities: 9
      periods: 15
    - id: gentle.02.4
      topic: expenses
      text: "\uC794\uB3C8\uC740 \uBD84\uBA85 \uBC1B\uC558\uC5B4\uC694. \uC5B4\uB514
        \uC788\uC9C0?"
      activities: 9
      periods: 15
    - id: gentle.02.5
      topic: expenses
      text: "\uC798\uBABB \uAC70\uC2AC\uB7EC \uC8FC\uC2E0 \uAC74 \uC544\uB2CC\uAC00."
      activities: 9
      periods: 15
    - id: gentle.02.6
      topic: expenses
      text: "\uD544\uC694 \uC5C6\uB2E4\uB294 \uB9D0\uC744 \uBABB \uD574\uC11C\uC694."
      activities: 9
      periods: 15
    - id: gentle.02.7
      topic: expenses
      text: "\uC774\uBC88\uC5D4 \uD3EC\uC7A5\uC744 \uC870\uAE08 \uC791\uAC8C \uD574
        \uB2EC\uB7A0\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: gentle.03.0
      topic: people
      text: "\uAD1C\uCC2E\uB2E4\uACE0 \uD558\uC168\uB294\uB370 \uC790\uAFB8 \uB9C8\uC74C\uC5D0
        \uAC78\uB824\uC694."
      activities: 9
      periods: 15
    - id: gentle.03.1
      topic: people
      text: "\uC131\uD568\uC744 \uD55C \uBC88\uB9CC \uB354 \uC5EC\uCB64\uBCFC\uAC78."
      activities: 9
      periods: 15
    - id: gentle.03.2
      topic: people
      text: "\uC6C3\uC73C\uC154\uC11C \uC800\uB3C4 \uB530\uB77C \uC6C3\uC5C8\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.03.3
      topic: people
      text: "\uBD88\uB7EC \uC138\uC6B8 \uB9CC\uD07C \uAE09\uD55C \uC77C\uC740 \uC544\uB2CC\uB370."
      activities: 9
      periods: 15
    - id: gentle.03.4
      topic: people
      text: "\uC544\uAE4C \uB9D0\uC500\uC774 \uC798 \uC548 \uB4E4\uB838\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.03.5
      topic: people
      text: "\uAD1C\uD788 \uBC29\uD574\uD55C \uAC74 \uC544\uB2C8\uACA0\uC9C0\uC694?"
      activities: 9
      periods: 15
    - id: gentle.03.6
      topic: people
      text: "\uB2E4\uC74C\uC5D0 \uB9CC\uB098\uBA74 \uADF8 \uC598\uAE30\uBD80\uD130
        \uD574\uC57C\uACA0\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.03.7
      topic: people
      text: "\uC791\uBCC4 \uC778\uC0AC\uAC00 \uB298 \uC870\uAE08 \uB2A6\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.0
      topic: animals
      text: "\uACE0\uC591\uC774\uAC00 \uBC1C\uC744 \uC811\uC73C\uBA74 \uB354 \uC791\uC544
        \uBCF4\uC5EC\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.1
      topic: animals
      text: "\uBA39\uC774\uB97C \uC904 \uB54C \uC190\uB05D\uC744 \uC870\uC2EC\uD574\uC57C
        \uD574\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.2
      topic: animals
      text: "\uAC00\uAE4C\uC774 \uAC00\uBA74 \uB180\uB784\uAE4C \uBD10 \uBA48\uCDC4\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.3
      topic: animals
      text: "\uAF2C\uB9AC\uAC00 \uC548 \uBCF4\uC774\uBA74 \uC7A0\uB4E0 \uAC78\uAE4C\uC694?"
      activities: 9
      periods: 15
    - id: gentle.04.4
      topic: animals
      text: "\uC791\uC740 \uC0C8\uB3C4 \uBC25\uC744 \uBA39\uB294 \uB370\uB294 \uBC14\uC058\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.5
      topic: animals
      text: "\uAC15\uC544\uC9C0\uB294 \uC774\uB984\uC744 \uB4E4\uC73C\uBA74 \uADC0\uBD80\uD130
        \uC6C0\uC9C1\uC5EC\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.6
      topic: animals
      text: "\uC816\uC740 \uBC1C\uC744 \uB2E6\uC544 \uC8FC\uB824\uB2E4 \uC800\uB3C4
        \uC816\uC5C8\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.04.7
      topic: animals
      text: "\uBE48 \uC790\uB9AC\uC5D0 \uC549\uC744 \uC904 \uC5B4\uB5BB\uAC8C \uC54C\uC558\uC744\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.0
      topic: clothes
      text: "\uC637\uC5D0 \uBD99\uC740 \uC2E4\uBC25\uC744 \uC790\uAFB8 \uB9CC\uC9C0\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.1
      topic: clothes
      text: "\uC190\uC218\uAC74\uC744 \uB108\uBB34 \uC791\uAC8C \uC811\uC5C8\uB098
        \uBD10\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.2
      topic: clothes
      text: "\uB2E4\uB9BC\uC9C8\uD55C \uB370\uAC00 \uB610 \uC811\uD614\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.3
      topic: clothes
      text: "\uC774 \uB2E8\uCD94\uB294 \uC870\uAE08 \uBE44\uC2A4\uB4EC\uD558\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.4
      topic: clothes
      text: "\uC637\uAE43\uC774 \uB4A4\uC9D1\uD614\uB2E4\uB294 \uB9D0\uC744 \uD574
        \uB4DC\uB9B4\uAC78."
      activities: 9
      periods: 15
    - id: gentle.05.5
      topic: clothes
      text: "\uBC1D\uC740 \uC0C9\uC740 \uC791\uC740 \uC5BC\uB8E9\uB3C4 \uAE08\uBC29
        \uBCF4\uC5EC\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.6
      topic: clothes
      text: "\uB9E4\uB4ED\uC774 \uC608\uC058\uAC8C \uC548 \uB418\uBA74 \uB2E4\uC2DC
        \uBB36\uAC8C \uB3FC\uC694."
      activities: 9
      periods: 15
    - id: gentle.05.7
      topic: clothes
      text: "\uC18C\uB9E4 \uC548\uC73C\uB85C \uC190\uC774 \uC790\uAFB8 \uB4E4\uC5B4\uAC00\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.0
      topic: habits
      text: "\uBA3C\uC800 \uB9D0\uC500\uD558\uC2DC\uAE38 \uAE30\uB2E4\uB9AC\uB2E4
        \uB05D\uB0AC\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.1
      topic: habits
      text: "\uACE0\uAC1C\uB97C \uB108\uBB34 \uB9CE\uC774 \uB044\uB355\uC600\uB098
        \uBD10\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.2
      topic: habits
      text: "\uB0AF\uC120 \uBD84 \uC55E\uC5D0\uC11C\uB294 \uB9D0\uC774 \uC791\uC544\uC838\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.3
      topic: habits
      text: "\uAC19\uC740 \uC778\uC0AC\uB97C \uB450 \uBC88 \uD588\uC744\uC9C0\uB3C4
        \uBAB0\uB77C\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.4
      topic: habits
      text: "\uB204\uAC00 \uC6C3\uC73C\uBA74 \uC774\uC720\uB3C4 \uBAA8\uB974\uACE0
        \uC6C3\uAC8C \uB3FC\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.5
      topic: habits
      text: "\uCEF5 \uC190\uC7A1\uC774\uB294 \uB298 \uAC19\uC740 \uCABD\uC73C\uB85C
        \uB3CC\uB9AC\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.6
      topic: habits
      text: "\uC0DD\uAC01\uD558\uB2E4\uAC00 \uBA38\uB9AC\uCE74\uB77D\uC744 \uB610
        \uB9CC\uC84C\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.06.7
      topic: habits
      text: "\uC2E4\uC218\uD558\uBA74 \uC0AC\uACFC\uBD80\uD130 \uB098\uC624\uB294
        \uBC84\uB987\uC774 \uC788\uB124\uC694."
      activities: 9
      periods: 15
    - id: gentle.07.0
      topic: plans
      text: "\uD55C \uC904\uC774\uB77C\uB3C4 \uC548\uBD80\uB97C \uC801\uC5B4 \uBCFC\uAE4C\uC694."
      activities: 9
      periods: 15
    - id: gentle.07.1
      topic: plans
      text: "\uB3CC\uB824 \uB4DC\uB9B4 \uB54C \uC791\uC740 \uAC04\uC2DD\uB3C4 \uB123\uACE0
        \uC2F6\uC5B4\uC694."
      activities: 9
      periods: 15
    - id: gentle.07.2
      topic: plans
      text: "\uBE4C\uB824 \uC8FC\uC2E0 \uAC74 \uAE68\uB057\uC774 \uD574\uC11C \uB4DC\uB824\uC57C\uC9C0\uC694."
      activities: 9
      periods: 15
    - id: gentle.07.3
      topic: plans
      text: "\uB2E4\uC74C\uC5D4 \uC81C\uAC00 \uBA3C\uC800 \uCC3E\uC544\uAC00\uB3C4
