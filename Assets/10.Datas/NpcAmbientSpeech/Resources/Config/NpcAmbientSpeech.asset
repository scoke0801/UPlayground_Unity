      text: "\uC5B4\uAE68\uC5D0 \uB20C\uB9B0 \uC790\uAD6D\uC774 \uAF64 \uC624\uB798\uAC00\uB124."
      activities: 9
      periods: 4
    - id: reserved.13.5
      topic: dusk
      text: "\uD574\uAC00 \uC9C0\uBA74 \uAC78\uC74C\uC774 \uBE68\uB77C\uC9C0\uB354\uB77C."
      activities: 9
      periods: 4
    - id: reserved.13.6
      topic: dusk
      text: "\uB3CC\uC544\uAC00\uAE30 \uC804\uC5D0 \uBE60\uC9C4 \uAC8C \uC5C6\uB098
        \uBCF4\uC790."
      activities: 9
      periods: 4
    - id: reserved.13.7
      topic: dusk
      text: "\uB0AE\uC5D0 \uD55C \uB9D0\uC744 \uAD73\uC774 \uB418\uC9DA\uC9C4 \uB9D0\uC790."
      activities: 9
      periods: 4
    - id: reserved.14.0
      topic: night
      text: "\uBC24\uC5D0\uB294 \uBAA9\uC18C\uB9AC\uB97C \uB354 \uB0AE\uCD94\uAC8C
        \uB3FC."
      activities: 9
      periods: 8
    - id: reserved.14.1
      topic: night
      text: "\uB208\uC774 \uC5B4\uB450\uC6B4 \uB370 \uC775\uC744 \uB54C\uAE4C\uC9C0."
      activities: 9
      periods: 8
    - id: reserved.14.2
      topic: night
      text: "\uC791\uC740 \uC18C\uB9AC \uD558\uB098\uAC00 \uC624\uB798 \uB0A8\uB124."
      activities: 9
      periods: 8
    - id: reserved.14.3
      topic: night
      text: "\uC774 \uC2DC\uAC04\uC5D4 \uC774\uB984\uC744 \uBD80\uB974\uAE30\uB3C4
