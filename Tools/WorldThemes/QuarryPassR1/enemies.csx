if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("QuarryPassR1-A-20261108"))throw new Exception("A 잠금 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/QuarryPassR1.unity"||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("A 씬 필요");
var loaders=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Manager.World.RuntimePlacementLoader>(true)).ToArray();if(loaders.Length==0)throw new Exception("실제 배치 로더 없음");
var db=AssetDatabase.LoadAssetAtPath<UPlayGround.Data.Actor.ActorDatabase>("Assets/10.Datas/Actor/DataBase/ActorDatabase.asset");var rows=new List<object>();
var route=new[]{new Vector3(539,0,1084),new Vector3(450,0,1140),new Vector3(420,0,1186),new Vector3(548,0,1240),new Vector3(560,0,1330),new Vector3(580,0,1435)};
foreach(var loader in loaders){var data=loader.PlacementData;if(data==null)continue;
foreach(var r in data.Records.Where(r=>r.position.x>=290&&r.position.x<=650&&r.position.z>=1000&&r.position.z<=1470&&!string.IsNullOrEmpty(r.actorId))){
var definitions=db.All.Where(d=>d!=null&&d.actorId==r.actorId).ToArray();if(definitions.Length!=1)throw new Exception("정의 중복/누락 "+r.actorId);var def=definitions[0];var prefab=def.prefab;var flying=prefab==null?new string[0]:prefab.GetComponentsInChildren<MonoBehaviour>(true).Where(c=>c!=null&&c.GetType().GetProperty("FlyingSettings")!=null).Select(c=>c.GetType().FullName).ToArray();
var q=route.OrderBy(p=>(new Vector2(p.x-r.position.x,p.z-r.position.z)).sqrMagnitude).First();q.y=Terrain.activeTerrain.SampleHeight(q);var paths=new List<object>();
for(int reverse=0;reverse<2;reverse++){UnityEngine.AI.NavMeshHit a,b;bool sa=UnityEngine.AI.NavMesh.SamplePosition(reverse==0?r.position:q,out a,3,-1),sb=UnityEngine.AI.NavMesh.SamplePosition(reverse==0?q:r.position,out b,3,-1);var path=new UnityEngine.AI.NavMeshPath();bool calculated=sa&&sb&&UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,-1,path);paths.Add(new{reverse,sampled=sa&&sb,calculated,status=calculated?path.status.ToString():"NoSample",corners=path.corners.Select(p=>new[]{p.x,p.y,p.z}).ToArray(),interpretation=flying.Length>0?"비행 적의 지상 표본 참고; 공중 이동 검증 아님":"지상 정적 경로; 실제 교전/추격 아님"});}
rows.Add(new{data=AssetDatabase.GetAssetPath(data),loader=loader.name,r.actorId,r.placementGuid,r.sceneEntityGuid,r.groupGuid,r.groupName,r.monsterChaseDistance,r.spawnWhenNearby,position=new[]{r.position.x,r.position.y,r.position.z},definition=AssetDatabase.GetAssetPath(def),prefab=AssetDatabase.GetAssetPath(prefab),behavior=AssetDatabase.GetAssetPath(def.EffectiveBehaviorData),abilitySet=AssetDatabase.GetAssetPath(def.EffectiveAbilitySet),flyingComponents=flying,paths});
}}
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var result=new{loaders=loaders.Select(l=>new{name=l.name,data=AssetDatabase.GetAssetPath(l.PlacementData)}).ToArray(),rows,scope="현재 씬의 실제 RuntimePlacementLoader 연결. 편집/스폰/AI 조정 없음"};System.IO.File.WriteAllText("output/QuarryPassR1/connected-enemies.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return new{loaders=loaders.Length,records=rows.Count};
