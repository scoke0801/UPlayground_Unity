var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlaying||scene.isDirty||scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity")throw new Exception("저장된 전용 씬 필요");
string data="Assets/10.Datas/World/RiverBasinWorld/VisualR1";if(AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(data+"/RiverBasinPipeline.asset")!=null)throw new Exception("기존 렌더 프로필 보존");
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var settings=(Dictionary<string,object>)json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText("Tools/RiverBasinWorld/VisualR1/lighting.json"),typeof(Dictionary<string,object>)});
var source=UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline as UnityEngine.Rendering.Universal.UniversalRenderPipelineAsset;var pipeline=UnityEngine.Object.Instantiate(source);pipeline.name="RiverBasinPipeline";pipeline.shadowDistance=Convert.ToSingle(settings["shadowDistance"]);pipeline.shadowCascadeCount=Convert.ToInt32(settings["shadowCascades"]);pipeline.mainLightShadowmapResolution=Convert.ToInt32(settings["shadowResolution"]);AssetDatabase.CreateAsset(pipeline,data+"/RiverBasinPipeline.asset");
var sky=new Material(AssetDatabase.LoadAssetAtPath<Material>("Assets/10.Datas/World/Sky/DaySky_Clear.mat"));sky.name="RiverBasinSky";sky.SetFloat("_Exposure",Convert.ToSingle(settings["skyExposure"]));sky.SetFloat("_CloudCoverage",Convert.ToSingle(settings["cloudCoverage"]));AssetDatabase.CreateAsset(sky,data+"/RiverBasinSky.mat");RenderSettings.skybox=sky;
var binding=GameObject.Find("RiverBasinWorld · 씬 계약").AddComponent<UPlayGround.Gameplay.World.SceneEnvironmentRendering>();var so=new SerializedObject(binding);so.FindProperty("_renderPipeline").objectReferenceValue=pipeline;so.FindProperty("_skySource").objectReferenceValue=sky;so.FindProperty("_sunLight").objectReferenceValue=RenderSettings.sun;so.ApplyModifiedPropertiesWithoutUndo();
var profile=ScriptableObject.CreateInstance<UnityEngine.Rendering.VolumeProfile>();AssetDatabase.CreateAsset(profile,data+"/B1Look.asset");var tonemapping=profile.Add<UnityEngine.Rendering.Universal.Tonemapping>(true);tonemapping.mode.Override(UnityEngine.Rendering.Universal.TonemappingMode.ACES);AssetDatabase.AddObjectToAsset(tonemapping,profile);var color=profile.Add<UnityEngine.Rendering.Universal.ColorAdjustments>(true);color.contrast.Override(Convert.ToSingle(settings["contrast"]));color.saturation.Override(Convert.ToSingle(settings["saturation"]));color.postExposure.Override(Convert.ToSingle(settings["postExposure"]));AssetDatabase.AddObjectToAsset(color,profile);
var look=new GameObject("B1 · 근경 색과 명암");look.transform.SetParent(GameObject.Find("B1_ArtR1").transform);look.transform.position=new Vector3(307,85,-15);var box=look.AddComponent<BoxCollider>();box.isTrigger=true;box.size=new Vector3(170,90,180);var volume=look.AddComponent<UnityEngine.Rendering.Volume>();volume.isGlobal=false;volume.blendDistance=18;volume.priority=2;volume.sharedProfile=profile;
var camera=GameObject.Find("Main Camera").GetComponent<Camera>();var cameraData=camera.GetComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>()??camera.gameObject.AddComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();cameraData.renderPostProcessing=true;cameraData.antialiasing=UnityEngine.Rendering.Universal.AntialiasingMode.SubpixelMorphologicalAntiAliasing;cameraData.antialiasingQuality=UnityEngine.Rendering.Universal.AntialiasingQuality.High;
foreach(var o in new UnityEngine.Object[]{pipeline,sky,profile})AssetDatabase.SaveAssetIfDirty(o);UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return "씬 소유 URP·하늘·국소 룩 적용. 원본 렌더러 기능 참조 유지";
