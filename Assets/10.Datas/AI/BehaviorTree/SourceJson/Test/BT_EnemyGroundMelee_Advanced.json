{
    "schemaVersion": 1,
    "id": "EnemyBehavior_GroundMelee_Advanced",
    "displayName": "Ground Melee Advanced",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_humanoid.asset",
    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": true,
        "optimalCombatDistance": 2.5,
        "minCombatDistance": 1.3,
        "personalSpaceDistance": 0.9,
        "guardChance": 0.25,
        "retreatChance": 0.20,
        "circleWeight": 0.30,
        "aggression": 0.55,
        "reactionChance": 0.40,
        "counterChance": 0.20,
        "dodgeChance": 0.35,
        "punishRecoveryChance": 0.40,
        "antiGuardChance": 0.30,
        "minRetreatCooldown": 1.5,
        "maxComboPressureCount": 3,
        "preferredRange": 2.5,
        "recentHitCount": 0,
        "lastHitReactionType": "",
        "poiseRatio": 1.0,
        "isPoiseBroken": false,
        "hitReactionLockTime": 0.0,
        "revengeChance": 0.25
    },
    "groups": [
        {
            "name": "01 Interrupt And Target Search",
            "priority": 1000,
            "rules": [
                {
                    "name": "BlockedState",
                    "priority": 1000,
                    "when": [
                        { "condition": "IsBlockedEnemyState" }
                    ],
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                },
                {
                    "name": "NoTargetPatrolOrIdle",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget", "invert": true }
                    ],
                    "do": [
                        { "action": "PatrolOrIdle" }
                    ]
                }
            ]
        },
        {
            "name": "02 Emergency Reactions",
            "priority": 950,
            "rules": [
                {
                    "name": "PoiseBreakReaction",
                    "priority": 950,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPoiseBroken" },
                        { "condition": "CooldownReady", "value": "PoiseBreakReaction" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "dodgeChance", "action": "Transition", "state": "Dodge" },
                        { "weight": 0.30, "action": "Transition", "state": "Retreat" },
                        { "weightKey": "counterChance", "action": "Transition", "state": "Counter" }
                    ]
                },
                {
                    "name": "RevengeAfterHit",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "RecentlyHitByPlayer" },
                        { "condition": "CanIgnoreLightHit" },
                        { "condition": "CanRevengeAfterHit", "value": "1.5" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "revengeChance", "action": "Transition", "state": "Counter" },
                        { "weight": 0.20, "action": "Transition", "state": "Guard", "cooldownId": "ReactiveGuard", "cooldownDuration": 2.8 },
                        { "weight": 0.22, "action": "Transition", "state": "Flank" }
                    ]
                },
                {
                    "name": "RepeatedHitDisengage",
                    "priority": 860,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "RecentHitCountGreaterOrEqual", "value": "3" },
                        { "condition": "CooldownReady", "value": "RepeatedHitReaction" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "dodgeChance", "action": "Transition", "state": "Dodge" },
                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                        { "weight": 0.14, "action": "Transition", "state": "Guard", "cooldownId": "ReactiveGuard", "cooldownDuration": 2.8 }
                    ]
                },
                {
                    "name": "PlayerAttackReaction",
                    "priority": 840,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerAttacking" },
                        { "condition": "DistanceLessOrEqual", "value": "2.6" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "guardChance", "action": "Transition", "state": "Guard", "cooldownId": "ReadGuard", "cooldownDuration": 2.8 },
                        { "weightKey": "dodgeChance", "action": "Transition", "state": "Dodge" },
                        { "weight": 0.18, "action": "Transition", "state": "Retreat" },
                        { "weightKey": "counterChance", "action": "Transition", "state": "Counter" }
                    ]
                }
            ]
        },
        {
            "name": "03 Punish And Pressure",
            "priority": 850,
            "rules": [
                {
                    "name": "PunishPlayerRecovery",
                    "priority": 850,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerRecovering" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "punishRecoveryChance", "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.30, "action": "ExecuteAttack", "attackCategory": "Skill" },
                        { "weight": 0.12, "action": "ExecuteAttack", "attackCategory": "Basic" }
                    ]
                },
                {
                    "name": "PunishStaggeredPlayer",
                    "priority": 860,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerStaggered" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.60, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.30, "action": "ExecuteAttack", "attackCategory": "Skill" },
                        { "weight": 0.10, "action": "ExecuteAttack", "attackCategory": "Basic" }
                    ]
                },
                {
                    "name": "AntiGuardAttack",
                    "priority": 820,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerGuarding" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "antiGuardChance", "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.25, "action": "ExecuteAttack", "attackCategory": "Skill" },
                        { "weight": 0.15, "action": "Transition", "state": "Flank" }
                    ]
                },
                {
                    "name": "AntiDodgeFlank",
                    "priority": 810,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerDodgingFrequently" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CooldownReady", "value": "AntiDodge" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.50, "action": "Transition", "state": "Flank", "cooldownId": "AntiDodge", "cooldownDuration": 3.0 },
                        { "weight": 0.30, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.20, "action": "Transition", "state": "Circle", "cooldownId": "AntiDodge", "cooldownDuration": 3.0 }
                    ]
                }
            ]
        },
        {
            "name": "04 Target Combat",
            "priority": 800,
            "rules": [
                {
                    "name": "ComboResetJumpBack",
                    "priority": 835,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "ConsecutiveAttackCountGreaterOrEqual", "value": "2" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CooldownReady", "value": "ComboReset" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.45, "action": "Transition", "state": "JumpBack", "cooldownId": "ComboReset", "cooldownDuration": 3.2 },
                        { "weight": 0.14, "action": "Transition", "state": "Guard", "cooldownId": "ComboReset", "cooldownDuration": 2.8 },
                        { "weight": 0.20, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.12, "action": "Transition", "state": "Counter", "cooldownId": "ComboReset", "cooldownDuration": 2.4 }
                    ]
                },
                {
                    "name": "OpeningComboPressure",
                    "priority": 790,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "ConsecutiveAttackCountLessThan", "value": "2" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.55, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.25, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.12, "action": "Transition", "state": "Counter", "cooldownId": "PressureReposition", "cooldownDuration": 1.2 },
                        { "weight": 0.05, "action": "Transition", "state": "Guard", "cooldownId": "PressureGuard", "cooldownDuration": 2.8 }
                    ]
                },
                {
                    "name": "CombatBeatAttackOrReposition",
                    "priority": 760,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.35, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.22, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.10, "action": "ExecuteAttack", "attackCategory": "Skill" },
                        { "weight": 0.10, "action": "Transition", "state": "Circle", "cooldownId": "PressureReposition", "cooldownDuration": 1.8 },
                        { "weight": 0.12, "action": "Transition", "state": "Flank", "cooldownId": "PressureReposition", "cooldownDuration": 1.8 },
                        { "weight": 0.08, "action": "Transition", "state": "Guard", "cooldownId": "PressureGuard", "cooldownDuration": 2.8 }
                    ]
                }
            ]
        },
        {
            "name": "05 Close Range Footwork",
            "priority": 700,
            "rules": [
                {
                    "name": "CloseRangeFootwork",
                    "priority": 740,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "minCombatDistance" },
                        { "condition": "CooldownReady", "value": "CloseFootwork" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.18, "action": "Transition", "state": "Circle", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 },
                        { "weight": 0.30, "action": "Transition", "state": "Flank", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 },
                        { "weight": 0.16, "action": "Transition", "state": "Guard", "cooldownId": "CloseGuard", "cooldownDuration": 2.8 },
                        { "weight": 0.22, "action": "Transition", "state": "Counter", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 }
                    ]
                },
                {
                    "name": "RetreatPointBlank",
                    "priority": 720,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" },
                        { "condition": "CooldownReady", "value": "CloseRetreat" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.36, "action": "Transition", "state": "JumpBack", "cooldownId": "CloseRetreat", "cooldownDuration": 2.6 },
                        { "weight": 0.22, "action": "Transition", "state": "Retreat", "cooldownId": "CloseRetreat", "cooldownDuration": 2.0 },
                        { "weight": 0.28, "action": "Transition", "state": "Dodge", "cooldownId": "CloseRetreat", "cooldownDuration": 2.0 },
                        { "weight": 0.14, "action": "Transition", "state": "Flank", "cooldownId": "CloseRetreat", "cooldownDuration": 2.0 }
                    ]
                }
            ]
        },
        {
            "name": "06 Positioning",
            "priority": 600,
            "rules": [
                {
                    "name": "ApproachOrCircle",
                    "priority": 620,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.65, "action": "Transition", "state": "Chase" },
                        { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" }
                    ]
                },
                {
                    "name": "WaitForOpening",
                    "priority": 600,
                    "when": [
                        { "condition": "HasTarget" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Idle" }
                    ]
                }
            ]
        }
    ],
    "rules": []
}
