var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||s.isDirty||!s.path.Contains("VillageConnectionR1"))throw new Exception("검토 상태");
var t=Terrain.activeTerrain;var d=t.terrainData;var src=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/LakeVisualV2/Terrain.asset");
var all=s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var protectedObjects=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&new[]{"SceneEntityId","SceneArrivalPoint","PortalActor","FlowGraphTriggerVolume"}.Contains(c.GetType().Name)).ToArray();
var ground=protectedObjects.Select(c=>new{c.name,delta=t.SampleHeight(c.transform.position)-src.GetInterpolatedHeight(c.transform.position.x/2400,(c.transform.position.z+700)/2800)}).Where(v=>Mathf.Abs(v.delta)>.02f).ToArray();
var points=new[]{new Vector3(1082,0,400),new Vector3(1048,0,408),new Vector3(1049,0,420),new Vector3(1067,0,480),new Vector3(1108,0,484),new Vector3(1085,0,559),new Vector3(1067,0,615),new Vector3(1067,0,710)};
var routes=new List<string>();for(int i=0;i<points.Length-1;i++)for(int reverse=0;reverse<2;reverse++){var p=points[reverse==0?i:i+1];var q=points[reverse==0?i+1:i];p.y=t.SampleHeight(p);q.y=t.SampleHeight(q);UnityEngine.AI.NavMeshHit a,b;if(!UnityEngine.AI.NavMesh.SamplePosition(p,out a,3,-1)||!UnityEngine.AI.NavMesh.SamplePosition(q,out b,3,-1)){routes.Add(i+"/"+reverse+" NoSample");continue;}var path=new UnityEngine.AI.NavMeshPath();UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,-1,path);routes.Add(i+"/"+reverse+" "+path.status);}
var h=d.GetHeights(0,0,d.heightmapResolution,d.heightmapResolution);var original=src.GetHeights(0,0,src.heightmapResolution,src.heightmapResolution);int changed=0,outside=0;float maxDelta=0;for(int z=0;z<h.GetLength(0);z++)for(int x=0;x<h.GetLength(1);x++){float delta=Mathf.Abs(h[z,x]-original[z,x])*400;if(delta<.001f)continue;changed++;maxDelta=Mathf.Max(maxDelta,delta);float wx=x*2400f/(h.GetLength(1)-1),wz=-700+z*2800f/(h.GetLength(0)-1);if(wx<1034||wx>1088||wz<393||wz>421)outside++;}
var result=new{scene=s.path,dirty=s.isDirty,compileFailed=EditorUtility.scriptCompilationFailed,missingScripts=all.Sum(q=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(q.gameObject)),protectedCount=protectedObjects.Length,protectedGroundChanges=ground,heightChanges=changed,heightOutsideScope=outside,maxHeightDelta=maxDelta,routes=routes.ToArray(),terrain=AssetDatabase.GetAssetPath(d),navigation=AssetDatabase.GetAssetPath(GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>().navMeshData),scope="Editor 데이터 및 양방향 NavMesh 계산. 실제 TPS·성능·저장 복원 대기"};
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(v=>v!=null);var text=(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result});System.IO.File.WriteAllText("output/VillageConnectionR1/final-validation.json",text);return result;
