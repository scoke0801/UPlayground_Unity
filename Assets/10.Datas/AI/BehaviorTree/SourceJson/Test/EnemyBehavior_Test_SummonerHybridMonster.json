{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_SummonerHybridMonster",
    "displayName": "Test Summoner Hybrid Monster",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_lich.asset",
    "blackboard": {
        "tickInterval": 0.1,
        "enablePatrol": true,
        "optimalCombatDistance": 5.5,
        "minCombatDistance": 2.0,
        "personalSpaceDistance": 1.1,
        "guardChance": 0.15,
        "retreatChance": 0.35,
        "circleWeight": 1.0
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "NoTarget",
            "priority": 900,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "PatrolOrIdle" }
            ]
        },
        {
            "name": "MeleeEmergencyAttack",
            "priority": 840,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "1.6" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "RetreatAfterMeleeRange",
            "priority": 800,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "SummonSkillWindow",
            "priority": 760,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceGreater", "value": "4.0" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "ProjectileSkillWindow",
            "priority": 720,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "8.0" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "ApproachCastingRange",
            "priority": 500,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceGreater", "value": "8.0" }
            ],
            "do": [
                { "action": "Transition", "state": "Chase" }
            ]
        },
        {
            "name": "CastingIdle",
            "priority": 100,
            "select": "WeightedRandom",
            "choices": [
                { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" },
                { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                { "weightKey": "guardChance", "action": "Transition", "state": "Guard" }
            ]
        }
    ]
}
