{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Example_GroundMelee",
    "displayName": "Example Ground Melee",
    "actorKind": "Ground",
    "sourceBehaviorSo": "",
    "blackboard": {
        "tickInterval": 0.08,
        "enablePatrol": true,
        "optimalCombatDistance": 2.4,
        "minCombatDistance": 1.2,
        "personalSpaceDistance": 0.85,
        "preferredRange": 2.4,
        "aggression": 0.6,
        "reactionChance": 0.5,
        "counterChance": 0.35,
        "guardChance": 0.3,
        "dodgeChance": 0.3,
        "retreatChance": 0.18,
        "punishRecoveryChance": 0.6,
        "antiGuardChance": 0.45,
        "revengeChance": 0.35,
        "circleWeight": 0.3,
        "maxComboPressureCount": 3,
        "minRetreatCooldown": 2.0
    },
    "groups": [
        {
            "name": "00 Survival And Interrupt",
            "priority": 1000,
            "rules": [
                {
                    "name": "BlockedStateKeep",
                    "priority": 1000,
                    "when": [
                        { "condition": "IsBlockedEnemyState" }
                    ],
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                },
                {
                    "name": "NoTargetPatrol",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget", "invert": true }
                    ],
                    "do": [
                        { "action": "PatrolOrIdle" }
                    ]
                }
            ]
        },
        {
            "name": "10 Emergency Reactions",
            "priority": 960,
            "when": [
                { "condition": "HasTarget" }
            ],
            "rules": [
                {
                    "name": "PoiseBreakEscape",
                    "priority": 960,
                    "when": [
                        { "condition": "IsPoiseBroken" },
                        { "condition": "CooldownReady", "value": "PoiseBreakReaction" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.6, "action": "RequestAction", "intent": "Evade", "style": "JumpBack", "cooldownId": "PoiseBreakReaction", "cooldownDuration": 2.4 },
                        { "weight": 0.4, "action": "RequestAction", "intent": "Retreat", "cooldownId": "PoiseBreakReaction", "cooldownDuration": 2.4 }
                    ]
                },
                {
                    "name": "RepeatedHitMakeSpace",
                    "priority": 940,
                    "when": [
                        { "condition": "RecentHitCountGreaterOrEqual", "value": "5" },
                        { "condition": "CooldownReady", "value": "RepeatedHitReaction" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Defend", "style": "Guard", "cooldownId": "RepeatedHitReaction", "cooldownDuration": 3.0 }
                    ]
                }
            ]
        },
        {
            "name": "20 Punish Windows",
            "priority": 935,
            "when": [
                { "condition": "HasTarget" }
            ],
            "rules": [
                {
                    "name": "PunishStagger",
                    "priority": 935,
                    "when": [
                        { "condition": "IsPlayerStaggered" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "ExecuteAttack", "attackCategory": "Heavy" }
                    ]
                },
                {
                    "name": "PunishRecovery",
                    "priority": 930,
                    "when": [
                        { "condition": "IsPlayerRecovering" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.55, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.45, "action": "ExecuteAttack", "attackCategory": "Basic" }
                    ]
                }
            ]
        },
        {
            "name": "30 Player Read Reactions",
            "priority": 910,
            "when": [
                { "condition": "HasTarget" }
            ],
            "rules": [
                {
                    "name": "FrequentAttackCounter",
                    "priority": 910,
                    "when": [
                        { "condition": "IsPlayerAttackingFrequently" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CooldownReady", "value": "FrequentAttackRead" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.6, "action": "RequestAction", "intent": "Counter", "cooldownId": "FrequentAttackRead", "cooldownDuration": 2.0 },
                        { "weight": 0.4, "action": "RequestAction", "intent": "Defend", "style": "Guard", "cooldownId": "FrequentAttackRead", "cooldownDuration": 2.0 }
                    ]
                }
            ]
        },
        {
            "name": "40 Execute Selected Intent",
            "priority": 880,
            "when": [
                { "condition": "HasTarget" }
            ],
            "rules": [
                {
                    "name": "IntentPunish",
                    "priority": 880,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Punish" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "ExecuteAttack", "attackCategory": "Heavy" }
                    ]
                },
                {
                    "name": "IntentAttack",
                    "priority": 875,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Attack" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.6, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.4, "action": "ExecuteAttack", "attackCategory": "Heavy" }
                    ]
                },
                {
                    "name": "IntentAttackApproach",
                    "priority": 872,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Attack" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Chase" }
                    ]
                },
                {
                    "name": "IntentCounter",
                    "priority": 870,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Counter" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CooldownReady", "value": "IntentCounter" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Counter", "cooldownId": "IntentCounter", "cooldownDuration": 1.8 }
                    ]
                },
                {
                    "name": "IntentPressure",
                    "priority": 865,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Pressure" },
                        { "condition": "CooldownReady", "value": "IntentPressure" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.55, "action": "RequestAction", "intent": "Pressure", "style": "Flank", "cooldownId": "IntentPressure", "cooldownDuration": 1.6 },
                        { "weight": 0.45, "action": "RequestAction", "intent": "KeepDistance", "style": "Circle", "cooldownId": "IntentPressure", "cooldownDuration": 1.6 }
                    ]
                },
                {
                    "name": "IntentKeepDistance",
                    "priority": 860,
                    "when": [
                        { "condition": "SelectedIntent", "value": "KeepDistance" },
                        { "condition": "CooldownReady", "value": "IntentKeepDistance" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "KeepDistance", "style": "Circle", "cooldownId": "IntentKeepDistance", "cooldownDuration": 1.8 }
                    ]
                },
                {
                    "name": "IntentDefend",
                    "priority": 855,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Defend" },
                        { "condition": "CooldownReady", "value": "IntentDefend" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Defend", "style": "Guard", "cooldownId": "IntentDefend", "cooldownDuration": 2.6 }
                    ]
                },
                {
                    "name": "IntentRetreat",
                    "priority": 850,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Retreat" },
                        { "condition": "CooldownReady", "value": "IntentRetreat" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.6, "action": "RequestAction", "intent": "Evade", "style": "JumpBack", "cooldownId": "IntentRetreat", "cooldownDuration": 2.4 },
                        { "weight": 0.4, "action": "RequestAction", "intent": "Retreat", "cooldownId": "IntentRetreat", "cooldownDuration": 2.4 }
                    ]
                },
                {
                    "name": "IntentChase",
                    "priority": 845,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Chase" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Chase" }
                    ]
                },
                {
                    "name": "IntentRecover",
                    "priority": 840,
                    "when": [
                        { "condition": "SelectedIntent", "value": "Recover" },
                        { "condition": "CooldownReady", "value": "IntentRecover" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Retreat", "cooldownId": "IntentRecover", "cooldownDuration": 2.8 }
                    ]
                }
            ]
        },
        {
            "name": "50 Default Combat Rhythm",
            "priority": 820,
            "when": [
                { "condition": "HasTarget" }
            ],
            "rules": [
                {
                    "name": "RhythmApproach",
                    "priority": 820,
                    "when": [
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" },
                        { "condition": "ActionDelayElapsed" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "Chase" }
                    ]
                },
                {
                    "name": "RhythmCombo",
                    "priority": 816,
                    "when": [
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "ConsecutiveAttackCountLessThan", "value": "3" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.6, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.4, "action": "ExecuteAttack", "attackCategory": "Heavy" }
                    ]
                },
                {
                    "name": "RhythmComboReset",
                    "priority": 812,
                    "when": [
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "ConsecutiveAttackCountGreaterOrEqual", "value": "3" },
                        { "condition": "CooldownReady", "value": "ComboReset" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "KeepDistance", "style": "Step", "cooldownId": "ComboReset", "cooldownDuration": 1.8 }
                    ]
                },
                {
                    "name": "RhythmTooClose",
                    "priority": 808,
                    "when": [
                        { "condition": "DistanceLessOrEqual", "value": "minCombatDistance" }
                    ],
                    "do": [
                        { "action": "RequestAction", "intent": "KeepDistance", "style": "Circle" }
                    ]
                },
                {
                    "name": "RhythmIdle",
                    "priority": 800,
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                }
            ]
        }
    ]
}
