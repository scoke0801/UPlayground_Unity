var exempt=(Dictionary<string,object>)read(plan["navigationPlacementExemption"].ToString(),typeof(Dictionary<string,object>));var exemptCenter=(float[])read(exempt["centerXZ"].ToString(),typeof(float[]));var exemptSize=(float[])read(exempt["sizeXZ"].ToString(),typeof(float[]));
var exemptVolumes=nav.Where(v=>{var c=v.transform.TransformPoint(v.center);var s=Vector3.Scale(v.size,v.transform.lossyScale);return Mathf.Abs(c.x-exemptCenter[0])<.001f&&Mathf.Abs(c.z-exemptCenter[1])<.001f&&Mathf.Abs(s.x-exemptSize[0])<.001f&&Mathf.Abs(s.z-exemptSize[1])<.001f&&Quaternion.Angle(v.transform.rotation,Quaternion.identity)<.001f;}).ToArray();if(exemptVolumes.Length!=1)throw new Exception("도시 open-area 정확 단일 일치 실패");
