{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Boss_Bokusei_PhaseDuel",
    "displayName": "Boss Bokusei Phase Duel",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_Bokusei.asset",
    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": false,
        "optimalCombatDistance": 2.6,
        "minCombatDistance": 1.2,
        "personalSpaceDistance": 0.75,
        "guardChance": 0.2,
        "retreatChance": 0.12,
        "circleWeight": 1.0
    },
    "groups": [
        {
            "name": "01 Interrupt And Acquire",
            "priority": 1000,
            "rules": [
                {
                    "name": "BlockedState",
                    "priority": 1000,
                    "when": [
                        { "condition": "IsBlockedEnemyState" }
                    ],
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                },
                {
                    "name": "NoTarget",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget", "invert": true }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Idle" }
                    ]
                }
            ]
        },
        {
            "name": "02 Berserk Phase",
            "priority": 900,
            "rules": [
                {
                    "name": "BerserkPhaseReaction",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "1" },
                        { "condition": "IsPlayerAttacking" },
                        { "condition": "DistanceLessOrEqual", "value": "1.8" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.55, "action": "Transition", "state": "Dodge" },
                        { "weight": 0.30, "action": "Transition", "state": "Counter" },
                        { "weight": 0.15, "action": "Transition", "state": "Retreat" }
                    ]
                },
                {
                    "name": "BerserkPhaseCombo",
                    "priority": 850,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "1" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "3.2" },
                        { "condition": "CanUseSkill" }
                    ],
                    "do": [
                        { "action": "RequestAttackSlot" },
                        { "action": "ExecuteAttack" }
                    ]
                }
            ]
        },
        {
            "name": "03 Ground Combat",
            "priority": 800,
            "rules": [
                {
                    "name": "AggressivePhaseCharge",
                    "priority": 820,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "0" },
                        { "condition": "DistanceGreater", "value": "2.8" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Charge" }
                    ]
                },
                {
                    "name": "GuardBreakResponse",
                    "priority": 780,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerGuarding" },
                        { "condition": "DistanceLessOrEqual", "value": "2.4" },
                        { "condition": "CanUseSkill" }
                    ],
                    "do": [
                        { "action": "RequestAttackSlot" },
                        { "action": "ExecuteAttack" }
                    ]
                },
                {
                    "name": "StandardBossAttack",
                    "priority": 720,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "2.6" },
                        { "condition": "CanUseSkill" }
                    ],
                    "do": [
                        { "action": "RequestAttackSlot" },
                        { "action": "ExecuteAttack" }
                    ]
                }
            ]
        },
        {
            "name": "04 Positioning",
            "priority": 600,
            "rules": [
                {
                    "name": "TooCloseSpacing",
                    "priority": 620,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Retreat" }
                    ]
                },
                {
                    "name": "Approach",
                    "priority": 420,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Chase" }
                    ]
                },
                {
                    "name": "BossDuelIdle",
                    "priority": 100,
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 1.2, "action": "Transition", "state": "Flank" },
                        { "weightKey": "guardChance", "action": "Transition", "state": "Guard" },
                        { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" },
                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" }
                    ]
                }
            ]
        }
    ],
    "rules": []
}
