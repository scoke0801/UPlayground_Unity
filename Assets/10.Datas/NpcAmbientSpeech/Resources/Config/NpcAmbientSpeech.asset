%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 332abaab2ed4fab45b37b63f6a07ccbc, type: 3}
  m_Name: NpcAmbientSpeech
  m_EditorClassIdentifier: UPlayGround.Data::UPlayGround.Data.Actor.NPC.NpcAmbientSpeechSO
  voices:
  - id: everyday
    direction: "\uC18C\uBC15\uD55C \uCC28\uB9BC\uC758 \uB2F4\uBC31\uD55C \uC8FC\uBBFC.
      \uAC74\uB9DD\uC99D\uC774 \uC788\uACE0 \uC791\uC740 \uC0B4\uB9BC\uACFC \uC0AC\uB78C
      \uAD6C\uACBD\uC5D0 \uAD00\uC2EC\uC774 \uB9CE\uB2E4. \uD63C\uC7A3\uB9D0\uC740
      \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uBC18\uB9D0, \uD6C8\uACC4\uB098 \uC778\uC0DD
      \uACA9\uC5B8\uC740 \uC4F0\uC9C0 \uC54A\uB294\uB2E4."
    lines:
    - id: everyday.00.0
      topic: lost
      text: "\uBD84\uBA85 \uCC59\uACBC\uB294\uB370. \uC5B4\uB514\uB2E4 \uB480\uC9C0?"
      activities: 9
      periods: 15
    - id: everyday.00.1
      topic: lost
      text: "\uC544, \uC8FC\uBA38\uB2C8\uB97C \uBC14\uAFD4 \uC785\uC5C8\uAD6C\uB098."
      activities: 9
      periods: 15
    - id: everyday.00.2
      topic: lost
      text: "\uBB58 \uC0AC\uB7EC \uB098\uC654\uB354\uB77C."
      activities: 9
      periods: 15
    - id: everyday.00.3
      topic: lost
      text: "\uC9D1\uC5D0 \uB450\uACE0 \uC628 \uAC74 \uC544\uB2C8\uACA0\uC9C0?"
      activities: 9
      periods: 15
    - id: everyday.00.4
      topic: lost
      text: "\uB9E4\uB4ED\uC744 \uBB36\uC5B4 \uB1A8\uB294\uB370\uB3C4 \uAE4C\uBA39\uB124."
      activities: 9
      periods: 15
    - id: everyday.00.5
      topic: lost
      text: "\uAC70\uAE30 \uB450\uBA74 \uBABB \uCC3E\uB294\uB2E4\uACE0 \uD588\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.00.6
      topic: lost
      text: "\uB450 \uAC1C\uC600\uB098, \uC138 \uAC1C\uC600\uB098."
      activities: 9
      periods: 15
    - id: everyday.00.7
      topic: lost
      text: "\uD55C\uCC38 \uCC3E\uC558\uB354\uB2C8 \uC190\uC5D0 \uC950\uACE0 \uC788\uC5C8\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.01.0
      topic: food
      text: "\uBE75 \uB05D\uBD80\uBD84\uB9CC \uB530\uB85C \uD314\uBA74 \uC88B\uACA0\uB2E4."
      activities: 9
      periods: 15
    - id: everyday.01.1
      topic: food
      text: "\uAD6D\uC5D0 \uC18C\uAE08\uC744 \uB450 \uBC88 \uB123\uC5C8\uB098 \uBD10."
      activities: 9
      periods: 15
    - id: everyday.01.2
      topic: food
      text: "\uBC30\uAC00 \uACE0\uD508 \uAC74\uC9C0 \uADF8\uB0E5 \uC2EC\uC2EC\uD55C
        \uAC74\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.01.3
      topic: food
      text: "\uC5B4\uC81C \uB0A8\uAE34 \uAC70 \uB204\uAC00 \uBA39\uC5C8\uC744\uAE4C."
      activities: 9
      periods: 15
    - id: everyday.01.4
      topic: food
      text: "\uB9D0\uB9B0 \uACFC\uC77C\uC740 \uBA39\uAE30 \uC2DC\uC791\uD558\uBA74
        \uB05D\uC774 \uC5C6\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.01.5
      topic: food
      text: "\uB2E4\uC74C\uC5D4 \uC791\uC740 \uADF8\uB987\uC5D0 \uB2F4\uC544\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.01.6
      topic: food
      text: "\uBE75\uC740 \uBD84\uBA85 \uB098\uB220 \uBA39\uC73C\uB824\uACE0 \uC0C0\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.01.7
      topic: food
      text: "\uB2EC\uAC40 \uD558\uB098\uB85C\uB294 \uAC04\uC5D0 \uAE30\uBCC4\uB3C4
        \uC548 \uAC00."
      activities: 9
      periods: 15
    - id: everyday.02.0
      topic: expenses
      text: "\uC2F8\uB2E4\uACE0 \uB450 \uAC1C \uC0AC\uBA74 \uB3C8\uC774 \uB354 \uB4E4\uC796\uC544."
      activities: 9
      periods: 15
    - id: everyday.02.1
      topic: expenses
      text: "\uC794\uB3C8\uC744 \uC5B4\uB514\uC5D0 \uB123\uC5C8\uB354\uB77C."
      activities: 9
      periods: 15
    - id: everyday.02.2
      topic: expenses
      text: "\uC9C0\uB09C\uBC88\uBCF4\uB2E4 \uC870\uAE08 \uBE44\uC2F8\uC84C\uB358\uB370."
      activities: 9
      periods: 15
    - id: everyday.02.3
      topic: expenses
      text: "\uAE4E\uC544 \uB2EC\uB77C\uB294 \uB9D0\uC774 \uC65C \uC774\uB807\uAC8C
        \uC5B4\uB835\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.02.4
      topic: expenses
      text: "\uC0B4 \uAC83\uB9CC \uC0AC\uACE0 \uC624\uB824\uB358 \uAC70\uC600\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.02.5
      topic: expenses
      text: "\uC774\uAC74 \uD544\uC694\uD55C \uAC70\uACE0, \uC800\uAC74 \uADF8\uB0E5
        \uAC16\uACE0 \uC2F6\uC740 \uAC70."
      activities: 9
      periods: 15
    - id: everyday.02.6
      topic: expenses
      text: "\uB3D9\uC804\uC740 \uBA87 \uAC1C \uC5C6\uB294\uB370 \uC65C \uC774\uB9AC
        \uBB34\uAC81\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.02.7
      topic: expenses
      text: "\uC0AC\uB294 \uAC83\uBCF4\uB2E4 \uACE0\uB974\uB294 \uB370 \uB354 \uC624\uB798
        \uAC78\uB824."
      activities: 9
      periods: 15
    - id: everyday.03.0
      topic: people
      text: "\uC544\uAE4C \uADF8 \uC0AC\uB78C \uC774\uB984\uC774 \uBB50\uC600\uB354\uB77C."
      activities: 9
      periods: 15
    - id: everyday.03.1
      topic: people
      text: "\uC778\uC0AC\uD558\uB824\uB2C8\uAE4C \uBC8C\uC368 \uAC00 \uBC84\uB838\uB124."
      activities: 9
      periods: 15
    - id: everyday.03.2
      topic: people
      text: "\uB2EE\uC740 \uC0AC\uB78C\uC778\uAC00? \uAD1C\uD788 \uC544\uB294 \uCC99\uD560
        \uBED4\uD588\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.03.3
      topic: people
      text: "\uBA3C\uC800 \uC6C3\uC5C8\uC5B4\uC57C \uD588\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.03.4
      topic: people
      text: "\uD560 \uB9D0\uC740 \uAF2D \uD5E4\uC5B4\uC9C0\uACE0 \uB098\uC11C \uC0DD\uAC01\uB098."
      activities: 9
      periods: 15
    - id: everyday.03.5
      topic: people
      text: "\uBAA9\uC18C\uB9AC\uAC00 \uB0AF\uC775\uC5C8\uB294\uB370 \uB204\uAD70\uC9C0
        \uBAA8\uB974\uACA0\uB124."
      activities: 9
      periods: 15
    - id: everyday.03.6
      topic: people
      text: "\uBCC4\uB9D0 \uC544\uB2CC\uB370 \uC790\uAFB8 \uC6C3\uC74C\uC774 \uB098\uB124."
      activities: 9
      periods: 15
    - id: everyday.03.7
      topic: people
      text: "\uB9D0 \uC548 \uD574\uB3C4 \uC54C\uC544\uC904 \uC904 \uC54C\uC558\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.04.0
      topic: animals
      text: "\uACE0\uC591\uC774\uB294 \uBD88\uB7EC\uB3C4 \uBABB \uB4E4\uC740 \uCC99\uD558\uB354\uB77C."
      activities: 9
      periods: 15
    - id: everyday.04.1
      topic: animals
      text: "\uBE75 \uBD80\uC2A4\uB7EC\uAE30\uB97C \uB0A8\uACA8 \uB193\uB294 \uAC8C
        \uC544\uB2C8\uC5C8\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.04.2
      topic: animals
      text: "\uC774\uB984\uC744 \uBD99\uC774\uBA74 \uB354 \uBCF4\uACE0 \uC2F6\uC5B4\uC9C0\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.04.3
      topic: animals
      text: "\uAC15\uC544\uC9C0 \uBC1C\uC740 \uC65C \uADF8\uB807\uAC8C \uBE68\uB9AC
        \uC790\uB784\uAE4C."
      activities: 9
      periods: 15
    - id: everyday.04.4
      topic: animals
      text: "\uC0C8\uD55C\uD14C\uB294 \uB0B4\uAC00 \uB290\uB9AC\uAC8C \uBCF4\uC774\uACA0\uC9C0?"
      activities: 9
      periods: 15
    - id: everyday.04.5
      topic: animals
      text: "\uBC1C\uC790\uAD6D\uC740 \uC791\uC740\uB370 \uD759\uC740 \uC794\uB729
        \uBB3B\uD600 \uB1A8\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.04.6
      topic: animals
      text: "\uB208\uC744 \uB9C8\uC8FC\uCE58\uBA74 \uB610 \uBA39\uC744 \uAC78 \uB2EC\uB77C\uACA0\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.04.7
      topic: animals
      text: "\uC0AC\uB78C\uBCF4\uB2E4 \uBA3C\uC800 \uC9D1\uC744 \uCC28\uC9C0\uD558\uB354\uB77C\uB2C8\uAE4C."
      activities: 9
      periods: 15
    - id: everyday.05.0
      topic: clothes
      text: "\uC774 \uC8FC\uBA38\uB2C8\uB294 \uC190\uC774 \uB05D\uAE4C\uC9C0 \uC548
        \uB4E4\uC5B4\uAC00."
      activities: 9
      periods: 15
    - id: everyday.05.1
      topic: clothes
      text: "\uC637\uAE43\uC774 \uD55C\uCABD\uB9CC \uC790\uAFB8 \uC811\uD788\uB124."
      activities: 9
      periods: 15
    - id: everyday.05.2
      topic: clothes
      text: "\uB2E8\uCD94\uB97C \uD558\uB098\uC529 \uBC00\uB824 \uCC44\uC6E0\uAD6C\uB098."
      activities: 9
      periods: 15
    - id: everyday.05.3
      topic: clothes
      text: "\uC774 \uC5BC\uB8E9\uC740 \uC5B8\uC81C \uBB3B\uC740 \uAC70\uC57C."
      activities: 9
      periods: 15
    - id: everyday.05.4
      topic: clothes
      text: "\uC0C8 \uC591\uB9D0\uBCF4\uB2E4 \uD5CC \uC591\uB9D0\uC774 \uB354 \uD3B8\uD574."
      activities: 9
      periods: 15
    - id: everyday.05.5
      topic: clothes
      text: "\uD5C8\uB9AC\uB048\uC744 \uB108\uBB34 \uC138\uAC8C \uBB36\uC5C8\uB098."
      activities: 9
      periods: 15
    - id: everyday.05.6
      topic: clothes
      text: "\uC791\uC740 \uAD6C\uBA4D\uC77C \uB54C \uAFF0\uB9F8\uC5B4\uC57C \uD588\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.05.7
      topic: clothes
      text: "\uC190\uBC14\uB290\uC9C8\uD55C \uB370\uB9CC \uBCF4\uBA74 \uC6C3\uC74C\uC774
        \uB098."
      activities: 9
      periods: 15
    - id: everyday.06.0
      topic: habits
      text: "\uBB38\uC744 \uC7A0\uAC14\uB098? \uC7A0\uADF8\uAE34 \uD588\uB294\uB370."
      activities: 9
      periods: 15
    - id: everyday.06.1
      topic: habits
      text: "\uD63C\uC7A3\uB9D0\uC774 \uC790\uAFB8 \uC785 \uBC16\uC73C\uB85C \uB098\uC624\uB124."
      activities: 9
      periods: 15
    - id: everyday.06.2
      topic: habits
      text: "\uD55C \uBC88 \uC2DC\uC791\uD558\uBA74 \uB05D\uAE4C\uC9C0 \uC138\uAC8C
        \uB3FC."
      activities: 9
      periods: 15
    - id: everyday.06.3
      topic: habits
      text: "\uC67C\uCABD\uBD80\uD130 \uD558\uB294 \uBC84\uB987\uC740 \uC548 \uACE0\uCCD0\uC9C0\uB124."
      activities: 9
      periods: 15
    - id: everyday.06.4
      topic: habits
      text: "\uC0DD\uAC01\uD560\uC218\uB85D \uB354 \uD5F7\uAC08\uB9AC\uB294 \uAC83
        \uAC19\uC544."
      activities: 9
      periods: 15
    - id: everyday.06.5
      topic: habits
      text: "\uC544\uBB34\uB3C4 \uC548 \uBCF4\uB294\uB370 \uAD1C\uD788 \uC790\uC138\uB97C
        \uACE0\uCE58\uB124."
      activities: 9
      periods: 15
    - id: everyday.06.6
      topic: habits
      text: "\uD55C\uC228 \uC26C\uBA74 \uBC30\uACE0\uD30C\uC9C4\uB2E4\uB358\uB370."
      activities: 9
      periods: 15
    - id: everyday.06.7
      topic: habits
      text: "\uC26C\uC6B4 \uB9D0\uB3C4 \uB9C9\uC0C1 \uD558\uB824\uBA74 \uAF2C\uC5EC."
      activities: 9
      periods: 15
    - id: everyday.07.0
      topic: plans
      text: "\uC9D1\uC5D0 \uAC00\uBA74 \uC81C\uC77C \uBA3C\uC800 \uBB3C\uBD80\uD130
        \uB9C8\uC154\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: everyday.07.1
      topic: plans
      text: "\uBC14\uAD6C\uB2C8 \uC190\uC7A1\uC774 \uACE0\uCE58\uB294 \uAC78 \uB610
        \uBBF8\uB918\uB124."
      activities: 9
      periods: 15
    - id: everyday.07.2
      topic: plans
      text: "\uB2E4\uC74C\uC5D0 \uBCF4\uC790\uB294 \uB9D0\uB9CC \uBA87 \uBC88\uC9F8\uB354\uB77C."
      activities: 9
      periods: 15
    - id: everyday.07.3
      topic: plans
      text: "\uB0A8\uB294 \uCC9C\uC73C\uB85C \uC791\uC740 \uC8FC\uBA38\uB2C8\uB098
        \uB9CC\uB4E4\uAE4C."
      activities: 9
      periods: 15
    - id: everyday.07.4
      topic: plans
      text: "\uD55C \uBC88\uCBE4\uC740 \uB2E4\uB978 \uC0C9\uB3C4 \uACE8\uB77C \uBCF4\uACE0
        \uC2F6\uC5B4."
      activities: 9
      periods: 15
    - id: everyday.07.5
      topic: plans
      text: "\uC9C0\uB09C\uBC88\uC5D0 \uB4E4\uC740 \uB178\uB798\uB97C \uB2E4\uC2DC
        \uB4E3\uACE0 \uC2F6\uC740\uB370."
      activities: 9
      periods: 15
    - id: everyday.07.6
      topic: plans
      text: "\uAE00\uC528\uB97C \uC880 \uC54C\uC544\uBCF4\uAC8C \uC801\uC5B4 \uB458\uAC78."
      activities: 9
      periods: 15
    - id: everyday.07.7
      topic: plans
      text: "\uC624\uB298\uC740 \uB3CC\uC544\uAC00\uC11C \uBC1C\uBD80\uD130 \uC53B\uC5B4\uC57C\uACA0\uB2E4."
      activities: 9
      periods: 15
    - id: everyday.08.0
      topic: travel
      text: "\uC544\uAE4C \uADF8 \uAC08\uB9BC\uAE38\uC774 \uB354 \uAC00\uAE4C\uC6E0\uB098?"
      activities: 2
      periods: 15
    - id: everyday.08.1
      topic: travel
      text: "\uAC78\uC5B4 \uB098\uC624\uACE0 \uB098\uC11C\uC57C \uC0DD\uAC01\uB098\uB124."
      activities: 2
      periods: 15
    - id: everyday.08.2
      topic: travel
      text: "\uBA40\uB9AC\uC11C \uBCFC \uB54C\uB294 \uAC00\uAE4C\uC6CC \uBCF4\uC600\uB294\uB370."
      activities: 2
      periods: 15
    - id: everyday.08.3
      topic: travel
      text: "\uB2E4\uC74C \uBAA8\uD241\uC774\uAE4C\uC9C0\uB9CC \uAC78\uC5B4 \uBCF4\uC790."
      activities: 2
      periods: 15
    - id: everyday.08.4
      topic: travel
      text: "\uB3CC\uC544\uAC08 \uB54C\uB3C4 \uC774 \uAE38\uB85C \uAC00\uBA74 \uB418\uACA0\uC9C0."
      activities: 2
      periods: 15
    - id: everyday.08.5
      topic: travel
      text: "\uBE68\uB9AC \uAC77\uB2E4 \uBCF4\uBA74 \uAF2D \uBB58 \uB193\uACE0 \uC640."
      activities: 2
      periods: 15
    - id: everyday.08.6
      topic: travel
      text: "\uCC98\uC74C \uAC77\uB294 \uAE38\uB3C4 \uC5B4\uB514\uC11C \uBCF8 \uAC83
        \uAC19\uC544."
      activities: 2
      periods: 15
    - id: everyday.08.7
      topic: travel
      text: "\uC9D1 \uCABD\uC73C\uB85C \uAC00\uB294 \uBC1C\uAC78\uC74C\uC740 \uC548
        \uBB34\uAC81\uC9C0."
      activities: 2
      periods: 15
    - id: everyday.09.0
      topic: feet
      text: "\uC544, \uBC1C\uB4A4\uAFC8\uCE58\uAC00 \uC4F8\uB9AC\uB124."
      activities: 2
      periods: 15
    - id: everyday.09.1
      topic: feet
      text: "\uC2E0\uBC1C \uC548\uC5D0 \uBB50\uAC00 \uB4E4\uC5B4\uAC14\uB098?"
      activities: 2
      periods: 15
    - id: everyday.09.2
      topic: feet
      text: "\uC624\uB978\uBC1C\uB9CC \uC790\uAFB8 \uB048\uC774 \uD480\uB824."
      activities: 2
      periods: 15
    - id: everyday.09.3
      topic: feet
      text: "\uBCF4\uD3ED\uC744 \uB108\uBB34 \uD06C\uAC8C \uC7A1\uC558\uB098 \uBD10."
      activities: 2
      periods: 15
    - id: everyday.09.4
      topic: feet
      text: "\uC774 \uC2E0\uBC1C\uC740 \uAC77\uACE0 \uB098\uC11C\uC57C \uBCF8\uC0C9\uC774
        \uB098\uC640."
      activities: 2
      periods: 15
    - id: everyday.09.5
      topic: feet
      text: "\uBC1C\uC740 \uAC77\uB294\uB370 \uC0DD\uAC01\uC740 \uC790\uAFB8 \uB534
        \uB370 \uAC00\uB124."
      activities: 2
      periods: 15
    - id: everyday.09.6
      topic: feet
      text: "\uAC78\uC74C \uC218\uB97C \uC138\uB2E4\uAC00 \uB610 \uB193\uCCE4\uC5B4."
      activities: 2
      periods: 15
    - id: everyday.09.7
      topic: feet
