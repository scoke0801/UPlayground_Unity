if(Application.dataPath.Replace('\\','/')!="C:/UsingProject/UnityProject/UPlayground/Assets")throw new Exception("프로젝트 불일치");
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});var lease=(Dictionary<string,string>)jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock"),typeof(Dictionary<string,string>)});if(lease["owner"]!="B")throw new Exception("B 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/CloudridgeR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 B 필요");
var d=Terrain.activeTerrain.terrainData;var baseline=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/ThemeStudies/CloudridgeR1/BaselineTerrain.asset");
if(d.heightmapResolution!=baseline.heightmapResolution||d.size!=baseline.size||d.alphamapResolution!=baseline.alphamapResolution||d.detailResolution!=baseline.detailResolution)throw new Exception("해상도/크기 계약 변경");
Func<float,float,bool> ellipse=(x,z)=>Mathf.Pow((x-1260)/145,2)+Mathf.Pow((z-1300)/82,2)<1.0001f;
var heightRows=new List<float[]>();int outsideHeight=0;float maxHeight=0;
for(int start=0;start<d.heightmapResolution;start+=64){int count=Math.Min(64,d.heightmapResolution-start);var old=baseline.GetHeights(0,start,d.heightmapResolution,count);var next=d.GetHeights(0,start,d.heightmapResolution,count);for(int z=0;z<count;z++)for(int x=0;x<d.heightmapResolution;x++){if(old[z,x]==next[z,x])continue;float wx=x*d.size.x/(d.heightmapResolution-1),wz=-700+(z+start)*d.size.z/(d.heightmapResolution-1);heightRows.Add(new[]{x,z+start,old[z,x],next[z,x]});maxHeight=Mathf.Max(maxHeight,Mathf.Abs(next[z,x]-old[z,x])*d.size.y);if(!ellipse(wx,wz)&&!(wx>=1180&&wx<=1245&&wz>=1218&&wz<=1255))outsideHeight++;}}
System.IO.File.WriteAllText("output/CloudridgeR1/terrain-height-delta.json",json(new{schema="CloudridgeR1.height-delta.v1",coordinateSpace="normalized heightmap, world origin (0,0,-700), size (2400,400,2800)",columns=new[]{"x","z","before","after"},resolution=d.heightmapResolution,beforeAssetHash="88F76A3D1D5A59467D632BBFAEB4EAFF55D9572C9582AC526861C751FAEC57BB",rows=heightRows,merge="좌표계/해상도 및 before 값 충돌 검사 후 절대 after 적용. 단순 높이 덧셈 금지"}));
var surfaceRows=new List<object>();int outsideAlpha=0;float maxWeightError=0;
for(int start=0;start<d.alphamapHeight;start+=32){int count=Math.Min(32,d.alphamapHeight-start);var old=baseline.GetAlphamaps(0,start,d.alphamapWidth,count);var next=d.GetAlphamaps(0,start,d.alphamapWidth,count);for(int z=0;z<count;z++)for(int x=0;x<d.alphamapWidth;x++){bool changed=false;float sum=0;for(int l=0;l<d.alphamapLayers;l++){float before=l<baseline.alphamapLayers?old[z,x,l]:0;if(before!=next[z,x,l])changed=true;sum+=next[z,x,l];}maxWeightError=Mathf.Max(maxWeightError,Mathf.Abs(sum-1));if(!changed)continue;var a=new float[baseline.alphamapLayers];var b=new float[d.alphamapLayers];for(int l=0;l<a.Length;l++)a[l]=old[z,x,l];for(int l=0;l<b.Length;l++)b[l]=next[z,x,l];surfaceRows.Add(new{x,z=z+start,before=a,after=b});if(!ellipse(x*d.size.x/(d.alphamapWidth-1),-700+(z+start)*d.size.z/(d.alphamapHeight-1)))outsideAlpha++;}}
Func<UnityEngine.Object,string> guid=o=>AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(o));
System.IO.File.WriteAllText("output/CloudridgeR1/terrain-surface-delta.json",json(new{schema="CloudridgeR1.surface-delta.v1",coordinateSpace="alphamap grid; world x=x*2400/(resolution-1), z=-700+z*2800/(resolution-1)",resolution=d.alphamapResolution,beforeLayerGuids=baseline.terrainLayers.Select(l=>guid(l)).ToArray(),afterLayerGuids=d.terrainLayers.Select(l=>guid(l)).ToArray(),rows=surfaceRows,merge="레이어 GUID와 원본 셀 가중치를 대조. index만으로 병합 금지"}));
var details=new List<object>();int outsideDetail=0;var oldPrototypes=baseline.detailPrototypes;var newPrototypes=d.detailPrototypes;
for(int l=0;l<newPrototypes.Length;l++){string id=guid(newPrototypes[l].prototype);int oldIndex=Array.FindIndex(oldPrototypes,p=>guid(p.prototype)==id);var old=oldIndex<0?new int[d.detailHeight,d.detailWidth]:baseline.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,oldIndex);var next=d.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,l);var cells=new List<int[]>();for(int z=0;z<d.detailHeight;z++)for(int x=0;x<d.detailWidth;x++){if(old[z,x]==next[z,x])continue;cells.Add(new[]{x,z,old[z,x],next[z,x]});if(!ellipse((x+.5f)*d.size.x/d.detailWidth,-700+(z+.5f)*d.size.z/d.detailHeight))outsideDetail++;}if(cells.Count>0)details.Add(new{prototypeGuid=id,beforeIndex=oldIndex,afterIndex=l,columns=new[]{"x","z","before","after"},cells});}
System.IO.File.WriteAllText("output/CloudridgeR1/terrain-detail-delta.json",json(new{schema="CloudridgeR1.detail-delta.v1",resolution=d.detailResolution,coordinateSpace="detail cell center: world x=(x+.5)*2400/resolution,z=-700+(z+.5)*2800/resolution",scatterMode=d.detailScatterMode.ToString(),prototypes=details,merge="prototype GUID/설정과 셀 이전 개수 확인. 랜덤 개별 instance ID가 없는 Terrain detail 셀 계약",treeInstanceChanges=0}));
Func<DetailPrototype,object> prototypeContract=p=>{var values=new Dictionary<string,object>();foreach(var property in typeof(DetailPrototype).GetProperties(System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance)){if(!property.CanRead||property.GetIndexParameters().Length!=0)continue;var value=property.GetValue(p,null);if(value is UnityEngine.Object){var asset=value as UnityEngine.Object;values[property.Name]=new{path=AssetDatabase.GetAssetPath(asset),guid=guid(asset)};}else if(value is Color){var color=(Color)value;values[property.Name]=new[]{color.r,color.g,color.b,color.a};}else if(value==null||value is string||value.GetType().IsPrimitive)values[property.Name]=value;else if(value.GetType().IsEnum)values[property.Name]=value.ToString();}return values;};
System.IO.File.WriteAllText("output/CloudridgeR1/vegetation-prototype-contract.json",json(new{before=oldPrototypes.Select(prototypeContract).ToArray(),after=newPrototypes.Select(prototypeContract).ToArray(),merge="GUID와 모든 설정을 비교한 뒤 셀 delta 적용"}));
int holesChanged=0;for(int start=0;start<d.holesResolution;start+=64){int count=Math.Min(64,d.holesResolution-start);var a=baseline.GetHoles(0,start,d.holesResolution,count);var b=d.GetHoles(0,start,d.holesResolution,count);for(int z=0;z<count;z++)for(int x=0;x<d.holesResolution;x++)if(a[z,x]!=b[z,x])holesChanged++;}
var result=new{heightCells=heightRows.Count,maxHeightDelta=maxHeight,surfaceCells=surfaceRows.Count,detailPrototypeLayersChanged=details.Count,outsideHeight,outsideAlpha,outsideDetail,holesChanged,treesBefore=baseline.treeInstanceCount,treesAfter=d.treeInstanceCount,scatterModeBefore=baseline.detailScatterMode.ToString(),scatterModeAfter=d.detailScatterMode.ToString(),maxWeightError,scope="전체 height/alpha/detail/hole 배열을 기준 Terrain과 직접 비교. 모든 delta는 최종 직렬화 후 읽은 값"};System.IO.File.WriteAllText("output/CloudridgeR1/terrain-validation.json",json(result));return result;

