// A00의 후속 읽기 lease 이후에만 실행한다. SceneRegion/streaming 부재를 이름 필터만으로 판정하지 않는다.
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");if(!host.isLoaded||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("Host Edit Mode 필요");
Func<Transform,string> path=t=>{string s=t.name;while(t.parent!=null){t=t.parent;s=t.name+"/"+s;}return s;};var reference=new Rect(1061,471,168,163);
var controllers=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<MonoBehaviour>(true)).Where(c=>c!=null&&c.GetType().Name=="ContinuousWorldController").ToArray();var rows=new List<object>();
foreach(var controller in controllers){var serialized=new SerializedObject(controller);var regions=serialized.FindProperty("Regions");if(regions==null||!regions.isArray)throw new Exception("실제 Controller.Regions 직렬화 계약 확인 필요");var regionRows=new List<object>();for(int i=0;i<regions.arraySize;i++){var region=regions.GetArrayElementAtIndex(i);var rect=region.FindPropertyRelative("Bounds").rectValue;var offset=region.FindPropertyRelative("SourceOffset").vector3Value;regionRows.Add(new{index=i,mapId=region.FindPropertyRelative("MapId").stringValue,sceneKey=region.FindPropertyRelative("SceneKey").stringValue,sourceOffset=new[]{offset.x,offset.y,offset.z},sourceYaw=region.FindPropertyRelative("SourceYaw").floatValue,boundsXZ=new[]{rect.xMin,rect.yMin,rect.xMax,rect.yMax},overlapsExpandedReference=rect.Overlaps(reference)});}rows.Add(new{path=path(controller.transform),globalId=GlobalObjectId.GetGlobalObjectIdSlow(controller).ToString(),regions=regionRows,serialized=EditorJsonUtility.ToJson(controller)});}
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/WorldThemeProduction/RedTreeForest/controller-regions.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{rows}));return "readonly controllers="+controllers.Length+"; 실제 overlap 지역의 source/prefab content는 별도보호목록 확인";
