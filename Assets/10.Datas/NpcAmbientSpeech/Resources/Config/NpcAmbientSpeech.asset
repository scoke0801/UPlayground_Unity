      activities: 9
      periods: 15
    - id: scholarly.03.7
      topic: people
      text: "\uC9E7\uAC8C \uB9D0\uD558\uB824\uB2C8\uAE4C \uB354 \uC5B4\uB824\uC6CC\uC9C0\uB124\uC694."
