.up-panel-header {
    min-height: 50px;
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-3);
    padding-top: 7px;
    padding-bottom: 7px;
    flex-shrink: 0;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-panel-kicker {
    height: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--up-accent);
}

.up-panel-title {
    height: 20px;
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--up-text);
}

.up-motion-list-view,
.up-motion-inspector {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--up-bg-1);
}

.up-motion-list-search {
    height: 26px;
    margin: var(--up-space-2);
    margin-bottom: var(--up-space-1);
    flex-shrink: 0;
}

.up-motion-list {
    flex-grow: 1;
    min-height: 120px;
}

.up-motion-list-item {
    margin-left: var(--up-space-1);
    margin-right: var(--up-space-1);
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.32);
}

.up-motion-list-group {
    height: 28px;
    padding-top: 6px;
    -unity-font-style: bold;
    color: var(--up-text-dim);
    background-color: var(--up-bg-1);
}

.up-motion-list-row {
    min-height: 46px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 3px;
}

.up-motion-list-row-selected {
    border-left-width: 3px;
    border-left-color: var(--up-accent);
    background-color: var(--up-accent-soft);
}

.up-motion-list-item-title {
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-motion-list-item-subtitle {
    margin-top: 2px;
    font-size: var(--up-font-sm);
    color: var(--up-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-motion-list-add {
    height: 30px;
    margin: var(--up-space-2);
    -unity-font-style: bold;
    flex-shrink: 0;
}

.up-motion-inspector-content {
    flex-grow: 1;
    padding: var(--up-space-3);
}

.up-inspector-selection-title {
    min-height: 38px;
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-2);
    padding-top: 10px;
    margin-bottom: var(--up-space-3);
    -unity-font-style: bold;
    color: var(--up-text);
    background-color: var(--up-bg-3);
    border-left-width: 3px;
    border-left-color: var(--up-accent);
    border-top-right-radius: var(--up-radius);
    border-bottom-right-radius: var(--up-radius);
}

.up-inspector-section {
    margin-bottom: var(--up-space-3);
    background-color: var(--up-bg-1);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-inspector-section-heading {
    min-height: 38px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-inspector-section-kicker {
    height: 12px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
}

.up-inspector-section-title {
    height: 18px;
    font-size: var(--up-font-md);
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-inspector-section-body {
    padding: var(--up-space-2);
}

.up-empty-hint {
    margin: var(--up-space-3);
    white-space: normal;
    color: var(--up-text-dim);
}

.up-motion-event-tool-panel {
    margin-top: var(--up-space-1);
    padding: var(--up-space-2);
    background-color: var(--up-bg-1);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-motion-asset-inspector {
    min-width: 280px;
    min-height: 0;
}

.up-motion-asset-inspector > .up-motion-inspector {
    min-height: 260px;
    margin-top: var(--up-space-2);
}

.up-open-motion-editor {
    height: 32px;
    margin: var(--up-space-2);
    flex-shrink: 0;
}

.up-control-panels,
.up-control-panel-tabs {
    flex-shrink: 0;
}

.up-control-panel-tabs {
    min-height: 25px;
}

.up-control-panel-tab {
    min-width: 78px;
    height: 22px;
}

.up-tab-selected {
    color: white;
    background-color: var(--up-accent);
}

.up-flex-spacer {
    flex-grow: 1;
}

.up-control-panel-help {
    margin-right: var(--up-space-2);
}

.up-control-panel-body {
    padding: var(--up-space-1);
    background-color: var(--up-bg-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-control-panel-stack {
    flex-direction: row;
}

.up-control-panel {
    flex-grow: 1;
    padding: var(--up-space-2);
    margin: var(--up-space-1);
    background-color: var(--up-bg-2);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-control-panel-title {
    margin-bottom: var(--up-space-2);
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-panel-fields {
    margin-left: var(--up-space-2);
}

.up-button-row {
    flex-direction: row;
    margin-top: var(--up-space-1);
    margin-bottom: var(--up-space-1);
}

.up-button-row > Button {
    margin-right: var(--up-space-1);
}

.up-control-panel-help-text {
    margin-top: var(--up-space-2);
    white-space: normal;
    color: var(--up-text-dim);
}

.up-motion-editor-body,
.up-timeline-view {
    flex-grow: 1;
    min-height: 0;
}

.up-motion-authoring-foldout {
    flex-shrink: 0;
    max-height: 360px;
    overflow: hidden;
    margin: var(--up-space-2);
    margin-bottom: 0;
    background-color: var(--up-bg-2);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-motion-authoring-imgui {
    max-height: 330px;
}

.up-timeline-view {
    background-color: var(--up-bg-0);
}

.up-timeline-toolbar {
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    flex-shrink: 0;
    flex-wrap: nowrap;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-timeline-title-block {
    width: 116px;
    min-width: 116px;
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    padding-top: 3px;
    padding-left: var(--up-space-1);
    flex-shrink: 0;
    overflow: hidden;
}

.up-timeline-kicker {
    height: 13px;
    min-height: 13px;
    max-height: 13px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
    white-space: nowrap;
    overflow: hidden;
}

.up-timeline-title {
    height: 19px;
    min-height: 19px;
    max-height: 19px;
    -unity-font-style: bold;
    color: var(--up-text);
    white-space: nowrap;
    overflow: hidden;
}

.up-timeline-toolbar-divider {
    width: 1px;
    min-width: 1px;
    height: 24px;
    margin-left: var(--up-space-2);
    margin-right: var(--up-space-2);
    flex-shrink: 0;
    background-color: var(--up-border);
}

.up-timeline-zoom {
    width: 220px;
}

.up-timeline-fps {
    width: 84px;
}

.up-timeline-frames {
    margin-right: var(--up-space-1);
}

.up-timeline-cursor-label {
    min-width: 96px;
    height: 24px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    margin-right: var(--up-space-1);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--up-text);
    background-color: var(--up-bg-0);
    border-width: 1px;
    border-color: var(--up-border-strong);
    border-radius: var(--up-radius);
}

.up-timeline-scroll {
    flex-grow: 1;
    min-height: 180px;
}

.up-timeline-canvas {
    flex-shrink: 0;
    min-width: 320px;
    background-color: var(--up-bg-1);
}

.up-timeline-group-label,
.up-timeline-track-label {
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-1);
    border-right-width: 1px;
    border-right-color: var(--up-border);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-timeline-group-label {
    padding-top: 4px;
    -unity-font-style: bold;
    font-size: var(--up-font-sm);
    letter-spacing: 0.5px;
    color: var(--up-text);
    background-color: var(--up-bg-2);
}

.up-timeline-track-label {
    padding-top: 4px;
    color: var(--up-text-dim);
    background-color: var(--up-bg-1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.55);
}

.up-timeline-ruler-label {
    font-size: 10px;
    color: var(--up-text-dim);
}

.up-timeline-event-bar-label {
    padding-left: 2px;
    padding-right: 2px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 9px;
    color: white;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-motion-asset-inspector > .up-timeline-view {
    min-height: 320px;
}
