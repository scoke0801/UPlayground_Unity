      activities: 9
      periods: 15
    - id: seasoned.02.0
      topic: expenses
      text: "\uAC12 \uAE4E\uB294 \uC598\uAE30\uD558\uB2E4 \uCE5C\uD574\uC9C4 \uC801\uB3C4
