      activities: 9
      periods: 15
    - id: seasoned.01.4
      topic: food
      text: "\uD55C \uC785\uB9CC \uB2EC\uB77C\uBA74 \uD070 \uD55C \uC785\uC774 \uB098\uC640."
      activities: 9
      periods: 15
    - id: seasoned.01.5
      topic: food
      text: "\uBA39\uB358 \uC598\uAE30 \uD558\uB2C8\uAE4C \uB610 \uBA39\uACE0 \uC2F6\uB124."
