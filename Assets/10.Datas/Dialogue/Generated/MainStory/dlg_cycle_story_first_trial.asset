  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "정확해. 중앙 신호는 봉인이 풀리면 나타날 거야. 그리고 안에서 세운 작전은 밖에서 큰 소리로 복습하지 마. 무사히 돌아오면 이유를 알려 줄게."
  portrait: {fileID: 0}
