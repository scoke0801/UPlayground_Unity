if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("QuarryPassR1-A-20261108"))throw new Exception("A 잠금 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/QuarryPassR1.unity"||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("A 씬 필요");
var root=GameObject.Find("QuarryA_ConnectedStrata");var colliders=root.GetComponentsInChildren<Collider>();var rows=new List<object>();
var points=new[]{new Vector3(542,0,1040),new Vector3(539,0,1084),new Vector3(524,0,1110),new Vector3(519,0,1107),new Vector3(564,0,1105),new Vector3(450,0,1140),new Vector3(420,0,1186),new Vector3(548,0,1240),new Vector3(560,0,1330),new Vector3(580,0,1435)};
int[][] pairs={new[]{0,1},new[]{1,2},new[]{2,3},new[]{1,4},new[]{5,6},new[]{7,8},new[]{8,9}};
Physics.SyncTransforms();foreach(var pair in pairs){var a=points[pair[0]];var b=points[pair[1]];a.y=Terrain.activeTerrain.SampleHeight(a);b.y=Terrain.activeTerrain.SampleHeight(b);UnityEngine.AI.NavMeshHit ah=new UnityEngine.AI.NavMeshHit(),bh=new UnityEngine.AI.NavMeshHit();bool sampled=UnityEngine.AI.NavMesh.SamplePosition(a,out ah,8,-1)&&UnityEngine.AI.NavMesh.SamplePosition(b,out bh,8,-1);var path=new UnityEngine.AI.NavMeshPath();bool calculated=sampled&&UnityEngine.AI.NavMesh.CalculatePath(ah.position,bh.position,-1,path);var hits=new List<object>();
if(calculated){var corners=path.corners;for(int j=1;j<corners.Length;j++){var start=corners[j-1]+Vector3.up;var end=corners[j]+Vector3.up;var vector=end-start;foreach(var hit in Physics.SphereCastAll(start,.4f,vector.normalized,vector.magnitude,~0,QueryTriggerInteraction.Ignore).Where(h=>colliders.Contains(h.collider)))hits.Add(new{segment=j,collider=hit.collider.name,distance=hit.distance});}}
rows.Add(new{from=pair[0],to=pair[1],sampled,calculated,status=calculated?path.status.ToString():"NoPath",newCliffHits=hits});}
var result=new{radius=.4f,centerHeight=1f,scope="기존 NavMesh 경로 구간의 새 암반에 대한 SphereCast. KCC 이동/회피/카메라 테스트 아님",rows};var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/QuarryPassR1/route-clearance.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return result;

