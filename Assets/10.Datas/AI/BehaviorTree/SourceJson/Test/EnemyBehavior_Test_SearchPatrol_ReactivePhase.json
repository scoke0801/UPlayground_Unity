    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": true,
        "optimalCombatDistance": 2.8,
        "minCombatDistance": 1.2,
        "personalSpaceDistance": 0.85,
        "guardChance": 0.28,
        "retreatChance": 0.18,
        "circleWeight": 0.35,
        "aggression": 0.55,
        "reactionChance": 0.45,
        "counterChance": 0.22,
        "dodgeChance": 0.34,
        "punishRecoveryChance": 0.36,
        "antiGuardChance": 0.32,
        "minRetreatCooldown": 1.5,
        "maxComboPressureCount": 3,
        "preferredRange": 2.8,
        "recentHitCount": 0,
        "lastHitReactionType": "",
