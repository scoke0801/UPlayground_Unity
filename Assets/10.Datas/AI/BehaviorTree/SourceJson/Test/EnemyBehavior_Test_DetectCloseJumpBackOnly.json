    "groups": [
        {
            "name": "01 Target Recognition",
            "priority": 1000,
            "rules": [
                {
                    "name": "BlockedState",
                    "priority": 1000,
                    "when": [
                        { "condition": "IsBlockedEnemyState" }
                    ],
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                },
                {
                    "name": "NoTargetPatrolOrIdle",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget", "invert": true }
                    ],
                    "do": [
                        { "action": "PatrolOrIdle" }
                    ]
                }
            ]
        },
        {
            "name": "02 Close Range JumpBack Test",
            "priority": 900,
            "rules": [
                {
                    "name": "CloseTargetJumpBackOnly",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceLessOrEqual", "value": "minCombatDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "JumpBack" }
                    ]
                },
                {
                    "name": "ApproachUntilClose",
                    "priority": 800,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceGreater", "value": "minCombatDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Chase" }
                    ]
                }
            ]
        }
    ],
    "rules": []
