// 실제 연결 배치에서 가까운 통행점까지 양방향 NavMesh 경로를 계산한다. AI 실행 검증은 아니다.
var data=AssetDatabase.LoadAssetAtPath<UPlayGround.Data.World.WorldPlacementDataSO>(AssetDatabase.GUIDToAssetPath("2819d64223022c84b9a62983354d6ecb"));var rows=new List<object>();var route=new[]{new Vector3(1700,0,740),new Vector3(1605,0,805),new Vector3(1650,0,855),new Vector3(1750,0,870)};
foreach(var r in data.Records.Where(r=>r.position.x>1500&&r.position.x<1810&&r.position.z>680&&r.position.z<980&&!string.IsNullOrEmpty(r.actorId))){var p=r.position;var q=route.OrderBy(v=>(new Vector2(v.x-p.x,v.z-p.z)).sqrMagnitude).First();q.y=Terrain.activeTerrain.SampleHeight(q);for(int reverse=0;reverse<2;reverse++){UnityEngine.AI.NavMeshHit a,b;bool found=UnityEngine.AI.NavMesh.SamplePosition(reverse==0?p:q,out a,3,-1)&&UnityEngine.AI.NavMesh.SamplePosition(reverse==0?q:p,out b,3,-1);if(!found){rows.Add(new{r.actorId,r.sceneEntityGuid,reverse,status="NoSample"});continue;}UnityEngine.AI.NavMesh.SamplePosition(reverse==0?q:p,out b,3,-1);var path=new UnityEngine.AI.NavMeshPath();UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,-1,path);rows.Add(new{r.actorId,r.sceneEntityGuid,reverse,status=path.status.ToString(),corners=path.corners.Length});}}
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/ShadeCreekR3/enemy-paths.json",(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{rows}));return rows;
