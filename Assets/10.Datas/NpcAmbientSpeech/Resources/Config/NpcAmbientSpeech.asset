    - id: bright.04.1
      topic: animals
      text: "\uACE0\uC591\uC774\uD55C\uD14C \uB208\uC2F8\uC6C0\uC740 \uBABB \uC774\uAE30\uACA0\uC5B4."
      activities: 9
      periods: 15
    - id: bright.04.2
      topic: animals
      text: "\uAC15\uC544\uC9C0\uB294 \uB9E4\uBC88 \uCC98\uC74C \uBCF4\uB294 \uAC83\uCC98\uB7FC
        \uBC18\uACA8."
      activities: 9
      periods: 15
    - id: bright.04.3
      topic: animals
      text: "\uB098\uBE44 \uB530\uB77C\uAC00\uB2E4 \uAE38\uC744 \uBC14\uAFBC \uC801\uB3C4
        \uC788\uC5B4."
      activities: 9
      periods: 15
    - id: bright.04.4
      topic: animals
      text: "\uACE0\uC591\uC774 \uC774\uB984\uC744 \uBD88\uB800\uB354\uB2C8 \uD558\uD488\uD558\uB354\uB77C."
      activities: 9
      periods: 15
    - id: bright.04.5
      topic: animals
      text: "\uC791\uC740 \uBC1C\uB85C \uC5B4\uB5BB\uAC8C \uADF8\uB807\uAC8C \uBE68\uB9AC
        \uAC00\uC9C0?"
      activities: 9
      periods: 15
    - id: bright.04.6
      topic: animals
      text: "\uBA39\uC744 \uAC78 \uC228\uAE30\uBA74 \uCF54\uBD80\uD130 \uC6C0\uC9C1\uC774\uB358\uB370."
      activities: 9
      periods: 15
    - id: bright.04.7
      topic: animals
      text: "\uBC1C\uC790\uAD6D\uC744 \uBCF4\uBA74 \uAD1C\uD788 \uB530\uB77C\uAC00
        \uBCF4\uACE0 \uC2F6\uC5B4."
      activities: 9
      periods: 15
    - id: bright.05.0
      topic: clothes
      text: "\uB048 \uB05D\uC744 \uAE38\uAC8C \uB0A8\uAE30\uBA74 \uC790\uAFB8 \uB9CC\uC9C0\uAC8C
        \uB3FC."
      activities: 9
      periods: 15
    - id: bright.05.1
      topic: clothes
      text: "\uC774 \uB9E4\uB4ED\uC740 \uB0B4\uAC00 \uBD10\uB3C4 \uC798 \uBB36\uC5C8\uC5B4."
      activities: 9
      periods: 15
    - id: bright.05.2
      topic: clothes
      text: "\uC8FC\uBA38\uB2C8 \uD558\uB098\uB97C \uB354 \uB2EC\uBA74 \uC5B4\uB5A8\uAE4C."
      activities: 9
      periods: 15
    - id: bright.05.3
      topic: clothes
      text: "\uC18C\uB9E4\uB97C \uC811\uC73C\uBA74 \uAE08\uBC29 \uB610 \uB0B4\uB824\uC640."
      activities: 9
      periods: 15
    - id: bright.05.4
      topic: clothes
      text: "\uAC19\uC740 \uC0C9\uC778 \uC904 \uC54C\uC558\uB294\uB370 \uB098\uB780\uD788
        \uB450\uB2C8 \uB2E4\uB974\uB124."
      activities: 9
      periods: 15
    - id: bright.05.5
      topic: clothes
      text: "\uBC14\uB78C \uBD88\uBA74 \uBA38\uB9AC\uCE74\uB77D\uC774 \uAF2D \uC785\uC5D0
        \uB4E4\uC5B4\uAC00."
      activities: 9
      periods: 15
    - id: bright.05.6
      topic: clothes
      text: "\uC637\uC744 \uAC70\uAFB8\uB85C \uC785\uACE0 \uB098\uC62C \uBED4\uD588\uB2E4\uB2C8\uAE4C."
      activities: 9
      periods: 15
    - id: bright.05.7
      topic: clothes
      text: "\uC591\uB9D0 \uC0C9\uC774 \uB2EC\uB77C\uB3C4 \uBAA8\uB97C \uC218\uB3C4
        \uC788\uACA0\uC9C0?"
      activities: 9
      periods: 15
    - id: bright.06.0
      topic: habits
      text: "\uC7AC\uBC0C\uB294 \uC598\uAE30\uB294 \uB05D\uBD80\uD130 \uB9D0\uD558\uAC8C
        \uB3FC."
      activities: 9
      periods: 15
    - id: bright.06.1
      topic: habits
      text: "\uAE30\uB2E4\uB9B4 \uB550 \uC190\uC774 \uAC00\uB9CC\uC788\uC9C8 \uBABB\uD574."
      activities: 9
      periods: 15
    - id: bright.06.2
      topic: habits
      text: "\uB178\uB798\uB294 \uB4B7\uBD80\uBD84\uB9CC \uC0DD\uAC01\uB098\uB294\uB370."
      activities: 9
      periods: 15
    - id: bright.06.3
      topic: habits
      text: "\uD558\uB098\uB97C \uC138\uB2E4 \uBCF4\uBA74 \uC14B\uC744 \uAC74\uB108\uB6F0\uC5B4."
      activities: 9
      periods: 15
    - id: bright.06.4
      topic: habits
      text: "\uBC1C\uB05D\uC73C\uB85C \uAE00\uC528 \uC4F0\uB294 \uBC84\uB987\uC774
        \uC0DD\uACBC\uB124."
      activities: 9
      periods: 15
    - id: bright.06.5
      topic: habits
      text: "\uD55C \uBC88 \uC6C3\uAE30 \uC2DC\uC791\uD558\uBA74 \uBA48\uCD94\uAE30\uAC00
        \uD798\uB4E4\uC5B4."
      activities: 9
      periods: 15
    - id: bright.06.6
      topic: habits
      text: "\uAD81\uAE08\uD55C \uAC74 \uB3CC\uC544\uC11C\uB3C4 \uC790\uAFB8 \uBCF4\uAC8C
        \uB3FC."
      activities: 9
      periods: 15
    - id: bright.06.7
      topic: habits
      text: "\uC785 \uB2E4\uBB3C\uACE0 \uC788\uC73C\uB2C8\uAE4C \uB354 \uB9D0\uD558\uACE0
        \uC2F6\uB124."
      activities: 9
      periods: 15
    - id: bright.07.0
      topic: plans
      text: "\uC791\uC740 \uB3CC\uC744 \uBAA8\uC544 \uB193\uC73C\uBA74 \uC608\uC058\uB824\uB098."
      activities: 9
      periods: 15
    - id: bright.07.1
      topic: plans
      text: "\uC774\uBC88\uC5D4 \uB05D\uAE4C\uC9C0 \uC678\uC6CC \uBCF4\uACE0 \uC2F6\uC740\uB370."
      activities: 9
      periods: 15
    - id: bright.07.2
      topic: plans
      text: "\uC544\uBB34 \uBB34\uB2AC \uC5C6\uB294 \uCC9C\uC5D0 \uC810\uC744 \uCC0D\uC5B4
        \uBCFC\uAE4C."
      activities: 9
      periods: 15
    - id: bright.07.3
      topic: plans
      text: "\uC9C0\uB09C\uBC88 \uB178\uB798\uB97C \uB2E4\uB974\uAC8C \uBD88\uB7EC
        \uBCF4\uACE0 \uC2F6\uC5B4."
      activities: 9
      periods: 15
    - id: bright.07.4
      topic: plans
      text: "\uD558\uB8E8 \uB3D9\uC548 \uBAA8\uB974\uB294 \uAE38\uB85C\uB9CC \uAC00
        \uBCF4\uBA74 \uC5B4\uB54C?"
      activities: 9
      periods: 15
    - id: bright.07.5
      topic: plans
      text: "\uB2E4\uC74C\uC5D4 \uB0B4\uAC00 \uBA3C\uC800 \uCC3E\uC544\uAC00 \uBD10\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: bright.07.6
      topic: plans
      text: "\uC8FC\uBA38\uB2C8\uC5D0 \uB4E4\uC5B4\uAC00\uB294 \uC120\uBB3C\uC774
        \uC88B\uACA0\uB2E4."
      activities: 9
      periods: 15
    - id: bright.07.7
      topic: plans
      text: "\uC798 \uADF8\uB9B0 \uAC74 \uC544\uB2CC\uB370 \uBC84\uB9AC\uAE34 \uC544\uAE4C\uC6CC."
      activities: 9
      periods: 15
    - id: bright.08.0
      topic: travel
      text: "\uC800 \uBAA8\uD241\uC774\uB9CC \uBCF4\uBA74 \uB2E4\uB978 \uAC8C \uB610
        \uAD81\uAE08\uD574\uC838."
      activities: 2
      periods: 15
    - id: bright.08.1
      topic: travel
      text: "\uAE38\uC744 \uC798\uBABB \uB4E4\uC5C8\uC73C\uBA74 \uC0C8 \uAE38\uC744
        \uC548 \uAC70\uC9C0 \uBB50."
      activities: 2
      periods: 15
    - id: bright.08.2
      topic: travel
      text: "\uAC77\uB2E4 \uBCF4\uB2C8 \uC0DD\uAC01\uBCF4\uB2E4 \uBA40\uB9AC \uC654\uB124."
      activities: 2
      periods: 15
    - id: bright.08.3
      topic: travel
      text: "\uBC1C\uAC78\uC74C \uC18C\uB9AC\uAC00 \uBC15\uC790 \uAC19\uC544."
      activities: 2
      periods: 15
    - id: bright.08.4
      topic: travel
      text: "\uB3CC\uC544\uAC08 \uAE38\uC740 \uAE30\uC5B5\uD574 \uB1A8\uC9C0. \uC544\uB9C8\uB3C4."
      activities: 2
      periods: 15
    - id: bright.08.5
      topic: travel
      text: "\uC5B4, \uC800\uCABD\uC73C\uB85C \uAC00\uB824\uB358 \uAC70\uC600\uB294\uB370."
      activities: 2
      periods: 15
    - id: bright.08.6
      topic: travel
      text: "\uD55C \uBC1C \uB354 \uD06C\uAC8C \uAC78\uC73C\uBA74 \uBE68\uB9AC \uB2FF\uC744\uAE4C?"
      activities: 2
      periods: 15
    - id: bright.08.7
      topic: travel
      text: "\uB204\uAC00 \uBA3C\uC800 \uAC78\uC740 \uAE38\uC778\uC9C0 \uAD81\uAE08\uD558\uB124."
      activities: 2
      periods: 15
    - id: bright.09.0
      topic: feet
      text: "\uBC1C\uC774 \uC790\uAFB8 \uC55E\uC11C \uAC00\uB124."
      activities: 2
      periods: 15
    - id: bright.09.1
      topic: feet
      text: "\uB098\uB9CC \uBC1C\uC18C\uB9AC\uAC00 \uD070\uAC00?"
      activities: 2
      periods: 15
    - id: bright.09.2
      topic: feet
      text: "\uC2E0\uBC1C\uC744 \uBC14\uAFB8\uBA74 \uAC78\uC74C\uB3C4 \uB2EC\uB77C\uC9C8\uAE4C."
      activities: 2
      periods: 15
    - id: bright.09.3
      topic: feet
      text: "\uC624\uB978\uBC1C, \uC67C\uBC1C\u2026 \uC65C \uC138\uACE0 \uC788\uC9C0?"
      activities: 2
      periods: 15
    - id: bright.09.4
      topic: feet
      text: "\uBC1C\uB05D\uC5D0 \uD798\uC8FC\uACE0 \uAC78\uC73C\uBA74 \uC880 \uC870\uC6A9\uD574\uC9C0\uB824\uB098."
      activities: 2
      periods: 15
    - id: bright.09.5
      topic: feet
      text: "\uB048 \uD480\uB9AC\uC9C0 \uB9C8\uB77C. \uC870\uAE08\uB9CC \uBC84\uD168."
      activities: 2
      periods: 15
    - id: bright.09.6
      topic: feet
      text: "\uC774 \uC18D\uB3C4\uB85C \uAC77\uB2E4\uAC04 \uB3C4\uCC29\uD574\uC11C\uB3C4
        \uAC77\uACA0\uB124."
      activities: 2
      periods: 15
    - id: bright.09.7
      topic: feet
      text: "\uD55C \uBC88 \uBA48\uCD94\uBA74 \uB2E4\uC2DC \uAC77\uAE30 \uC2EB\uC5B4\uC9C8
        \uAC83 \uAC19\uC544."
      activities: 2
      periods: 15
    - id: bright.10.0
      topic: effort
      text: "\uC774\uBC88\uC5D4 \uC190\uC774 \uC880 \uBE60\uB978\uB370?"
      activities: 4
      periods: 15
    - id: bright.10.1
      topic: effort
      text: "\uC544, \uADF8\uCABD\uC774 \uC544\uB2C8\uB77C \uC774\uCABD\uC774\uB124!"
      activities: 4
      periods: 15
    - id: bright.10.2
      topic: effort
      text: "\uBC29\uAE08\uC740 \uAF64 \uADF8\uB7F4\uB4EF\uD588\uC5B4."
      activities: 4
      periods: 15
    - id: bright.10.3
      topic: effort
      text: "\uC810\uC810 \uC694\uB839\uC774 \uC0DD\uAE30\uB294 \uAC83 \uAC19\uC544."
      activities: 4
      periods: 15
    - id: bright.10.4
      topic: effort
      text: "\uD55C \uBC88\uC5D0 \uD558\uB824\uB2C8\uAE4C \uC190\uC774 \uAF2C\uC774\uB124."
      activities: 4
      periods: 15
    - id: bright.10.5
      topic: effort
      text: "\uBA4B\uC788\uAC8C \uD558\uB824\uB2E4 \uB610 \uB2A6\uC5B4\uC84C\uC5B4."
      activities: 4
      periods: 15
    - id: bright.10.6
      topic: effort
      text: "\uC9D1\uC911\uD574\uC57C\uC9C0. \uC790\uAFB8 \uB2E4\uB978 \uAC8C \uC0DD\uAC01\uB098."
      activities: 4
      periods: 15
    - id: bright.10.7
      topic: effort
      text: "\uC870\uAE08\uB9CC \uB354 \uD558\uBA74 \uC790\uB791\uD560 \uB9CC\uD558\uACA0\uB294\uB370."
      activities: 4
      periods: 15
    - id: bright.11.0
      topic: mistakes
      text: "\uC5B4\uB77C, \uC774\uAC8C \uC65C \uB0A8\uC558\uC9C0?"
      activities: 4
      periods: 15
    - id: bright.11.1
      topic: mistakes
      text: "\uBD84\uBA85 \uBC29\uAE08 \uC804\uAE4C\uC9C0 \uB9DE\uC558\uB294\uB370."
      activities: 4
      periods: 15
    - id: bright.11.2
      topic: mistakes
      text: "\uB108\uBB34 \uC77C\uCC0D \uC88B\uC544\uD588\uB098 \uBD10."
      activities: 4
      periods: 15
    - id: bright.11.3
      topic: mistakes
      text: "\uC544\uC9C1 \uC544\uBB34\uB3C4 \uBABB \uBD24\uACA0\uC9C0?"
      activities: 4
      periods: 15
    - id: bright.11.4
      topic: mistakes
      text: "\uC7A0\uAE50, \uCC98\uC74C\uBD80\uD130 \uC138\uC5B4 \uBCFC\uAC8C. \uC544\uB2C8,
        \uD63C\uC7A3\uB9D0\uC774\uC57C."
      activities: 4
      periods: 15
    - id: bright.11.5
      topic: mistakes
      text: "\uC544\uAE4C \uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uD588\uB354\uB77C?"
      activities: 4
      periods: 15
    - id: bright.11.6
      topic: mistakes
      text: "\uBC18\uB300\uB85C \uD558\uB2C8\uAE4C \uC624\uD788\uB824 \uB418\uB124?"
      activities: 4
      periods: 15
    - id: bright.11.7
      topic: mistakes
      text: "\uB2E4\uC74C\uC5D4 \uC774 \uC2E4\uC218\uB85C \uB0A8\uC744 \uAC00\uB974\uCE60
        \uC218 \uC788\uACA0\uB2E4."
      activities: 4
      periods: 15
    - id: bright.12.0
      topic: dawn
      text: "\uBC8C\uC368 \uC77C\uC5B4\uB0AC\uB124? \uB098\uB3C4 \uB180\uB790\uC5B4."
      activities: 9
      periods: 1
    - id: bright.12.1
      topic: dawn
      text: "\uAFC8\uC774 \uC7AC\uBC0C\uC5C8\uB294\uB370 \uB05D\uC744 \uBABB \uBD24\uB124."
      activities: 9
      periods: 1
    - id: bright.12.2
      topic: dawn
      text: "\uB208 \uB728\uC790\uB9C8\uC790 \uD560 \uC0DD\uAC01\uC774 \uB108\uBB34
        \uB9CE\uC544."
      activities: 9
      periods: 1
    - id: bright.12.3
      topic: dawn
      text: "\uC544\uCE68\uC5D4 \uBC30\uAC00 \uC81C\uC77C \uBA3C\uC800 \uAE68\uB294
        \uAC83 \uAC19\uC544."
      activities: 9
      periods: 1
    - id: bright.12.4
      topic: dawn
      text: "\uC548 \uC878\uB824. \uBC29\uAE08 \uD558\uD488\uC740 \uADF8\uB0E5 \uB098\uC628
        \uAC70\uC57C."
      activities: 9
      periods: 1
    - id: bright.12.5
      topic: dawn
      text: "\uC774\uB807\uAC8C \uC77C\uCC0D \uAE68\uBA74 \uD558\uB8E8\uAC00 \uB354
        \uAE34\uAC00?"
      activities: 9
      periods: 1
    - id: bright.12.6
      topic: dawn
      text: "\uAFC8\uC5D0\uC11C \uB4E4\uC740 \uB178\uB798\uAC00 \uC0AC\uB77C\uC9C0\uAE30
        \uC804\uC5D0."
      activities: 9
      periods: 1
    - id: bright.12.7
      topic: dawn
      text: "\uB2A6\uC7A0 \uC548 \uC7A4\uB2E4\uACE0 \uC790\uB791\uD560 \uB370\uB3C4
        \uC5C6\uB124."
      activities: 9
      periods: 1
    - id: bright.13.0
      topic: dusk
      text: "\uC544, \uC544\uC9C1 \uD574 \uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uB0A8\uC558\uB294\uB370."
      activities: 9
      periods: 4
    - id: bright.13.1
      topic: dusk
      text: "\uC624\uB298 \uC598\uAE43\uAC70\uB9AC \uAF64 \uB9CE\uC774 \uBAA8\uC558\uC5B4."
      activities: 9
      periods: 4
    - id: bright.13.2
      topic: dusk
      text: "\uC800\uB141\uC740 \uC870\uAE08 \uC0C8\uB85C\uC6B4 \uAC78 \uBA39\uC5B4
        \uBCFC\uAE4C."
      activities: 9
      periods: 4
    - id: bright.13.3
      topic: dusk
      text: "\uD55C \uC77C\uBCF4\uB2E4 \uAD6C\uACBD\uD55C \uAC8C \uB354 \uB9CE\uC740
        \uAC83 \uAC19\uC544."
      activities: 9
      periods: 4
    - id: bright.13.4
      topic: dusk
      text: "\uC774\uC81C \uB3CC\uC544\uAC00\uBA74 \uC774\uC57C\uAE30\uBD80\uD130
        \uD574\uC57C\uC9C0."
      activities: 9
      periods: 4
    - id: bright.13.5
      topic: dusk
      text: "\uBC8C\uC368 \uC800\uB141\uAC70\uB9AC \uC0DD\uAC01\uD560 \uB54C\uB124."
      activities: 9
      periods: 4
    - id: bright.13.6
      topic: dusk
      text: "\uB0AE\uC5D0 \uBD24\uB358 \uAC78 \uADF8\uB824 \uB193\uACE0 \uC2F6\uB2E4."
      activities: 9
      periods: 4
    - id: bright.13.7
      topic: dusk
      text: "\uC624\uB298\uC740 \uC5B4\uCA50\uC9C0 \uBC1C\uC774 \uB9CE\uC774 \uC6C0\uC9C1\uC600\uC5B4."
      activities: 9
      periods: 4
    - id: bright.14.0
      topic: night
      text: "\uBC24\uC5D0\uB294 \uC6C3\uC74C\uC18C\uB9AC\uB3C4 \uB354 \uBA40\uB9AC
        \uAC00\uB824\uB098."
      activities: 9
      periods: 8
    - id: bright.14.1
      topic: night
      text: "\uC878\uB9AC\uAE30 \uC804\uC5D0 \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uC57C
        \uD558\uB294\uB370."
      activities: 9
      periods: 8
    - id: bright.14.2
      topic: night
      text: "\uB208 \uAC10\uC73C\uBA74 \uBC14\uB85C \uC7A0\uB4E4 \uC790\uC2E0 \uC788\uC5B4."
      activities: 9
      periods: 8
    - id: bright.14.3
      topic: night
      text: "\uC870\uC6A9\uD788 \uD558\uB824\uB2C8\uAE4C \uC2E0\uBC1C\uC774 \uB354
        \uD06C\uAC8C \uC6B8\uB824."
      activities: 9
      periods: 8
    - id: bright.14.4
      topic: night
      text: "\uB0B4\uC77C \uC544\uCE68\uC5D0 \uC0DD\uAC01\uD558\uBA74 \uB610 \uC6C3\uAE30\uACA0\uC9C0."
      activities: 9
      periods: 8
    - id: bright.14.5
      topic: night
      text: "\uBC24\uC5D0 \uBA39\uB294 \uAC04\uC2DD\uC740 \uC65C \uB354 \uB9DB\uC788\uC744\uAE4C."
      activities: 9
      periods: 8
    - id: bright.14.6
      topic: night
      text: "\uD55C \uBC88\uB9CC \uB354 \uD558\uD488\uD558\uBA74 \uB3CC\uC544\uAC00\uC57C\uC9C0."
      activities: 9
      periods: 8
    - id: bright.14.7
      topic: night
      text: "\uC7A0 \uC548 \uC628\uB2E4\uACE0 \uB215\uC9C0 \uC54A\uC73C\uBA74 \uB354
        \uBABB \uC790\uB294\uB370."
      activities: 9
      periods: 8
    - id: bright.15.0
      topic: rest
      text: "\uC549\uC790\uB9C8\uC790 \uC77C\uC5B4\uB098\uAE30 \uC2EB\uC5B4\uC84C\uC5B4."
      activities: 8
      periods: 15
    - id: bright.15.1
      topic: rest
      text: "\uBC1C\uAC00\uB77D\uB3C4 \uC26C\uACE0 \uC788\uACA0\uC9C0?"
      activities: 8
      periods: 15
    - id: bright.15.2
      topic: rest
      text: "\uC26C\uBA74\uC11C \uD560 \uC77C\uAE4C\uC9C0 \uC0DD\uAC01\uD574 \uC654\uB294\uB370."
      activities: 8
      periods: 15
    - id: bright.15.3
      topic: rest
      text: "\uAC00\uB9CC\uD788 \uC788\uAE30\uAC00 \uC774\uB807\uAC8C \uC5B4\uB835\uB124."
      activities: 8
      periods: 15
    - id: bright.15.4
      topic: rest
      text: "\uB208\uB9CC \uC7A0\uAE50 \uAC10\uC744\uAE4C. \uC9C4\uC9DC \uC7A0\uAE50."
      activities: 8
      periods: 15
    - id: bright.15.5
      topic: rest
      text: "\uC2EC\uC2EC\uD558\uB2E4\uACE0 \uB610 \uB3CC\uC544\uB2E4\uB2C8\uBA74
        \uC26C\uB294 \uAC8C \uC544\uB2C8\uC9C0."
      activities: 8
      periods: 15
    - id: bright.15.6
      topic: rest
      text: "\uC26C\uACE0 \uB098\uBA74 \uC544\uAE4C\uBCF4\uB2E4 \uC798\uD560 \uC218\uB3C4
        \uC788\uC796\uC544."
      activities: 8
      periods: 15
    - id: bright.15.7
      topic: rest
      text: "\uC190\uAC00\uB77D\uC73C\uB85C \uBC15\uC790\uB9CC \uC880 \uB9DE\uCDB0
        \uBCFC\uAE4C."
      activities: 8
      periods: 15
  - id: practical
    direction: "\uD2BC\uD2BC\uD55C \uCC28\uB9BC, \uC190\uC744 \uC790\uC8FC \uC4F0\uB294
      \uC2E4\uC18D\uD30C \uC778\uC0C1. \uBB3C\uAC74\uC758 \uAD6C\uC870\uC640 \uAC12\uC5D0
      \uBBFC\uAC10\uD558\uACE0 \uC790\uAE30 \uC2E4\uC218\uC5D0\uB294 \uD22C\uB35C\uB304\uB2E4.
      \uC9C1\uC5C5\uC740 \uB2E8\uC815\uD558\uC9C0 \uC54A\uC73C\uBA70 \uC9E7\uC740
      \uBC18\uB9D0\uB85C \uD63C\uC7A3\uB9D0\uD55C\uB2E4."
    lines:
    - id: practical.00.0
      topic: lost
      text: "\uB123\uC5B4 \uB454 \uB370\uB294 \uC548 \uC78A\uB294\uB370 \uC62E\uAE34
        \uB370\uB97C \uC78A\uC5B4."
      activities: 9
      periods: 15
    - id: practical.00.1
      topic: lost
      text: "\uB3C4\uAD6C\uBCF4\uB2E4 \uB3C4\uAD6C \uB123\uB294 \uD1B5\uC744 \uB354
        \uCC3E\uB124."
      activities: 9
      periods: 15
    - id: practical.00.2
      topic: lost
      text: "\uC791\uC740 \uAC83\uB9CC \uAF2D \uBC14\uB2E5\uC73C\uB85C \uC228\uC5B4\uB4E4\uC5B4."
      activities: 9
      periods: 15
    - id: practical.00.3
      topic: lost
      text: "\uC8FC\uBA38\uB2C8 \uC18D\uC5D0\uC11C \uB610 \uC5C9\uCF30\uB124."
      activities: 9
      periods: 15
    - id: practical.00.4
      topic: lost
      text: "\uC190 \uB2FF\uB294 \uB370 \uB454\uB2E4\uB354\uB2C8 \uC190\uC774 \uC548
        \uB2FF\uC544."
      activities: 9
      periods: 15
    - id: practical.00.5
      topic: lost
      text: "\uC783\uC5B4\uBC84\uB9B0 \uC904 \uC54C\uACE0 \uB610 \uC0B4 \uBED4\uD588\uB124."
      activities: 9
      periods: 15
    - id: practical.00.6
      topic: lost
      text: "\uBD84\uBA85 \uB0A8\uB294 \uAC78 \uD558\uB098 \uCC59\uACA8 \uB480\uB294\uB370."
      activities: 9
      periods: 15
    - id: practical.00.7
      topic: lost
      text: "\uC548 \uC4F0\uB294 \uAC74 \uBCF4\uC774\uACE0 \uCC3E\uB294 \uAC74 \uC548
        \uBCF4\uC774\uC9C0."
      activities: 9
      periods: 15
    - id: practical.01.0
      topic: food
      text: "\uAD6D\uC5D0 \uB0A8\uC740 \uBE75 \uCC0D\uC5B4 \uBA39\uC73C\uBA74 \uB531\uC778\uB370."
      activities: 9
      periods: 15
    - id: practical.01.1
      topic: food
      text: "\uAC10\uC790\uB294 \uD06C\uAC8C \uC370\uC5B4\uC57C \uC539\uB294 \uB9DB\uC774
        \uC788\uC9C0."
      activities: 9
      periods: 15
    - id: practical.01.2
      topic: food
      text: "\uBC30\uB9CC \uCC44\uC6B8 \uAC70\uBA74 \uC544\uBB34\uAC70\uB098 \uBA39\uC5C8\uACA0\uC9C0."
      activities: 9
      periods: 15
    - id: practical.01.3
      topic: food
      text: "\uAC04 \uBCF8\uB2E4\uACE0 \uBA39\uC740 \uAC8C \uBC18\uC740 \uB418\uACA0\uB124."
      activities: 9
      periods: 15
    - id: practical.01.4
      topic: food
      text: "\uADF8\uB987\uC5D0 \uBD99\uC740 \uAC8C \uB354 \uB9DB\uC788\uB354\uB77C."
      activities: 9
      periods: 15
    - id: practical.01.5
      topic: food
      text: "\uB728\uAC70\uC6B8 \uB54C \uC695\uC2EC\uB0B4\uBA74 \uC785\uCC9C\uC7A5\uB9CC
        \uB370\uC9C0."
      activities: 9
      periods: 15
    - id: practical.01.6
      topic: food
      text: "\uB9D0\uB9B0 \uAC74 \uC624\uB798 \uB450\uB824\uACE0 \uC0AC\uB294 \uAC74\uB370
        \uAE08\uBC29 \uBA39\uC5B4."
      activities: 9
      periods: 15
    - id: practical.01.7
      topic: food
      text: "\uBE75\uC740 \uC790\uB978 \uB450\uAED8\uC5D0 \uB530\uB77C \uB9DB\uB3C4
        \uB2EC\uB77C."
      activities: 9
      periods: 15
    - id: practical.02.0
      topic: expenses
      text: "\uC2FC \uAC74\uB370 \uC2E4\uAC12\uC774 \uB354 \uB4E4\uAC8C \uC0DD\uACBC\uB124."
      activities: 9
      periods: 15
    - id: practical.02.1
      topic: expenses
      text: "\uB531 \uB9DE\uB294 \uAC83 \uD558\uB098\uAC00 \uC5B4\uC124\uD508 \uC14B\uBCF4\uB2E4
        \uB0AB\uC9C0."
      activities: 9
      periods: 15
    - id: practical.02.2
      topic: expenses
      text: "\uB098\uC911\uC5D0 \uC4F8 \uAC70\uB77C\uB294 \uB9D0\uB85C \uB610 \uC0C0\uB124."
      activities: 9
      periods: 15
    - id: practical.02.3
      topic: expenses
      text: "\uAC12\uC740 \uAE30\uC5B5\uD558\uB294\uB370 \uC5B4\uB514 \uB480\uB294\uC9C0\uB97C
        \uBAB0\uB77C."
      activities: 9
      periods: 15
    - id: practical.02.4
      topic: expenses
      text: "\uB0A8\uB294 \uAC78 \uC0AC \uC624\uBA74 \uADF8\uAC8C \uB610 \uB0A8\uB294
        \uAC70\uC9C0."
      activities: 9
      periods: 15
    - id: practical.02.5
      topic: expenses
      text: "\uACE0\uCCD0 \uC4F0\uB824\uACE0 \uC0C0\uB294\uB370 \uACE0\uCE60 \uAC8C
        \uB298\uC5C8\uC5B4."
      activities: 9
      periods: 15
    - id: practical.02.6
      topic: expenses
      text: "\uD55C \uAC1C \uAC12\uB9CC \uBB3C\uC5C8\uB294\uB370 \uB450 \uAC1C\uB97C
        \uAD8C\uD558\uB354\uB77C."
      activities: 9
      periods: 15
    - id: practical.02.7
      topic: expenses
      text: "\uC548 \uC0AC\uB294 \uAC8C \uC81C\uC77C \uC2F8\uAE34 \uD55C\uB370."
      activities: 9
      periods: 15
    - id: practical.03.0
      topic: people
      text: "\uBE4C\uB824 \uAC04 \uAC74 \uC798 \uC4F0\uACE0 \uC788\uB098 \uBAA8\uB974\uACA0\uB124."
      activities: 9
      periods: 15
    - id: practical.03.1
      topic: people
      text: "\uB3C4\uC640\uC900\uB2E4\uB354\uB2C8 \uC794\uC18C\uB9AC\uB9CC \uB450\uACE0
        \uAC14\uC5B4."
      activities: 9
      periods: 15
    - id: practical.03.2
      topic: people
      text: "\uB098\uBCF4\uB2E4 \uC798 \uC544\uB294 \uC0AC\uB78C\uC774 \uBCF4\uBA74
        \uC6C3\uACA0\uC9C0."
      activities: 9
      periods: 15
    - id: practical.03.3
      topic: people
      text: "\uD574 \uB2EC\uB77C\uACE0\uB294 \uC26C\uC6B4\uB370 \uD574 \uBCF4\uAE30\uB294
        \uC5B4\uB835\uC9C0."
      activities: 9
      periods: 15
    - id: practical.03.4
      topic: people
      text: "\uB9D0\uB85C\uB9CC \uB4E4\uC744 \uB550 \uAC04\uB2E8\uD574 \uBCF4\uC600\uB294\uB370."
      activities: 9
      periods: 15
    - id: practical.03.5
      topic: people
      text: "\uBB3B\uB294 \uB9D0\uBCF4\uB2E4 \uC124\uBA85\uC774 \uB354 \uAE38\uC5C8\uC5B4."
      activities: 9
      periods: 15
    - id: practical.03.6
      topic: people
      text: "\uBC18\uB0A9\uD560 \uB54C \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC740 \uD574\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: practical.03.7
      topic: people
      text: "\uAD1C\uCC2E\uB2E4\uB354\uB2C8 \uD45C\uC815\uC740 \uC548 \uAD1C\uCC2E\uB358\uB370."
      activities: 9
      periods: 15
    - id: practical.04.0
      topic: animals
      text: "\uACE0\uC591\uC774\uD55C\uD14C \uB048\uC740 \uBCF4\uC5EC \uC8FC\uBA74
        \uC548 \uB3FC."
      activities: 9
      periods: 15
    - id: practical.04.1
      topic: animals
      text: "\uC0C8\uAC00 \uB465\uC9C0 \uC9D3\uB294 \uAC74 \uCC38 \uC57C\uBB34\uC838."
      activities: 9
      periods: 15
    - id: practical.04.2
      topic: animals
      text: "\uAC15\uC544\uC9C0\uAC00 \uBB3C\uC5B4 \uAC00\uBA74 \uB2E4 \uC790\uAE30
        \uAC70\uB354\uB77C."
      activities: 9
      periods: 15
    - id: practical.04.3
      topic: animals
      text: "\uBA39\uC774\uB97C \uC8FC\uB294 \uC190\uC740 \uAE30\uAC00 \uB9C9\uD788\uAC8C
        \uC54C\uC544."
      activities: 9
      periods: 15
    - id: practical.04.4
      topic: animals
      text: "\uC5BC\uB9C8\uB098 \uC791\uC740 \uD2C8\uC73C\uB85C\uB3C4 \uB4E4\uC5B4\uAC00\uB294\uC9C0."
      activities: 9
      periods: 15
    - id: practical.04.5
      topic: animals
      text: "\uBC1C\uC790\uAD6D \uB2E6\uB294 \uAC74 \uACB0\uAD6D \uC0AC\uB78C \uBAAB\uC774\uC9C0."
      activities: 9
      periods: 15
    - id: practical.04.6
      topic: animals
      text: "\uBE48 \uBC14\uAD6C\uB2C8\uC5D4 \uAF2D \uBB50\uAC00 \uB4E4\uC5B4\uC640
        \uC790\uB354\uB77C."
      activities: 9
      periods: 15
    - id: practical.04.7
      topic: animals
      text: "\uB3D9\uBB3C\uC740 \uC81C \uBAB8\uC5D0 \uB9DE\uB294 \uC790\uB9AC\uB97C
        \uC798 \uCC3E\uC544."
      activities: 9
      periods: 15
    - id: practical.05.0
      topic: clothes
      text: "\uC637\uC774 \uBA40\uCA61\uD55C\uB370 \uC8FC\uBA38\uB2C8\uB9CC \uB2F3\uC558\uB124."
      activities: 9
      periods: 15
    - id: practical.05.1
      topic: clothes
      text: "\uB450\uAEBC\uC6B4 \uC2E4\uC774 \uAF2D \uD2BC\uD2BC\uD55C \uAC74 \uC544\uB2C8\uC57C."
      activities: 9
      periods: 15
    - id: practical.05.2
      topic: clothes
      text: "\uB9E4\uB4ED\uC740 \uC791\uAC8C \uBB36\uC5B4\uC57C \uC548 \uAC78\uB824."
      activities: 9
      periods: 15
    - id: practical.05.3
      topic: clothes
      text: "\uC18C\uB9E4\uAC00 \uB113\uC73C\uBA74 \uC790\uAFB8 \uBB58 \uBB3B\uD788\uC9C0."
      activities: 9
      periods: 15
    - id: practical.05.4
      topic: clothes
      text: "\uC774 \uB048\uC740 \uB05D\uC744 \uC880 \uC798\uB77C\uC57C\uACA0\uC5B4."
      activities: 9
      periods: 15
    - id: practical.05.5
      topic: clothes
      text: "\uC798 \uBCF4\uC774\uB294 \uB370\uB9CC \uAFF0\uB9E4 \uB1A8\uAD6C\uB098."
      activities: 9
      periods: 15
    - id: practical.05.6
      topic: clothes
      text: "\uC67C\uCABD \uC2E0\uBC1C\uC774 \uBA3C\uC800 \uB2F3\uB294 \uBC84\uB987\uC774
        \uC788\uB124."
      activities: 9
      periods: 15
    - id: practical.05.7
      topic: clothes
      text: "\uC637 \uACE0\uB97C \uB54C \uC8FC\uBA38\uB2C8\uBD80\uD130 \uBCF4\uB294
        \uAC74 \uC5B4\uCA54 \uC218 \uC5C6\uC5B4."
      activities: 9
      periods: 15
    - id: practical.06.0
      topic: habits
      text: "\uBB3C\uAC74 \uBCF4\uBA74 \uC5B4\uB514\uAC00 \uBA3C\uC800 \uB2F3\uC744\uC9C0\uBD80\uD130
        \uBCF4\uAC8C \uB3FC."
      activities: 9
      periods: 15
    - id: practical.06.1
      topic: habits
      text: "\uB0A8\uB294 \uB048\uC744 \uBC84\uB9AC\uB824\uB2C8 \uC190\uC774 \uC548
        \uAC00\uB124."
      activities: 9
      periods: 15
    - id: practical.06.2
      topic: habits
      text: "\uD55C \uBC88 \uB354 \uB9CC\uC838 \uBCF4\uACE0 \uC2F6\uC740 \uBC84\uB987\uC774
        \uBB38\uC81C\uC57C."
      activities: 9
      periods: 15
    - id: practical.06.3
      topic: habits
      text: "\uB2E4 \uD588\uB2E4\uACE0 \uB193\uC73C\uBA74 \uAF2D \uB2E4\uC2DC \uBCF4\uAC8C
        \uB3FC."
      activities: 9
      periods: 15
    - id: practical.06.4
      topic: habits
      text: "\uC0DD\uAC01\uD560 \uB54C \uC5C4\uC9C0\uBD80\uD130 \uAD6C\uBD80\uB9AC\uB124."
      activities: 9
      periods: 15
    - id: practical.06.5
      topic: habits
      text: "\uAC00\uB9CC\uD788 \uC788\uC5B4\uB3C4 \uC190\uC73C\uB85C \uBB58 \uB9CC\uC9C0\uACE0
        \uC788\uC9C0."
      activities: 9
      periods: 15
    - id: practical.06.6
      topic: habits
      text: "\uB300\uCDA9\uC774 \uC548 \uB418\uB2C8\uAE4C \uC77C\uC774 \uB298\uC5B4\uB098\uB294
        \uAC70\uC57C."
      activities: 9
      periods: 15
    - id: practical.06.7
      topic: habits
      text: "\uC798 \uB9DE\uB294 \uC18C\uB9AC\uAC00 \uB098\uBA74 \uAE30\uBD84\uC774
        \uD480\uB824."
      activities: 9
      periods: 15
    - id: practical.07.0
      topic: plans
      text: "\uC9D1\uC5D0 \uAC00\uBA74 \uADF8 \uB69C\uAED1\uBD80\uD130 \uB9DE\uCDB0
        \uBD10\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: practical.07.1
      topic: plans
      text: "\uB2E4\uC74C\uC5D4 \uC190\uC7A1\uC774\uB97C \uC870\uAE08 \uC9E7\uAC8C
        \uD574 \uBCFC\uAE4C."
      activities: 9
      periods: 15
    - id: practical.07.2
      topic: plans
      text: "\uB0A8\uB294 \uCC9C\uC73C\uB85C \uBC14\uB2E5\uC744 \uB367\uB300\uBA74
        \uB418\uACA0\uB124."
      activities: 9
      periods: 15
    - id: practical.07.3
      topic: plans
      text: "\uBC14\uAD6C\uB2C8 \uBB34\uAC8C\uBD80\uD130 \uC904\uC5EC\uC57C\uACA0\uC5B4."
      activities: 9
      periods: 15
    - id: practical.07.4
      topic: plans
      text: "\uC78A\uAE30 \uC804\uC5D0 \uAE38\uC774\uB9CC \uC801\uC5B4 \uB458\uAC78."
      activities: 9
      periods: 15
    - id: practical.07.5
      topic: plans
      text: "\uC9D1\uC5D0 \uB454 \uAC78 \uD55C\uBC88 \uD480\uC5B4 \uBCF4\uACE0 \uC2F6\uB124."
      activities: 9
      periods: 15
    - id: practical.07.6
      topic: plans
      text: "\uC774\uBC88\uC5D4 \uCC98\uC74C\uBD80\uD130 \uB9DE\uB294 \uD06C\uAE30\uB85C
        \uACE8\uB77C\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: practical.07.7
      topic: plans
      text: "\uBC11\uC774 \uB113\uC73C\uBA74 \uB35C \uB118\uC5B4\uC9C0\uACA0\uB294\uB370."
      activities: 9
      periods: 15
    - id: practical.08.0
      topic: travel
      text: "\uB3CC\uC544\uAC00\uB294 \uAE38\uC774 \uD3B8\uD558\uBA74 \uADF8\uCABD\uC774
        \uB0AB\uC9C0."
      activities: 2
      periods: 15
    - id: practical.08.1
      topic: travel
      text: "\uBC1C\uB85C \uB2E4\uB2C8\uBA74 \uAE38 \uC0DD\uAE40\uC0C8\uAC00 \uAE30\uC5B5\uC5D0
        \uB0A8\uC544."
      activities: 2
      periods: 15
    - id: practical.08.2
      topic: travel
      text: "\uAC19\uC740 \uAE38\uB3C4 \uC9D0 \uB4E4\uBA74 \uB2E4\uB974\uAC8C \uB290\uAEF4\uC838."
      activities: 2
      periods: 15
    - id: practical.08.3
      topic: travel
      text: "\uC774\uCABD\uC73C\uB85C \uC624\uBA74 \uBC1C\uC740 \uC880 \uB35C \uC4F0\uACA0\uC9C0."
      activities: 2
      periods: 15
    - id: practical.08.4
      topic: travel
      text: "\uAC77\uB2E4 \uBCF4\uBA74 \uACE0\uCE60 \uBC29\uBC95\uC774 \uB5A0\uC624\uB974\uB354\uB77C\uACE0."
      activities: 2
      periods: 15
    - id: practical.08.5
      topic: travel
      text: "\uB3CC\uC544\uAC08 \uB54C \uC0B4 \uAC8C \uC788\uC5C8\uB294\uB370."
      activities: 2
      periods: 15
    - id: practical.08.6
      topic: travel
      text: "\uD55C \uC190\uC744 \uBE44\uC6CC \uB193\uACE0 \uB098\uC62C\uAC78."
      activities: 2
      periods: 15
    - id: practical.08.7
      topic: travel
      text: "\uAC70\uB9AC\uBCF4\uB2E4 \uC790\uAFB8 \uBA48\uCD94\uB294 \uAC8C \uD798\uB4E4\uC5B4."
      activities: 2
      periods: 15
    - id: practical.09.0
      topic: feet
      text: "\uBC11\uCC3D\uC774 \uC587\uC544\uC84C\uB098, \uBC1C\uC774 \uC608\uBBFC\uD574\uC84C\uB098."
      activities: 2
      periods: 15
    - id: practical.09.1
      topic: feet
      text: "\uBC1C\uB4A4\uAFC8\uCE58\uBD80\uD130 \uB514\uB514\uB2C8\uAE4C \uB35C
        \uD53C\uACE4\uD558\uB124."
      activities: 2
      periods: 15
    - id: practical.09.2
      topic: feet
      text: "\uC2E0\uBC1C \uC548\uCABD \uC774\uC74C\uC0C8\uAC00 \uAC70\uC2AC\uB824."
      activities: 2
      periods: 15
    - id: practical.09.3
      topic: feet
      text: "\uAC77\uB2E4\uAC00 \uACE0\uCE58\uACA0\uB2E4\uB294 \uAC74 \uC548 \uB418\uACA0\uB124."
      activities: 2
      periods: 15
    - id: practical.09.4
      topic: feet
      text: "\uB048\uC774 \uC9E7\uC544\uC11C \uB05D\uC774 \uC790\uAFB8 \uBE60\uC838."
      activities: 2
      periods: 15
    - id: practical.09.5
      topic: feet
      text: "\uC67C\uBC1C\uC774 \uBB34\uAC70\uC6B4 \uAC74 \uAE30\uBD84 \uD0D3\uC778\uAC00."
      activities: 2
      periods: 15
    - id: practical.09.6
      topic: feet
      text: "\uC2E0\uBC1C\uC774 \uC090\uAC71\uB300\uB294 \uB370\uB294 \uC774\uC720\uAC00
        \uC788\uC744 \uD150\uB370."
      activities: 2
      periods: 15
    - id: practical.09.7
      topic: feet
      text: "\uBA48\uCD9C \uB54C\uB9C8\uB2E4 \uBC11\uCC3D\uC774 \uBD99\uB294 \uB290\uB08C\uC774
        \uB098."
      activities: 2
      periods: 15
    - id: practical.10.0
      topic: effort
      text: "\uD55C \uBC88\uC5D0 \uD798\uC8FC\uC9C0 \uB9D0\uACE0 \uB098\uB220\uC11C."
      activities: 4
      periods: 15
    - id: practical.10.1
      topic: effort
      text: "\uC190\uC774 \uBA3C\uC800 \uAC00\uBA74 \uB208\uC774 \uBABB \uB530\uB77C\uC640."
      activities: 4
      periods: 15
    - id: practical.10.2
      topic: effort
      text: "\uC774\uBC88\uC5D4 \uC5B4\uAE0B\uB09C \uB370\uAC00 \uC5C6\uB124."
      activities: 4
      periods: 15
    - id: practical.10.3
      topic: effort
      text: "\uC544, \uC774\uB807\uAC8C \uC7A1\uC73C\uBA74 \uB35C \uD798\uB4E4\uAD6C\uB098."
      activities: 4
      periods: 15
    - id: practical.10.4
      topic: effort
      text: "\uC21C\uC11C\uB97C \uBC14\uAFB8\uB2C8\uAE4C \uC77C\uC774 \uC904\uC5C8\uC5B4."
      activities: 4
      periods: 15
    - id: practical.10.5
      topic: effort
      text: "\uC5EC\uAE30\uAE4C\uC9C0 \uD574 \uB450\uBA74 \uC190\uC774 \uC880 \uD3B8\uD558\uC9C0."
      activities: 4
      periods: 15
    - id: practical.10.6
      topic: effort
      text: "\uB9C8\uC9C0\uB9C9\uC5D0 \uD798\uC8FC\uBA74 \uB2E4\uC2DC \uBC8C\uC5B4\uC9C8
        \uD150\uB370."
      activities: 4
      periods: 15
    - id: practical.10.7
      topic: effort
      text: "\uC190\uBAA9\uC744 \uC138\uC6B0\uC9C0 \uB9D0\uC558\uC5B4\uC57C \uD588\uB124."
      activities: 4
      periods: 15
    - id: practical.11.0
      topic: mistakes
      text: "\uC695\uC2EC\uB0B8 \uB9CC\uD07C \uB2E4\uC2DC \uC190 \uAC00\uB124."
      activities: 4
      periods: 15
    - id: practical.11.1
      topic: mistakes
      text: "\uC798 \uB9DE\uB294 \uC904 \uC54C\uC558\uB294\uB370 \uD55C\uCABD\uB9CC
        \uB9DE\uC558\uC5B4."
      activities: 4
      periods: 15
    - id: practical.11.2
      topic: mistakes
      text: "\uC774\uAC78 \uBE7C\uBA39\uACE0 \uBB58 \uB2E4 \uD588\uB2E4\uB294 \uAC70\uC57C."
      activities: 4
      periods: 15
    - id: practical.11.3
      topic: mistakes
      text: "\uC544\uAE4C \uC870\uAE08 \uB0A8\uACA8 \uB480\uC5B4\uC57C \uD588\uB294\uB370."
      activities: 4
      periods: 15
    - id: practical.11.4
      topic: mistakes
      text: "\uACE0\uCE5C \uB370 \uC606\uC774 \uB610 \uB9D0\uC37D\uC774\uB124."
      activities: 4
      periods: 15
    - id: practical.11.5
      topic: mistakes
      text: "\uC548 \uB418\uBA74 \uC7A0\uAE50 \uB193\uACE0 \uB2E4\uC2DC \uBCF4\uBA74
        \uB3FC."
      activities: 4
      periods: 15
    - id: practical.11.6
      topic: mistakes
      text: "\uC190\uAC00\uB77D\uBD80\uD130 \uD480\uC5B4\uC57C\uACA0\uC5B4."
      activities: 4
      periods: 15
    - id: practical.11.7
      topic: mistakes
      text: "\uBD84\uBA85 \uC26C\uC6B4 \uBC29\uBC95\uC774 \uD558\uB098 \uB354 \uC788\uC744
        \uD150\uB370."
      activities: 4
      periods: 15
    - id: practical.12.0
      topic: dawn
      text: "\uC544\uCE68\uC5D4 \uC190\uC774 \uC880 \uAD7C\uB728\uB124."
      activities: 9
      periods: 1
    - id: practical.12.1
      topic: dawn
      text: "\uC77C\uC5B4\uB098\uC790\uB9C8\uC790 \uBB58 \uCC3E\uACE0 \uC788\uB124,
        \uB610."
      activities: 9
      periods: 1
    - id: practical.12.2
      topic: dawn
      text: "\uC7A0\uACB0\uC5D0 \uC0DD\uAC01\uD55C \uBC29\uBC95\uC774 \uAD1C\uCC2E\uC558\uB294\uB370."
      activities: 9
      periods: 1
    - id: practical.12.3
      topic: dawn
      text: "\uCC2C\uBB3C \uB9CC\uC9C0\uAE30 \uC804\uC5D0 \uC190\uBD80\uD130 \uD3B4\uC57C\uACA0\uC5B4."
      activities: 9
      periods: 1
    - id: practical.12.4
      topic: dawn
      text: "\uAFC8\uC5D0\uC11C\uAE4C\uC9C0 \uACE0\uCE58\uACE0 \uC788\uC5C8\uC9C0
        \uBB50\uC57C."
      activities: 9
      periods: 1
    - id: practical.12.5
      topic: dawn
      text: "\uC5B4\uC81C \uD574 \uB454 \uAC8C \uC788\uC73C\uB2C8 \uB35C \uBC14\uC058\uACA0\uB124."
      activities: 9
      periods: 1
    - id: practical.12.6
      topic: dawn
      text: "\uC544\uCE68\uBC25 \uBA39\uAE30 \uC804\uC5D4 \uC77C\uC744 \uBC8C\uC774\uBA74
        \uC548 \uB418\uB294\uB370."
      activities: 9
      periods: 1
    - id: practical.12.7
      topic: dawn
      text: "\uC544\uC9C1 \uC190\uC5D0 \uD798\uC774 \uB35C \uB4E4\uC5B4\uAC00\uB124."
      activities: 9
      periods: 1
    - id: practical.13.0
      topic: dusk
      text: "\uC9D1\uC5D0 \uAC00\uBA74 \uC190\uBD80\uD130 \uC53B\uC5B4\uC57C\uACA0\uC5B4."
      activities: 9
      periods: 4
    - id: practical.13.1
      topic: dusk
      text: "\uB0B4\uC77C \uC4F8 \uAC74 \uB530\uB85C \uBE7C \uB46C\uC57C\uC9C0."
      activities: 9
      periods: 4
    - id: practical.13.2
      topic: dusk
      text: "\uB9C8\uC800 \uD558\uACA0\uB2E4\uACE0 \uD558\uBA74 \uC800\uB141\uC744
        \uB193\uCCD0."
      activities: 9
      periods: 4
    - id: practical.13.3
      topic: dusk
      text: "\uC624\uB298 \uC4F4 \uB9CC\uD07C\uC740 \uC815\uB9AC\uD574 \uB194\uC57C\uC9C0."
      activities: 9
      periods: 4
    - id: practical.13.4
      topic: dusk
      text: "\uD574\uAC00 \uAC00\uAE30 \uC804\uC5D0 \uCC59\uAE38 \uAC8C \uC788\uC5C8\uB294\uB370."
      activities: 9
      periods: 4
    - id: practical.13.5
      topic: dusk
      text: "\uC800\uB141 \uBA39\uB2E4\uAC00\uB3C4 \uC0DD\uAC01\uC774 \uB098\uACA0\uB124."
      activities: 9
      periods: 4
    - id: practical.13.6
      topic: dusk
      text: "\uB0A8\uC740 \uAC74 \uC190\uB304 \uC21C\uC11C\uB300\uB85C \uC801\uC5B4
        \uB450\uC790."
      activities: 9
      periods: 4
    - id: practical.13.7
      topic: dusk
      text: "\uC624\uB298\uC740 \uC774 \uC190\uC73C\uB85C \uAF64 \uB9CE\uC774 \uD588\uB124."
      activities: 9
      periods: 4
    - id: practical.14.0
      topic: night
      text: "\uC5B4\uB450\uC6B8 \uB54C \uC190\uB300\uBA74 \uAD1C\uD788 \uB354 \uB9DD\uAC00\uB728\uB824."
      activities: 9
      periods: 8
    - id: practical.14.1
      topic: night
      text: "\uBC24\uC5D4 \uC791\uC740 \uB370\uAC00 \uC798 \uC548 \uBCF4\uC774\uB124."
      activities: 9
      periods: 8
    - id: practical.14.2
      topic: night
      text: "\uC190\uC740 \uBA48\uCDC4\uB294\uB370 \uBA38\uB9AC\uB85C \uACC4\uC18D
        \uACE0\uCE58\uB124."
      activities: 9
      periods: 8
    - id: practical.14.3
      topic: night
      text: "\uC774\uB7EC\uB2E4 \uB204\uC6CC\uC11C\uB3C4 \uAE38\uC774\uB97C \uC7AC\uACA0\uC5B4."
      activities: 9
      periods: 8
    - id: practical.14.4
      topic: night
      text: "\uB0B4\uC77C \uBCF4\uBA74 \uB354 \uC798 \uBCF4\uC774\uACA0\uC9C0."
      activities: 9
      periods: 8
    - id: practical.14.5
      topic: night
      text: "\uB2A6\uAC8C\uAE4C\uC9C0 \uBD99\uB4E4\uBA74 \uAF2D \uD558\uB098\uB97C
        \uBE7C\uBA39\uB354\uB77C."
      activities: 9
      periods: 8
    - id: practical.14.6
      topic: night
      text: "\uC7A0\uB4E4\uAE30 \uC804\uC5D0 \uC190\uC5D0 \uAE30\uB984\uC774\uB098
        \uBC1C\uB77C\uC57C\uC9C0."
      activities: 9
      periods: 8
    - id: practical.14.7
      topic: night
      text: "\uBC24\uC5D0 \uB09C \uC18C\uB9AC\uB294 \uC5B4\uB514\uAC00 \uC6B8\uB9AC\uB294\uC9C0
        \uD5F7\uAC08\uB824."
      activities: 9
      periods: 8
    - id: practical.15.0
      topic: rest
      text: "\uC190\uC744 \uD3B4\uACE0 \uC26C\uB2C8\uAE4C \uC190\uBC14\uB2E5\uC774
        \uB2F9\uAE30\uB124."
      activities: 8
      periods: 15
    - id: practical.15.1
      topic: rest
      text: "\uC7A0\uAE50 \uB193\uC73C\uB2C8 \uC548 \uB418\uB358 \uC774\uC720\uAC00
        \uBCF4\uC774\uB124."
      activities: 8
      periods: 15
    - id: practical.15.2
      topic: rest
      text: "\uC549\uC740 \uAE40\uC5D0 \uC2E0\uBC1C \uB048\uC774\uB098 \uACE0\uCCD0
        \uBB36\uC744\uAE4C."
      activities: 8
      periods: 15
    - id: practical.15.3
      topic: rest
      text: "\uC26C\uB294\uB370 \uC77C\uC744 \uCC3E\uC73C\uBA74 \uC548 \uB418\uC9C0."
      activities: 8
      periods: 15
    - id: practical.15.4
      topic: rest
      text: "\uC190\uAC00\uB77D \uAD00\uC808\uC774 \uB530\uB85C\uB530\uB85C \uC26C\uB294
        \uB290\uB08C\uC774\uC57C."
      activities: 8
      periods: 15
    - id: practical.15.5
      topic: rest
      text: "\uD5C8\uB9AC \uD3B4\uACE0 \uC549\uC73C\uB824\uB2C8 \uB610 \uC5B4\uC0C9\uD558\uB124."
      activities: 8
      periods: 15
    - id: practical.15.6
      topic: rest
      text: "\uD55C \uBC88 \uC77C\uC5B4\uB098\uBA74 \uB2E4\uC2DC \uC190\uC774 \uAC08
        \uD150\uB370."
      activities: 8
      periods: 15
    - id: practical.15.7
      topic: rest
      text: "\uAC00\uB9CC\uB450\uB294 \uAC8C \uC81C\uC77C \uC5B4\uB824\uC6B4 \uC77C\uC774\uB124."
      activities: 8
      periods: 15
  - id: reserved
    direction: "\uC815\uB3C8\uB41C \uAC11\uC637\uC774\uB098 \uB2E8\uB2E8\uD55C \uCC28\uB9BC.
      \uC0AC\uB78C\uACFC \uAC70\uB9AC\uB97C \uB450\uC9C0\uB9CC \uAC70\uCE60\uC9C0
      \uC54A\uACE0, \uC18C\uC74C\uACFC \uC5B4\uAE0B\uB09C \uBD80\uBD84\uC5D0 \uC608\uBBFC\uD558\uB2E4.
      \uACFC\uBB35\uD568\uC744 \uBA85\uB839\uD615\uC73C\uB85C \uD45C\uD604\uD558\uC9C0
      \uC54A\uB294\uB2E4. \uBC18\uB9D0 \uD63C\uC7A3\uB9D0."
    lines:
    - id: reserved.00.0
      topic: lost
      text: "\uC5C6\uC5B4\uC9C4 \uAC8C \uC544\uB2C8\uB77C \uB0B4\uAC00 \uC62E\uACBC\uACA0\uC9C0."
      activities: 9
      periods: 15
    - id: reserved.00.1
      topic: lost
      text: "\uC548\uCABD\uC5D0 \uB123\uC740 \uAC74 \uAE30\uC5B5\uB098\uB294\uB370."
      activities: 9
      periods: 15
    - id: reserved.00.2
      topic: lost
      text: "\uD55C\uCABD\uB9CC \uB0A8\uC744 \uBB3C\uAC74\uC740 \uC544\uB2CC\uB370."
      activities: 9
      periods: 15
    - id: reserved.00.3
      topic: lost
      text: "\uB2E4\uC2DC \uBCF4\uBA74 \uC0DD\uAC01\uB098\uB824\uB098."
      activities: 9
      periods: 15
    - id: reserved.00.4
      topic: lost
      text: "\uC5B4\uB514\uC11C \uC190\uC744 \uBE44\uC6E0\uB294\uC9C0\uBD80\uD130."
      activities: 9
      periods: 15
    - id: reserved.00.5
      topic: lost
      text: "\uC8FC\uBA38\uB2C8\uB97C \uB2E4 \uD655\uC778\uD588\uB098?"
      activities: 9
      periods: 15
    - id: reserved.00.6
      topic: lost
      text: "\uB108\uBB34 \uAE4A\uC774 \uB123\uC5B4 \uB450\uC5C8\uB124."
      activities: 9
      periods: 15
    - id: reserved.00.7
      topic: lost
      text: "\uCC3E\uB294 \uD2F0\uB294 \uC548 \uB0C8\uC73C\uBA74 \uC88B\uACA0\uB294\uB370."
      activities: 9
      periods: 15
    - id: reserved.01.0
      topic: food
      text: "\uADF8 \uBE75\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uBD80\uB4DC\uB7EC\uC6E0\uC5B4."
      activities: 9
      periods: 15
    - id: reserved.01.1
      topic: food
      text: "\uAD6D\uC740 \uC2DD\uACE0 \uB098\uC11C \uAC04\uC774 \uB354 \uC138\uC9C0\uB124."
      activities: 9
      periods: 15
    - id: reserved.01.2
      topic: food
      text: "\uBC30\uC5D0\uC11C \uC18C\uB9AC\uB9CC \uC548 \uB098\uBA74 \uC88B\uACA0\uB294\uB370."
      activities: 9
      periods: 15
    - id: reserved.01.3
      topic: food
      text: "\uB9F5\uC9C0 \uC54A\uB2E4\uB354\uB2C8 \uB05D\uC5D0 \uB9F5\uB354\uB77C."
      activities: 9
      periods: 15
    - id: reserved.01.4
      topic: food
      text: "\uC5B4\uC81C \uBA39\uC740 \uAC8C \uC544\uC9C1\uB3C4 \uC0DD\uAC01\uB098\uB124."
      activities: 9
      periods: 15
    - id: reserved.01.5
      topic: food
      text: "\uC2E0 \uC74C\uC2DD\uC740 \uD55C \uC785\uC774\uBA74 \uC7A0\uC774 \uAE68."
      activities: 9
      periods: 15
    - id: reserved.01.6
      topic: food
      text: "\uC870\uC6A9\uD788 \uBA39\uB294 \uAC8C \uD3B8\uD574."
      activities: 9
      periods: 15
    - id: reserved.01.7
      topic: food
      text: "\uD070 \uC870\uAC01\uC744 \uC9D1\uC740 \uAC74 \uC880 \uD6C4\uD68C\uB3FC."
      activities: 9
      periods: 15
    - id: reserved.02.0
      topic: expenses
      text: "\uC0B4 \uC0DD\uAC01\uC774 \uC5C6\uC73C\uBA74 \uC624\uB798 \uBCF4\uC9C8
        \uB9D0\uC544\uC57C\uC9C0."
      activities: 9
      periods: 15
    - id: reserved.02.1
      topic: expenses
      text: "\uAC12\uC740 \uAD1C\uCC2E\uC740\uB370 \uB4E4\uACE0 \uB2E4\uB2C8\uAE34
        \uD06C\uB124."
      activities: 9
      periods: 15
    - id: reserved.02.2
      topic: expenses
      text: "\uD544\uC694\uD55C \uAC8C \uBB54\uC9C0\uB294 \uC54C\uACE0 \uB098\uC654\uB294\uB370."
      activities: 9
      periods: 15
    - id: reserved.02.3
      topic: expenses
      text: "\uBB3C\uC5B4\uB9CC \uBCF4\uACE0 \uAC00\uAE30\uAC00 \uB354 \uC5B4\uB835\uB124."
      activities: 9
      periods: 15
