{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_Integrated_ReactivePhaseBoss",
    "displayName": "Test Integrated Reactive Phase Boss",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_Bokusei.asset",
    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": true,
        "optimalCombatDistance": 2.8,
        "minCombatDistance": 1.2,
        "personalSpaceDistance": 0.8,
        "guardChance": 0.25,
        "retreatChance": 0.18,
        "circleWeight": 1.0
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "NoTargetSearch",
            "priority": 920,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "PatrolOrIdle" }
            ]
        },
        {
            "name": "BerserkPointBlankReaction",
            "priority": 900,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsEnemyPhase", "value": "1" },
                { "condition": "IsPlayerAttacking" },
                { "condition": "DistanceLessOrEqual", "value": "1.6" }
            ],
            "select": "WeightedRandom",
            "choices": [
                { "weight": 0.45, "action": "Transition", "state": "Dodge" },
                { "weight": 0.35, "action": "Transition", "state": "Counter" },
                { "weight": 0.20, "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "BerserkComboPressure",
            "priority": 870,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsEnemyPhase", "value": "1" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "3.2" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "AggressivePhaseCharge",
            "priority": 840,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsEnemyPhase", "value": "0" },
                { "condition": "DistanceGreater", "value": "2.8" }
            ],
            "do": [
                { "action": "Transition", "state": "Charge" }
            ]
        },
        {
            "name": "ReactToPointBlankAttack",
            "priority": 820,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerAttacking" },
                { "condition": "DistanceLessOrEqual", "value": "1.5" }
            ],
            "select": "WeightedRandom",
            "choices": [
                { "weight": 0.50, "action": "Transition", "state": "Dodge" },
                { "weight": 0.25, "action": "Transition", "state": "Counter" },
                { "weight": 0.25, "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "ReactToCloseAttack",
            "priority": 790,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerAttacking" },
                { "condition": "DistanceLessOrEqual", "value": "2.8" }
            ],
            "select": "WeightedRandom",
            "choices": [
                { "weight": 0.30, "action": "Transition", "state": "Guard" },
                { "weight": 0.30, "action": "Transition", "state": "Dodge" },
                { "weight": 0.20, "action": "Transition", "state": "Counter" },
                { "weight": 0.20, "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "PunishPlayerRecovery",
            "priority": 760,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerRecovering" },
                { "condition": "DistanceLessOrEqual", "value": "3.0" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "GuardBreakResponse",
            "priority": 730,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerGuarding" },
                { "condition": "DistanceLessOrEqual", "value": "2.5" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "StandardAttack",
            "priority": 680,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "TooCloseSpacing",
            "priority": 600,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "ChaseTarget",
            "priority": 450,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Chase" }
            ]
        },
        {
            "name": "CombatIdleDecision",
            "priority": 100,
            "select": "WeightedRandom",
            "choices": [
                { "weight": 1.20, "action": "Transition", "state": "Circle" },
                { "weightKey": "guardChance", "action": "Transition", "state": "Guard" },
                { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                { "weight": 0.35, "action": "Transition", "state": "Flank" }
            ]
        }
    ]
}
