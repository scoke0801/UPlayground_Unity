if(!UnityEngine.Application.isPlaying || UnityEditor.SessionState.GetString("VegetationConversion.PlayOwner","")!="20261114")return "실행 소유 확인 필요";
var world=UnityEngine.Object.FindFirstObjectByType<UPlayGround.Manager.WorldStateManager>();var scene=UnityEngine.SceneManagement.SceneManager.GetSceneByPath("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");if(world==null||!scene.isLoaded)return "대기";
var targets=new System.Collections.Generic.List<UPlayGround.Gameplay.World.ReactiveEnvironment.ReactiveEnvironmentObject>();foreach(var root in scene.GetRootGameObjects())targets.AddRange(root.GetComponentsInChildren<UPlayGround.Gameplay.World.ReactiveEnvironment.ReactiveEnvironmentObject>(true));var target=targets.Find(x=>x.isActiveAndEnabled&&x.IsAlive()&&x.Definition.reaction.canIgnite&&!x.Definition.reaction.canBreak);if(target==null)return "가연 대상 없음";
UnityEditor.EditorApplication.isPaused=true;var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;var export=typeof(UPlayGround.Manager.WorldStateManager).GetMethod("ExportEnvironment",flags);var import=typeof(UPlayGround.Manager.WorldStateManager).GetMethod("ImportEnvironment",flags);var tick=typeof(UPlayGround.Manager.WorldStateManager).GetMethod("TickEnvironment",flags);var baseline=new UPlayGround.Data.Save.WorldStateSaveData();bool captured=false;var report=new System.Text.StringBuilder();
try{export.Invoke(world,new object[]{baseline});captured=true;var arranged=new UPlayGround.Data.Save.WorldStateSaveData();export.Invoke(world,new object[]{arranged});foreach(var record in arranged.reactiveEnvironment)if(record.guid==target.StableId){record.state=new UPlayGround.Core.ReactiveEnvironment.EnvironmentReactionState{fuel=target.Definition.reaction.initialFuel,durability=target.Definition.reaction.maxDurability};record.pendingHeat=record.pendingWater=record.pendingContinuousWater=0;record.tickRemainder=0;}import.Invoke(world,new object[]{arranged});
System.Func<UnityEngine.MaterialPropertyBlock,UnityEngine.Vector4> readSurface = property => { if(!property.HasFloat("_EnvironmentReactionIndex") || property.GetFloat("_EnvironmentReactionIndex")<0) return property.GetVector("_EnvState0"); var bt=typeof(UPlayGround.Gameplay.World.ReactiveEnvironment.ReactiveEnvironmentSurface).Assembly.GetType("UPlayGround.Gameplay.World.ReactiveEnvironment.EnvironmentSurfaceStateBuffer"); var bf=System.Reflection.BindingFlags.Static|System.Reflection.BindingFlags.NonPublic; bt.GetMethod("Flush",bf).Invoke(null,null); var managed=(System.Array)bt.GetField("_values",bf).GetValue(null); var element=managed.GetType().GetElementType(); var result=System.Array.CreateInstance(element,1); ((UnityEngine.ComputeBuffer)bt.GetField("_buffer",bf).GetValue(null)).GetData(result,0,(int)property.GetFloat("_EnvironmentReactionIndex"),1); return (UnityEngine.Vector4)element.GetField("surface").GetValue(result.GetValue(0)); };bool acceptedHeat=target.TryApplyImpact(202611140001UL,0,0,1,0);var watch=System.Diagnostics.Stopwatch.StartNew();tick.Invoke(world,new object[]{0.4f});long tickMs=watch.ElapsedMilliseconds;var fire=target.State;var bindings=(UPlayGround.Gameplay.World.ReactiveEnvironment.EnvironmentSurfaceBinding[])typeof(UPlayGround.Gameplay.World.ReactiveEnvironment.ReactiveEnvironmentObject).GetField("_surfaceBindings",flags).GetValue(target);var block=new UnityEngine.MaterialPropertyBlock();bindings[0].renderer.GetPropertyBlock(block,bindings[0].slots[0]);var fireVector=readSurface(block);
