var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||EditorApplication.isCompiling||scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity")throw new Exception("월드 Edit Mode 필요");
var folder="output/OpenWorld/LandmarkSites";var root=GameObject.Find("AuthoredEnvironment/랜드마크 유적 구역");if(root==null)throw new Exception("배치 누락");
var surface=GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>();surface.BuildNavMesh();if(surface.navMeshData==null)throw new Exception("NavMesh 생성 실패");
string navAssetPath="Assets/10.Datas/World/OpenWorld/LandmarkSitesNavigation.asset";var saved=AssetDatabase.LoadAssetAtPath<UnityEngine.AI.NavMeshData>(navAssetPath);
if(saved==null)AssetDatabase.CreateAsset(surface.navMeshData,navAssetPath);else{var baked=surface.navMeshData;surface.RemoveData();EditorUtility.CopySerialized(baked,saved);EditorUtility.SetDirty(saved);AssetDatabase.SaveAssetIfDirty(saved);surface.navMeshData=saved;surface.AddData();}EditorUtility.SetDirty(surface);
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var parse=json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/OpenWorld/landmark-sites-plan.json"),typeof(Dictionary<string,object>));var sites=(Dictionary<string,object>[])read(plan["sites"].ToString(),typeof(Dictionary<string,object>[]));
var report=new System.Text.StringBuilder();int missing=0,materials=0,passed=0,failed=0;var terrain=Terrain.activeTerrain;
foreach(var t in root.GetComponentsInChildren<Transform>(true))missing+=GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject);
foreach(var r in root.GetComponentsInChildren<Renderer>(true))foreach(var m in r.sharedMaterials)if(m==null||m.shader==null||m.shader.name.Contains("InternalError"))materials++;
report.AppendLine("Missing Script="+missing+" / 재질·셰이더 오류="+materials);
foreach(var site in sites){int routeIndex=0;foreach(var route in (Dictionary<string,object>[])read(site["paths"].ToString(),typeof(Dictionary<string,object>[]))){
 var points=(float[][])read(route["points"].ToString(),typeof(float[][]));var hits=new List<Vector3>();bool sample=true,complete=true;float longest=0;
 foreach(var p in points){var pos=new Vector3(p[0],0,p[1]);pos.y=terrain.SampleHeight(pos)+terrain.transform.position.y;UnityEngine.AI.NavMeshHit hit;if(!UnityEngine.AI.NavMesh.SamplePosition(pos,out hit,4,UnityEngine.AI.NavMesh.AllAreas)){sample=false;break;}hits.Add(hit.position);}
 var path=new UnityEngine.AI.NavMeshPath();if(sample)for(int k=1;k<hits.Count;k++)foreach(bool reverse in new[]{false,true}){var a=hits[reverse?k:k-1];var b=hits[reverse?k-1:k];bool ok=UnityEngine.AI.NavMesh.CalculatePath(a,b,UnityEngine.AI.NavMesh.AllAreas,path)&&path.status==UnityEngine.AI.NavMeshPathStatus.PathComplete;complete&=ok;float distance=0;if(ok)for(int j=1;j<path.corners.Length;j++)distance+=Vector3.Distance(path.corners[j-1],path.corners[j]);if(ok)longest=Mathf.Max(longest,distance/Mathf.Max(1,Vector3.Distance(a,b)));if(!ok)report.AppendLine("경로 실패 "+a+" → "+b);}
 if(sample&&complete)passed++;else failed++;report.AppendLine(site["name"]+" 경로 "+(routeIndex++)+" / 표본="+sample+" / 양방향="+complete+" / 최대 우회비="+longest.ToString("F2"));
 }}
var ids=string.Join("\n",scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).Select(c=>c.Guid+"|"+c.transform.position.ToString("F4")).OrderBy(s=>s));bool same=ids==System.IO.File.ReadAllText(folder+"/identities-before.txt");
report.AppendLine("기존 ID·좌표 동일="+same+" / 경로 통과="+passed+" 실패="+failed);System.IO.File.WriteAllText(folder+"/identities-after.txt",ids);
var manifest=new System.Text.StringBuilder("name,group,x,y,z\n");foreach(var t in root.GetComponentsInChildren<Transform>(true).Where(t=>PrefabUtility.IsOutermostPrefabInstanceRoot(t.gameObject)))manifest.AppendLine(t.name+","+t.parent.name+","+t.position.x+","+t.position.y+","+t.position.z);
System.IO.File.WriteAllText(folder+"/placements.csv",manifest.ToString());System.IO.File.WriteAllText(folder+"/audit.txt",report.ToString());UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return report.ToString();
