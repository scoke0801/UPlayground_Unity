// 저장된 검토 씬의 보존·내비게이션 검사를 수행한다. 실제 TPS 조작 검사가 아니다.
var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||s.path!="Assets/01.Scenes/ArtReview/WorldThemes/LakeReworkR2.unity")throw new Exception("검토 씬 필요");
var t=Terrain.activeTerrain;var d=t.terrainData;var original=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/Terrain.asset");
var all=s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var types=new[]{"SceneEntityId","SceneArrivalPoint","PortalActor","FlowGraphTriggerVolume"};
var protectedObjects=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&types.Contains(c.GetType().Name)).ToArray();
var groundChanges=protectedObjects.Select(c=>new{name=c.name,type=c.GetType().Name,pos=c.transform.position.ToString(),delta=t.SampleHeight(c.transform.position)-original.GetInterpolatedHeight(c.transform.position.x/2400,(c.transform.position.z+700)/2800)}).Where(v=>Mathf.Abs(v.delta)>.05f).ToArray();
var newRoots=new[]{"LakeRework_CanopyMasses","LakeRework_ContinuousOutcrops","LakeRework_SlopeCanopy","WestLakeBackdrop"}.Select(n=>GameObject.Find(n)).Where(g=>g!=null).ToArray();
var newColliders=new HashSet<Collider>(newRoots.SelectMany(g=>g.GetComponentsInChildren<Collider>()));
Physics.SyncTransforms(); var collisions=new List<string>();foreach(var c in protectedObjects){var hits=Physics.OverlapSphere(c.transform.position+Vector3.up,1,-1,QueryTriggerInteraction.Ignore).Where(v=>newColliders.Contains(v));foreach(var hit in hits)collisions.Add(c.name+" / "+hit.name);}
var surface=GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>();
var targets=new[]{new Vector3(1090,0,818),new Vector3(1120,0,747),new Vector3(1000,0,720),new Vector3(1077,0,1045),new Vector3(765,0,1063),new Vector3(1047,0,807),new Vector3(1068,0,1110),new Vector3(1096,0,838)};
Func<TerrainData,string[]> routes=terrain=>{var rows=new List<string>();var start=new Vector3(1067,terrain.GetInterpolatedHeight(1067f/2400,1415f/2800),715);UnityEngine.AI.NavMeshHit a;if(!UnityEngine.AI.NavMesh.SamplePosition(start,out a,5,UnityEngine.AI.NavMesh.AllAreas))return new[]{"입구 NavMesh 샘플 실패"};foreach(var target in targets){var p=target;p.y=terrain.GetInterpolatedHeight(p.x/2400,(p.z+700)/2800);UnityEngine.AI.NavMeshHit b;if(!UnityEngine.AI.NavMesh.SamplePosition(p,out b,5,UnityEngine.AI.NavMesh.AllAreas)){rows.Add(target+" NoSample");continue;}var path=new UnityEngine.AI.NavMeshPath();UnityEngine.AI.NavMesh.CalculatePath(a.position,b.position,UnityEngine.AI.NavMesh.AllAreas,path);rows.Add(target+" "+path.status+" corners="+path.corners.Length);}return rows.ToArray();};
var after=routes(d);string[] before;surface.RemoveData();var old=UnityEngine.AI.NavMesh.AddNavMeshData(AssetDatabase.LoadAssetAtPath<UnityEngine.AI.NavMeshData>("Assets/10.Datas/World/OpenWorld/DungeonContinuityNavigation.asset"));try{before=routes(original);}finally{old.Remove();surface.AddData();}
var report=new{scene=s.path,s.isDirty,playing=EditorApplication.isPlaying,compilationFailed=EditorUtility.scriptCompilationFailed,missingScripts=all.Sum(q=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(q.gameObject)),privateTerrain=AssetDatabase.GetAssetPath(d),privateNavigation=AssetDatabase.GetAssetPath(surface.navMeshData),heightTextureShared=d.heightmapTexture==original.heightmapTexture,alphaTexturesShared=d.alphamapTextures.Any(v=>original.alphamapTextures.Contains(v)),waterHeight=GameObject.Find("LakeWater").transform.position.y,protectedGroundChanges=groundChanges,newColliderContentOverlaps=collisions,beforeRoutes=before,afterRoutes=after,scope="EditMode 데이터·경로 검사. TPS 사용자 테스트 대기"};
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(v=>v!=null);string text=(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{report});System.IO.File.WriteAllText("output/LakeReworkR2/final-validation.json",text);return report;

