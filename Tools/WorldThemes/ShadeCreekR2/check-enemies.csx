var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(s.path!="Assets/01.Scenes/ArtReview/WorldThemes/ShadeCreekR2.unity"||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("R2 Edit 필요");
var data=AssetDatabase.LoadAssetAtPath<UPlayGround.Data.World.WorldPlacementDataSO>(AssetDatabase.GUIDToAssetPath("2819d64223022c84b9a62983354d6ecb"));var links=new List<string>();
foreach(var c in s.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<MonoBehaviour>(true)).Where(c=>c!=null)){var so=new SerializedObject(c);var p=so.GetIterator();while(p.NextVisible(true))if(p.propertyType==SerializedPropertyType.ObjectReference&&p.objectReferenceValue==data)links.Add(c.GetType().FullName+"."+p.propertyPath);}
if(links.Count==0)throw new Exception("현재 씬의 실제 배치 연결 없음");var rows=data.Records.Where(r=>r.position.x>1500&&r.position.x<1810&&r.position.z>680&&r.position.z<980&&!string.IsNullOrEmpty(r.actorId)).Select(r=>new{r.actorId,r.groupGuid,r.sceneEntityGuid,r.groupName,r.monsterChaseDistance,p=new[]{r.position.x,r.position.y,r.position.z}}).ToArray();var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var result=new{data=AssetDatabase.GetAssetPath(data),links,rows,scope="현재 연결 배치 읽기. AI·Ability·추격 값 수정 없음. 비행 적 미확인, 통과 판정 없음"};System.IO.File.WriteAllText("output/ShadeCreekR2/placed-enemies.json",(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return result;
