      text: "\uC544\uB07C\uB358 \uBC18\uCC2C\uC774 \uBA3C\uC800 \uC26C\uC5B4 \uBC84\uB9AC\uB354\uB77C."
      activities: 9
      periods: 15
    - id: seasoned.01.7
      topic: food
      text: "\uBC25 \uB0A8\uAE30\uC9C0 \uB9D0\uB7AC\uB354\uB2C8 \uB0B4 \uAC83\uAE4C\uC9C0
