if(Application.dataPath.Replace('\\','/')!="C:/UsingProject/UnityProject/UPlayground/Assets")throw new Exception("프로젝트 불일치");
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});var lease=(Dictionary<string,string>)jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock"),typeof(Dictionary<string,string>)});if(lease["owner"]!="B")throw new Exception("B 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/CloudridgeR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 B 필요");
string stage=System.IO.File.ReadAllText("Tools/WorldThemes/CloudridgeR1/stage.txt").Trim();var route=new[]{new Vector3(1040,0,1410),new Vector3(1080,0,1370),new Vector3(1145,0,1300),new Vector3(1225,0,1265),new Vector3(1310,0,1310),new Vector3(1400,0,1365),new Vector3(1360,0,1420)};var terrain=Terrain.activeTerrain;for(int i=0;i<route.Length;i++)route[i].y=terrain.SampleHeight(route[i])+terrain.transform.position.y;
Func<Vector3,Vector3,object> check=(a,b)=>{UnityEngine.AI.NavMeshHit start,end;bool foundA=UnityEngine.AI.NavMesh.SamplePosition(a,out start,3,-1),foundB=UnityEngine.AI.NavMesh.SamplePosition(b,out end,3,-1);var path=new UnityEngine.AI.NavMeshPath();bool calculated=foundA&&foundB&&UnityEngine.AI.NavMesh.CalculatePath(start.position,end.position,-1,path);return new{from=new[]{a.x,a.y,a.z},to=new[]{b.x,b.y,b.z},foundA,foundB,calculated,status=calculated?path.status.ToString():"NoPath",corners=path.corners.Length,length=path.corners.Zip(path.corners.Skip(1),(p,q)=>Vector3.Distance(p,q)).Sum()};};
var paths=new List<object>();for(int i=0;i<route.Length-1;i++){paths.Add(check(route[i],route[i+1]));paths.Add(check(route[i+1],route[i]));}
var loaders=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<MonoBehaviour>(true)).Where(c=>c!=null&&c.GetType().Name=="RuntimePlacementLoader").ToArray();var datasets=loaders.Select(c=>new SerializedObject(c).FindProperty("_placementData").objectReferenceValue as UPlayGround.Data.World.WorldPlacementDataSO).Where(d=>d!=null).Distinct().ToArray();if(datasets.Length==0)throw new Exception("실제 연결 배치 없음");
var definitions=AssetDatabase.FindAssets("t:ActorDefinitionSO").Select(g=>AssetDatabase.LoadAssetAtPath<UPlayGround.Data.Actor.ActorDefinitionSO>(AssetDatabase.GUIDToAssetPath(g))).Where(d=>d!=null).ToArray();var enemies=new List<object>();
foreach(var dataset in datasets)foreach(var r in dataset.Records.Where(r=>r.position.x>1080&&r.position.x<1440&&r.position.z>1190&&r.position.z<1440&&!string.IsNullOrEmpty(r.actorId))){var matches=definitions.Where(d=>d.actorId==r.actorId).ToArray();var definition=matches.Length==1?matches[0]:null;var prefab=definition==null?null:definition.prefab;var flying=prefab==null?new MonoBehaviour[0]:prefab.GetComponentsInChildren<MonoBehaviour>(true).Where(c=>c!=null&&c.GetType().Name=="EnemyFlyingAIController").ToArray();var q=route.OrderBy(p=>(new Vector2(p.x-r.position.x,p.z-r.position.z)).sqrMagnitude).First();enemies.Add(new{dataset=AssetDatabase.GetAssetPath(dataset),r.actorId,r.placementGuid,r.sceneEntityGuid,r.groupGuid,r.groupName,r.monsterChaseDistance,position=new[]{r.position.x,r.position.y,r.position.z},definition=definition==null?null:AssetDatabase.GetAssetPath(definition),definitionMatches=matches.Length,prefab=prefab==null?null:AssetDatabase.GetAssetPath(prefab),flyingComponents=flying.Select(c=>new{type=c.GetType().FullName,c.enabled,active=c.gameObject.activeSelf}).ToArray(),outbound=check(r.position,q),inbound=check(q,r.position),scope="지상 NavMesh 왕복만 검사. 비행 전투·추격·착지는 별도 TPS 검증"});}
System.IO.File.WriteAllText("output/CloudridgeR1/paths-"+stage+".json",json(new{routePaths=paths,enemies,linkedPlacementAssets=datasets.Select(d=>AssetDatabase.GetAssetPath(d)).ToArray(),method="정적 NavMesh. 실제 입력·AI 실행·비행 통과를 뜻하지 않음"}));return new{routePaths=paths,enemies=enemies.Count};
