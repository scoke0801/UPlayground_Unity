{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_SearchPatrol_ReactivePhase",
    "displayName": "Test Search Patrol Reactive Phase",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_Bokusei.asset",
    "blackboard": {
        "tickInterval": 0.06,
        "enablePatrol": true,
        "optimalCombatDistance": 2.8,
        "minCombatDistance": 1.2,
        "personalSpaceDistance": 0.85,
        "guardChance": 0.28,
        "retreatChance": 0.18,
        "circleWeight": 1.1,
        "aggression": 0.55,
        "reactionChance": 0.45,
        "counterChance": 0.22,
        "dodgeChance": 0.34,
        "punishRecoveryChance": 0.36,
        "antiGuardChance": 0.32,
        "minRetreatCooldown": 1.5,
        "maxComboPressureCount": 3,
        "preferredRange": 2.8,
        "recentHitCount": 0,
        "lastHitReactionType": "",
        "poiseRatio": 1.0,
        "isPoiseBroken": false,
        "hitReactionLockTime": 0.0,
        "revengeChance": 0.28
    },
    "groups": [
        {
            "name": "01 Interrupt And Target Search",
            "priority": 1000,
            "rules": [
                {
                    "name": "BlockedState",
                    "priority": 1000,
                    "when": [
                        { "condition": "IsBlockedEnemyState" }
                    ],
                    "do": [
                        { "action": "KeepCurrentState" }
                    ]
                },
                {
                    "name": "SearchFailedPatrol",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget", "invert": true }
                    ],
                    "do": [
                        { "action": "PatrolOrIdle" }
                    ]
                }
            ]
        },
        {
            "name": "02 Emergency Reactions",
            "priority": 950,
            "rules": [
                {
                    "name": "PoiseBreakRetreatOrCounter",
                    "priority": 950,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPoiseBroken" },
                        { "condition": "CooldownReady", "value": "PoiseBreakReaction" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "dodgeChance", "action": "Transition", "state": "Dodge" },
                        { "weight": 0.35, "action": "Transition", "state": "Retreat" },
                        { "weightKey": "counterChance", "action": "Transition", "state": "Counter" }
                    ]
                },
                {
                    "name": "RevengeAfterLightHit",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "RecentlyHitByPlayer" },
                        { "condition": "CanIgnoreLightHit" },
                        { "condition": "CanRevengeAfterHit", "value": "1.5" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "revengeChance", "action": "Transition", "state": "Counter" },
                        { "weightKey": "guardChance", "action": "Transition", "state": "Guard" },
                        { "weight": 0.20, "action": "Transition", "state": "Circle" }
                    ]
                },
                {
                    "name": "RepeatedHitDisengage",
                    "priority": 860,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "RecentHitCountGreaterOrEqual", "value": "3" },
                        { "condition": "CooldownReady", "value": "RepeatedHitReaction" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "dodgeChance", "action": "Transition", "state": "Dodge" },
                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                        { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" }
                    ]
                }
            ]
        },
        {
            "name": "03 Phase Branch",
            "priority": 900,
            "rules": [
                {
                    "name": "Phase1AggressiveReactToAttack",
                    "priority": 900,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "1" },
                        { "condition": "IsPlayerAttacking" },
                        { "condition": "DistanceLessOrEqual", "value": "2.6" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.35, "action": "Transition", "state": "Guard" },
                        { "weight": 0.45, "action": "Transition", "state": "Dodge" },
                        { "weight": 0.20, "action": "Transition", "state": "Retreat" }
                    ]
                },
                {
                    "name": "Phase1SkillPressure",
                    "priority": 860,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "1" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "3.4" },
                        { "condition": "CanUseSkill" }
                    ],
                    "do": [
                        { "action": "RequestAttackSlot" },
                        { "action": "ExecuteAttack" }
                    ]
                },
                {
                    "name": "Phase0KeepPressure",
                    "priority": 820,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsEnemyPhase", "value": "0" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.65, "action": "Transition", "state": "Chase" },
                        { "weight": 0.35, "action": "Transition", "state": "Circle" }
                    ]
                }
            ]
        },
        {
            "name": "04 Target Combat",
            "priority": 800,
            "rules": [
                {
                    "name": "ReactGuardOrDodgeWhenTargetAttacks",
                    "priority": 840,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "IsPlayerAttacking" },
                        { "condition": "DistanceLessOrEqual", "value": "2.8" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "guardChance", "action": "Transition", "state": "Guard" },
                        { "weight": 0.32, "action": "Transition", "state": "Dodge" },
                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                        { "weight": 0.16, "action": "Transition", "state": "Circle" }
                    ]
                },
                {
                    "name": "AttackRollBasicHeavySkill",
                    "priority": 760,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.55, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.30, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.15, "action": "ExecuteAttack", "attackCategory": "Skill" }
                    ]
                },
                {
                    "name": "RetreatFromPointBlank",
                    "priority": 700,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Retreat" }
                    ]
                }
            ]
        },
        {
            "name": "05 Positioning",
            "priority": 600,
            "rules": [
                {
                    "name": "ApproachSearchSuccessTarget",
                    "priority": 520,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
                    ],
                    "do": [
                        { "action": "Transition", "state": "Chase" }
                    ]
                },
                {
                    "name": "TargetOrbitAndSpacing",
                    "priority": 220,
                    "when": [
                        { "condition": "HasTarget" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" },
                        { "weight": 0.40, "action": "Transition", "state": "Flank" },
                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                        { "weightKey": "guardChance", "action": "Transition", "state": "Guard" }
                    ]
                }
            ]
        }
    ],
    "rules": []
}
