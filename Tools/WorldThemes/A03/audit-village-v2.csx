// 최종 독립 씬의 데이터·원본 보존·네이티브 환경 계약을 읽기 검수한다.
string output="output/WorldThemeProduction/VillageFields/v2",hostPath="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity",scenePath="Assets/01.Scenes/ArtReview/WorldThemes/WorkingCopies/Theme_VillageFields_V2.unity";
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(hostPath);var scene=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(scenePath);if(EditorApplication.isPlayingOrWillChangePlaymode||EditorUtility.scriptCompilationFailed)throw new Exception("정상 Edit Mode 필요");
if(!host.IsValid()||!host.isLoaded||!scene.IsValid()||!scene.isLoaded)throw new Exception("실제 로딩된 원본과 새 작업 씬 필요");
var loadedSceneStates=new List<object>();for(int si=0;si<UnityEngine.SceneManagement.SceneManager.sceneCount;si++){var sc=UnityEngine.SceneManagement.SceneManager.GetSceneAt(si);loadedSceneStates.Add(new{path=sc.path,isValid=sc.IsValid(),isLoaded=sc.isLoaded,dirty=sc.isDirty});}
var source=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var terrain=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var a=source.terrainData;var b=terrain.terrainData;
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(x=>x.GetType("Newtonsoft.Json.JsonConvert")).First(x=>x!=null);var parse=jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});
var baseline=(Dictionary<string,object>)read(System.IO.File.ReadAllText("output/WorldThemeProduction/A00/live-baseline.json"),typeof(Dictionary<string,object>));var priorIds=(Dictionary<string,object>[])read(baseline["ids"].ToString(),typeof(Dictionary<string,object>[]));var expectedPlan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/A03/v2-production-plan.json"),typeof(Dictionary<string,object>));
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
int heightChanges=0;var ah=a.GetHeights(0,0,a.heightmapResolution,a.heightmapResolution);var bh=b.GetHeights(0,0,b.heightmapResolution,b.heightmapResolution);for(int z=0;z<ah.GetLength(0);z++)for(int x=0;x<ah.GetLength(1);x++)if(ah[z,x]!=bh[z,x])heightChanges++;
int detailChanges=0;var detailRows=new List<object>();for(int l=0;l<a.detailPrototypes.Length;l++){var ad=a.GetDetailLayer(0,0,a.detailWidth,a.detailHeight,l);var bd=b.GetDetailLayer(0,0,b.detailWidth,b.detailHeight,l);int changed=0;long sum=0;for(int z=0;z<ad.GetLength(0);z++)for(int x=0;x<ad.GetLength(1);x++){if(ad[z,x]!=bd[z,x])changed++;sum+=bd[z,x];}detailChanges+=changed;detailRows.Add(new{index=l,changed=changed,sum=sum,prototypeEqual=a.detailPrototypes[l].Equals(b.detailPrototypes[l])});}
int alphaOutside=0,alphaInside=0;var aa=a.GetAlphamaps(0,0,a.alphamapWidth,a.alphamapHeight);var ba=b.GetAlphamaps(0,0,b.alphamapWidth,b.alphamapHeight);for(int z=0;z<aa.GetLength(0);z++)for(int x=0;x<aa.GetLength(1);x++)for(int l=0;l<aa.GetLength(2);l++)if(aa[z,x,l]!=ba[z,x,l]){float wx=(x+.5f)/a.alphamapWidth*2400f,wz=-700f+(z+.5f)/a.alphamapHeight*2800f;if(wx<1010||wx>1135||wz<340||wz>395)alphaOutside++;else alphaInside++;}
var ids=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).ToArray();int identityMismatch=0;float maxPositionDelta=0,maxGroundDelta=0;
foreach(var old in priorIds){var id=ids.FirstOrDefault(i=>i.Guid==old["id"].ToString());if(id==null){identityMismatch++;continue;}var p=(float[])read(old["position"].ToString(),typeof(float[]));maxPositionDelta=Mathf.Max(maxPositionDelta,Vector3.Distance(id.transform.position,new Vector3(p[0],p[1],p[2])));maxGroundDelta=Mathf.Max(maxGroundDelta,Mathf.Abs(source.SampleHeight(id.transform.position)+source.transform.position.y-Convert.ToSingle(old["ground"])));}
var root=scene.GetRootGameObjects().Single(g=>g.name=="ThemeEnvironment");Physics.SyncTransforms();int footprintOutside=0,centralCorridorOverlap=0;float maxCentreSupportGap=0;int plantCount=0;
var plants=new HashSet<Transform>();foreach(var renderer in root.GetComponentsInChildren<MeshRenderer>(true)){var lod=renderer.GetComponentInParent<LODGroup>();plants.Add(lod==null?renderer.transform:lod.transform);}foreach(var plant in plants){plantCount++;var rs=plant.GetComponentsInChildren<MeshRenderer>(true);var bounds=rs[0].bounds;foreach(var r in rs)bounds.Encapsulate(r.bounds);if(bounds.min.x<1010||bounds.max.x>1135||bounds.min.z<340||bounds.max.z>395)footprintOutside++;if(bounds.max.x>1086&&bounds.min.x<1096)centralCorridorOverlap++;float ground=terrain.SampleHeight(plant.position)+terrain.transform.position.y;maxCentreSupportGap=Mathf.Max(maxCentreSupportGap,Mathf.Abs(bounds.min.y-ground));}
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();int missing=all.Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject));var scripts=all.SelectMany(t=>t.GetComponents<MonoBehaviour>()).Where(m=>m!=null).Select(m=>m.GetType().FullName).Distinct().ToArray();var forbidden=scripts.Where(n=>n.Contains("SceneEntityId")||n.Contains("SceneContext")||n.Contains("NpcLife")||n.Contains("GameActor")||n.Contains("WorldLighting")||n.Contains("ContinuousWorld")).ToArray();var renderers=all.SelectMany(t=>t.GetComponents<MeshRenderer>()).ToArray();int nullMaterials=renderers.Sum(r=>r.sharedMaterials.Count(m=>m==null));int unsupported=renderers.Sum(r=>r.sharedMaterials.Count(m=>m!=null&&!m.shader.isSupported));
bool sharedAlpha=b.alphamapTextures.Any(t=>a.alphamapTextures.Any(s=>s==t));bool sharedHeight=a.heightmapTexture==b.heightmapTexture;
string sceneHash=hash(hostPath),terrainHash=hash(AssetDatabase.GetAssetPath(a));
System.IO.File.WriteAllText(output+"/loaded-scenes-v2.json",(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{loadedSceneStates}));
var result=new{version="VillageFields-v2",heightChanges,detailChanges,detail=detailRows,alphaOutside,alphaInside,scatterEqual=a.detailScatterMode==b.detailScatterMode,treeInstancesEqual=a.treeInstances.SequenceEqual(b.treeInstances),internalAlphaShared=sharedAlpha,internalHeightShared=sharedHeight,sourceIdentityCount=ids.Length,identityMismatch,maxPositionDelta,maxGroundDelta,plantCount,footprintOutside,centralCorridorOverlap,maxCentreSupportGap,missingScripts=missing,forbiddenContentComponents=forbidden,nullMaterials,unsupportedShaders=unsupported,environmentScripts=root.GetComponentsInChildren<MonoBehaviour>(true).Length,environmentColliders=root.GetComponentsInChildren<Collider>(true).Length,sourceSceneHash=sceneHash,sourceTerrainHash=terrainHash,sourceSceneDirty=host.isDirty,sourceTerrainDirty=EditorUtility.IsDirty(a),themeSceneDirty=scene.isDirty,activeScene=UnityEngine.SceneManagement.SceneManager.GetActiveScene().path,play=EditorApplication.isPlaying,compileFailed=EditorUtility.scriptCompilationFailed,pipeline=QualitySettings.renderPipeline==null?"None":QualitySettings.renderPipeline.name};
System.IO.File.WriteAllText(output+"/validation-v2.json",(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));
if(heightChanges!=0||detailChanges!=0||alphaOutside!=0||identityMismatch!=0||maxPositionDelta>.0001f||maxGroundDelta>.0001f||sharedAlpha||sharedHeight||footprintOutside!=0||centralCorridorOverlap!=0||missing!=0||forbidden.Length!=0||nullMaterials!=0||unsupported!=0||sceneHash!=expectedPlan["expectedSceneHash"].ToString()||terrainHash!=expectedPlan["expectedTerrainHash"].ToString())throw new Exception("A03 보존/기술 검수 실패. validation.json 참조");
return "A03 final data audit PASS plants="+plantCount+" outsideAlpha=0 height/detail=0 identities="+ids.Length+" supportGap="+maxCentreSupportGap;
