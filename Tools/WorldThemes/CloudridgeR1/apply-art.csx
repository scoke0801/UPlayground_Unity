if(Application.dataPath.Replace('\\','/')!="C:/UsingProject/UnityProject/UPlayground/Assets")throw new Exception("프로젝트 불일치");
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});Func<string,Type,object> read=(p,t)=>jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText(p),t});
var lease=(Dictionary<string,string>)read("Tools/WorldThemes/AgentCoordination/editor.lock",typeof(Dictionary<string,string>));if(lease["owner"]!="B")throw new Exception("B 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/CloudridgeR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode||EditorApplication.isCompiling||EditorUtility.scriptCompilationFailed)throw new Exception("저장된 B Edit 필요");
string folder="Assets/10.Datas/World/ThemeStudies/CloudridgeR1/";var terrain=Terrain.activeTerrain;var d=terrain.terrainData;var baseline=AssetDatabase.LoadAssetAtPath<TerrainData>(folder+"BaselineTerrain.asset");if(AssetDatabase.GetAssetPath(d)!=folder+"Terrain.asset")throw new Exception("전용 지형 필요");
if(System.IO.File.Exists("output/CloudridgeR1/art-pass.json"))throw new Exception("반복 실행 금지: 결과 확인 후 별도 보정");
var settings=(Dictionary<string,float[]>)read("Tools/WorldThemes/CloudridgeR1/surface-plan.json",typeof(Dictionary<string,float[]>));var disabledIds=(string[])read("Tools/WorldThemes/CloudridgeR1/disable-ids.json",typeof(string[]));
var selected=new List<Transform>();foreach(string id in disabledIds){GlobalObjectId key;if(!GlobalObjectId.TryParse(id,out key))throw new Exception(id);var t=GlobalObjectId.GlobalObjectIdentifierToObjectSlow(key) as Transform;if(t==null||t.gameObject.scene!=scene||!t.gameObject.activeSelf)throw new Exception("배치 전제 불일치: "+id);if(t.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true).Length>0)throw new Exception("보호 콘텐츠 포함: "+id);selected.Add(t);}
var sceneRows=selected.Select(t=>new{id=GlobalObjectId.GetGlobalObjectIdSlow(t.gameObject).ToString(),transformId=GlobalObjectId.GetGlobalObjectIdSlow(t).ToString(),property="m_IsActive",before=true,after=false,position=new[]{t.position.x,t.position.y,t.position.z},prefab=PrefabUtility.GetPrefabAssetPathOfNearestInstanceRoot(t.gameObject)}).ToArray();
foreach(var t in selected){Undo.RecordObject(t.gameObject,"고원 조망 열기");t.gameObject.SetActive(false);PrefabUtility.RecordPrefabInstancePropertyModifications(t.gameObject);}
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();var protectedPoints=all.SelectMany(t=>t.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&new[]{"SceneEntityId","SceneArrivalPoint","PortalActor","FlowGraphTriggerVolume","WildlifeCreature"}.Contains(c.GetType().Name)).Select(c=>c.transform.position).ToArray();
var loaders=all.SelectMany(t=>t.GetComponents<MonoBehaviour>()).Where(c=>c!=null&&c.GetType().Name=="RuntimePlacementLoader").ToArray();
var placementData=loaders.Select(c=>new SerializedObject(c).FindProperty("_placementData").objectReferenceValue as UPlayGround.Data.World.WorldPlacementDataSO).Where(v=>v!=null).Distinct().ToArray();
if(placementData.Length==0)throw new Exception("실제 연결 배치 데이터 미확인");
protectedPoints=protectedPoints.Concat(placementData.SelectMany(v=>v.Records).Select(r=>r.position)).Where(p=>p.x>1080&&p.x<1440&&p.z>1180&&p.z<1420).ToArray();
System.IO.File.WriteAllText("output/CloudridgeR1/protected-points.json",json(new{placementAssets=placementData.Select(v=>AssetDatabase.GetAssetPath(v)).ToArray(),points=protectedPoints.Select(p=>new[]{p.x,p.y,p.z}).ToArray(),scope="씬 콘텐츠·야생동물과 실제 연결된 런타임 배치 지지면 보호"}));
var supports=all.SelectMany(t=>t.GetComponents<Collider>()).Where(c=>c.enabled&&c.gameObject.activeInHierarchy&&!c.isTrigger&&!(c is TerrainCollider)).Select(c=>c.bounds).Where(b=>b.max.x>1115&&b.min.x<1405&&b.max.z>1218&&b.min.z<1382).ToArray();
var routes=new[]{new[]{new Vector2(1040,1410),new Vector2(1080,1370),new Vector2(1145,1300),new Vector2(1225,1265),new Vector2(1310,1310),new Vector2(1400,1365),new Vector2(1360,1420)},new[]{new Vector2(800,1230),new Vector2(1040,1410),new Vector2(1190,1450),new Vector2(1360,1420),new Vector2(1490,1330),new Vector2(1580,1220),new Vector2(1630,1100)}};
Func<Vector2,float> routeDistance=p=>{float distance=9999;foreach(var route in routes)for(int i=0;i<route.Length-1;i++){var v=route[i+1]-route[i];distance=Mathf.Min(distance,Vector2.Distance(p,route[i]+v*Mathf.Clamp01(Vector2.Dot(p-route[i],v)/v.sqrMagnitude)));}return distance;};
float[] ellipse=settings["ellipse"],protect=settings["protection"];
Func<float,float,float> mask=(x,z)=>1-Mathf.SmoothStep(0,1,Mathf.InverseLerp(.72f,1,Mathf.Sqrt(Mathf.Pow((x-ellipse[0])/ellipse[2],2)+Mathf.Pow((z-ellipse[1])/ellipse[3],2))));
Func<Vector2,float> protection=p=>{float w=Mathf.SmoothStep(0,1,Mathf.InverseLerp(protect[0],protect[0]+8,routeDistance(p)));foreach(var q in protectedPoints)w*=Mathf.SmoothStep(0,1,Mathf.InverseLerp(protect[1],protect[1]+8,Vector2.Distance(p,new Vector2(q.x,q.z))));foreach(var b in supports){float dx=Mathf.Max(b.min.x-p.x,0,p.x-b.max.x),dz=Mathf.Max(b.min.z-p.y,0,p.y-b.max.z);w*=Mathf.SmoothStep(0,1,Mathf.InverseLerp(protect[2],protect[2]+6,Mathf.Sqrt(dx*dx+dz*dz)));}return w;};
int x0=Mathf.FloorToInt(1115/d.size.x*(d.heightmapResolution-1)),z0=Mathf.FloorToInt((1218-terrain.transform.position.z)/d.size.z*(d.heightmapResolution-1));int x1=Mathf.CeilToInt(1405/d.size.x*(d.heightmapResolution-1)),z1=Mathf.CeilToInt((1382-terrain.transform.position.z)/d.size.z*(d.heightmapResolution-1));
var heights=baseline.GetHeights(x0,z0,x1-x0+1,z1-z0+1);var heightRows=new List<float[]>();
for(int z=0;z<heights.GetLength(0);z++)for(int x=0;x<heights.GetLength(1);x++){float wx=(x+x0)*d.size.x/(d.heightmapResolution-1),wz=terrain.transform.position.z+(z+z0)*d.size.z/(d.heightmapResolution-1);float amount=0;for(int j=0;j<3;j++){var h=settings["shoulder"+j];amount+=h[4]*Mathf.Exp(-Mathf.Pow((wx-h[0])/h[2],2)-Mathf.Pow((wz-h[1])/h[3],2));}amount*=mask(wx,wz)*protection(new Vector2(wx,wz));if(amount<.002f)continue;float old=heights[z,x];heights[z,x]+=amount/d.size.y;heightRows.Add(new[]{x+x0,z+z0,old,heights[z,x]});}
d.SetHeights(x0,z0,heights);
var oldLayers=baseline.terrainLayers;var layerList=oldLayers.ToList();var sources=new[]{"Assets/10.Datas/World/OpenWorld/LakeVisualV2/Meadow.terrainlayer","Assets/10.Datas/World/OpenWorld/ResourceOverhaul/Ground_3.terrainlayer","Assets/10.Datas/World/OpenWorld/RedForestVisualR1/WeatheredRock.terrainlayer"};var keys=new[]{"meadow","dry","rock"};
for(int i=0;i<sources.Length;i++){string path=folder+keys[i]+".terrainlayer";if(!AssetDatabase.CopyAsset(sources[i],path))throw new Exception("레이어 복제 실패");var layer=AssetDatabase.LoadAssetAtPath<TerrainLayer>(path);var v=settings[keys[i]];layer.tileSize=new Vector2(v[0],v[0]);layer.diffuseRemapMax=new Vector4(v[1],v[2],v[3],1);layer.normalScale=.22f;layer.smoothness=.02f;EditorUtility.SetDirty(layer);AssetDatabase.SaveAssetIfDirty(layer);layerList.Add(layer);}
var before=baseline.GetAlphamaps(0,0,baseline.alphamapWidth,baseline.alphamapHeight);var alpha=new float[d.alphamapHeight,d.alphamapWidth,layerList.Count];for(int z=0;z<d.alphamapHeight;z++)for(int x=0;x<d.alphamapWidth;x++)for(int l=0;l<oldLayers.Length;l++)alpha[z,x,l]=before[z,x,l];d.terrainLayers=layerList.ToArray();
var surfaceRows=new List<object>();
for(int z=0;z<d.alphamapHeight;z++)for(int x=0;x<d.alphamapWidth;x++){
float wx=x*d.size.x/(d.alphamapWidth-1),wz=terrain.transform.position.z+z*d.size.z/(d.alphamapHeight-1);float w=mask(wx,wz);if(w<=0)continue;float distance=routeDistance(new Vector2(wx,wz));float pathWeight=1-Mathf.SmoothStep(0,1,Mathf.InverseLerp(1.5f,4.5f,distance));float slope=d.GetSteepness(wx/d.size.x,(wz-terrain.transform.position.z)/d.size.z);float rockWeight=Mathf.SmoothStep(0,1,Mathf.InverseLerp(19,34,slope))*.65f*(1-pathWeight);float dryWeight=(.13f+.32f*Mathf.PerlinNoise(wx*.019f,wz*.019f))*(1-pathWeight)*(1-rockWeight);float meadowWeight=1-pathWeight-rockWeight-dryWeight;
var old=new float[oldLayers.Length];var next=new float[layerList.Count];for(int l=0;l<oldLayers.Length;l++){old[l]=before[z,x,l];alpha[z,x,l]=old[l]*(1-w);}alpha[z,x,5]+=w*pathWeight;alpha[z,x,oldLayers.Length]+=w*meadowWeight;alpha[z,x,oldLayers.Length+1]+=w*dryWeight;alpha[z,x,oldLayers.Length+2]+=w*rockWeight;for(int l=0;l<next.Length;l++)next[l]=alpha[z,x,l];surfaceRows.Add(new{x,z,before=old,after=next});
}
d.SetAlphamaps(0,0,alpha);d.SetBaseMapDirty();terrain.Flush();EditorUtility.SetDirty(d);AssetDatabase.SaveAssetIfDirty(d);UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);
System.IO.File.WriteAllText("output/CloudridgeR1/scene-changes.json",json(sceneRows));System.IO.File.WriteAllText("output/CloudridgeR1/terrain-height-delta.json",json(new{coordinateSpace="heightmap normalized height; world origin and size in clone.json",columns=new[]{"x","z","before","after"},resolution=d.heightmapResolution,rows=heightRows}));
System.IO.File.WriteAllText("output/CloudridgeR1/terrain-surface-delta.json",json(new{coordinateSpace="alphamap; x/z world mapping uses resolution-1",resolution=d.alphamapResolution,beforeLayerGuids=oldLayers.Select(l=>AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(l))).ToArray(),afterLayerGuids=layerList.Select(l=>AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(l))).ToArray(),rows=surfaceRows}));
var result=new{disabled=sceneRows.Length,heightCells=heightRows.Count,maxHeightMetres=heightRows.Count==0?0:heightRows.Max(r=>(r[3]-r[2])*d.size.y),surfaceCells=surfaceRows.Count,protectedPoints=protectedPoints.Length,supports=supports.Length,scope=settings["ellipse"],baselineLayerCount=oldLayers.Length,newLayerCount=layerList.Count};System.IO.File.WriteAllText("output/CloudridgeR1/art-pass.json",json(result));return result;


