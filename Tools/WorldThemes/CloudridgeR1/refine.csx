if(Application.dataPath.Replace('\\','/')!="C:/UsingProject/UnityProject/UPlayground/Assets")throw new Exception("프로젝트 불일치");
var jsonType=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jsonType.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});Func<string,Type,object> read=(p,t)=>jsonType.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText(p),t});
var lease=(Dictionary<string,string>)read("Tools/WorldThemes/AgentCoordination/editor.lock",typeof(Dictionary<string,string>));if(lease["owner"]!="B")throw new Exception("B 작업권 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/CloudridgeR1.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode||EditorUtility.scriptCompilationFailed)throw new Exception("저장된 B 필요");
if(System.IO.File.Exists("output/CloudridgeR1/refine-pass.json"))throw new Exception("반복 실행 금지");
var settings=(Dictionary<string,float[]>)read("Tools/WorldThemes/CloudridgeR1/refine-plan.json",typeof(Dictionary<string,float[]>));
string folder="Assets/10.Datas/World/ThemeStudies/CloudridgeR1/";var terrain=Terrain.activeTerrain;var d=terrain.terrainData;if(AssetDatabase.GetAssetPath(d)!=folder+"Terrain.asset")throw new Exception("전용 지형 필요");
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var supports=all.SelectMany(t=>t.GetComponents<Collider>()).Where(c=>c.enabled&&c.gameObject.activeInHierarchy&&!c.isTrigger&&!(c is TerrainCollider)).Select(c=>c.bounds).Where(b=>b.max.x>1180&&b.min.x<1245&&b.max.z>1218&&b.min.z<1255).ToArray();
var route=new[]{new Vector2(1040,1410),new Vector2(1080,1370),new Vector2(1145,1300),new Vector2(1225,1265),new Vector2(1310,1310),new Vector2(1400,1365),new Vector2(1360,1420)};
Func<Vector2,float> distance=p=>{float min=9999;for(int i=0;i<route.Length-1;i++){var v=route[i+1]-route[i];min=Mathf.Min(min,Vector2.Distance(p,route[i]+v*Mathf.Clamp01(Vector2.Dot(p-route[i],v)/v.sqrMagnitude)));}return min;};
var notch=settings["notch"];int x0=Mathf.FloorToInt(1180/d.size.x*(d.heightmapResolution-1)),x1=Mathf.CeilToInt(1245/d.size.x*(d.heightmapResolution-1)),z0=Mathf.FloorToInt((1218+700)/d.size.z*(d.heightmapResolution-1)),z1=Mathf.CeilToInt((1255+700)/d.size.z*(d.heightmapResolution-1));var heights=d.GetHeights(x0,z0,x1-x0+1,z1-z0+1);int cuts=0;float maxCut=0;
for(int z=0;z<heights.GetLength(0);z++)for(int x=0;x<heights.GetLength(1);x++){float wx=(x+x0)*d.size.x/(d.heightmapResolution-1),wz=-700+(z+z0)*d.size.z/(d.heightmapResolution-1);float edge=Mathf.SmoothStep(0,1,Mathf.InverseLerp(1218,1225,wz))*Mathf.SmoothStep(0,1,Mathf.InverseLerp(1255,1247,wz))*Mathf.SmoothStep(0,1,Mathf.InverseLerp(1180,1188,wx))*Mathf.SmoothStep(0,1,Mathf.InverseLerp(1245,1237,wx));float protect=Mathf.SmoothStep(0,1,Mathf.InverseLerp(6,13,distance(new Vector2(wx,wz))));foreach(var b in supports){float dx=Mathf.Max(b.min.x-wx,0,wx-b.max.x),dz=Mathf.Max(b.min.z-wz,0,wz-b.max.z);protect*=Mathf.SmoothStep(0,1,Mathf.InverseLerp(2,6,Mathf.Sqrt(dx*dx+dz*dz)));}float amount=notch[4]*Mathf.Exp(-Mathf.Pow((wx-notch[0])/notch[2],2)-Mathf.Pow((wz-notch[1])/notch[3],2))*edge*protect;if(amount<.002f)continue;heights[z,x]-=amount/d.size.y;maxCut=Mathf.Max(maxCut,amount);cuts++;}
d.SetHeights(x0,z0,heights);
string prefabPath=folder+"ShortGrass.prefab",materialPath=folder+"ShortGrass.mat";if(!AssetDatabase.CopyAsset("Assets/10.Datas/World/OpenWorld/LakeVisualV2/MeadowGrass.prefab",prefabPath)||!AssetDatabase.CopyAsset("Assets/10.Datas/World/OpenWorld/LakeVisualV2/MeadowGrass.mat",materialPath))throw new Exception("잔디 분리 실패");
var material=AssetDatabase.LoadAssetAtPath<Material>(materialPath);foreach(var pair in new[]{new[]{"_ColorTop","grassColorTop"},new[]{"_ColorBottom","grassColorBottom"},new[]{"_ColorTopVariation","grassColorVariation"}}){var c=settings[pair[1]];if(material.HasProperty(pair[0]))material.SetColor(pair[0],new Color(c[0],c[1],c[2],c[3]));}EditorUtility.SetDirty(material);AssetDatabase.SaveAssetIfDirty(material);
var prefab=PrefabUtility.LoadPrefabContents(prefabPath);try{foreach(var renderer in prefab.GetComponentsInChildren<Renderer>(true))renderer.sharedMaterial=material;PrefabUtility.SaveAsPrefabAsset(prefab,prefabPath);}finally{PrefabUtility.UnloadPrefabContents(prefab);}
var originalPrototypes=d.detailPrototypes;var maps=Enumerable.Range(0,originalPrototypes.Length).Select(i=>d.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,i)).ToArray();var shortMap=new int[d.detailHeight,d.detailWidth];var newProto=new DetailPrototype();foreach(var property in typeof(DetailPrototype).GetProperties(System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance))if(property.CanRead&&property.CanWrite&&property.GetIndexParameters().Length==0)property.SetValue(newProto,property.GetValue(originalPrototypes[6],null),null);newProto.prototype=AssetDatabase.LoadAssetAtPath<GameObject>(prefabPath);var scale=settings["grassScale"];newProto.minHeight=scale[0];newProto.maxHeight=scale[1];newProto.minWidth=scale[2];newProto.maxWidth=scale[3];
int detailCells=0;
for(int z=0;z<d.detailHeight;z++)for(int x=0;x<d.detailWidth;x++){float wx=(x+.5f)*d.size.x/d.detailWidth,wz=-700+(z+.5f)*d.size.z/d.detailHeight;float radius=Mathf.Sqrt(Mathf.Pow((wx-1260)/145,2)+Mathf.Pow((wz-1300)/82,2));float w=1-Mathf.SmoothStep(0,1,Mathf.InverseLerp(.72f,1,radius));if(w<=0)continue;float pathClear=Mathf.SmoothStep(0,1,Mathf.InverseLerp(2.4f,5,distance(new Vector2(wx,wz))));float slope=d.GetSteepness(wx/d.size.x,(wz+700)/d.size.z);float slopeWeight=1-Mathf.SmoothStep(0,1,Mathf.InverseLerp(19,32,slope));float grouping=.3f+.7f*Mathf.SmoothStep(0,1,Mathf.InverseLerp(.25f,.65f,Mathf.PerlinNoise(wx*.028f,wz*.028f)));float density=Mathf.Lerp(settings["density"][0],settings["density"][1],grouping);for(int i=0;i<3;i++)maps[i][z,x]=Mathf.RoundToInt(maps[i][z,x]*(1-w));shortMap[z,x]=Mathf.RoundToInt(density*w*pathClear*slopeWeight);detailCells++;}
d.detailPrototypes=originalPrototypes.Concat(new[]{newProto}).ToArray();for(int i=0;i<maps.Length;i++)d.SetDetailLayer(0,0,i,maps[i]);d.SetDetailLayer(0,0,maps.Length,shortMap);d.SetBaseMapDirty();terrain.Flush();EditorUtility.SetDirty(d);AssetDatabase.SaveAssetIfDirty(d);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);
var result=new{cuts,maxCut,notchBounds=new[]{1180,1245,1218,1255},detailCells,oldPrototypes=originalPrototypes.Length,newPrototypes=d.detailPrototypes.Length,prototype=AssetDatabase.AssetPathToGUID(prefabPath),material=AssetDatabase.AssetPathToGUID(materialPath),detailScatterMode=d.detailScatterMode.ToString(),scope="낮은 조망 어깨 절개와 짧은 풀 면. 기존 길 지지면과 활성 구조물 접지 보존. 실제 TPS/성능 미검증"};System.IO.File.WriteAllText("output/CloudridgeR1/refine-pass.json",json(result));return result;
