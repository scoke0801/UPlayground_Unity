                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.48, "action": "Transition", "state": "JumpBack", "cooldownId": "ComboReset", "cooldownDuration": 3.2 },
                        { "weight": 0.12, "action": "Transition", "state": "Guard", "cooldownId": "ComboReset", "cooldownDuration": 2.8 },
                        { "weight": 0.18, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.10, "action": "Transition", "state": "Counter", "cooldownId": "ComboReset", "cooldownDuration": 2.4 }
                    ]
