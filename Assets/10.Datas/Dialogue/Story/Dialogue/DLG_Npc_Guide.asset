  m_EditorClassIdentifier: 
  nodeId: guide_final_1
  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "바깥길은 계속 열려 있어. 시련장도 이제 통과자를 막는 대신 다음 탐험대를 훈련하고 있고."
  portrait: {fileID: 0}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId: guide_final_2
  trueNextNodeId: 
  falseNextNodeId: 
  choices: []
