/* 궁극기 시퀀스 에디터 전용 스타일. UPlayGroundEditor.uss의 --up-* 토큰을 함께 사용한다. */

.up-ult-root {
    flex-grow: 1;
}

/* ── 상단 툴바 ───────────────────────────────────────── */
.up-ult-toolbar {
    flex-shrink: 0;
    align-items: center;
    height: 26px;
}

.up-ult-toolbar-asset {
    min-width: 200px;
    margin-right: 6px;
}

.up-ult-spacer {
    flex-grow: 1;
}

.up-ult-pill {
    -unity-font-style: bold;
    font-size: 11px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 9px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.up-ult-pill--ok {
    background-color: rgba(73, 171, 143, 0.18);
    color: rgb(126, 214, 184);
}

.up-ult-pill--warn {
    background-color: rgba(214, 165, 62, 0.20);
    color: rgb(232, 192, 112);
}

.up-ult-pill--error {
    background-color: rgba(224, 90, 90, 0.20);
    color: rgb(240, 142, 142);
}

/* ── 본문 스플릿 ─────────────────────────────────────── */
.up-ult-split {
    flex-grow: 1;
    min-height: 240px;
    border-top-width: 1px;
    border-top-color: var(--up-border-strong);
}

.up-ult-timeline-pane {
    min-width: 360px;
    background-color: var(--up-bg-0);
}

.up-ult-inspector-pane {
    min-width: 300px;
    background-color: var(--up-bg-1);
    border-left-width: 1px;
    border-left-color: var(--up-border-strong);
}

/* ── 타임라인 툴바 ───────────────────────────────────── */
.up-ult-timeline-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 24px;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
    padding-left: 6px;
    padding-right: 6px;
}

.up-ult-timeline-toolbar Label {
    font-size: 11px;
    color: var(--up-text-dim);
    margin-right: 4px;
}

.up-ult-timeline-toolbar .unity-slider {
    width: 120px;
    margin-right: 4px;
}

.up-ult-timeline-toolbar .unity-integer-field {
    width: 44px;
}

.up-ult-time-label {
    -unity-font-style: bold;
    color: var(--up-text);
    min-width: 96px;
    -unity-text-align: middle-right;
}

.up-ult-tool-btn {
    height: 18px;
    margin-left: 3px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.up-ult-scroll {
    flex-grow: 1;
}

/* ── 캔버스(타임라인 본체) ───────────────────────────── */
.up-ult-canvas {
    position: relative;
}

.up-ult-grid {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.up-ult-ruler {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 24px;
}

.up-ult-tick {
    position: absolute;
    font-size: 10px;
    color: var(--up-text-faint);
    top: 6px;
}

.up-ult-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgb(255, 82, 86);
}

.up-ult-cursor-cap {
    position: absolute;
    top: 0;
    width: 40px;
    height: 14px;
    margin-left: -19px;
    background-color: rgb(255, 82, 86);
    border-radius: 3px;
    color: rgb(20, 12, 12);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.up-ult-marquee {
    position: absolute;
    background-color: rgba(96, 156, 240, 0.14);
    border-width: 1px;
    border-color: rgba(126, 184, 255, 0.75);
}

/* ── 이벤트 블록 ─────────────────────────────────────── */
.up-ult-event {
    position: absolute;
    height: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
    overflow: hidden;
    flex-direction: row;
    align-items: center;
}

.up-ult-event:hover {
    border-color: rgba(255, 255, 255, 0.55);
}

.up-ult-event--selected {
    border-width: 2px;
    border-color: rgb(126, 192, 255);
}

.up-ult-event__label {
    flex-grow: 1;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(16, 22, 28);
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-ult-event__handle {
    width: 6px;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.18);
}

.up-ult-event--instant {
    border-radius: 5px;
}

.up-ult-event--instant .up-ult-event__label {
    padding-left: 2px;
    padding-right: 2px;
}

/* 타입별 색상 */
.up-ult-event--vfx { background-color: rgb(86, 150, 210); }
.up-ult-event--sound { background-color: rgb(118, 182, 120); }
.up-ult-event--time { background-color: rgb(214, 165, 62); }
.up-ult-event--camfx { background-color: rgb(152, 122, 202); }
.up-ult-event--shake { background-color: rgb(202, 122, 92); }
.up-ult-event--damage { background-color: rgb(212, 92, 92); }
.up-ult-event--callback { background-color: rgb(134, 144, 154); }

/* ── 인스펙터 ────────────────────────────────────────── */
.up-ult-inspector-scroll {
    flex-grow: 1;
}

.up-ult-section {
    margin: 6px;
    padding: 6px;
    background-color: var(--up-bg-2);
    border-radius: var(--up-radius);
    border-width: 1px;
    border-color: var(--up-border);
}

.up-ult-section-title {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--up-text);
    margin-bottom: 4px;
}

.up-ult-validation-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 2px;
    margin-bottom: 2px;
}

.up-ult-validation-badge {
    width: 6px;
    min-width: 6px;
    height: 14px;
    border-radius: 2px;
    margin-right: 6px;
    margin-top: 1px;
}

.up-ult-validation-text {
    flex-grow: 1;
    font-size: 11px;
    white-space: normal;
    color: var(--up-text-dim);
}

.up-ult-badge--ok { background-color: rgb(73, 171, 143); }
.up-ult-badge--warn { background-color: rgb(214, 165, 62); }
.up-ult-badge--error { background-color: rgb(224, 90, 90); }

.up-ult-event-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.up-ult-event-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 6px;
}

.up-ult-btn-row {
    flex-direction: row;
    margin-top: 6px;
}

.up-ult-btn-row Button {
    flex-grow: 1;
    height: 22px;
    margin-left: 2px;
    margin-right: 2px;
}

.up-ult-empty-hint {
    font-size: 11px;
    color: var(--up-text-faint);
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 12px;
}

.up-ult-quicklinks {
    flex-direction: row;
}

.up-ult-quicklinks Button {
    margin-left: 2px;
    font-size: 11px;
}
