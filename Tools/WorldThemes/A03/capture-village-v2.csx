// 승인된 v2 구도의 전후를 별도 증거 경로에 남긴다. 기존 전 사진은 덮어쓰지 않는다.
string scenePath="Assets/01.Scenes/ArtReview/WorldThemes/WorkingCopies/Theme_VillageFields_V2.unity",output="output/WorldThemeProduction/VillageFields/v2";
string stage=System.IO.File.Exists(output+"/applied-v2.json")?"after":"before",folder=output+"/"+stage;System.IO.Directory.CreateDirectory(folder);
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var parse=jt.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});Func<object,string> json=o=>(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/A03/v2-production-plan.json"),typeof(Dictionary<string,object>));var poses=(Dictionary<string,object>[])read(plan["capturePoses"].ToString(),typeof(Dictionary<string,object>[]));
var existing=System.IO.File.Exists(folder+"/poses.json")?(Dictionary<string,object>[])read(System.IO.File.ReadAllText(folder+"/poses.json"),typeof(Dictionary<string,object>[])):new Dictionary<string,object>[0];
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");bool dirty=host.isDirty;var loaded=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(scenePath);var previousActive=UnityEngine.SceneManagement.SceneManager.GetActiveScene();var previousPipeline=QualitySettings.renderPipeline;
if(!host.isLoaded||!loaded.isLoaded||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("열린 본편과 아트 씬의 Edit Mode가 필요합니다.");
UnityEngine.SceneManagement.SceneManager.SetActiveScene(loaded);var preview=UnityEditor.SceneManagement.EditorSceneManager.OpenPreviewScene(scenePath);var rows=new List<object>();
try{
 QualitySettings.renderPipeline=AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.RenderPipelineAsset>("Assets/Settings/LakeVillage_RPAsset.asset");var camera=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Camera>(true)).Single();camera.scene=preview;camera.overrideSceneCullingMask=UnityEditor.SceneManagement.EditorSceneManager.GetSceneCullingMask(preview);camera.fieldOfView=60;
 var terrain=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var extra=camera.GetComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();extra.renderPostProcessing=true;extra.volumeLayerMask=1<<31;extra.volumeTrigger=camera.transform;var volume=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UnityEngine.Rendering.Volume>(true)).Single();volume.enabled=false;volume.gameObject.layer=31;volume.enabled=true;
 foreach(var pose in poses){
  string file=pose["key"]+".png";var prior=existing.FirstOrDefault(r=>r["file"].ToString()==file);if(System.IO.File.Exists(folder+"/"+file)){if(prior==null)throw new Exception("기존 사진의 조건 기록 없음: "+file);rows.Add(prior);continue;}
  var xz=(float[])read(pose["xz"].ToString(),typeof(float[]));var txz=(float[])read(pose["target"].ToString(),typeof(float[]));var p=new Vector3(xz[0],terrain.SampleHeight(new Vector3(xz[0],0,xz[1]))+terrain.transform.position.y+1.7f,xz[1]);var target=new Vector3(txz[0],terrain.SampleHeight(new Vector3(txz[0],0,txz[1]))+terrain.transform.position.y+1f,txz[1]);camera.transform.position=p;camera.transform.rotation=Quaternion.LookRotation(target-p);
  var rt=new RenderTexture(1280,720,24,RenderTextureFormat.ARGB32);var image=new Texture2D(1280,720,TextureFormat.RGB24,false);var old=RenderTexture.active;
  try{camera.targetTexture=rt;camera.Render();camera.Render();UnityEngine.Rendering.VolumeManager.instance.Update(camera.transform,extra.volumeLayerMask);var adjustment=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.ColorAdjustments>();var bloom=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.Bloom>();float skyThickness=RenderSettings.skybox.GetFloat("_AtmosphereThickness");if(adjustment.saturation.value!=15||adjustment.contrast.value!=2||Mathf.Abs(bloom.intensity.value-.08f)>.001f||skyThickness!=1)throw new Exception("A01 실효 룩 불일치");RenderTexture.active=rt;image.ReadPixels(new Rect(0,0,1280,720),0,0);image.Apply();System.IO.File.WriteAllBytes(folder+"/"+file,image.EncodeToPNG());var rotation=camera.transform.eulerAngles;rows.Add(new{version="VillageFields-v2",file,position=new[]{p.x,p.y,p.z},target=new[]{target.x,target.y,target.z},rotation=new[]{rotation.x,rotation.y,rotation.z},fov=60,mode="Editor 정지 PreviewScene·v2 "+stage,fog=RenderSettings.fog,fogStart=RenderSettings.fogStartDistance,fogEnd=RenderSettings.fogEndDistance,postProcessing=extra.renderPostProcessing,effectiveSaturation=adjustment.saturation.value,effectiveContrast=adjustment.contrast.value,effectiveBloom=bloom.intensity.value,skyThickness,pipeline="LakeVillage_RPAsset",hostDirtyBefore=dirty,hostDirtyAfter=host.isDirty});}
  finally{camera.targetTexture=null;RenderTexture.active=old;UnityEngine.Object.DestroyImmediate(image);UnityEngine.Object.DestroyImmediate(rt);}
 }
 if(host.isDirty!=dirty)throw new Exception("본편 dirty 변경");
}finally{QualitySettings.renderPipeline=previousPipeline;UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(preview);UnityEngine.SceneManagement.SceneManager.SetActiveScene(previousActive);}
System.IO.File.WriteAllText(folder+"/poses.json",json(rows));return "A03 v2 "+stage+" views="+rows.Count+" original photos preserved";
