// 저장된 검토본의 자원 소유와 촬영 임시 상태 잔존 여부를 기록한다.
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();
var dependencies=AssetDatabase.GetDependencies(scene.path,true);
var terrain=Terrain.activeTerrain;var data=terrain.terrainData;
var objects=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var shader=AssetDatabase.LoadAssetAtPath<Shader>("Assets/10.Datas/World/ThemeStudies/ShadeCreekR3/CanopyImpostor.shader");
var result=new{checkedAt=DateTime.UtcNow.ToString("o"),scene=scene.path,sceneGuid=AssetDatabase.AssetPathToGUID(scene.path),dirty=scene.isDirty,playing=EditorApplication.isPlaying,compiling=EditorApplication.isCompiling,updating=EditorApplication.isUpdating,compileFailed=EditorUtility.scriptCompilationFailed,temporaryObjects=objects.Where(t=>t.name.StartsWith("Temporary")).Select(t=>t.name).ToArray(),priorReviewDependencies=dependencies.Where(p=>p.Contains("/ShadeCreekR1/")||p.Contains("/ShadeCreekR2/")).ToArray(),temporaryDependencies=dependencies.Where(p=>p.Contains("Temporary")||p.Contains("Capture")).ToArray(),terrainPath=AssetDatabase.GetAssetPath(data),terrainLayers=data.terrainLayers.Select(l=>AssetDatabase.GetAssetPath(l)).ToArray(),detailPrefabs=data.detailPrototypes.Select(p=>AssetDatabase.GetAssetPath(p.prototype)).ToArray(),pipeline=AssetDatabase.GetAssetPath(QualitySettings.renderPipeline),shaderMessages=ShaderUtil.GetShaderMessages(shader).Select(m=>new{m.message,m.line,severity=m.severity.ToString()}).ToArray(),qualitySettingsDirty=EditorUtility.IsDirty(Unsupported.GetSerializedAssetInterfaceSingleton("QualitySettings")),actualTpsValidated=false,testsStartedByAgent=false};
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/ShadeCreekR3/editor-final-state.json",(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return result;
