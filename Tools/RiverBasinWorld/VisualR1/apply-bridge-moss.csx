var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(Application.isPlaying||scene.isDirty||scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity")throw new Exception("저장된 전용 Edit Mode 씬 필요");
string data="Assets/10.Datas/World/RiverBasinWorld/VisualR1",model="Assets/08.Models/World/RiverBasinWorld/VisualR1",prefabPath="Assets/03.Prefabs/Environment/RiverBasinWorld/VisualR1/B1_BridgeArtR1.prefab",texturePath="Assets/04.Images/World/RiverBasinWorld/VisualR1/GraniteMossAlbedo_R2.png";
AssetDatabase.Refresh();var importer=(TextureImporter)AssetImporter.GetAtPath(texturePath);if(importer==null)throw new Exception("생성 텍스처 필요");importer.textureType=TextureImporterType.Default;importer.sRGBTexture=true;importer.wrapMode=TextureWrapMode.Repeat;importer.mipmapEnabled=true;importer.anisoLevel=8;importer.maxTextureSize=2048;importer.SaveAndReimport();
var old=AssetDatabase.LoadAssetAtPath<Material>(data+"/BridgeGranite.mat");var moss=AssetDatabase.LoadAssetAtPath<Material>(data+"/BridgeGraniteMoss_R2.mat");if(moss==null){moss=new Material(old);AssetDatabase.CreateAsset(moss,data+"/BridgeGraniteMoss_R2.mat");}moss.SetTexture("_BaseMap",AssetDatabase.LoadAssetAtPath<Texture2D>(texturePath));moss.SetColor("_BaseColor",new Color(.9f,.9f,.85f,1));moss.SetFloat("_Smoothness",.12f);EditorUtility.SetDirty(moss);
var root=PrefabUtility.LoadPrefabContents(prefabPath);var checks=new List<string>();try{foreach(var mf in root.GetComponentsInChildren<MeshFilter>(true)){
string path=model+"/"+mf.name+"_MossR2.asset";var mesh=AssetDatabase.LoadAssetAtPath<Mesh>(path);if(mesh!=null)throw new Exception("기존 분할 결과 보존: "+path);var source=mf.sharedMesh;mesh=UnityEngine.Object.Instantiate(source);mesh.name=source.name+"_MossR2";
var vertices=source.vertices;var triangles=source.triangles;var dry=new List<int>();var wet=new List<int>();for(int i=0;i<triangles.Length;i+=3){var a=vertices[triangles[i]];var b=vertices[triangles[i+1]];var c=vertices[triangles[i+2]];var n=Vector3.Cross(b-a,c-a).normalized;float height=(a.z+b.z+c.z)/3;var target=height<-.5f||Mathf.Abs(n.z)<.65f?wet:dry;target.Add(triangles[i]);target.Add(triangles[i+1]);target.Add(triangles[i+2]);}
mesh.subMeshCount=2;mesh.SetTriangles(dry,0);mesh.SetTriangles(wet,1);AssetDatabase.CreateAsset(mesh,path);mf.sharedMesh=mesh;mf.GetComponent<Renderer>().sharedMaterials=new[]{old,moss};checks.Add(mf.name+" vertices="+mesh.vertexCount+" dryTri="+dry.Count/3+" mossTri="+wet.Count/3);
}PrefabUtility.SaveAsPrefabAsset(root,prefabPath);}finally{PrefabUtility.UnloadPrefabContents(root);}
AssetDatabase.SaveAssets();UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);System.IO.File.WriteAllLines("output/RiverBasinWorld/VisualR1/bridge-moss-check.txt",checks);return string.Join("\n",checks.ToArray())+"\nshaderError="+ShaderUtil.ShaderHasError(moss.shader);
