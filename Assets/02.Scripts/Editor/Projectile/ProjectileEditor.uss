.up-projectile-editor {
    min-width: 900px;
    min-height: 560px;
}

.up-projectile-toolbar {
    min-height: 30px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-projectile-toolbar-title {
    margin-left: var(--up-space-2);
    margin-right: var(--up-space-3);
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: var(--up-accent);
}

.up-projectile-main-split {
    flex-grow: 1;
    min-height: 0;
}

.up-projectile-sidebar {
    min-width: 260px;
    max-width: 480px;
    background-color: var(--up-bg-1);
    border-right-width: 1px;
    border-right-color: var(--up-border-strong);
}

.up-projectile-search {
    height: 27px;
    margin: var(--up-space-2);
    margin-bottom: var(--up-space-1);
    flex-shrink: 0;
}

.up-projectile-list {
    flex-grow: 1;
    min-height: 120px;
}

.up-projectile-list-row {
    min-height: 48px;
    margin-left: var(--up-space-1);
    margin-right: var(--up-space-1);
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    padding-top: 6px;
    padding-bottom: 5px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.45);
}

.up-projectile-list-row:hover {
    background-color: var(--up-accent-soft);
}

.up-projectile-list-row-selected {
    border-left-color: var(--up-accent);
    background-color: var(--up-accent-soft);
}

.up-projectile-list-name {
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-projectile-list-subtitle {
    margin-top: 3px;
    font-size: var(--up-font-sm);
    color: var(--up-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-projectile-detail-root,
.up-projectile-detail-scroll {
    flex-grow: 1;
    min-width: 480px;
    min-height: 0;
    background-color: var(--up-bg-0);
}

.up-projectile-detail-scroll {
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-3);
    padding-top: var(--up-space-2);
    padding-bottom: var(--up-space-3);
}

.up-projectile-selection {
    min-height: 58px;
    margin-bottom: var(--up-space-3);
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-3);
    padding-top: 9px;
    padding-bottom: 8px;
    background-color: var(--up-bg-3);
    border-left-width: 4px;
    border-left-color: var(--up-accent);
    border-top-right-radius: var(--up-radius);
    border-bottom-right-radius: var(--up-radius);
}

.up-projectile-selection-title {
    height: 22px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-projectile-selection-path {
    font-size: var(--up-font-sm);
    color: var(--up-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-projectile-managed-field {
    margin-top: var(--up-space-2);
    padding-top: var(--up-space-2);
    border-top-width: 1px;
    border-top-color: var(--up-border);
}

.up-projectile-behavior-card {
    margin-bottom: var(--up-space-2);
    padding-bottom: var(--up-space-2);
    background-color: var(--up-bg-1);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-projectile-behavior-header {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-1);
    background-color: var(--up-bg-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-projectile-behavior-header > Button {
    min-width: 28px;
    height: 22px;
    margin-left: 2px;
    padding-left: 5px;
    padding-right: 5px;
}

.up-projectile-behavior-title {
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-projectile-behavior-card > .unity-property-field {
    margin-left: var(--up-space-2);
    margin-right: var(--up-space-2);
    margin-top: var(--up-space-1);
}

.up-projectile-danger-button {
    color: rgb(255, 142, 132);
}

.up-projectile-add-behavior {
    height: 30px;
    margin-top: var(--up-space-1);
    -unity-font-style: bold;
    color: var(--up-accent);
}

.up-projectile-analysis {
    margin-bottom: var(--up-space-2);
    padding: var(--up-space-2);
    white-space: normal;
    color: var(--up-text-dim);
    background-color: var(--up-bg-0);
    border-radius: var(--up-radius);
}

.up-projectile-preview {
    height: 190px;
    min-height: 190px;
    margin-bottom: var(--up-space-2);
    background-color: var(--up-bg-0);
    border-width: 1px;
    border-color: var(--up-border-strong);
    border-radius: var(--up-radius);
}

.up-projectile-validation {
    margin-top: var(--up-space-1);
}

.up-projectile-validation > .unity-help-box {
    margin-bottom: var(--up-space-1);
}

.up-projectile-status {
    height: 24px;
    min-height: 24px;
    padding-left: var(--up-space-2);
    padding-top: 4px;
    flex-shrink: 0;
    color: var(--up-text-dim);
    background-color: var(--up-bg-2);
    border-top-width: 1px;
    border-top-color: var(--up-border-strong);
}
