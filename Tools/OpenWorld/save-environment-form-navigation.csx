// 타일을 명시적으로 저장하고 디스크 역직렬화까지 통과한 새 에셋만 씬에 연결한다.
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();string folder="output/OpenWorld/EnvironmentForm",path="Assets/10.Datas/World/OpenWorld/EnvironmentFormNavigation.asset";
if(scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode||EditorApplication.isCompiling||EditorUtility.scriptCompilationFailed||System.IO.File.ReadAllText(folder+"/navigation-operation.txt")!="COMPLETED")throw new Exception("내비게이션 저장 상태 불일치");
var updated=AssetDatabase.LoadAssetAtPath<UnityEngine.AI.NavMeshData>(path);int tiles=new SerializedObject(updated).FindProperty("m_NavMeshTiles").arraySize;if(tiles==0||updated.sourceBounds.size.x<2000)throw new Exception("타일 또는 범위 없음");
EditorUtility.SetDirty(updated);AssetDatabase.SaveAssetIfDirty(updated);long bytes=new System.IO.FileInfo(path).Length;if(bytes<100000)throw new Exception("디스크 타일 없음");
var disk=UnityEditorInternal.InternalEditorUtility.LoadSerializedFileAndForget(path);int diskTiles=0;try{var nav=disk.OfType<UnityEngine.AI.NavMeshData>().Single();diskTiles=new SerializedObject(nav).FindProperty("m_NavMeshTiles").arraySize;if(diskTiles!=tiles||nav.sourceBounds.size.x<2000)throw new Exception("디스크 역직렬화 불일치");}finally{foreach(var asset in disk)UnityEngine.Object.DestroyImmediate(asset);}
var surface=GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>();surface.RemoveData();surface.navMeshData=updated;surface.AddData();EditorUtility.SetDirty(surface);UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);if(!UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene))throw new Exception("씬 저장 실패");
string result="PASS tiles="+tiles+" diskTiles="+diskTiles+" bytes="+bytes+" path="+path;System.IO.File.WriteAllText(folder+"/navigation-disk.txt",result);return result;
