if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("QuarryPassR1-A-20261108"))throw new Exception("A 잠금 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/QuarryPassR1.unity")throw new Exception("A 씬 필요");
var terrain=Terrain.activeTerrain;var rows=new List<object>();
foreach(string path in new[]{"Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Stones/Cliffs/PF_EastLands_Cliff_01.prefab","Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Stones/Cliffs/PF_EastLands_Cliff_02.prefab","Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Stones/Cliffs/PF_EastLands_Cliff_03.prefab","Assets/ExternalAssets/Environment/Toon Golden Valley/Prefabs/Rocks/TGV_Cliff_01A.prefab"}){
var p=AssetDatabase.LoadAssetAtPath<GameObject>(path);rows.Add(new{path,meshes=p.GetComponentsInChildren<MeshFilter>(true).Select(m=>new{name=m.name,bounds=m.sharedMesh.bounds.ToString("F3"),vertices=m.sharedMesh.vertexCount}).ToArray(),materials=p.GetComponentsInChildren<Renderer>(true).SelectMany(r=>r.sharedMaterials).Where(m=>m!=null).Distinct().Select(m=>new{path=AssetDatabase.GetAssetPath(m),shader=m.shader.name}).ToArray()});}
var transforms=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();
var rocks=transforms.Where(t=>t.name.StartsWith("채석장_")||t.name.StartsWith("고개_")).Where(t=>t.GetComponent<Renderer>()!=null).Select(t=>new{name=t.name,position=t.position.ToString("F3"),bounds=t.GetComponent<Renderer>().bounds.ToString("F3"),materials=t.GetComponent<Renderer>().sharedMaterials.Select(m=>new{path=AssetDatabase.GetAssetPath(m),shader=m.shader.name,properties=Enumerable.Range(0,m.shader.GetPropertyCount()).Select(i=>m.shader.GetPropertyName(i)).ToArray()}).ToArray()}).ToArray();
var heights=new List<object>();for(int z=1120;z<=1440;z+=20)for(int x=320;x<=580;x+=20)heights.Add(new{x,z,y=terrain.SampleHeight(new Vector3(x,0,z)),slope=terrain.terrainData.GetSteepness(x/2400f,(z+700)/2800f)});
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/QuarryPassR1/production-survey.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{new{candidates=rows,rocks,heights}}));
return new{candidates=rows,rocks=rocks.Take(2).ToArray()};
