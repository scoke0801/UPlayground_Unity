{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_ArcherMonster",
    "displayName": "Test Archer Monster",
    "actorKind": "Ground",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_skeleton_bow.asset",
    "blackboard": {
        "tickInterval": 0.1,
        "enablePatrol": true,
        "optimalCombatDistance": 7.0,
        "minCombatDistance": 4.0,
        "personalSpaceDistance": 2.5,
        "guardChance": 0.1,
        "retreatChance": 0.55,
        "circleWeight": 0.8
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "NoTarget",
            "priority": 900,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "PatrolOrIdle" }
            ]
        },
        {
            "name": "KiteWhenTooClose",
            "priority": 850,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceLessOrEqual", "value": "personalSpaceDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Retreat" }
            ]
        },
        {
            "name": "GuardAgainstPressure",
            "priority": 780,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsPlayerAttacking" },
                { "condition": "DistanceLessOrEqual", "value": "4.0" }
            ],
            "do": [
                { "action": "Transition", "state": "Guard" }
            ]
        },
        {
            "name": "RangedAttack",
            "priority": 700,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "ActionDelayElapsed" },
                { "condition": "DistanceLessOrEqual", "value": "9.0" },
                { "condition": "CanUseSkill" }
            ],
            "do": [
                { "action": "RequestAttackSlot" },
                { "action": "ExecuteAttack" }
            ]
        },
        {
            "name": "RepositionToRange",
            "priority": 500,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
            ],
            "do": [
                { "action": "Transition", "state": "Chase" }
            ]
        },
        {
            "name": "RangedCombatIdle",
            "priority": 100,
            "select": "WeightedRandom",
            "choices": [
                { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                { "weightKey": "circleWeight", "action": "Transition", "state": "Circle" },
                { "weightKey": "guardChance", "action": "Transition", "state": "Guard" }
            ]
        }
    ]
}
