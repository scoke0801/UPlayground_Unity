.up-panel-header {
    min-height: 50px;
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-3);
    padding-top: 7px;
    padding-bottom: 7px;
    flex-shrink: 0;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-panel-kicker {
    height: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--up-accent);
}

.up-panel-title {
    height: 20px;
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--up-text);
}

.up-motion-list-view,
.up-motion-inspector {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--up-bg-1);
}

.up-motion-list-search {
    height: 26px;
    margin: var(--up-space-2);
    margin-bottom: var(--up-space-1);
    flex-shrink: 0;
}

.up-motion-list {
    flex-grow: 1;
    min-height: 120px;
}

.up-motion-list-item {
    margin-left: var(--up-space-1);
    margin-right: var(--up-space-1);
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.32);
}

.up-motion-list-group {
    height: 28px;
    padding-top: 6px;
    -unity-font-style: bold;
    color: var(--up-text-dim);
    background-color: var(--up-bg-1);
}

.up-motion-list-row {
    min-height: 46px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 3px;
    /* 선택 시 좌측 막대가 생기면서 글자가 밀리지 않도록 폭을 미리 확보한다. */
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

/* 선택 표시는 토큰 해석 여부와 무관하게 보여야 하므로 명시 색상을 쓴다. */
.up-motion-list-row-selected {
    border-left-color: rgb(46, 154, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(46, 154, 255, 0.55);
    border-right-color: rgba(46, 154, 255, 0.55);
    border-bottom-color: rgba(46, 154, 255, 0.55);
    background-color: rgba(46, 154, 255, 0.24);
}

.up-motion-list-row-selected .up-motion-list-item-title {
    color: rgb(146, 205, 255);
}

.up-motion-list-row-selected .up-motion-list-item-subtitle {
    color: rgb(178, 205, 230);
}

.up-theme-light .up-motion-list-row-selected {
    border-left-color: rgb(20, 106, 200);
    border-top-color: rgba(20, 106, 200, 0.55);
    border-right-color: rgba(20, 106, 200, 0.55);
    border-bottom-color: rgba(20, 106, 200, 0.55);
    background-color: rgba(20, 106, 200, 0.20);
}

.up-theme-light .up-motion-list-row-selected .up-motion-list-item-title {
    color: rgb(16, 66, 122);
}

.up-theme-light .up-motion-list-row-selected .up-motion-list-item-subtitle {
    color: rgb(52, 88, 130);
}

.up-motion-list-item-title {
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-motion-list-item-subtitle {
    margin-top: 2px;
    font-size: var(--up-font-sm);
    color: var(--up-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.up-motion-list-add {
    height: 30px;
    margin: var(--up-space-2);
    -unity-font-style: bold;
    flex-shrink: 0;
}

.up-motion-inspector-content {
    flex-grow: 1;
    padding: var(--up-space-3);
}

.up-inspector-selection-title {
    min-height: 38px;
    padding-left: var(--up-space-3);
    padding-right: var(--up-space-2);
    padding-top: 10px;
    margin-bottom: var(--up-space-3);
    -unity-font-style: bold;
    color: var(--up-text);
    background-color: var(--up-bg-3);
    border-left-width: 3px;
    border-left-color: var(--up-accent);
    border-top-right-radius: var(--up-radius);
    border-bottom-right-radius: var(--up-radius);
}

.up-inspector-section {
    margin-bottom: var(--up-space-3);
    background-color: var(--up-bg-1);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-inspector-section-heading {
    min-height: 38px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-inspector-section-kicker {
    height: 12px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
}

.up-inspector-section-title {
    height: 18px;
    font-size: var(--up-font-md);
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-inspector-section-body {
    padding: var(--up-space-2);
}

.up-empty-hint {
    margin: var(--up-space-3);
    white-space: normal;
    color: var(--up-text-dim);
}

.up-motion-event-tool-panel {
    margin-top: var(--up-space-1);
    padding: var(--up-space-2);
    background-color: var(--up-bg-1);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-motion-asset-inspector {
    min-width: 280px;
    min-height: 0;
}

.up-motion-asset-inspector > .up-motion-inspector {
    min-height: 260px;
    margin-top: var(--up-space-2);
}

.up-open-motion-editor {
    height: 32px;
    margin: var(--up-space-2);
    flex-shrink: 0;
}

.up-control-panels,
.up-control-panel-tabs {
    flex-shrink: 0;
}

.up-control-panel-tabs {
    min-height: 25px;
}

.up-control-panel-tab {
    min-width: 78px;
    height: 22px;
}

.up-tab-selected {
    color: white;
    background-color: var(--up-accent);
}

.up-flex-spacer {
    flex-grow: 1;
}

.up-control-panel-help {
    margin-right: var(--up-space-2);
}

.up-control-panel-body {
    padding: var(--up-space-1);
    background-color: var(--up-bg-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border);
}

.up-control-panel-stack {
    flex-direction: row;
}

.up-control-panel {
    flex-grow: 1;
    padding: var(--up-space-2);
    margin: var(--up-space-1);
    background-color: var(--up-bg-2);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
}

.up-control-panel-title {
    margin-bottom: var(--up-space-2);
    -unity-font-style: bold;
    color: var(--up-text);
}

.up-panel-fields {
    margin-left: var(--up-space-2);
}

.up-button-row {
    flex-direction: row;
    margin-top: var(--up-space-1);
    margin-bottom: var(--up-space-1);
}

.up-button-row > Button {
    margin-right: var(--up-space-1);
}

.up-control-panel-help-text {
    margin-top: var(--up-space-2);
    white-space: normal;
    color: var(--up-text-dim);
}

.up-motion-editor-body,
.up-timeline-view {
    flex-grow: 1;
    min-height: 0;
}

.up-motion-authoring-foldout {
    flex-shrink: 0;
    max-height: 360px;
    overflow: hidden;
    margin: var(--up-space-2);
    margin-bottom: 0;
    background-color: var(--up-bg-2);
    border-width: 1px;
    border-color: var(--up-border);
    border-radius: var(--up-radius);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-motion-authoring-scroll {
    max-height: 330px;
    min-height: 0;
    flex-shrink: 1;
}

.up-motion-authoring-imgui {
    flex-shrink: 0;
}

.up-timeline-view {
    background-color: var(--up-bg-0);
}

.up-timeline-toolbar {
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    flex-shrink: 0;
    flex-wrap: nowrap;
    background-color: var(--up-bg-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-timeline-title-block {
    width: 116px;
    min-width: 116px;
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    padding-top: 3px;
    padding-left: var(--up-space-1);
    flex-shrink: 0;
    overflow: hidden;
}

.up-timeline-kicker {
    height: 13px;
    min-height: 13px;
    max-height: 13px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--up-accent);
    white-space: nowrap;
    overflow: hidden;
}

.up-timeline-title {
    height: 19px;
    min-height: 19px;
    max-height: 19px;
    -unity-font-style: bold;
    color: var(--up-text);
    white-space: nowrap;
    overflow: hidden;
}

.up-timeline-toolbar-divider {
    width: 1px;
    min-width: 1px;
    height: 24px;
    margin-left: var(--up-space-2);
    margin-right: var(--up-space-2);
    flex-shrink: 0;
    background-color: var(--up-border);
}

.up-timeline-zoom {
    width: 220px;
}

.up-timeline-fps {
    width: 84px;
}

.up-timeline-frames {
    margin-right: var(--up-space-1);
}

.up-timeline-cursor-label {
    min-width: 96px;
    height: 24px;
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-2);
    margin-right: var(--up-space-1);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--up-text);
    background-color: var(--up-bg-0);
    border-width: 1px;
    border-color: var(--up-border-strong);
    border-radius: var(--up-radius);
}

.up-timeline-layer-row {
    flex-direction: row;
    flex-shrink: 0;
    background-color: var(--up-bg-2);
    border-left-width: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-timeline-layer-handle {
    width: 20px;
    min-width: 20px;
    padding-top: 5px;
    -unity-text-align: middle-center;
    color: var(--up-text-faint);
    flex-shrink: 0;
}

.up-timeline-layer-name {
    width: 110px;
    min-width: 76px;
    height: 24px;
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: var(--up-text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.up-timeline-layer-action {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--up-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.up-timeline-layer-action:hover,
.up-timeline-layer-name:hover {
    background-color: var(--up-accent-soft);
}

.up-timeline-layer-add {
    color: var(--up-accent);
    -unity-font-style: bold;
}

.up-layer-hidden-state {
    opacity: 0.48;
}

.up-layer-locked-state {
    background-color: var(--up-bg-3);
}

.up-layer-locked-state > .up-timeline-layer-action {
    color: var(--up-accent);
}

.up-timeline-corner-label {
    padding-left: var(--up-space-2);
    padding-top: 7px;
    -unity-font-style: bold;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--up-text-faint);
    background-color: var(--up-bg-0);
    border-right-width: 1px;
    border-right-color: var(--up-border-strong);
    border-bottom-width: 1px;
    border-bottom-color: var(--up-border-strong);
}

.up-timeline-scroll {
    flex-grow: 1;
    min-height: 180px;
}

.up-timeline-canvas {
    flex-shrink: 0;
    min-width: 320px;
    background-color: var(--up-bg-1);
}

.up-timeline-group-label,
.up-timeline-track-label {
    padding-left: var(--up-space-2);
    padding-right: var(--up-space-1);
    border-right-width: 1px;
    border-right-color: var(--up-border);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-motion-track-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 3px;
    background-color: var(--up-bg-1);
    border-right-width: 1px;
    border-right-color: var(--up-border);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.55);
}

.up-motion-track-toggle {
    width: 20px;
    min-width: 20px;
    height: 22px;
    margin: 0;
    padding-top: 3px;
    -unity-text-align: middle-center;
    color: var(--up-accent);
}

.up-motion-track-toggle > .unity-toggle__input {
    margin-left: 2px;
    margin-right: 2px;
}

.up-motion-track-badge {
    width: 34px;
    min-width: 34px;
    height: 18px;
    margin-right: 3px;
    padding-top: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 9px;
    color: var(--up-accent);
    background-color: var(--up-accent-soft);
    border-radius: 3px;
}

.up-motion-track-name {
    flex-grow: 1;
    min-width: 58px;
    height: 24px;
    margin: 0;
    padding-left: 4px;
    padding-right: 3px;
    -unity-text-align: middle-left;
    color: var(--up-text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-motion-track-name:hover,
.up-motion-track-action:hover {
    background-color: var(--up-accent-soft);
}

.up-motion-track-count {
    width: 20px;
    min-width: 20px;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: var(--up-text-faint);
}

.up-motion-track-action {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--up-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.up-motion-track-disabled {
    opacity: 0.46;
}

.up-motion-clip-label {
    padding-left: 2px;
    padding-right: 2px;
    -unity-text-align: middle-left;
    font-size: 9px;
    color: rgba(235, 242, 249, 0.92);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-motion-track-drop-hint {
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-left;
    font-size: 9px;
    color: var(--up-text-faint);
    background-color: rgba(62, 151, 232, 0.07);
    border-left-width: 2px;
    border-left-color: rgba(62, 151, 232, 0.38);
}

.up-timeline-group-label {
    padding-top: 4px;
    -unity-font-style: bold;
    font-size: var(--up-font-sm);
    letter-spacing: 0.5px;
    color: var(--up-text);
    background-color: var(--up-bg-2);
}

.up-timeline-track-label {
    padding-top: 4px;
    color: var(--up-text-dim);
    background-color: var(--up-bg-1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 69, 82, 0.55);
}

.up-timeline-ruler-label {
    font-size: 10px;
    color: var(--up-text-dim);
}

.up-timeline-event-bar-label {
    padding-left: 2px;
    padding-right: 2px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 9px;
    color: white;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.up-motion-asset-inspector > .up-timeline-view {
    min-height: 320px;
}
.up-hidden {
    display: none;
}
