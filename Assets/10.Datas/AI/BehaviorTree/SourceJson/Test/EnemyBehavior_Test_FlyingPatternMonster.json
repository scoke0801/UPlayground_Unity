{
    "schemaVersion": 1,
    "id": "EnemyBehavior_Test_FlyingPatternMonster",
    "displayName": "Test Flying Pattern Monster",
    "actorKind": "Flying",
    "sourceBehaviorSo": "Assets/10.Datas/Actor/Enemy/BehaviorData/BehaviorData_griffin.asset",
    "blackboard": {
        "tickInterval": 0.1,
        "enablePatrol": true,
        "optimalCombatDistance": 2.0,
        "minCombatDistance": 1.4,
        "personalSpaceDistance": 0.9,
        "guardChance": 0.0,
        "retreatChance": 0.25,
        "circleWeight": 1.0
    },
    "rules": [
        {
            "name": "BlockedState",
            "priority": 1000,
            "when": [
                { "condition": "IsBlockedEnemyState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "AirDiveAttack",
            "priority": 960,
            "when": [
                { "condition": "IsCurrentState", "value": "Flying_AirCircle" },
                { "condition": "IsAirAttackLimitReached" },
                { "condition": "HasDiveSkillAvailable" },
                { "condition": "RollDiveChance" }
            ],
            "do": [
                { "action": "SelectFlyingDiveSkill" },
                { "action": "FlyingTransition", "state": "Dive" }
            ]
        },
        {
            "name": "LandAfterAirPattern",
            "priority": 940,
            "when": [
                { "condition": "IsCurrentState", "value": "Flying_AirCircle" },
                { "condition": "IsAirAttackLimitReached" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Land" }
            ]
        },
        {
            "name": "KeepAirPattern",
            "priority": 920,
            "when": [
                { "condition": "IsFlyingAirState" }
            ],
            "do": [
                { "action": "KeepCurrentState" }
            ]
        },
        {
            "name": "TakeOffFromGroundCombat",
            "priority": 890,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "ShouldFlyingTakeOff" }
            ],
            "do": [
                { "action": "ResetFlyingAirCounters" },
                { "action": "FlyingTransition", "state": "TakeOff" }
            ]
        },
        {
            "name": "NoTarget",
            "priority": 800,
            "when": [
                { "condition": "HasTarget", "invert": true }
            ],
            "do": [
                { "action": "FlyingPatrolOrIdle" }
            ]
        },
        {
            "name": "GroundAttack",
            "priority": 650,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "DistanceLessOrEqual", "value": "2.0" },
                { "condition": "FlyingCanUseSkill" }
            ],
            "do": [
                { "action": "RequestFlyingAttackSlot" },
                { "action": "FlyingTransition", "state": "GroundAttack" }
            ]
        },
        {
            "name": "GroundApproach",
            "priority": 450,
            "when": [
                { "condition": "HasTarget" },
                { "condition": "IsFlyingGroundCombatState" },
                { "condition": "DistanceGreater", "value": "optimalCombatDistance" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Chase" }
            ]
        },
        {
            "name": "ReturnToGroundChase",
            "priority": 200,
            "when": [
                { "condition": "HasTarget" }
            ],
            "do": [
                { "action": "FlyingTransition", "state": "Chase" }
            ]
        }
    ]
}
