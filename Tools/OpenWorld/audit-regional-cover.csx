var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||EditorApplication.isCompiling||scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity")throw new Exception("월드 Edit Mode 필요");
var root=GameObject.Find("AuthoredEnvironment/연속 경관과 농경지");if(root==null)throw new Exception("연속 경관 누락");var folder="output/OpenWorld/RegionalCover";
var surface=GameObject.Find("AuthoredEnvironment").GetComponent<Unity.AI.Navigation.NavMeshSurface>();surface.BuildNavMesh();if(surface.navMeshData==null)throw new Exception("NavMesh 생성 실패");
string navPath="Assets/10.Datas/World/OpenWorld/RegionalCoverNavigation.asset";var saved=AssetDatabase.LoadAssetAtPath<UnityEngine.AI.NavMeshData>(navPath);if(saved==null)AssetDatabase.CreateAsset(surface.navMeshData,navPath);else{var baked=surface.navMeshData;surface.RemoveData();EditorUtility.CopySerialized(baked,saved);EditorUtility.SetDirty(saved);AssetDatabase.SaveAssetIfDirty(saved);surface.navMeshData=saved;surface.AddData();}EditorUtility.SetDirty(surface);
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var parse=json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/OpenWorld/regional-cover-plan.json"),typeof(Dictionary<string,object>));var routes=(Dictionary<string,object>[])read(plan["routes"].ToString(),typeof(Dictionary<string,object>[]));
int missing=0,materials=0,invalid=0,passed=0,failed=0;var report=new System.Text.StringBuilder();var terrain=Terrain.activeTerrain;
foreach(var t in root.GetComponentsInChildren<Transform>(true))missing+=GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject);
foreach(var r in root.GetComponentsInChildren<Renderer>(true))foreach(var m in r.sharedMaterials)if(m==null||m.shader==null||m.shader.name.Contains("InternalError"))materials++;
foreach(var mf in root.GetComponentsInChildren<MeshFilter>(true).Where(m=>m.name.StartsWith("Wheat_LOD")))foreach(var v in mf.sharedMesh.vertices)if(float.IsNaN(v.x)||float.IsNaN(v.y)||float.IsNaN(v.z)||float.IsInfinity(v.y))invalid++;
report.AppendLine("Missing Script="+missing+" / 재질·셰이더="+materials+" / 잘못된 작물 정점="+invalid);
int index=0;foreach(var route in routes){var points=(float[][])read(route["points"].ToString(),typeof(float[][]));var hits=new List<Vector3>();bool sample=true,complete=true;
 foreach(var point in points){var p=new Vector3(point[0],0,point[1]);p.y=terrain.SampleHeight(p)+terrain.transform.position.y;UnityEngine.AI.NavMeshHit hit;if(!UnityEngine.AI.NavMesh.SamplePosition(p,out hit,4,UnityEngine.AI.NavMesh.AllAreas)){sample=false;break;}hits.Add(hit.position);}
 var path=new UnityEngine.AI.NavMeshPath();if(sample)for(int i=1;i<hits.Count;i++)foreach(bool reverse in new[]{false,true}){var a=hits[reverse?i:i-1];var b=hits[reverse?i-1:i];bool ok=UnityEngine.AI.NavMesh.CalculatePath(a,b,UnityEngine.AI.NavMesh.AllAreas,path)&&path.status==UnityEngine.AI.NavMeshPathStatus.PathComplete;complete&=ok;if(!ok)report.AppendLine("실패 "+a+" -> "+b);}
 if(sample&&complete)passed++;else failed++;report.AppendLine("경로 "+(index++)+" / 표본="+sample+" / 양방향="+complete);
}
var ids=string.Join("\n",scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).Select(c=>c.Guid+"|"+c.transform.position.ToString("F4")).OrderBy(s=>s));bool same=ids==System.IO.File.ReadAllText(folder+"/identities-before.txt");report.AppendLine("기존 진행 ID·좌표 보존="+same+" / 경로 통과="+passed+" 실패="+failed);
System.IO.File.WriteAllText(folder+"/audit.txt",report.ToString());UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return report.ToString();
