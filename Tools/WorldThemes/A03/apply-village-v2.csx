foreach(var item in clusters){var group=new GameObject(item["key"].ToString());group.transform.SetParent(addedRoot.transform,false);var c=(float[])read(item["center"].ToString(),typeof(float[]));var r=(float[])read(item["radius"].ToString(),typeof(float[]));int total=Convert.ToInt32(item["white"])+Convert.ToInt32(item["yellow"])+Convert.ToInt32(item["bush"]),seed=Convert.ToInt32(item["seed"]),sequence=0;
 foreach(string key in new[]{"white","yellow","bush"})for(int i=0;i<Convert.ToInt32(item[key]);i++){
  float angle=(seed%360+sequence*137.50776f)*Mathf.Deg2Rad,distance=Mathf.Sqrt((sequence+.5f)/total);float x=c[0]+Mathf.Cos(angle)*r[0]*distance,z=c[1]+Mathf.Sin(angle)*r[1]*distance;sequence++;
