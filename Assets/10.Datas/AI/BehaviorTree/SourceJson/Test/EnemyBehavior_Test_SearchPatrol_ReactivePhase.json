                        { "condition": "ConsecutiveAttackCountLessThan", "value": "2" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.58, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.24, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.10, "action": "Transition", "state": "Counter", "cooldownId": "PressureReposition", "cooldownDuration": 1.2 },
                        { "weight": 0.04, "action": "Transition", "state": "Guard", "cooldownId": "PressureGuard", "cooldownDuration": 2.8 }
                    ]
                },
                {
                    "name": "CombatBeatAttackOrReposition",
                    "priority": 760,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "optimalCombatDistance" },
                        { "condition": "CanUseSkill" }
                    ],
                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.36, "action": "ExecuteAttack", "attackCategory": "Basic" },
                        { "weight": 0.24, "action": "ExecuteAttack", "attackCategory": "Heavy" },
                        { "weight": 0.08, "action": "ExecuteAttack", "attackCategory": "Skill" },
                        { "weight": 0.08, "action": "Transition", "state": "Circle", "cooldownId": "PressureReposition", "cooldownDuration": 1.8 },
                        { "weight": 0.10, "action": "Transition", "state": "Flank", "cooldownId": "PressureReposition", "cooldownDuration": 1.8 },
                        { "weight": 0.08, "action": "Transition", "state": "Guard", "cooldownId": "PressureGuard", "cooldownDuration": 2.8 }
                    ]
                }
            ]
        },
        {
            "name": "05 Positioning",
