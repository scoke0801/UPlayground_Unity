 int ax=Mathf.Clamp((int)(x/2400f*sourceData.alphamapWidth),0,sourceData.alphamapWidth-1),az=Mathf.Clamp((int)((z+700f)/2800f*sourceData.alphamapHeight),0,sourceData.alphamapHeight-1);if(sourceAlpha[az,ax,1]+sourceAlpha[az,ax,5]>roadThreshold||sourceData.GetSteepness(x/2400f,(z+700f)/2800f)>maxSlope)return false;
