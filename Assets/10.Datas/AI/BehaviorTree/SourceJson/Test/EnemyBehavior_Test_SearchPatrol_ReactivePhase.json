                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.12, "action": "Transition", "state": "Guard", "cooldownId": "SpacingGuard", "cooldownDuration": 2.8 },
                        { "weight": 0.36, "action": "Transition", "state": "Flank", "cooldownId": "SpacingBeat", "cooldownDuration": 1.4 },
                        { "weight": 0.22, "action": "Transition", "state": "Chase", "cooldownId": "SpacingBeat", "cooldownDuration": 1.4 },
                        { "weight": 0.12, "action": "Transition", "state": "Circle", "cooldownId": "SpacingBeat", "cooldownDuration": 1.4 },
                        { "weight": 0.06, "action": "Transition", "state": "Retreat", "cooldownId": "SpacingBeat", "cooldownDuration": 1.4 }
                    ]
