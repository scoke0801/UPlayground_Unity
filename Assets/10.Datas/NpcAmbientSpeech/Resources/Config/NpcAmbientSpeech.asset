      activities: 9
      periods: 15
    - id: seasoned.01.1
      topic: food
      text: "\uC5B4\uB9B4 \uB550 \uC548 \uBA39\uB358 \uAC78 \uC774\uC81C \uCC3E\uB124."
      activities: 9
      periods: 15
    - id: seasoned.01.2
      topic: food
      text: "\uADF8 \uC9D1 \uAD6D\uC740 \uADF8\uB987\uBD80\uD130 \uAE30\uC5B5\uB098."
      activities: 9
      periods: 15
    - id: seasoned.01.3
      topic: food
      text: "\uAC04\uC740 \uB9DE\uB294\uB370 \uBB54\uAC00 \uD558\uB098 \uBE60\uC9C4
