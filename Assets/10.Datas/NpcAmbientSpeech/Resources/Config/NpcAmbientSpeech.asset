      activities: 9
      periods: 15
    - id: seasoned.02.1
      topic: expenses
      text: "\uC2F8\uAC8C \uC0C0\uB2E4\uB294 \uC598\uAE30\uB294 \uC624\uB798 \uD558\uAC8C
