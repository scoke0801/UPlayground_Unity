      activities: 9
      periods: 15
    - id: scholarly.07.2
      topic: plans
      text: "\uBE44\uC2B7\uD55C \uAC83\uB07C\uB9AC \uB193\uACE0 \uBE44\uAD50\uD558\uACE0
