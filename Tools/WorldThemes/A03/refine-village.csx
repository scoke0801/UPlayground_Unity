// 실제 가용 셀 조사로 확인한 작은 포켓에, 이전에 비어 있던 추가분만 보완한다.
string output="output/WorldThemeProduction/VillageFields",scenePath="Assets/01.Scenes/ArtReview/WorldThemes/Theme_VillageFields.unity",hostPath="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity";
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var deserialize=jt.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});
Func<string,Type,object> read=(s,t)=>deserialize.Invoke(null,new object[]{s,t});Func<object,string> json=o=>(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
var report=(Dictionary<string,object>)read(System.IO.File.ReadAllText(output+"/applied.json"),typeof(Dictionary<string,object>));if(report["version"].ToString()!="VillageFields-v1")throw new Exception("v1의 빈 세번째 군락 전용 보완입니다.");
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/A03/village-study.json"),typeof(Dictionary<string,object>));
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(hostPath);var scene=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(scenePath);bool dirty=host.isDirty;
if(EditorApplication.isPlayingOrWillChangePlaymode||EditorUtility.scriptCompilationFailed||!host.isLoaded||!scene.isLoaded)throw new Exception("본편 보존 중의 정상 Edit Mode 필요");
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
if(hash(hostPath)!=plan["sourceSceneHash"].ToString()||hash("Assets/10.Datas/World/OpenWorld/Terrain.asset")!=plan["sourceTerrainHash"].ToString())throw new Exception("기준선 변경");
var previousActive=UnityEngine.SceneManagement.SceneManager.GetActiveScene();UnityEngine.SceneManagement.SceneManager.SetActiveScene(scene);var source=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var terrain=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var sourceData=source.terrainData;var data=terrain.terrainData;
var root=scene.GetRootGameObjects().Single(g=>g.name=="ThemeEnvironment");var cluster=root.transform.Find("집앞_작은노랑꽃");if(cluster==null||cluster.childCount!=0)throw new Exception("빈 세번째 군락 확인 실패");
var templates=scene.GetRootGameObjects().Single(g=>g.name=="PreviewRig").transform.Find("CandidateComparison_ExcludeFromIntegration");
var ids=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).ToArray();var identityBefore=ids.Select(i=>i.Guid+"|"+i.transform.position.ToString("R")+"|"+(source.SampleHeight(i.transform.position)+source.transform.position.y).ToString("R")).OrderBy(s=>s).ToArray();
var alpha=sourceData.GetAlphamaps(0,0,sourceData.alphamapWidth,sourceData.alphamapHeight);var before=data.GetAlphamaps(0,0,data.alphamapWidth,data.alphamapHeight);var preferences=host.GetRootGameObjects().Single(g=>g.name=="AuthoredEnvironment").transform.Find("NavigationPreferences");var volumes=preferences.GetComponentsInChildren<BoxCollider>(true);Physics.SyncTransforms();
Func<float,float,bool> eligible=(x,z)=>{if(x<1080||x>1135||z<340||z>395||Mathf.Abs(x-1091)<5)return false;if(ids.Any(i=>new Vector2(x-i.transform.position.x,z-i.transform.position.z).sqrMagnitude<196))return false;foreach(var v in volumes)if(v.enabled&&v.bounds.Contains(new Vector3(x,v.bounds.center.y,z)))return false;int ax=Mathf.Clamp((int)(x/2400f*data.alphamapWidth),0,data.alphamapWidth-1),az=Mathf.Clamp((int)((z+700f)/2800f*data.alphamapHeight),0,data.alphamapHeight-1);if(alpha[az,ax,1]+alpha[az,ax,5]>.4f||sourceData.GetSteepness(x/2400f,(z+700f)/2800f)>20)return false;float gy=source.SampleHeight(new Vector3(x,0,z))+source.transform.position.y;foreach(var c in Physics.OverlapSphere(new Vector3(x,gy+.7f,z),.5f,~0,QueryTriggerInteraction.Ignore))if(!(c is TerrainCollider)&&c.gameObject.scene==host&&c.bounds.max.y>gy+.25f)return false;return true;};
var added=new List<object>();var rejected=new List<object>();
for(int i=0;i<9;i++){
 string key=i<3?"white":"yellow";float a=(i*137.50776f+323f)*Mathf.Deg2Rad,r=Mathf.Sqrt((i+.5f)/9f);float x=1128.5f+Mathf.Cos(a)*1.2f*r,z=391.5f+Mathf.Sin(a)*1.8f*r;
 if(!eligible(x,z)){rejected.Add(new{x,z,key,reason="기존 보호 mask"});continue;}
 var plant=UnityEngine.Object.Instantiate(templates.Find("Candidate_"+key).gameObject);plant.name=key+"_v11_"+i;plant.transform.SetParent(cluster,false);plant.SetActive(true);plant.transform.position=new Vector3(x,0,z);plant.transform.rotation=Quaternion.Euler(0,i*67f,0);Physics.SyncTransforms();
 var rs=plant.GetComponentsInChildren<MeshRenderer>(true);var b=rs[0].bounds;foreach(var mr in rs)b.Encapsulate(mr.bounds);float ground=terrain.SampleHeight(new Vector3(x,0,z))+terrain.transform.position.y;plant.transform.position+=Vector3.up*(ground-b.min.y+.005f);Physics.SyncTransforms();b=rs[0].bounds;foreach(var mr in rs)b.Encapsulate(mr.bounds);
 if(!eligible(b.min.x,b.min.z)||!eligible(b.min.x,b.max.z)||!eligible(b.max.x,b.min.z)||!eligible(b.max.x,b.max.z)){UnityEngine.Object.DestroyImmediate(plant);rejected.Add(new{x,z,key,reason="실제 메시 footprint 보호 mask"});continue;}
 added.Add(new{cluster="집앞_작은노랑꽃",key,position=new[]{plant.transform.position.x,plant.transform.position.y,plant.transform.position.z},scale=new[]{plant.transform.localScale.x,plant.transform.localScale.y,plant.transform.localScale.z},rotationY=plant.transform.eulerAngles.y,support=ground,height=key=="white" ? .65f : .55f,colliders=0});
}
if(added.Count==0)throw new Exception("보완 실배치0; 성공 판정 안 함");
var painted=(float[,,])before.Clone();int newPaint=0;
for(int z=0;z<painted.GetLength(0);z++)for(int x=0;x<painted.GetLength(1);x++){float wx=(x+.5f)/data.alphamapWidth*2400f,wz=-700f+(z+.5f)/data.alphamapHeight*2800f;float distance=Mathf.Pow((wx-1128.5f)/2f,2)+Mathf.Pow((wz-391.5f)/3f,2);if(distance>=1||!eligible(wx,wz))continue;float green=painted[z,x,0]+painted[z,x,4];if(green<.4f)continue;float shift=.1f*(1-distance)*(1-distance);painted[z,x,0]-=shift*painted[z,x,0]/green;painted[z,x,4]-=shift*painted[z,x,4]/green;painted[z,x,3]+=shift;newPaint++;}
data.SetAlphamaps(0,0,painted);var after=data.GetAlphamaps(0,0,data.alphamapWidth,data.alphamapHeight);int outside=0,inside=0;
for(int z=0;z<after.GetLength(0);z++)for(int x=0;x<after.GetLength(1);x++)for(int l=0;l<after.GetLength(2);l++)if(after[z,x,l]!=alpha[z,x,l]){float wx=(x+.5f)/data.alphamapWidth*2400f,wz=-700f+(z+.5f)/data.alphamapHeight*2800f;if(wx<1080||wx>1135||wz<340||wz>395)outside++;else inside++;}
if(outside!=0)throw new Exception("core 밖 표면 변경");
if(!identityBefore.SequenceEqual(ids.Select(i=>i.Guid+"|"+i.transform.position.ToString("R")+"|"+(source.SampleHeight(i.transform.position)+source.transform.position.y).ToString("R")).OrderBy(s=>s)))throw new Exception("ID/위치/발밑 변경");
if(host.isDirty!=dirty||hash(hostPath)!=plan["sourceSceneHash"].ToString()||hash("Assets/10.Datas/World/OpenWorld/Terrain.asset")!=plan["sourceTerrainHash"].ToString())throw new Exception("원본 보존 실패");
EditorUtility.SetDirty(data);AssetDatabase.SaveAssetIfDirty(data);string prefab=report["prefab"].ToString(),prefabGuid=AssetDatabase.AssetPathToGUID(prefab);PrefabUtility.SaveAsPrefabAsset(root,prefab);if(prefabGuid!=AssetDatabase.AssetPathToGUID(prefab))throw new Exception("환경 프리팹GUID 변경");if(!UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene))throw new Exception("A03 저장 실패");
var oldPlacements=(object[])read(report["placements"].ToString(),typeof(object[]));var oldRejected=(object[])read(report["rejected"].ToString(),typeof(object[]));report["placements"]=oldPlacements.Concat(added).ToArray();report["rejected"]=oldRejected.Concat(rejected).ToArray();report["paintedCells"]=Convert.ToInt32(report["paintedCells"])+newPaint;report["insideAlphaChannelsChanged"]=inside;report["outsideAlphaChannelsChanged"]=outside;report["version"]="VillageFields-v1.1";report["refinement"]=new{reason="기존 3번째 군락의 경사/흙길을 우회하지 않고 실제 가용 포켓으로 이동",center=new[]{1128.5f,391.5f},added=added.Count,rejected=rejected.Count,sourceIdentityCount=ids.Length,hostDirtyBefore=dirty,hostDirtyAfter=host.isDirty};
System.IO.File.WriteAllText(output+"/applied.json",json(report));UnityEngine.SceneManagement.SceneManager.SetActiveScene(previousActive);return "A03 v1.1 added="+added.Count+" total="+(oldPlacements.Length+added.Count)+" surface+="+newPaint+" outside=0";
