  - id: scholarly
    direction: "\uAE34 \uB85C\uBE0C\uC640 \uC0AC\uC0C9\uC801\uC778 \uC778\uC0C1.
      \uC774\uB984\xB7\uAE00\uC790\xB7\uC21C\uC11C\uB97C \uB530\uC9C0\uB2E4\uAC00
