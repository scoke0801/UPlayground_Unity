if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("QuarryPassR1-A-20261108"))throw new Exception("A 잠금 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/QuarryPassR1.unity")throw new Exception("A 씬 필요");
string folder="Assets/10.Datas/World/ThemeStudies/QuarryPassR1";var own=System.IO.Directory.GetFiles(folder,"*",System.IO.SearchOption.AllDirectories).Where(p=>!p.EndsWith(".meta")).Select(p=>p.Replace('\\','/')).Concat(new[]{scene.path}).ToArray();var paths=AssetDatabase.GetDependencies(own,true);var rows=new List<object>();
foreach(var p in paths){if(!p.StartsWith("Assets/")||!System.IO.File.Exists(p))continue;string h="pending-external-hash";rows.Add(new{path=p,guid=AssetDatabase.AssetPathToGUID(p),sha256=h,owned=p.StartsWith(folder+"/")||p==scene.path,bytes=new System.IO.FileInfo(p).Length});}
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var result=new{project=Application.dataPath,scene=scene.path,resources=rows,sharedPolicy="공유 참조는 읽기 전용. 패키지는 A 신규 자원과 meta만 포함하며 기존 GUID 의존성은 이 목록으로 확인",otherAgentDependencies=paths.Where(p=>p.Contains("/CloudridgeR1/")||p.Contains("/HarborReedR1/")).ToArray()};System.IO.File.WriteAllText("output/QuarryPassR1/references-final.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));
var state=new{project=Application.dataPath,scene=scene.path,dirty=scene.isDirty,playing=EditorApplication.isPlaying,isCompiling=EditorApplication.isCompiling,compileFailed=EditorUtility.scriptCompilationFailed,pipeline=QualitySettings.renderPipeline==null?null:AssetDatabase.GetAssetPath(QualitySettings.renderPipeline),temporaryCapture=GameObject.Find("QuarryA_TemporaryCapture")!=null,recordedUtc=DateTime.UtcNow.ToString("o")};System.IO.File.WriteAllText("output/QuarryPassR1/editor-final-state.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{state}));return new{resources=rows.Count,state};
