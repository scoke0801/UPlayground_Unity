var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity")throw new Exception("월드 Edit Mode 필요");
var root=GameObject.Find("AuthoredEnvironment/연속 경관과 농경지");if(root==null)throw new Exception("배치 누락");
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var parse=json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/OpenWorld/regional-cover-plan.json"),typeof(Dictionary<string,object>));
var routes=((Dictionary<string,object>[])read(plan["routes"].ToString(),typeof(Dictionary<string,object>[]))).Select(r=>(float[][])read(r["points"].ToString(),typeof(float[][]))).ToArray();
Func<Vector2,bool> onRoad=p=>{foreach(var line in routes)for(int k=1;k<line.Length;k++){var a=new Vector2(line[k-1][0],line[k-1][1]);var d=new Vector2(line[k][0],line[k][1])-a;float f=Mathf.Clamp01(Vector2.Dot(p-a,d)/d.sqrMagnitude);if(Vector2.Distance(p,a+d*f)<8)return true;}return false;};
var source=AssetDatabase.LoadAssetAtPath<GameObject>(plan["cropPath"].ToString()).GetComponentsInChildren<MeshFilter>(true);int removed=0,keptPlants=0;
foreach(var mf in root.GetComponentsInChildren<MeshFilter>(true).Where(m=>m.name.StartsWith("Wheat_LOD"))){int level=mf.name.EndsWith("1")?1:2;int block=source.First(m=>m.name.Contains("LOD"+level)).sharedMesh.vertexCount;var mesh=mf.sharedMesh;var vertices=mesh.vertices;var keep=new bool[vertices.Length/block];
 for(int i=0;i<keep.Length;i++){var center=Vector3.zero;for(int j=0;j<block;j++)center+=vertices[i*block+j];center/=block;center=mf.transform.TransformPoint(center);keep[i]=!onRoad(new Vector2(center.x,center.z));if(level==1){if(keep[i])keptPlants++;else removed++;}}
 var triangles=mesh.triangles;var result=new List<int>(triangles.Length);for(int i=0;i<triangles.Length;i+=3)if(keep[triangles[i]/block]){result.Add(triangles[i]);result.Add(triangles[i+1]);result.Add(triangles[i+2]);}mesh.SetTriangles(result,0);EditorUtility.SetDirty(mesh);AssetDatabase.SaveAssetIfDirty(mesh);
}
string report="길 주변 작물 묶음 제거="+removed+" / 유지="+keptPlants;System.IO.File.WriteAllText("output/OpenWorld/RegionalCover/crop-clearance.txt",report);return report;
