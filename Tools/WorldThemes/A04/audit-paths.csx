var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");if(!host.isLoaded||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("Host Edit Mode 필요");
var loadedPaths=new List<string>();for(int i=0;i<UnityEngine.SceneManagement.SceneManager.sceneCount;i++)loadedPaths.Add(UnityEngine.SceneManagement.SceneManager.GetSceneAt(i).path);if(loadedPaths.Count!=1||loadedPaths[0]!=host.path)throw new Exception("Global Nav에 영향을 줄 다른 loaded scene 있음. 제거/저장 없이 중단");
var terrain=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();var agents=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UnityEngine.AI.NavMeshAgent>(true)).ToArray();var masks=agents.Select(a=>a.areaMask).Distinct().ToArray();if(masks.Length>1)throw new Exception("서로 다른 실제 agent areaMask 검토 필요");int mask=masks.Length==1?masks[0]:UnityEngine.AI.NavMesh.AllAreas;
var pairs=new[]{new[]{new Vector2(1150,500),new Vector2(1130,580)},new[]{new Vector2(1120,548),new Vector2(1180,530)}};var rows=new List<object>();
foreach(var pair in pairs)for(int direction=0;direction<2;direction++){var startXZ=pair[direction];var endXZ=pair[1-direction];var start=new Vector3(startXZ.x,terrain.SampleHeight(new Vector3(startXZ.x,0,startXZ.y))+terrain.transform.position.y,startXZ.y);var end=new Vector3(endXZ.x,terrain.SampleHeight(new Vector3(endXZ.x,0,endXZ.y))+terrain.transform.position.y,endXZ.y);UnityEngine.AI.NavMeshHit startHit,endHit;bool startSample=UnityEngine.AI.NavMesh.SamplePosition(start,out startHit,2f,mask),endSample=UnityEngine.AI.NavMesh.SamplePosition(end,out endHit,2f,mask);var path=new UnityEngine.AI.NavMeshPath();bool calculated=startSample&&endSample&&UnityEngine.AI.NavMesh.CalculatePath(startHit.position,endHit.position,mask,path);rows.Add(new{from=new[]{start.x,start.y,start.z},to=new[]{end.x,end.y,end.z},startSample=startSample,endSample=endSample,tolerance=2f,startSamplePosition=startSample?new[]{startHit.position.x,startHit.position.y,startHit.position.z}:null,endSamplePosition=endSample?new[]{endHit.position.x,endHit.position.y,endHit.position.z}:null,startDelta=startSample?Vector3.Distance(start,startHit.position):float.MaxValue,endDelta=endSample?Vector3.Distance(end,endHit.position):float.MaxValue,areaMask=mask,maskBasis=masks.Length==1?"actual loaded Host NavMeshAgent.areaMask":"AllAreas exploratory; no loaded NavMeshAgent, runtime code basis pending",calculated=calculated,status=path.status.ToString(),worldCorners=path.corners.Select(p=>new[]{p.x,p.y,p.z}).ToArray()});}
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};var result=new{loadedScenes=loadedPaths,globalNavScope="Host only, no duplicate art NavMesh loaded",sourceNav="Assets/10.Datas/World/OpenWorld/VillageBuildingGroundingNavigation.asset",sourceNavHash=hash("Assets/10.Datas/World/OpenWorld/VillageBuildingGroundingNavigation.asset"),hostAgentMasks=masks,paths=rows,baked=false,heightEdited=false};var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);System.IO.File.WriteAllText("output/WorldThemeProduction/RedTreeForest/path-audit.json",(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result}));return "A04 readonly path directions="+rows.Count+" mask="+mask;
