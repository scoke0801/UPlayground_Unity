// A00 lease에서 이미 열린 Host/이미 임포트된 prefab을 읽기만 한다. 인스턴스/씬/임포트/저장 생성 금지.
if(UnityEditor.EditorApplication.isPlayingOrWillChangePlaymode||UnityEditor.EditorApplication.isCompiling)throw new Exception("안정된 Edit Mode 필요");
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var deserialize=json.GetMethod("DeserializeObject",new Type[]{typeof(string),typeof(Type)});
Func<string,Type,object> read=(s,t)=>deserialize.Invoke(null,new object[]{s,t});
var input=(Dictionary<string,object>)read(System.IO.File.ReadAllText("output/WorldThemeProduction/ShadeCreek/ConnectedProtection/unity-pose-audit-input.json"),typeof(Dictionary<string,object>));
var lease=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/Integration/editor-lease.json"),typeof(Dictionary<string,object>));if(lease["owner"].ToString()!=input["editorLeaseOwnerRequired"].ToString())throw new Exception("A00 명시 Editor lease 필요");
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
Func<Vector3,float[]> vec=p=>new[]{p.x,p.y,p.z};
Func<Matrix4x4,float[]> matrix=m=>new[]{m.m00,m.m01,m.m02,m.m03,m.m10,m.m11,m.m12,m.m13,m.m20,m.m21,m.m22,m.m23,m.m30,m.m31,m.m32,m.m33};
var rows=(Dictionary<string,object>[])read(input["records"].ToString(),typeof(Dictionary<string,object>[]));var results=new List<object>();
foreach(var row in rows){
 string scenePath=row["sourceScene"].ToString(),prefabPath=row["sourcePrefabPath"].ToString();var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(scenePath);if(!host.isLoaded)throw new Exception("Host가 이미 열려 있어야 함. 자동 로드 금지");bool dirty=host.isDirty;
 if(hash(scenePath)!=row["sourceSceneHash"].ToString()||hash(prefabPath)!=row["sourcePrefabHash"].ToString()||UnityEditor.AssetDatabase.AssetPathToGUID(prefabPath)!=row["sourcePrefabGuid"].ToString())throw new Exception("원본 source/hash/GUID 변동");
 string guid=row["entityGuid"].ToString();var entities=host.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true)).Where(e=>e.Guid==guid).ToArray();if(entities.Length!=1)throw new Exception("Host entityGuid 일치가 1개 아님: "+guid);
 var entity=entities[0];var objectId=UnityEditor.GlobalObjectId.GetGlobalObjectIdSlow(entity);if(objectId.assetGUID.ToString()!=row["sourceSceneGuid"].ToString()||objectId.targetObjectId.ToString()!=row["componentFileId"].ToString())throw new Exception("정확 SceneEntityId component GlobalObjectId 불일치");
 var asset=UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(prefabPath);if(asset==null)throw new Exception("이미 임포트된 정확 prefab root 로드 실패");
 string assetGuid;long assetId;UnityEditor.AssetDatabase.TryGetGUIDAndLocalFileIdentifier(asset.transform,out assetGuid,out assetId);
 var parents=new List<object>();for(var t=entity.transform.parent;t!=null;t=t.parent)parents.Add(new{name=t.name,position=vec(t.position),localPosition=vec(t.localPosition),localScale=vec(t.localScale),localToWorld=matrix(t.localToWorldMatrix)});
 if(host.isDirty!=dirty||hash(scenePath)!=row["sourceSceneHash"].ToString()||hash(prefabPath)!=row["sourcePrefabHash"].ToString())throw new Exception("읽기 조사 중 원본/dirty 상태 변경");
 results.Add(new{entityGuid=guid,mapId=row["mapId"].ToString(),componentGlobalId=objectId.ToString(),sourceScene=scenePath,sourceSceneHash=hash(scenePath),hostDirty=dirty,worldPosition=vec(entity.transform.position),localPosition=vec(entity.transform.localPosition),localScale=vec(entity.transform.localScale),localToWorldMatrixRowMajor=matrix(entity.transform.localToWorldMatrix),nativeAndPrefabParentMatrices=parents,sourcePrefab=new{path=prefabPath,guid=assetGuid,rootTransformFileId=assetId.ToString(System.Globalization.CultureInfo.InvariantCulture),hash=hash(prefabPath),localPosition=vec(asset.transform.localPosition),localScale=vec(asset.transform.localScale),localToWorldMatrixRowMajor=matrix(asset.transform.localToWorldMatrix),sourceEntityIds=asset.GetComponentsInChildren<UPlayGround.Components.SceneEntityId>(true).Select(e=>new{guid=e.Guid,name=e.name,localPosition=vec(e.transform.localPosition)}).ToArray()},status="Unity 읽기 matrix 확인. Collider/접지/진행 미검증"});
}
var report=new{status="읽기 API만. 생성/임포트/씬변경/저장/Play 없음",records=results};string output=(string)json.GetMethod("SerializeObject",new Type[]{typeof(object)}).Invoke(null,new object[]{report});System.IO.Directory.CreateDirectory("output/WorldThemeProduction/ShadeCreek/ConnectedProtection");System.IO.File.WriteAllText(input["expectedOutput"].ToString(),output);return "variant pose 읽기 "+results.Count+"개. 원본/dirty 보존";
