// 디스크 백업을 별도 역직렬화해 변경 표본과 허용 영역 밖 보존을 비교한다.
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity"||EditorApplication.isPlayingOrWillChangePlaymode||EditorApplication.isCompiling||EditorUtility.scriptCompilationFailed)throw new Exception("월드 Edit Mode 필요");
string folder="output/OpenWorld/EnvironmentForm";var terrain=GameObject.Find("AuthoredEnvironment").GetComponentInChildren<Terrain>();var data=terrain.terrainData;
var loaded=UnityEditorInternal.InternalEditorUtility.LoadSerializedFileAndForget(folder+"/backup/Assets/10.Datas/World/OpenWorld/Terrain.asset");
try{
var before=loaded.OfType<TerrainData>().Single();if(before.heightmapResolution!=data.heightmapResolution||before.size!=data.size)throw new Exception("Terrain 규격 변경");
var a=before.GetHeights(0,0,before.heightmapResolution,before.heightmapResolution);var b=data.GetHeights(0,0,data.heightmapResolution,data.heightmapResolution);int changed=0,outside=0;float max=0;
Func<float,float,bool> allowed=(x,z)=>Mathf.Pow((x-383)/64,2)+Mathf.Pow((z-1187)/104,2)<1.001f||Mathf.Pow((x-467)/61,2)+Mathf.Pow((z-1381)/109,2)<1.001f||Mathf.Pow((x-326)/105,2)+Mathf.Pow((z-1198)/170,2)<1.001f||Mathf.Pow((x-350)/140,2)+Mathf.Pow((z-1210)/190,2)<1.001f||Mathf.Pow((x-467)/85,2)+Mathf.Pow((z-1381)/109,2)<1.001f;
for(int z=0;z<a.GetLength(0);z++)for(int x=0;x<a.GetLength(1);x++){float delta=Mathf.Abs(a[z,x]-b[z,x]);if(delta<.0000001f)continue;changed++;max=Mathf.Max(max,delta*data.size.y);float wx=terrain.transform.position.x+x*data.size.x/(data.heightmapResolution-1),wz=terrain.transform.position.z+z*data.size.z/(data.heightmapResolution-1);if(!allowed(wx,wz))outside++;}
bool layers=before.terrainLayers.Select(l=>AssetDatabase.GetAssetPath(l)).SequenceEqual(data.terrainLayers.Select(l=>AssetDatabase.GetAssetPath(l)));
int paintChanged=0,paintOutside=0;for(int z=0;z<data.alphamapHeight;z+=64){int height=Mathf.Min(64,data.alphamapHeight-z);var aa=before.GetAlphamaps(0,z,data.alphamapWidth,height);var bb=data.GetAlphamaps(0,z,data.alphamapWidth,height);for(int zz=0;zz<height;zz++)for(int x=0;x<data.alphamapWidth;x++){bool different=false;for(int l=0;l<data.alphamapLayers;l++)if(Mathf.Abs(aa[zz,x,l]-bb[zz,x,l])>.0001f){different=true;break;}if(!different)continue;paintChanged++;float wx=(x+.5f)/data.alphamapWidth*data.size.x,wz=terrain.transform.position.z+(z+zz+.5f)/data.alphamapHeight*data.size.z;if(!allowed(wx,wz))paintOutside++;}}
string result="heights="+changed+" maxDelta="+max.ToString("F4")+" outsideHeights="+outside+" paint="+paintChanged+" outsidePaint="+paintOutside+" layersPreserved="+layers;System.IO.File.WriteAllText(folder+"/terrain-preservation.txt",result);if(outside!=0||paintOutside!=0||!layers)throw new Exception(result);return result;
}finally{foreach(var asset in loaded)UnityEngine.Object.DestroyImmediate(asset);}
