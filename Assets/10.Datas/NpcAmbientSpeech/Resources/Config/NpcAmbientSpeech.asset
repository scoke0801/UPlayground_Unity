      activities: 9
      periods: 15
    - id: seasoned.03.1
      topic: people
      text: "\uADF8 \uC598\uAE34 \uBC8C\uC368 \uD588\uB098? \uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C
        \uD588\uB098?"
      activities: 9
      periods: 15
    - id: seasoned.03.2
      topic: people
      text: "\uC778\uC0AC\uB9CC \uD558\uB824\uB2E4\uAC00 \uD55C\uCC38 \uC788\uC5C8\uB124."
