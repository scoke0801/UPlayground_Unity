  m_Script: {fileID: 11500000, guid: 33dbbdb6f707d9846a5e61bf67613e4e, type: 3}
  m_Name: Node_Talk
  m_EditorClassIdentifier: 
  nodeId: ffba7a1c-900e-498b-972e-4c0104628179
  nodeType: 0
  channel: 0
  speakerId: "\uACBD\uBE44\uBCD1"
  dialogueText: "\uADF8\uB798.\n\n\uD558\uC9C0\uB9CC \uACC4\uC18D \uBC29\uCE58\uD560
    \uC218\uB3C4 \uC5C6\uB2E4.\n\n\uC800 \uC55E \uACF5\uD130\uC5D0 \uB098\uD0C0\uB09C
    \uAD34\uBB3C\uB4E4\uC744 \uC815\uB9AC\uD574 \uC900\uB2E4\uBA74,\n\uC6B0\uB9AC\uB294
    \uB124\uAC00 \uCDA9\uBD84\uD55C \uC2E4\uB825\uC744 \uAC16\uCDC4\uB2E4\uACE0 \uD310\uB2E8\uD558\uACA0\uB2E4.\n\n\uC2DD\uBB3C\uC774\uB4E0,\n\uD574\uACE8\uC774\uB4E0,\n\uB3C4\uC801\uC774\uB4E0,\n\n\uC9C0\uAE08\uBD80\uD130
    \uB9C8\uC8FC\uD558\uAC8C \uB420 \uC801\uB4E4\uC740 \uBAA8\uB450 \uC704\uD5D8\uD558\uB2E4."
  portrait: {fileID: 21300000, guid: 2e7bb733976c597408dce7c345447399, type: 3}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
  nextNodeId: fbf553d2-6334-44bd-9cd0-9f6576f4b9fd
  trueNextNodeId: 
  falseNextNodeId: 
