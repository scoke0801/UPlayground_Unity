var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlaying||scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity")throw new Exception("전용 씬 필요");
var root=GameObject.Find("B1_ArtR1").transform;if(root.Find("지표와 미세 자갈")!=null)throw new Exception("적용된 지표 보존");var parent=new GameObject("지표와 미세 자갈").transform;parent.SetParent(root);
string data="Assets/10.Datas/World/RiverBasinWorld/VisualR1";
Func<float,float,float,float> blend=(a,b,v)=>Mathf.SmoothStep(0,1,Mathf.InverseLerp(a,b,v));
var terrains=Terrain.activeTerrains;Func<float,float,float> ground=(x,z)=>{var t=terrains.First(a=>x>=a.transform.position.x&&x<=a.transform.position.x+512&&z>=a.transform.position.z&&z<=a.transform.position.z+512);return t.SampleHeight(new Vector3(x,0,z))+t.transform.position.y;};
var gravelLayer=AssetDatabase.LoadAssetAtPath<TerrainLayer>("Assets/10.Datas/World/OpenWorld/ShadeCreekVisualR3/WetRiverBed.terrainlayer");
var gravel=new Material(Shader.Find("UPlayGround/Environment/Creek Ground"));gravel.SetTexture("_BaseMap",gravelLayer.diffuseTexture);gravel.SetColor("_BaseColor",new Color(.76f,.70f,.57f,1));gravel.SetColor("_WetColor",new Color(.40f,.43f,.35f,1));gravel.SetFloat("_WeatherExposure",1);AssetDatabase.CreateAsset(gravel,data+"/ClearingGravel.mat");
var humus=new Material(gravel);humus.SetTexture("_BaseMap",AssetDatabase.LoadAssetAtPath<Texture2D>("Assets/04.Images/World/RiverBasinWorld/LeafEarth_Albedo.png"));humus.SetColor("_BaseColor",new Color(.55f,.49f,.34f,1));humus.SetColor("_WetColor",new Color(.33f,.36f,.25f,1));AssetDatabase.CreateAsset(humus,data+"/CanopyHumus.mat");
Action<string,float,float,int,int,Material,Func<float,float,float>> surface=(name,minX,minZ,columns,rows,material,alpha)=>{
 var vertices=new Vector3[columns*rows];var uv=new Vector2[vertices.Length];var colors=new Color[vertices.Length];var tris=new List<int>();
 for(int z=0;z<rows;z++)for(int x=0;x<columns;x++){int i=z*columns+x;float wx=minX+x*.75f,wz=minZ+z*.75f;float y=ground(wx,wz);vertices[i]=new Vector3(wx,y+.035f,wz);uv[i]=new Vector2(wx/2.4f,wz/2.4f);float a=alpha(wx,wz);a*=Mathf.SmoothStep(0,1,Mathf.Min(x,columns-1-x)/3f)*Mathf.SmoothStep(0,1,Mathf.Min(z,rows-1-z)/3f);colors[i]=new Color(Mathf.Clamp01((74.8f-y)/3),0,0,a);if(x>0&&z>0){tris.AddRange(new[]{i-columns-1,i-1,i,i-columns-1,i,i-columns});}}
 var mesh=new Mesh();mesh.name=name;mesh.vertices=vertices;mesh.uv=uv;mesh.colors=colors;mesh.triangles=tris.ToArray();mesh.RecalculateNormals();mesh.RecalculateBounds();AssetDatabase.CreateAsset(mesh,data+"/"+name+".asset");var g=new GameObject(name,typeof(MeshFilter),typeof(MeshRenderer));g.transform.SetParent(parent);g.GetComponent<MeshFilter>().sharedMesh=mesh;g.GetComponent<Renderer>().sharedMaterial=material;g.GetComponent<Renderer>().shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;
};
surface("ClearingGravel",239,-23,65,65,gravel,(x,z)=>{float r=Mathf.Sqrt(Mathf.Pow((x-260)/19,2)+Mathf.Pow(z/23,2));return 1-blend(.94f,1.03f,r);});
var trees=root.GetComponentsInChildren<Transform>().Where(t=>t.parent!=null&&(t.parent.name=="수관 프레이밍"||t.parent.name=="배경 군락"||t.parent.name=="수관과 호안 보강")&&t.name.Contains("Osmanthus")).Select(t=>t.position).ToArray();
surface("CanopyFloor",232,-80,191,191,humus,(x,z)=>{float distance=100;foreach(var t in trees)distance=Mathf.Min(distance,Vector2.Distance(new Vector2(x,z),new Vector2(t.x,t.z)));float alpha=1-blend(3,7,distance);float clearing=Mathf.Sqrt(Mathf.Pow((x-260)/20,2)+Mathf.Pow(z/24,2));alpha*=blend(.9f,1.2f,clearing);if(ground(x,z)<72.5f)alpha=0;return alpha;});
// 표면을 이루는 작은 자갈은 한 구간 메시로 묶고 이동 충돌은 지형에 맡긴다.
var source=AssetDatabase.LoadAssetAtPath<GameObject>("Assets/ExternalAssets/Environment/PolyartStudio/DreamscapeEastLands/Prefabs/Stones/RiverRocks/PF_EastLands_RiverRock_03.prefab");var filter=source.GetComponentsInChildren<MeshFilter>().Last();var random=new System.Random(19437);var combines=new List<CombineInstance>();
for(int i=0;i<850;i++){float x=240+(float)random.NextDouble()*45,z=-21+(float)random.NextDouble()*43;float radius=Mathf.Sqrt(Mathf.Pow((x-260)/19,2)+Mathf.Pow(z/22,2));if(radius>1.2f)continue;float size=.025f+(float)random.NextDouble()*.035f;var matrix=Matrix4x4.TRS(new Vector3(x,ground(x,z)-.01f,z),Quaternion.Euler(0,(float)random.NextDouble()*360,0),new Vector3(size,size*.6f,size))*filter.transform.localToWorldMatrix;combines.Add(new CombineInstance{mesh=filter.sharedMesh,transform=matrix});}
var stones=new Mesh();stones.name="ClearingPebbles";stones.indexFormat=UnityEngine.Rendering.IndexFormat.UInt32;stones.CombineMeshes(combines.ToArray(),true,true);stones.RecalculateBounds();AssetDatabase.CreateAsset(stones,data+"/ClearingPebbles.asset");var stoneMaterial=new Material(Shader.Find("Universal Render Pipeline/Lit"));stoneMaterial.mainTexture=AssetDatabase.LoadAssetAtPath<Texture2D>("Assets/04.Images/World/RiverBasinWorld/VisualR1/GraniteAlbedo.png");stoneMaterial.color=new Color(.55f,.52f,.43f,1);stoneMaterial.SetFloat("_Smoothness",.12f);AssetDatabase.CreateAsset(stoneMaterial,data+"/SmallStones.mat");var pebbles=new GameObject("ClearingPebbles",typeof(MeshFilter),typeof(MeshRenderer));pebbles.transform.SetParent(parent);pebbles.GetComponent<MeshFilter>().sharedMesh=stones;pebbles.GetComponent<Renderer>().sharedMaterial=stoneMaterial;pebbles.GetComponent<Renderer>().shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;
foreach(var obj in new UnityEngine.Object[]{gravel,humus,stoneMaterial})AssetDatabase.SaveAssetIfDirty(obj);
UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return "자갈 표면·수관 아래 부엽토·미세 자갈 "+combines.Count;
