  m_Script: {fileID: 11500000, guid: 33dbbdb6f707d9846a5e61bf67613e4e, type: 3}
  m_Name: Node_Talk
  m_EditorClassIdentifier: 
  nodeId: 07a49056-f5aa-4080-92f6-f4cb9cdcbfc7
  nodeType: 0
  channel: 0
  speakerId: "\uACBD\uBE44\uBCD1"
  dialogueText: "\uAC70\uAE30, \uC7A0\uC2DC \uBA48\uCDB0\uB77C.\n\n\uC55E\uCABD \uAE38\uC740
    \uD604\uC7AC \uD1B5\uC81C \uC911\uC774\uB2E4.\n\n\uC6D0\uB798\uB77C\uBA74 \uC21C\uCC30\uB300\uAC00
    \uC0AC\uC6A9\uD558\uB294 \uC548\uC804\uD55C \uD1B5\uD589\uB85C\uC600\uC9C0\uB9CC,\n\uCD5C\uADFC
    \uB4E4\uC5B4 \uC774\uC0C1\uD55C \uC0AC\uAC74\uC774 \uC5F0\uB2EC\uC544 \uBC1C\uC0DD\uD558\uACE0
    \uC788\uB2E4."
  portrait: {fileID: 21300000, guid: 2e7bb733976c597408dce7c345447399, type: 3}
  typingSpeed: 0.04
  autoAdvanceDuration: 0
