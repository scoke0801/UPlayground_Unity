 return true;
};
var patches=(Dictionary<string,object>[])read(plan["surfacePatches"].ToString(),typeof(Dictionary<string,object>[]));var painted=(float[,,])before.Clone();int paintedCells=0;
for(int z=0;z<painted.GetLength(0);z++)for(int x=0;x<painted.GetLength(1);x++){
 float wx=(x+.5f)/data.alphamapWidth*2400f,wz=-700f+(z+.5f)/data.alphamapHeight*2800f;if(wx<1010||wx>1080||wz<340||wz>395)continue;
 float dirt=0,warm=0;foreach(var patch in patches){var c=(float[])read(patch["center"].ToString(),typeof(float[]));var r=(float[])read(patch["radius"].ToString(),typeof(float[]));float distance=Mathf.Pow((wx-c[0])/r[0],2)+Mathf.Pow((wz-c[1])/r[1],2);if(distance>=1)continue;float weight=(1-distance)*(1-distance);dirt=Mathf.Max(dirt,weight*Convert.ToSingle(patch["flatDirtWeight"]));warm=Mathf.Max(warm,weight*Convert.ToSingle(patch["warmGrassWeight"]));}
 float green=painted[z,x,0]+painted[z,x,4];if(dirt+warm<.001f||green<.4f||!eligible(wx,wz))continue;float total=Mathf.Min(green*.7f,dirt+warm),ratio=total/(dirt+warm);painted[z,x,0]-=total*painted[z,x,0]/green;painted[z,x,4]-=total*painted[z,x,4]/green;painted[z,x,5]+=dirt*ratio;painted[z,x,3]+=warm*ratio;paintedCells++;
