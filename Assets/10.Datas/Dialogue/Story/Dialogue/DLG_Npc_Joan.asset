  m_EditorClassIdentifier:
  nodeId: joan_intro_02
  nodeType: 0
  channel: 0
  speakerId: Protagonist
  dialogueText: "준과 마을 사람 둘이 그물을 걷으러 갔다가 돌아오지 않았다고."
