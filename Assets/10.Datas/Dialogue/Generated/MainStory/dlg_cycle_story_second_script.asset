  nodeType: 0
  channel: 0
  speakerId: "안내인"
  dialogueText: "응. 시련장은 도전자의 전술뿐 아니라 우리가 해 준 조언도 다음 배치에 반영해."
  portrait: {fileID: 0}
  typingSpeed: 0.04
