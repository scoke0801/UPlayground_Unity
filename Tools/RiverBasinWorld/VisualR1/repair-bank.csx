var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlaying||scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity")throw new Exception("전용 Edit Mode 필요");
var terrains=Terrain.activeTerrains;Func<float,float,float> ground=(x,z)=>{var t=terrains.First(a=>x>=a.transform.position.x&&x<=a.transform.position.x+512&&z>=a.transform.position.z&&z<=a.transform.position.z+512);return t.SampleHeight(new Vector3(x,0,z))+t.transform.position.y;};
var root=GameObject.Find("B1_ArtR1").transform;var groups=new HashSet<string>{"수관 프레이밍","배경 군락","주요 암반","자갈과 작은 하상석","길가 낮은 풀","낮은 관목","마당 외곽 쓰러진 나무","물가 갈대","군락 아래 낙엽","수관과 호안 보강"};
var objects=root.GetComponentsInChildren<Transform>().Where(t=>t.parent!=null&&groups.Contains(t.parent.name)).ToArray();var before=objects.Select(t=>ground(t.position.x,t.position.z)).ToArray();
foreach(int tx in new[]{1,2}){var t=GameObject.Find("Terrain_"+tx+"_1").GetComponent<Terrain>();var heights=new float[513,513];var bytes=System.IO.File.ReadAllBytes("Tools/RiverBasinWorld/VisualR1/Generated/Terrain_"+tx+"_1.f32");Buffer.BlockCopy(bytes,0,heights,0,bytes.Length);t.terrainData.SetHeights(0,0,heights);AssetDatabase.SaveAssetIfDirty(t.terrainData);}
for(int i=0;i<objects.Length;i++){var p=objects[i].position;p.y+=ground(p.x,p.z)-before[i];objects[i].position=p;if((objects[i].parent.name=="길가 낮은 풀"||objects[i].parent.name=="물가 갈대")&&p.y<72.5f)objects[i].gameObject.SetActive(false);}
foreach(string name in new[]{"ClearingGravel","CanopyFloor"}){var mesh=AssetDatabase.LoadAssetAtPath<Mesh>("Assets/10.Datas/World/RiverBasinWorld/VisualR1/"+name+".asset");var vertices=mesh.vertices;var colors=mesh.colors;for(int i=0;i<vertices.Length;i++){var p=vertices[i];float y=ground(p.x,p.z);vertices[i].y=y+.035f;if(y<72.5f)colors[i].a=0;}mesh.vertices=vertices;mesh.colors=colors;mesh.RecalculateNormals();EditorUtility.SetDirty(mesh);AssetDatabase.SaveAssetIfDirty(mesh);}
Physics.SyncTransforms();UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);return "교대 호안의 경사 전이와 접지 보정";
