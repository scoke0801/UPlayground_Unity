      activities: 9
      periods: 15
    - id: bright.01.2
      topic: food
      text: "\uC0C8\uB85C\uC6B4 \uB9DB\uC740 \uD55C \uC785\uB9CC \uBA39\uC5B4 \uBCF4\uBA74
