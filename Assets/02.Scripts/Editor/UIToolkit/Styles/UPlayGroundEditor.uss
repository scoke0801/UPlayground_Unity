.up-editor-root {
    --up-bg-0: rgb(9, 14, 20);
    --up-bg-1: rgb(14, 21, 29);
    --up-bg-2: rgb(20, 29, 39);
    --up-bg-3: rgb(27, 38, 50);
    --up-border: rgb(44, 61, 77);
    --up-border-strong: rgb(62, 84, 103);
    --up-accent: rgb(46, 154, 255);
    --up-accent-soft: rgba(46, 154, 255, 0.16);
    --up-text: rgb(228, 235, 244);
    --up-text-dim: rgb(142, 157, 174);
    --up-text-faint: rgb(94, 112, 130);
    --up-space-1: 4px;
    --up-space-2: 8px;
    --up-space-3: 12px;
    --up-radius: 4px;
    --up-font-sm: 11px;
    --up-font-md: 12px;
    --up-track-montage: rgb(66, 135, 201);
    --up-track-timing: rgb(214, 165, 62);
    --up-track-notify: rgb(177, 96, 199);
    --up-track-overlay: rgb(73, 171, 143);

    flex-grow: 1;
    min-width: 600px;
    min-height: 400px;
    color: var(--up-text);
    background-color: var(--up-bg-0);
}

.up-theme-light {
    --up-bg-0: rgb(224, 226, 230);
    --up-bg-1: rgb(235, 237, 240);
    --up-bg-2: rgb(207, 210, 215);
    --up-bg-3: rgb(198, 203, 210);
    --up-border: rgb(150, 154, 160);
    --up-border-strong: rgb(125, 132, 141);
    --up-accent-soft: rgba(46, 133, 235, 0.14);
    --up-text: rgb(35, 38, 43);
    --up-text-dim: rgb(82, 87, 94);
    --up-text-faint: rgb(112, 118, 126);
}

.up-motion-toolbar,
.up-motion-control-panels,
.up-motion-preview-controls {
    flex-shrink: 0;
}

.up-motion-main-split {
    flex-grow: 1;
    min-height: 260px;
    border-top-width: 1px;
    border-top-color: var(--up-border-strong);
}

.up-motion-content-split {
    flex-grow: 1;
    min-width: 600px;
}

.up-motion-sidebar {
    min-width: 280px;
    background-color: var(--up-bg-1);
}

.up-motion-sidebar-imgui,
.up-motion-body,
.up-motion-body-imgui {
    flex-grow: 1;
}

.up-motion-body {
    min-width: 320px;
    background-color: var(--up-bg-0);
}

.up-motion-inspector-pane {
    min-width: 280px;
    background-color: var(--up-bg-1);
    border-left-width: 1px;
    border-left-color: var(--up-border-strong);
}

.up-hidden {
    display: none;
}
