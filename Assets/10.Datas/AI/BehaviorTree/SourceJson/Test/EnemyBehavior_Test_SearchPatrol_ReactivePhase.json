                        { "weight": 0.30, "action": "Transition", "state": "Dodge", "cooldownId": "CloseRetreat", "cooldownDuration": 2.0 },
                        { "weight": 0.20, "action": "Transition", "state": "Flank", "cooldownId": "CloseRetreat", "cooldownDuration": 2.0 },
                        { "weight": 0.08, "action": "Transition", "state": "Guard", "cooldownId": "CloseGuard", "cooldownDuration": 2.8 }
                    ]
