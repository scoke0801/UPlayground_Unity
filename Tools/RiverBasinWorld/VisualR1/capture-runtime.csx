if(!Application.isPlaying||UPlayGround.Manager.GameManager.Instance.BootState!=UPlayGround.Manager.GameBootState.Ready)throw new Exception("Play 초기화 Ready 필요");
string output="output/RiverBasinWorld/VisualR1/runtime";System.IO.Directory.CreateDirectory(output);string label=System.IO.File.ReadAllText("Tools/RiverBasinWorld/VisualR1/capture-label.txt").Trim();if(label.IndexOfAny(System.IO.Path.GetInvalidFileNameChars())>=0)throw new Exception("캡처 파일명 오류");
var camera=Camera.main;var previous=RenderTexture.active;var oldTarget=camera.targetTexture;var rt=RenderTexture.GetTemporary(1280,800,24,RenderTextureFormat.ARGB32);
try{camera.targetTexture=rt;camera.Render();RenderTexture.active=rt;var texture=new Texture2D(1280,800,TextureFormat.RGBA32,false);texture.ReadPixels(new Rect(0,0,1280,800),0,0);texture.Apply();System.IO.File.WriteAllBytes(output+"/"+label+".png",texture.EncodeToPNG());UnityEngine.Object.Destroy(texture);}finally{camera.targetTexture=oldTarget;RenderTexture.active=previous;RenderTexture.ReleaseTemporary(rt);}
var player=UnityEngine.Object.FindFirstObjectByType<UPlayGround.PlayerActor>();string metadata="boot="+UPlayGround.Manager.GameManager.Instance.BootState+"\nmap="+UPlayGround.Manager.SceneManager.Instance.CurrentMapID+"\npipeline="+UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline.name+"\ncamera="+camera.transform.position+"\nrotation="+camera.transform.eulerAngles+"\nfov="+camera.fieldOfView+"\nplayer="+player.transform.position+"\nAPI staged; no input-driven traversal; game camera 3D render without overlay HUD";System.IO.File.WriteAllText(output+"/"+label+".txt",metadata);return output+"/"+label+".png";
