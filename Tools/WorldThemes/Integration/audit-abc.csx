var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("Edit Mode 필요");
string folder="output/WorldThemesABCIntegration";var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{o});Func<string,Type,object> read=(p,t)=>jt.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)}).Invoke(null,new object[]{System.IO.File.ReadAllText(p),t});
var terrain=Terrain.activeTerrain;var d=terrain.terrainData;var baseline=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/ShadeCreekVisualR3/Terrain.asset");var hs=new HashSet<int>();var als=new HashSet<int>();
foreach(string n in new[]{"QuarryPassR1","CloudridgeR1","HarborReedR1"}){var c=(Dictionary<string,float[][]>)read(folder+"/"+n+"-cells.json",typeof(Dictionary<string,float[][]>));foreach(var r in c["height"])hs.Add((int)r[1]*4097+(int)r[0]);foreach(var r in c["alpha"])als.Add((int)r[1]*1024+(int)r[0]);}
int heightOutside=0,alphaOutside=0,holeChanges=0;for(int start=0;start<4097;start+=64){int count=Math.Min(64,4097-start);var a=baseline.GetHeights(0,start,4097,count);var b=d.GetHeights(0,start,4097,count);for(int z=0;z<count;z++)for(int x=0;x<4097;x++)if(a[z,x]!=b[z,x]&&!hs.Contains((z+start)*4097+x))heightOutside++;}
var oldLayers=baseline.terrainLayers;var newLayers=d.terrainLayers;int[] map=oldLayers.Select(l=>Array.FindIndex(newLayers,q=>q==l)).ToArray();
for(int start=0;start<1024;start+=32){var a=baseline.GetAlphamaps(0,start,1024,32);var b=d.GetAlphamaps(0,start,1024,32);for(int z=0;z<32;z++)for(int x=0;x<1024;x++){if(als.Contains((z+start)*1024+x))continue;for(int l=0;l<oldLayers.Length;l++)if(Mathf.Abs(a[z,x,l]-b[z,x,map[l]])>0.000001f){alphaOutside++;break;}}}
for(int start=0;start<4096;start+=64){var a=baseline.GetHoles(0,start,4096,64);var b=d.GetHoles(0,start,4096,64);for(int z=0;z<64;z++)for(int x=0;x<4096;x++)if(a[z,x]!=b[z,x])holeChanges++;}
var all=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();var missing=new List<string>();var references=new List<object>();var ids=new List<object>();var supports=new List<object>();
foreach(var t in all){if(GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject)>0)missing.Add(t.name);foreach(var component in t.GetComponents<Component>()){if(component==null)continue;var so=new SerializedObject(component);var it=so.GetIterator();while(it.Next(true)){if(it.propertyType==SerializedPropertyType.ObjectReference&&it.objectReferenceValue==null&&it.objectReferenceInstanceIDValue!=0)references.Add(new{objectName=t.name,type=component.GetType().Name,property=it.propertyPath});}if(component.GetType().Name=="SceneEntityId"){ids.Add(new{name=t.name,globalId=GlobalObjectId.GetGlobalObjectIdSlow(component).ToString(),serialized=EditorJsonUtility.ToJson(component)});RaycastHit hit;bool found=Physics.Raycast(t.position+Vector3.up*1.5f,Vector3.down,out hit,5,-1,QueryTriggerInteraction.Ignore);supports.Add(new{name=t.name,position=new[]{t.position.x,t.position.y,t.position.z},found,ground=found?hit.point.y:0,collider=found?hit.collider.name:null});}}}
var deps=AssetDatabase.GetDependencies(scene.path,true);var forbidden=deps.Where(p=>p.Contains("/ThemeStudies/")||p.Contains("UPlayground_QuarryA")||p.Contains("UPlayground_HighlandB")||p.Contains("UPlayground_HarborC")).ToArray();var materialMissing=all.SelectMany(t=>t.GetComponents<Renderer>()).Count(r=>r.sharedMaterials.Any(m=>m==null||m.shader==null));
var result=new{scene=scene.path,objects=all.Length,missingScripts=missing,missingReferences=references,missingMaterials=materialMissing,forbiddenDependencies=forbidden,dependencies=deps,sceneEntityIds=ids,temporaryObjects=all.Where(t=>t.name.Contains("TemporaryArtCapture")||t.name.Contains("TemporaryCapture")).Select(t=>t.name).ToArray(),heightOutside,alphaOutside,holeChanges,treeCountBefore=baseline.treeInstanceCount,treeCountAfter=d.treeInstanceCount,terrainPosition=new[]{terrain.transform.position.x,terrain.transform.position.y,terrain.transform.position.z},terrainSize=new[]{d.size.x,d.size.y,d.size.z}};
System.IO.File.WriteAllText(folder+"/references-content-"+(scene.path.Contains("ABCIntegration")?"staging":"final")+".json",json(result));System.IO.File.WriteAllText(folder+"/walking-support.json",json(new{method="Editor Raycast 표본; 실제 TPS 아님",supports}));return new{scene.path,objects=all.Length,missing=missing.Count,references=references.Count,materialMissing,forbidden,heightOutside,alphaOutside,holeChanges};
