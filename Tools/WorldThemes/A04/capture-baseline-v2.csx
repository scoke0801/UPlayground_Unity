var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var deserialize=jt.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>deserialize.Invoke(null,new object[]{s,t});Func<object,string> json=o=>(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/A04/baseline-v2-capture-plan.json"),typeof(Dictionary<string,object>));var baseline=(Dictionary<string,object>)read(System.IO.File.ReadAllText(plan["baselineContract"].ToString()),typeof(Dictionary<string,object>));var lease=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/Integration/editor-lease.json"),typeof(Dictionary<string,object>));if(lease["owner"].ToString()!="A04")throw new Exception("A04 lease 필요");
Func<string,string> hash=p=>{using(var sha=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(sha.ComputeHash(System.IO.File.ReadAllBytes(p))).Replace("-","");};
var host=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(baseline["sourceScene"].ToString());if(!host.isLoaded||host.isDirty||EditorApplication.isCompiling||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("clean Host Edit Mode 필요");
string[] preservedFiles={baseline["sourceScene"].ToString(),baseline["sourceTerrain"].ToString(),baseline["navMesh"].ToString(),baseline["sky"].ToString(),"Assets/10.Datas/World/ThemeStudies/LookWater/PreviewSky.mat","Assets/10.Datas/World/ThemeStudies/RedTreeForest_Baseline/PreviewSky.mat"};var hashes=preservedFiles.ToDictionary(p=>p,p=>hash(p));if(hashes[baseline["sourceScene"].ToString()]!=baseline["sourceSceneHash"].ToString()||hashes[baseline["sourceTerrain"].ToString()]!=baseline["sourceTerrainHash"].ToString()||hashes[baseline["navMesh"].ToString()]!=baseline["navMeshHash"].ToString())throw new Exception("source v3 guard mismatch");
var previousActive=UnityEngine.SceneManagement.SceneManager.GetActiveScene();var previousPipeline=QualitySettings.renderPipeline;var previousPipelineGlobal=UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline;bool hostDirty=host.isDirty;var loaded=UnityEngine.SceneManagement.SceneManager.GetSceneByPath(plan["scene"].ToString());bool opened=false;var preview=new UnityEngine.SceneManagement.Scene();bool hasPreview=false;var rows=new List<object>();string output=plan["output"].ToString();System.IO.Directory.CreateDirectory(output);
try{
 if(!loaded.isLoaded){loaded=UnityEditor.SceneManagement.EditorSceneManager.OpenScene(plan["scene"].ToString(),UnityEditor.SceneManagement.OpenSceneMode.Additive);opened=true;}if(loaded.isDirty)throw new Exception("baseline未저장변경보존; 촬영중단");
 UnityEngine.SceneManagement.SceneManager.SetActiveScene(loaded);preview=UnityEditor.SceneManagement.EditorSceneManager.OpenPreviewScene(plan["scene"].ToString());hasPreview=true;
 QualitySettings.renderPipeline=AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.RenderPipelineAsset>("Assets/Settings/LakeVillage_RPAsset.asset");
 var camera=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Camera>(true)).Single();var terrain=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();camera.scene=preview;camera.overrideSceneCullingMask=UnityEditor.SceneManagement.EditorSceneManager.GetSceneCullingMask(preview);camera.fieldOfView=60;
 var extra=camera.GetComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();extra.renderPostProcessing=true;extra.volumeLayerMask=1<<31;extra.volumeTrigger=camera.transform;var volume=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UnityEngine.Rendering.Volume>(true)).Single();volume.enabled=false;volume.gameObject.layer=31;volume.enabled=true;
 if(!RenderSettings.fog||RenderSettings.fogStartDistance!=100||RenderSettings.fogEndDistance!=650||RenderSettings.skybox==null||!RenderSettings.skybox.HasProperty("_AtmosphereThickness")||RenderSettings.skybox.GetFloat("_AtmosphereThickness")!=1)throw new Exception("baseline 자체 A01 fog/sky 계약 불일치; 원본/아트재질수정없이중단");
 var poses=(Dictionary<string,object>[])read(plan["poses"].ToString(),typeof(Dictionary<string,object>[]));if(poses.Length!=6)throw new Exception("6구도 필요");
 foreach(var pose in poses.Where(p=>p["key"].ToString()=="boundary_west")){string file=pose["key"].ToString()+".png";if(System.IO.File.Exists(output+"/"+file))throw new Exception("기존 증거 덮어쓰기 금지: "+file);var xz=(float[])read(pose["xz"].ToString(),typeof(float[]));var txz=(float[])read(pose["target"].ToString(),typeof(float[]));var p=new Vector3(xz[0],terrain.SampleHeight(new Vector3(xz[0],0,xz[1]))+terrain.transform.position.y+1.7f,xz[1]);var target=new Vector3(txz[0],terrain.SampleHeight(new Vector3(txz[0],0,txz[1]))+terrain.transform.position.y+1,txz[1]);camera.transform.position=p;camera.transform.rotation=Quaternion.LookRotation(target-p);var rt=new RenderTexture(1280,720,24,RenderTextureFormat.ARGB32);var texture=new Texture2D(1280,720,TextureFormat.RGB24,false);var previousRt=RenderTexture.active;
  try{camera.targetTexture=rt;camera.Render();camera.Render();UnityEngine.Rendering.VolumeManager.instance.Update(camera.transform,extra.volumeLayerMask);var adjustments=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.ColorAdjustments>();var bloom=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.Bloom>();if(adjustments.saturation.value!=15||adjustments.contrast.value!=2||Mathf.Abs(bloom.intensity.value-.08f)>.001f)throw new Exception("실효 PP mismatch");RenderTexture.active=rt;texture.ReadPixels(new Rect(0,0,1280,720),0,0);texture.Apply();System.IO.File.WriteAllBytes(output+"/"+file,texture.EncodeToPNG());rows.Add(new{file=file,version=plan["version"].ToString(),position=new[]{p.x,p.y,p.z},target=new[]{target.x,target.y,target.z},fov=camera.fieldOfView,fog=true,fogStart=RenderSettings.fogStartDistance,fogEnd=RenderSettings.fogEndDistance,skyThickness=RenderSettings.skybox.GetFloat("_AtmosphereThickness"),effectiveSaturation=adjustments.saturation.value,effectiveContrast=adjustments.contrast.value,effectiveBloom=bloom.intensity.value,mode="Editor PreviewScene baseline, actual TPS actor not cloned"});System.IO.File.WriteAllText(output+"/poses.json",json(rows));}
  finally{camera.targetTexture=null;RenderTexture.active=previousRt;UnityEngine.Object.DestroyImmediate(texture);UnityEngine.Object.DestroyImmediate(rt);}
 }
}finally{
 QualitySettings.renderPipeline=previousPipeline;UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline=previousPipelineGlobal;if(hasPreview)UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(preview);if(previousActive.isLoaded)UnityEngine.SceneManagement.SceneManager.SetActiveScene(previousActive);if(opened&&loaded.isLoaded&&!loaded.isDirty)UnityEditor.SceneManagement.EditorSceneManager.CloseScene(loaded,true);
 var after=preservedFiles.ToDictionary(p=>p,p=>hash(p));bool filesUnchanged=preservedFiles.All(p=>hashes[p]==after[p]);System.IO.File.WriteAllText(output+"/preservation.json",json(new{filesBefore=hashes,filesAfter=after,filesUnchanged=filesUnchanged,hostDirtyBefore=hostDirty,hostDirtyAfter=host.isDirty,activeSceneBefore=previousActive.path,activeSceneAfter=UnityEngine.SceneManagement.SceneManager.GetActiveScene().path,qualityRpRestored=QualitySettings.renderPipeline==previousPipeline,globalRpRestored=UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline==previousPipelineGlobal,baselineDirty=loaded.isLoaded&&loaded.isDirty}));if(!filesUnchanged||host.isDirty!=hostDirty)throw new Exception("촬영 원본 보존 실패");
}
return "A04 baseline 6 views="+rows.Count+" preserved host/sky/RP/activeScene";
