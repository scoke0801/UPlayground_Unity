// 동일 카메라·거리에서 원본/녹색/검토 수목의 자동 LOD 전이를 비교한다. 실제 TPS·성능 검증과 구분한다.
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/ShadeCreekR3.unity"||scene.isDirty||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("저장된 R2 필요");
string folder="output/ShadeCreekR3/lod2-angle-review";System.IO.Directory.CreateDirectory(folder);
var sample=scene.GetRootGameObjects().SelectMany(q=>q.GetComponentsInChildren<LODGroup>(true)).First(q=>q.gameObject.activeInHierarchy&&q.transform.position.x>1600&&q.transform.position.x<1650&&q.transform.position.z>770&&q.transform.position.z<830&&q.GetLODs().Length==4);
string red=PrefabUtility.GetPrefabAssetPathOfNearestInstanceRoot(sample),green=red.Replace("_Red.prefab",".prefab");
var sources=new[]{AssetDatabase.LoadAssetAtPath<GameObject>(red),AssetDatabase.LoadAssetAtPath<GameObject>(green),sample.gameObject,sample.gameObject};var names=new[]{"original","green","r2","r3"};
var go=new GameObject("TemporaryLodCamera");go.hideFlags=HideFlags.HideAndDontSave;var camera=go.AddComponent<Camera>();camera.enabled=false;camera.clearFlags=CameraClearFlags.SolidColor;camera.backgroundColor=new Color(.22f,.26f,.29f,1);camera.cullingMask=1<<31;camera.fieldOfView=60;camera.aspect=16f/9f;camera.farClipPlane=2000;
var rt=new RenderTexture(1280,720,24);var texture=new Texture2D(1280,720,TextureFormat.RGB24,false);rt.hideFlags=HideFlags.HideAndDontSave;texture.hideFlags=HideFlags.HideAndDontSave;var old=RenderTexture.active;var rows=new List<string>();rows.Add("Editor isolated static renders. formulaOnlyLOD is a screen-size estimate, NOT measured active GPU LOD. CPU/GPU performance and TPS unmeasured. FOV60 1280x720, fog disabled, same rotation/scale/light, no postprocessing.");GameObject tree=null;
bool oldFog=RenderSettings.fog;RenderSettings.fog=false;try{camera.targetTexture=rt;for(int i=0;i<sources.Length;i++){tree=UnityEngine.Object.Instantiate(sources[i]);tree.hideFlags=HideFlags.HideAndDontSave;tree.transform.position=new Vector3(0,1000,0);tree.transform.rotation=sample.transform.rotation;tree.transform.localScale=sample.transform.lossyScale;foreach(var tr in tree.GetComponentsInChildren<Transform>(true))tr.gameObject.layer=31;var group=tree.GetComponent<LODGroup>();if(i>=2){var lods=group.GetLODs();var bill=tree.GetComponentsInChildren<MeshRenderer>(true).First(r=>r.GetComponent<MeshFilter>().sharedMesh.vertexCount==4);bill.enabled=true;bill.sharedMaterial=AssetDatabase.LoadAssetAtPath<Material>("Assets/10.Datas/World/ThemeStudies/ShadeCreekR3/Canopy_2.mat");lods[lods.Length-1].renderers=new Renderer[]{bill};group.SetLODs(lods);}if(i==2){foreach(var renderer in tree.GetComponentsInChildren<Renderer>(true)){renderer.sharedMaterials=renderer.sharedMaterials.Select(m=>{if(m==null)return m;string p=AssetDatabase.GetAssetPath(m);return p.Contains("/ShadeCreekR3/")?AssetDatabase.LoadAssetAtPath<Material>(p.Replace("/ShadeCreekR3/","/ShadeCreekR2/")):m;}).ToArray();}}
group.ForceLOD(2);var center=tree.transform.TransformPoint(group.localReferencePoint);float size=group.size*Mathf.Max(tree.transform.lossyScale.x,tree.transform.lossyScale.y,tree.transform.lossyScale.z);
foreach(float angle in new[]{0f,45f,90f,135f,180f,225f,270f,315f}){float distance=80;var position=center+Quaternion.Euler(0,angle,0)*new Vector3(0,0,-distance);camera.transform.SetPositionAndRotation(position,Quaternion.LookRotation(center-position));camera.Render();camera.Render();RenderTexture.active=rt;texture.ReadPixels(new Rect(0,0,1280,720),0,0);texture.Apply();System.IO.File.WriteAllBytes(folder+"/"+names[i]+"-"+angle+".png",texture.EncodeToPNG());float relative=size/(2*distance*Mathf.Tan(30*Mathf.Deg2Rad))*QualitySettings.lodBias;int lod=Array.FindIndex(group.GetLODs(),l=>relative>=l.screenRelativeTransitionHeight);rows.Add(names[i]+" angle="+angle+" distance="+distance+" formulaOnlyLOD="+lod+" relative="+relative+" size="+size+" bias="+QualitySettings.lodBias);}
foreach(var l in group.GetLODs())foreach(var r in l.renderers)rows.Add(names[i]+" LOD="+l.screenRelativeTransitionHeight+" renderer="+r.name+" vertices="+(r.GetComponent<MeshFilter>()==null?0:r.GetComponent<MeshFilter>().sharedMesh.vertexCount)+" materials="+string.Join(";",r.sharedMaterials.Select(m=>AssetDatabase.GetAssetPath(m))));UnityEngine.Object.DestroyImmediate(tree);tree=null;}
}finally{RenderSettings.fog=oldFog;if(tree!=null)UnityEngine.Object.DestroyImmediate(tree);camera.targetTexture=null;RenderTexture.active=old;UnityEngine.Object.DestroyImmediate(texture);UnityEngine.Object.DestroyImmediate(rt);UnityEngine.Object.DestroyImmediate(go);}
System.IO.File.WriteAllLines(folder+"/measurements.txt",rows);return rows;






