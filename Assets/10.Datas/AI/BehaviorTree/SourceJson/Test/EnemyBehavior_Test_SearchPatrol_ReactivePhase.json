                        { "weightKey": "retreatChance", "action": "Transition", "state": "Retreat" },
                        { "weight": 0.20, "action": "Transition", "state": "Counter" }
                    ]
                },
                {
                    "name": "CloseRangeFootwork",
                    "priority": 805,
                    "when": [
                        { "condition": "HasTarget" },
                        { "condition": "ActionDelayElapsed" },
                        { "condition": "DistanceLessOrEqual", "value": "minCombatDistance" },
                        { "condition": "CooldownReady", "value": "CloseFootwork" }
