      activities: 9
      periods: 15
    - id: scholarly.07.3
      topic: plans
      text: "\uD5F7\uAC08\uB9B0 \uB2E8\uC5B4\uB9CC \uB530\uB85C \uBAA8\uC544 \uBCFC\uAE4C
