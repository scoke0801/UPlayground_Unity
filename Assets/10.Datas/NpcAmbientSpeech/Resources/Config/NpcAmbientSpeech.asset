      activities: 9
      periods: 15
    - id: scholarly.04.5
      topic: animals
      text: "\uC0C8 \uB465\uC9C0\uB294 \uC5B4\uB514\uC11C\uBD80\uD130 \uB9CC\uB4E4\uAE30
