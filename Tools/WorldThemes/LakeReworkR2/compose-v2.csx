var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(EditorApplication.isPlayingOrWillChangePlaymode||scene.isDirty)throw new Exception("저장된 검토 씬 필요");
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);var parse=json.GetMethod("DeserializeObject",new[]{typeof(string),typeof(Type)});Func<string,Type,object> read=(s,t)=>parse.Invoke(null,new object[]{s,t});
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/WorldThemes/LakeReworkR2/composition-v2.json"),typeof(Dictionary<string,object>));if(scene.path!=plan["scene"].ToString())throw new Exception("검토 사본 경로 불일치");
var rows=(Dictionary<string,object>[])read(plan["outcrops"].ToString(),typeof(Dictionary<string,object>[]));
var root=GameObject.Find("LakeRework_ContinuousOutcrops");if(root!=null)throw new Exception("이미 적용한 버전");root=new GameObject("LakeRework_ContinuousOutcrops");
var terrain=Terrain.activeTerrain;var report=new List<string>();
foreach(var row in rows){string asset=plan["rockRoot"]+row["asset"].ToString();var prefab=AssetDatabase.LoadAssetAtPath<GameObject>(asset);if(prefab==null)throw new Exception(asset);var o=(GameObject)PrefabUtility.InstantiatePrefab(prefab,scene);o.name=row["name"].ToString();o.transform.SetParent(root.transform);var p=(float[])read(row["position"].ToString(),typeof(float[]));var sc=(float[])read(row["scale"].ToString(),typeof(float[]));var pos=new Vector3(p[0],p[1],p[2]);if(row.ContainsKey("groundOffset"))pos.y=terrain.SampleHeight(pos)+Convert.ToSingle(row["groundOffset"]);o.transform.SetPositionAndRotation(pos,Quaternion.Euler(0,Convert.ToSingle(row["yaw"]),0));o.transform.localScale=new Vector3(sc[0],sc[1],sc[2]);report.Add(o.name+" "+pos);}
UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);System.IO.File.WriteAllLines("output/LakeReworkR2/outcrops-v2.txt",report);return report;
