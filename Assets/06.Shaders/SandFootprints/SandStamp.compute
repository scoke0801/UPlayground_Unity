#pragma kernel UpdateTile
#pragma kernel CopyScratchToTile

Texture2DArray<float2> _CacheRead;
RWTexture2DArray<float2> _CacheWrite;
Texture2D<float2> _ScratchRead;
RWTexture2D<float2> _ScratchWrite;
int4 _Rect;
int _Slot;
int _Mode;
int _TileResolution;
int _Interior;
float4 _RebuildSlots0, _RebuildSlots1;
float4 _RebuildDecay0, _RebuildDecay1;
float _Decay;
float _PixelSize;
float2 _TileOrigin;
float2 _Center;
float4 _InverseBasis;
float2 _Strength;

float2 NeighborEdge(int2 pixel, int2 offset)
{
    int index = (offset.y + 1) * 3 + offset.x + 1;
    if (index > 4) index--;
    int slot = (int)(index < 4 ? _RebuildSlots0[index] : _RebuildSlots1[index - 4]);
    if (slot < 0) return 0;
    float decay = index < 4 ? _RebuildDecay0[index] : _RebuildDecay1[index - 4];
    return _CacheRead.Load(int4(pixel - offset * _Interior, slot, 0)) * decay;
}

float2 Sole(float2 uv)
{
    float width = lerp(0.33, 0.51, smoothstep(-0.4, 0.27, uv.y));
    float2 p = float2((uv.x - 0.06 * uv.y) / width, uv.y / 0.5);
    float d = pow(pow(abs(p.x), 3.0) + pow(abs(p.y), 3.0), 1.0 / 3.0);
    float tread = smoothstep(0.12, 0.4, abs(frac(uv.y * 9 + abs(uv.x) * 1.6) - 0.5));
    float imprint = (1 - smoothstep(0.79, 1.02, d)) * lerp(0.78, 1, tread);
    float rim = smoothstep(0.77, 1.0, d) * (1 - smoothstep(1.0, 1.2, d));
    return float2(imprint, rim);
}

[numthreads(8, 8, 1)]
void UpdateTile(uint2 thread : SV_DispatchThreadID)
{
    if (any(thread >= (uint2)_Rect.zw)) return;
    int2 pixel = (int2)thread + _Rect.xy;
    float2 value = 0;
    if (_Mode == 1 || _Mode == 2) value = _CacheRead.Load(int4(pixel, _Slot, 0)) * _Decay;
    if (_Mode == 3)
    {
        int2 dir = int2(pixel.x < 4 ? -1 : pixel.x >= _TileResolution - 4 ? 1 : 0,
                        pixel.y < 4 ? -1 : pixel.y >= _TileResolution - 4 ? 1 : 0);
        if (dir.x != 0) value = NeighborEdge(pixel, int2(dir.x, 0));
        if (dir.y != 0) value = max(value, NeighborEdge(pixel, int2(0, dir.y)));
        if (all(dir != 0)) value = max(value, NeighborEdge(pixel, dir));
    }
    if (_Mode == 2)
    {
        float2 delta = _TileOrigin + (float2(pixel) - 1.5) * _PixelSize - _Center;
        float2 uv = float2(dot(delta, _InverseBasis.xy), dot(delta, _InverseBasis.zw));
        value = max(value, Sole(uv) * _Strength);
    }
    _ScratchWrite[pixel] = value;
}

[numthreads(8, 8, 1)]
void CopyScratchToTile(uint2 thread : SV_DispatchThreadID)
{
    if (any(thread >= (uint2)_Rect.zw)) return;
    uint2 pixel = thread + (uint2)_Rect.xy;
    _CacheWrite[uint3(pixel, _Slot)] = _ScratchRead.Load(int3(pixel, 0));
}
