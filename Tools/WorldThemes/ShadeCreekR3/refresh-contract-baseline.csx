// 최신 코드로 읽은 정규 씬 계약을 다시 수집한다. 정규 씬은 저장하지 않는다.
var current=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(current.isDirty||EditorApplication.isPlayingOrWillChangePlaymode||EditorUtility.scriptCompilationFailed)throw new Exception("Editor not ready");
var preview=UnityEditor.SceneManagement.EditorSceneManager.OpenPreviewScene("Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity");
try{var all=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();var rows=all.SelectMany(q=>q.GetComponents<MonoBehaviour>()).Where(c=>c!=null).Select(c=>new{id=GlobalObjectId.GetGlobalObjectIdSlow(c).targetObjectId.ToString(),type=c.GetType().FullName,json=EditorJsonUtility.ToJson(c),position=new[]{c.transform.position.x,c.transform.position.y,c.transform.position.z}}).ToArray();var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(a=>a!=null);string text=(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{rows});System.IO.File.WriteAllText("output/ShadeCreekR3/contracts-current-canonical.json",text);System.IO.File.WriteAllLines("output/ShadeCreekR3/ids-current-canonical.tsv",all.SelectMany(t=>t.GetComponents<UPlayGround.Components.SceneEntityId>()).Select(e=>GlobalObjectId.GetGlobalObjectIdSlow(e).targetObjectId.ToString()+"\t"+e.Guid));return rows.Length;}finally{UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(preview);}
