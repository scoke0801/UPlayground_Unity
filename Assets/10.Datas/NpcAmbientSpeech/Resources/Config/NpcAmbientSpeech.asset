      periods: 15
    - id: seasoned.03.3
      topic: people
      text: "\uC61B\uB0A0 \uBCC4\uBA85\uC73C\uB85C \uBD80\uB97C \uBED4\uD588\uC5B4."
      activities: 9
      periods: 15
    - id: seasoned.03.4
      topic: people
      text: "\uC798 \uC9C0\uB0B8\uB2E4\uB294 \uB9D0 \uB4E4\uC73C\uBA74 \uBC18\uAC00\uC6B4
