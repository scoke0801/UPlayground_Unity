if(Application.dataPath!="C:/UsingProject/UnityProject/UPlayground/Assets"||!System.IO.File.ReadAllText("Tools/WorldThemes/AgentCoordination/editor.lock").Contains("QuarryPassR1-A-20261108"))throw new Exception("A 잠금 필요");
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/ArtReview/WorldThemes/QuarryPassR1.unity"||EditorApplication.isPlayingOrWillChangePlaymode)throw new Exception("A 씬 Edit 필요");
string stage=System.IO.File.ReadAllText("Tools/WorldThemes/QuarryPassR1/stage.txt").Trim();
var terrain=Terrain.activeTerrain;var d=terrain.terrainData;var original=AssetDatabase.LoadAssetAtPath<TerrainData>("Assets/10.Datas/World/OpenWorld/ShadeCreekVisualR3/Terrain.asset");
var jt=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);Func<object,string> json=o=>(string)jt.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new[]{o});
Func<Array,string> hash=a=>{var bytes=new byte[Buffer.ByteLength(a)];Buffer.BlockCopy(a,0,bytes,0,bytes.Length);using(var s=System.Security.Cryptography.SHA256.Create())return BitConverter.ToString(s.ComputeHash(bytes)).Replace("-","");};
string heightHash=hash(d.GetHeights(0,0,d.heightmapResolution,d.heightmapResolution));string sourceHeightHash=hash(original.GetHeights(0,0,original.heightmapResolution,original.heightmapResolution));
var details=new List<object>();for(int i=0;i<d.detailPrototypes.Length;i++)details.Add(new{index=i,guid=AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(d.detailPrototypes[i].prototype)),unchanged=hash(d.GetDetailLayer(0,0,d.detailWidth,d.detailHeight,i))==hash(original.GetDetailLayer(0,0,original.detailWidth,original.detailHeight,i))});
var transforms=scene.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();int missing=transforms.Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject));
var points=new[]{new Vector3(542,0,1040),new Vector3(539,0,1084),new Vector3(524,0,1110),new Vector3(519,0,1107),new Vector3(564,0,1105),new Vector3(450,0,1140),new Vector3(420,0,1186),new Vector3(548,0,1240),new Vector3(560,0,1330),new Vector3(580,0,1435)};
Physics.SyncTransforms();var support=new List<object>();foreach(var point in points){float y=terrain.SampleHeight(point)+terrain.transform.position.y;var p=new Vector3(point.x,y,point.z);var hits=Physics.RaycastAll(p+Vector3.up*8,Vector3.down,16,~0,QueryTriggerInteraction.Ignore).OrderBy(h=>h.distance).ToArray();support.Add(new{x=p.x,z=p.z,terrainY=y,slope=d.GetSteepness(p.x/2400f,(p.z+700)/2800f),surfaces=hits.Select(h=>new{name=h.collider.name,y=h.point.y,normal=new[]{h.normal.x,h.normal.y,h.normal.z},type=h.collider.GetType().Name}).ToArray()});}
int[][] pairs={new[]{0,1},new[]{1,2},new[]{2,3},new[]{1,4},new[]{5,6},new[]{7,8},new[]{8,9}};var routes=new List<object>();foreach(var pair in pairs)for(int direction=0;direction<2;direction++){
int a=pair[direction],b=pair[1-direction];var pa=points[a];pa.y=terrain.SampleHeight(pa);var pb=points[b];pb.y=terrain.SampleHeight(pb);UnityEngine.AI.NavMeshHit ha,hb;bool sa=UnityEngine.AI.NavMesh.SamplePosition(pa,out ha,8,UnityEngine.AI.NavMesh.AllAreas),sb=UnityEngine.AI.NavMesh.SamplePosition(pb,out hb,8,UnityEngine.AI.NavMesh.AllAreas);var path=new UnityEngine.AI.NavMeshPath();bool computed=sa&&sb&&UnityEngine.AI.NavMesh.CalculatePath(ha.position,hb.position,UnityEngine.AI.NavMesh.AllAreas,path);routes.Add(new{from=a,to=b,fromSample=sa,toSample=sb,computed,status=path.status.ToString(),corners=path.corners.Select(p=>new[]{p.x,p.y,p.z}).ToArray(),mode="정적 NavMesh 조회; 실제 TPS 아님"});}
var actors=new List<object>();foreach(var t in transforms){var p=t.position;if(p.x<290||p.x>650||p.z<1000||p.z>1470)continue;foreach(var c in t.GetComponents<MonoBehaviour>()){if(c==null)continue;string name=c.GetType().Name;if(name.Contains("MonsterActor")||name.Contains("EnemyMovement")||name.Contains("EnemyAI")||name.Contains("Encounter"))actors.Add(new{name=t.name,type=c.GetType().FullName,position=new[]{p.x,p.y,p.z},serialized=EditorJsonUtility.ToJson(c)});}}
var references=new{terrain=AssetDatabase.GetAssetPath(d),layers=d.terrainLayers.Select(l=>new{path=AssetDatabase.GetAssetPath(l),guid=AssetDatabase.AssetPathToGUID(AssetDatabase.GetAssetPath(l))}).ToArray(),details,trees=d.treePrototypes.Select(p=>AssetDatabase.GetAssetPath(p.prefab)).ToArray()};
var result=new{stage,scene=scene.path,missingScripts=missing,terrainHeightHash=heightHash,sourceHeightHash,heightsPreserved=heightHash==sourceHeightHash,references,support,routes,actors,playMode="미수행",performance="미수행",actualLodTransitions="미수행"};
System.IO.File.WriteAllText("output/QuarryPassR1/audit-"+stage+".json",json(result));return new{stage,missing,heightsPreserved=heightHash==sourceHeightHash,routes=routes.Count,actors=actors.Count};
