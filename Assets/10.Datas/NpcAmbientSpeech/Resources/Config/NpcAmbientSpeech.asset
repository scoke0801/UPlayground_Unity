      activities: 9
      periods: 15
    - id: scholarly.07.7
      topic: plans
      text: "\uAE30\uC5B5\uB0A0 \uB54C \uCCAB \uAE00\uC790\uB9CC \uC801\uC5B4\uB3C4
        \uB418\uACA0\uB124\uC694."
      activities: 9
      periods: 15
    - id: scholarly.08.0
      topic: travel
      text: "\uAC78\uC73C\uBA74\uC11C \uC0DD\uAC01\uD558\uBA74 \uC21C\uC11C\uAC00
        \uC798 \uB9DE\uC544\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.1
      topic: travel
      text: "\uAE38\uC774 \uAD7D\uC73C\uBA74 \uAC70\uB9AC\uB3C4 \uB2EC\uB9AC \uB290\uAEF4\uC9C0\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.2
      topic: travel
      text: "\uC774\uCABD\uC73C\uB85C \uC654\uB2E4\uB294 \uAC78 \uC5B4\uB5BB\uAC8C
        \uAE30\uC5B5\uD560\uAE4C\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.3
      topic: travel
      text: "\uBC1C\uAC78\uC74C\uC5D0 \uB9DE\uCDB0 \uC678\uC6B0\uB2C8 \uC870\uAE08
        \uC27D\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.4
      topic: travel
      text: "\uAC77\uB2E4 \uBA48\uCD94\uBA74 \uC0DD\uAC01\uB3C4 \uAC19\uC774 \uBA48\uCD94\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.5
      topic: travel
      text: "\uB3CC\uC544\uAC08 \uB54C\uB294 \uBC18\uB300 \uC21C\uC11C\uB85C \uBCF4\uC774\uACA0\uC9C0\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.6
      topic: travel
      text: "\uAE38 \uC774\uB984\uBCF4\uB2E4 \uBAA8\uC591\uC774 \uBA3C\uC800 \uAE30\uC5B5\uB098\uC694."
      activities: 2
      periods: 15
    - id: scholarly.08.7
      topic: travel
      text: "\uC774 \uAC70\uB9AC\uBA74 \uBA38\uB9BF\uC18D\uC73C\uB85C \uBA87 \uC904\uC744
        \uC678\uC6B8\uAE4C\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.0
      topic: feet
      text: "\uBC1C\uC18C\uB9AC\uAC00 \uAC19\uC740 \uAC04\uACA9\uC73C\uB85C \uC548
        \uB098\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.1
      topic: feet
      text: "\uBCF4\uD3ED\uC744 \uB9DE\uCD94\uB2E4 \uC0DD\uAC01\uC744 \uB193\uCCE4\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.2
      topic: feet
      text: "\uC67C\uBC1C\uBD80\uD130 \uC2DC\uC791\uD55C \uC774\uC720\uB294 \uC5C6\uB294\uB370."
      activities: 2
      periods: 15
    - id: scholarly.09.3
      topic: feet
      text: "\uC18D\uB3C4\uB97C \uC904\uC774\uBA74 \uC18C\uB9AC\uB3C4 \uB0AE\uC544\uC9C0\uB098\uC694?"
      activities: 2
      periods: 15
    - id: scholarly.09.4
      topic: feet
      text: "\uC2E0\uBC1C\uC774 \uC6B8\uB9AC\uB294 \uC790\uB9AC\uAC00 \uBC14\uB00C\uC5C8\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.5
      topic: feet
      text: "\uB4A4\uAFC8\uCE58\uC640 \uC55E\uAFC8\uCE58 \uC18C\uB9AC\uAC00 \uB2E4\uB974\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.6
      topic: feet
      text: "\uBC14\uB2E5\uC744 \uBCF4\uB290\uB77C \uAE38\uC744 \uB193\uCE60 \uBED4\uD588\uC5B4\uC694."
      activities: 2
      periods: 15
    - id: scholarly.09.7
      topic: feet
      text: "\uAC77\uB294 \uBC15\uC790\uB97C \uC138\uB2E4\uAC00 \uB610 \uD5F7\uAC08\uB838\uB124\uC694."
      activities: 2
      periods: 15
    - id: scholarly.10.0
      topic: effort
      text: "\uD55C \uB2E8\uACC4\uC529 \uB098\uB204\uBA74 \uB35C \uD5F7\uAC08\uB824\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.1
      topic: effort
      text: "\uC774\uB807\uAC8C \uC7A1\uB294 \uB370\uB294 \uC774\uC720\uAC00 \uC788\uACA0\uC9C0\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.2
      topic: effort
      text: "\uBA3C\uC800 \uD55C \uAC83\uACFC \uBAA8\uC591\uC744 \uBE44\uAD50\uD574
        \uBD10\uC57C\uACA0\uC5B4\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.3
      topic: effort
      text: "\uD798\uC744 \uB35C \uC92C\uB354\uB2C8 \uC624\uD788\uB824 \uB9DE\uB124\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.4
      topic: effort
      text: "\uC0DD\uAC01\uB9CC \uD560 \uB54C\uB294 \uC26C\uC6E0\uB294\uB370\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.5
      topic: effort
      text: "\uC190\uC774 \uB530\uB77C\uC624\uB294 \uB370 \uC2DC\uAC04\uC774 \uB4DC\uB124\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.6
      topic: effort
      text: "\uC124\uBA85\uD560 \uC218 \uC788\uC5B4\uB3C4 \uD560 \uC218 \uC788\uB294
        \uAC74 \uC544\uB2C8\uB124\uC694."
      activities: 4
      periods: 15
    - id: scholarly.10.7
      topic: effort
