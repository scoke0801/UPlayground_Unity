      activities: 9
      periods: 15
    - id: seasoned.00.3
      topic: lost
      text: "\uC608\uC804 \uC790\uB9AC\uBD80\uD130 \uCC3E\uAC8C \uB418\uB124."
      activities: 9
      periods: 15
    - id: seasoned.00.4
      topic: lost
