try{
 if(!loaded.isLoaded){loaded=UnityEditor.SceneManagement.EditorSceneManager.OpenScene(plan["scene"].ToString(),UnityEditor.SceneManagement.OpenSceneMode.Additive);opened=true;}if(loaded.isDirty)throw new Exception("baseline未저장변경보존; 촬영중단");
 UnityEngine.SceneManagement.SceneManager.SetActiveScene(loaded);preview=UnityEditor.SceneManagement.EditorSceneManager.OpenPreviewScene(plan["scene"].ToString());hasPreview=true;
 QualitySettings.renderPipeline=AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.RenderPipelineAsset>("Assets/Settings/LakeVillage_RPAsset.asset");
 var camera=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Camera>(true)).Single();var terrain=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<Terrain>(true)).Single();camera.scene=preview;camera.overrideSceneCullingMask=UnityEditor.SceneManagement.EditorSceneManager.GetSceneCullingMask(preview);camera.fieldOfView=60;
 persistentTerrain=terrain.terrainData;persistentDirtyBefore=EditorUtility.IsDirty(persistentTerrain);persistentAlphaBefore=arrayHash(persistentTerrain.GetAlphamaps(0,0,persistentTerrain.alphamapWidth,persistentTerrain.alphamapHeight));
 if(stage=="Before"){var source=AssetDatabase.LoadAssetAtPath<TerrainData>(baseline["sourceTerrain"].ToString());temporaryTerrain=UnityEngine.Object.Instantiate(persistentTerrain);var original=source.GetAlphamaps(0,0,source.alphamapWidth,source.alphamapHeight);if(temporaryTerrain.alphamapLayers!=8||original.GetLength(2)!=7)throw new Exception("원본7+forest0 채널 계약 불일치");var restored=new float[source.alphamapHeight,source.alphamapWidth,8];for(int z=0;z<source.alphamapHeight;z++)for(int x=0;x<source.alphamapWidth;x++)for(int l=0;l<7;l++)restored[z,x,l]=original[z,x,l];temporaryTerrain.SetAlphamaps(0,0,restored);terrain.terrainData=temporaryTerrain;terrain.GetComponent<TerrainCollider>().terrainData=temporaryTerrain;}
 var extra=camera.GetComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();extra.renderPostProcessing=true;extra.volumeLayerMask=1<<31;extra.volumeTrigger=camera.transform;var volume=preview.GetRootGameObjects().SelectMany(g=>g.GetComponentsInChildren<UnityEngine.Rendering.Volume>(true)).Single();volume.enabled=false;volume.gameObject.layer=31;volume.enabled=true;
 if(!RenderSettings.fog||RenderSettings.fogStartDistance!=100||RenderSettings.fogEndDistance!=650||RenderSettings.skybox==null||!RenderSettings.skybox.HasProperty("_AtmosphereThickness")||RenderSettings.skybox.GetFloat("_AtmosphereThickness")!=1)throw new Exception("baseline 자체 A01 fog/sky 계약 불일치; 원본/아트재질수정없이중단");
 var poses=(Dictionary<string,object>[])read(plan["poses"].ToString(),typeof(Dictionary<string,object>[]));if(poses.Length!=6)throw new Exception("6구도 필요");
 foreach(var pose in poses){string file=pose["key"].ToString()+".png";if(System.IO.File.Exists(output+"/"+file))throw new Exception("기존 증거 덮어쓰기 금지: "+file);var xz=(float[])read(pose["xz"].ToString(),typeof(float[]));var txz=(float[])read(pose["target"].ToString(),typeof(float[]));var p=new Vector3(xz[0],terrain.SampleHeight(new Vector3(xz[0],0,xz[1]))+terrain.transform.position.y+1.7f,xz[1]);var target=new Vector3(txz[0],terrain.SampleHeight(new Vector3(txz[0],0,txz[1]))+terrain.transform.position.y+1,txz[1]);camera.transform.position=p;camera.transform.rotation=Quaternion.LookRotation(target-p);var rt=new RenderTexture(1280,720,24,RenderTextureFormat.ARGB32);var texture=new Texture2D(1280,720,TextureFormat.RGB24,false);var previousRt=RenderTexture.active;
  try{if(fadeMask()!=0)throw new Exception("렌더 전 fade mask 비0");camera.targetTexture=rt;camera.Render();camera.Render();if(fadeMask()!=0)throw new Exception("렌더 후 fade mask 비0");UnityEngine.Rendering.VolumeManager.instance.Update(camera.transform,extra.volumeLayerMask);var adjustments=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.ColorAdjustments>();var bloom=UnityEngine.Rendering.VolumeManager.instance.stack.GetComponent<UnityEngine.Rendering.Universal.Bloom>();if(adjustments.saturation.value!=15||adjustments.contrast.value!=2||Mathf.Abs(bloom.intensity.value-.08f)>.001f)throw new Exception("실효 PP mismatch");RenderTexture.active=rt;texture.ReadPixels(new Rect(0,0,1280,720),0,0);texture.Apply();System.IO.File.WriteAllBytes(output+"/"+file,texture.EncodeToPNG());rows.Add(new{file=file,version=plan["version"].ToString(),position=new[]{p.x,p.y,p.z},target=new[]{target.x,target.y,target.z},fov=camera.fieldOfView,fog=true,fogStart=RenderSettings.fogStartDistance,fogEnd=RenderSettings.fogEndDistance,skyThickness=RenderSettings.skybox.GetFloat("_AtmosphereThickness"),effectiveSaturation=adjustments.saturation.value,effectiveContrast=adjustments.contrast.value,effectiveBloom=bloom.intensity.value,stage=stage,rendererSha256=hash("Assets/Settings/PC_Renderer.asset"),rpAsset=AssetDatabase.GetAssetPath(UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline),rpSha256=hash("Assets/Settings/LakeVillage_RPAsset.asset"),activeSlotMaskBefore=0,activeSlotMaskAfter=fadeMask(),mode="Editor PreviewScene 동조건 전후, 실제 TPS 액터 복제0"});System.IO.File.WriteAllText(output+"/poses.json",json(rows));}
  finally{camera.targetTexture=null;RenderTexture.active=previousRt;UnityEngine.Object.DestroyImmediate(texture);UnityEngine.Object.DestroyImmediate(rt);}
 }
}finally{
