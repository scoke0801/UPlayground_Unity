var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/Ingame/Worlds/RiverBasinWorld.unity"||EditorApplication.isPlaying)throw new Exception("전용 Edit Mode 씬 필요");
var json=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("Newtonsoft.Json.JsonConvert")).First(t=>t!=null);
var deserialize=json.GetMethod("DeserializeObject",new Type[]{typeof(string),typeof(Type)});
Func<object,Type,object> read=(v,t)=>deserialize.Invoke(null,new object[]{v.ToString(),t});
Func<object,Dictionary<string,object>[]> rows=v=>(Dictionary<string,object>[])read(v,typeof(Dictionary<string,object>[]));
var plan=(Dictionary<string,object>)read(System.IO.File.ReadAllText("Tools/RiverBasinWorld/production-plan.json"),typeof(Dictionary<string,object>));
var roots=scene.GetRootGameObjects();var all=roots.SelectMany(g=>g.GetComponentsInChildren<Transform>(true)).ToArray();var terrains=all.Select(t=>t.GetComponent<Terrain>()).Where(t=>t!=null).ToArray();
var defects=new List<object>();var routeResults=new List<object>();Physics.SyncTransforms();
var playerRoot=GameObject.Find("Player · RiverBasinWorld").transform;
foreach(var r in rows(plan["routes"]).Concat(rows(plan["branches"])).Concat(new[]{(Dictionary<string,object>)read(plan["detail"],typeof(Dictionary<string,object>))})){
 string id=r.ContainsKey("id")?r["id"].ToString():"P2";var pp=(float[][])read(r["points"],typeof(float[][]));int unsupported=0,blocked=0,samples=0,navFailures=0;float maxSlope=0,maxError=0;
 for(int i=1;i<pp.Length;i++){var a=new Vector3(pp[i-1][0],pp[i-1][1],pp[i-1][2]);var b=new Vector3(pp[i][0],pp[i][1],pp[i][2]);int count=Mathf.CeilToInt(Vector3.Distance(a,b)/2);Vector3 previous=Vector3.zero;bool hasPrevious=false;
  for(int j=0;j<=count;j++){var p=Vector3.Lerp(a,b,(float)j/count);samples++;var hits=Physics.RaycastAll(p+Vector3.up*2,Vector3.down,6,-1,QueryTriggerInteraction.Ignore).Where(h=>!h.collider.transform.IsChildOf(playerRoot)).OrderBy(h=>h.distance).ToArray();if(hits.Length==0){unsupported++;if(unsupported<5)defects.Add(new{route=id,kind="support",position=new[]{p.x,p.y,p.z}});hasPrevious=false;continue;}var hit=hits[0];
   float error=Mathf.Abs(hit.point.y-p.y);maxError=Mathf.Max(maxError,error);if(error>.4f&&defects.Count<120)defects.Add(new{route=id,kind="height",error,position=new[]{p.x,p.y,p.z},collider=hit.collider.name});
   if(hasPrevious){float horizontal=Vector2.Distance(new Vector2(p.x,p.z),new Vector2(previous.x,previous.z));if(horizontal>.1f)maxSlope=Mathf.Max(maxSlope,Mathf.Atan2(Mathf.Abs(hit.point.y-previous.y),horizontal)*Mathf.Rad2Deg);}previous=hit.point;hasPrevious=true;
   var overlaps=Physics.OverlapCapsule(hit.point+Vector3.up*.5f,hit.point+Vector3.up*1.5f,.35f,-1,QueryTriggerInteraction.Ignore).Where(c=>!(c is TerrainCollider)&&c!=hit.collider&&!c.transform.IsChildOf(GameObject.Find("Player · RiverBasinWorld").transform)).ToArray();if(overlaps.Length>0){blocked++;if(blocked<5)defects.Add(new{route=id,kind="capsule",position=new[]{p.x,p.y,p.z},names=overlaps.Select(c=>c.name).ToArray()});}
  }
  UnityEngine.AI.NavMeshHit na,nb;var path=new UnityEngine.AI.NavMeshPath();if(!UnityEngine.AI.NavMesh.SamplePosition(a,out na,3,UnityEngine.AI.NavMesh.AllAreas)||!UnityEngine.AI.NavMesh.SamplePosition(b,out nb,3,UnityEngine.AI.NavMesh.AllAreas)||!UnityEngine.AI.NavMesh.CalculatePath(na.position,nb.position,UnityEngine.AI.NavMesh.AllAreas,path)||path.status!=UnityEngine.AI.NavMeshPathStatus.PathComplete)navFailures++;
  if(UnityEngine.AI.NavMesh.SamplePosition(a,out na,3,UnityEngine.AI.NavMesh.AllAreas)&&UnityEngine.AI.NavMesh.SamplePosition(b,out nb,3,UnityEngine.AI.NavMesh.AllAreas)){if(!UnityEngine.AI.NavMesh.CalculatePath(nb.position,na.position,UnityEngine.AI.NavMesh.AllAreas,path)||path.status!=UnityEngine.AI.NavMeshPathStatus.PathComplete)navFailures++;}
 }
 routeResults.Add(new{id,samples,unsupported,blocked,maxSlope,maxError,navFailures});
}
float seam=0;foreach(var a in terrains)foreach(var b in terrains){var d=b.transform.position-a.transform.position;if(Mathf.Abs(d.x-512)<.01f&&Mathf.Abs(d.z)<.01f)for(int i=0;i<513;i++)seam=Mathf.Max(seam,Mathf.Abs(a.terrainData.GetHeight(512,i)-b.terrainData.GetHeight(0,i)));if(Mathf.Abs(d.z-512)<.01f&&Mathf.Abs(d.x)<.01f)for(int i=0;i<513;i++)seam=Mathf.Max(seam,Mathf.Abs(a.terrainData.GetHeight(i,512)-b.terrainData.GetHeight(i,0)));}
var rules=AssetDatabase.LoadAssetAtPath<UPlayGround.Data.CameraOccluderNameRulesSO>("Assets/10.Datas/Camera/CameraOccluderNameRules.asset");var structureChecks=new List<object>();foreach(var t in all.Where(t=>t.name.StartsWith("Castle_Moat_Bridge")||t.name=="PoorHouse_Barn"||t.name.StartsWith("House_Shrine")||t.name.StartsWith("LakeHouse_"))){UPlayGround.Data.CameraOccluderNameRulesSO.Rule match;bool found=rules.TryMatch(t.name,out match);structureChecks.Add(new{name=t.name,matched=found,mode=found?match.mode.ToString():"unmatched",colliders=t.GetComponentsInChildren<Collider>().Length});}
int missing=all.Sum(t=>GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(t.gameObject));var rendererList=all.SelectMany(t=>t.GetComponents<Renderer>()).ToArray();var invalidMats=rendererList.Where(r=>r.sharedMaterials.Any(m=>m==null||m.shader==null||m.shader.name=="Hidden/InternalErrorShader"||!m.shader.isSupported)).Select(r=>r.name).ToArray();
var result=new{scene=scene.path,version=Application.unityVersion,terrainCount=terrains.Length,seamError=seam,missingScripts=missing,invalidMaterialRenderers=invalidMats,objects=all.Length,routes=routeResults,structures=structureChecks,defects};
string output=(string)json.GetMethod("SerializeObject",new[]{typeof(object)}).Invoke(null,new object[]{result});System.IO.Directory.CreateDirectory("output/RiverBasinWorld");System.IO.File.WriteAllText("output/RiverBasinWorld/audit.json",output);return output;
