if(UnityEditor.EditorApplication.isCompiling||UnityEditor.EditorApplication.isUpdating)return "BUSY";var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/01.Scenes/Scenario/OpenWorld/LakeVillageWorld.unity")return "Lake 씬 필요";var weather=UnityEngine.Object.FindFirstObjectByType<UPlayGround.Gameplay.World.LivingWorld.EnvironmentController>();var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;var effects=(UPlayGround.Gameplay.World.LivingWorld.EnvironmentEffects)typeof(UPlayGround.Gameplay.World.LivingWorld.EnvironmentController).GetField("_effects",flags).GetValue(weather);var effectType=effects.GetType();var shelters=(UnityEngine.BoxCollider[])effectType.GetField("_shelters",flags).GetValue(effects);var mask=(UnityEngine.LayerMask)effectType.GetField("_roofLayers",flags).GetValue(effects);float distance=(float)effectType.GetField("_roofProbeDistance",flags).GetValue(effects);var positions=new System.Collections.Generic.List<UnityEngine.Vector3>();var roots=new System.Collections.Generic.List<UnityEngine.Transform>();foreach(var root in scene.GetRootGameObjects())foreach(var target in root.GetComponentsInChildren<UPlayGround.Gameplay.World.ReactiveEnvironment.ReactiveEnvironmentObject>(true))if(target.isActiveAndEnabled){positions.Add(target.ReactionPosition);roots.Add(target.OcclusionRoot);}var inside=new bool[positions.Count];var watch=System.Diagnostics.Stopwatch.StartNew();int sheltered=0;for(int i=0;i<positions.Count;i++){inside[i]=effects.IsSheltered(positions[i]);if(inside[i])sheltered++;}double volumeMs=watch.Elapsed.TotalMilliseconds;watch.Restart();var hits=new UnityEngine.RaycastHit[32];int rays=0,hitCount=0,blocked=0;for(int i=0;i<positions.Count;i++){if(inside[i])continue;rays++;int count=UnityEngine.Physics.RaycastNonAlloc(positions[i],UnityEngine.Vector3.up,hits,distance,mask,UnityEngine.QueryTriggerInteraction.Ignore);hitCount+=count;bool isBlocked=count==hits.Length;for(int h=0;h<count;h++)if(roots[i]==null||!hits[h].transform.IsChildOf(roots[i])){isBlocked=true;break;}if(isBlocked)blocked++;}string result="playing="+UnityEngine.Application.isPlaying+" targets="+positions.Count+" shelterVolumes="+shelters.Length+" volumeInside="+sheltered+" volumeMs="+volumeMs.ToString("F2")+" rayCount="+rays+" hits="+hitCount+" blocked="+blocked+" rayAndFilterMs="+watch.Elapsed.TotalMilliseconds.ToString("F2");System.IO.File.WriteAllText("output/ReactiveEnvironment/VegetationConversion-20261114/runtime-rain-cost.txt",result);return result;
