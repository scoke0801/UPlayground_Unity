                    "select": "WeightedRandom",
                    "choices": [
                        { "weight": 0.16, "action": "Transition", "state": "Circle", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 },
                        { "weight": 0.30, "action": "Transition", "state": "Flank", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 },
                        { "weight": 0.14, "action": "Transition", "state": "Guard", "cooldownId": "CloseGuard", "cooldownDuration": 2.8 },
                        { "weight": 0.24, "action": "Transition", "state": "Counter", "cooldownId": "CloseFootwork", "cooldownDuration": 2.2 }
                    ]
                },
